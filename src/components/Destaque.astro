---
/**
 * Destaque da home (briefing §5.1, D26, D33): o post mais recente numa folha, com a ilustração no
 * painel tingido, categoria, data e tempo de leitura (com os ícones), o título inteiro e a descrição
 * (como no blog atual), tags em pílulas e o botão "Ler artigo". Sem ilustração, ocupa uma coluna só.
 */
import Chip from "./Chip.astro";
import DataLeitura from "./DataLeitura.astro";
import Ilustracao from "./Ilustracao.astro";
import { ICONES } from "../lib/icones";
import { mdEmLinha, tituloComQuebras, transicaoPost } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import { urlTag, type Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
---

<section class="destaque wrap" aria-labelledby="destaque-titulo">
  <h2 id="destaque-titulo" class="titulo-secao">Em destaque</h2>
  <article class:list={["cartao-destaque", "folha", { "com-ilustracao": temIlustracao(post.slug) }]}>
    {
      temIlustracao(post.slug) && (
        <a class="ilustracao-destaque painel" data-desenhar href={post.url} tabindex="-1" aria-hidden="true" style={`--cor:${post.cor};${transicaoPost(post.slug, "desenho")}`}>
          <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} tamanho="cartao" decorativa inteira />
        </a>
      )
    }
    <div class="corpo-destaque">
      <p class="meta">
        <Chip cor={post.cor} nome={post.rotulo} href={post.urlRotulo} />
        <DataLeitura data={post.publicado} minutos={post.minutos} longo />
      </p>
      <h3 style={transicaoPost(post.slug, "titulo")}><a href={post.url} set:html={tituloComQuebras(post.tituloCompleto)} /></h3>
      <p class="descricao" set:html={mdEmLinha(post.descricao)} />
      <ul class="tags" aria-label="Tags">
        {
          post.tags.map((t) => (
            <li>
              <a class="pilula" href={urlTag(t)}>
                #{t}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="botao-primario" href={post.url}
        >Ler artigo<span class="sr">: {post.tituloCompleto}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} /></a
      >
    </div>
  </article>
</section>

<style>
  .destaque {
    padding-top: 56px;
  }

  .cartao-destaque {
    padding: 14px;
  }

  /*
   * O painel do desenho acompanha a altura do texto (D33): o recorte médio aparece inteiro, o maior
   * possível, centrado no painel, e o painel nunca fica solto no meio do card.
   */
  .cartao-destaque.com-ilustracao {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 36px;
    align-items: stretch;
  }

  .ilustracao-destaque {
    display: grid;
    min-height: 300px;
  }

  .corpo-destaque {
    padding: 18px 22px;
  }

  .com-ilustracao .corpo-destaque {
    padding-left: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

  h3 {
    margin: 12px 0 0;
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  h3 a:hover {
    color: var(--acento);
  }

  .descricao {
    max-width: 56ch;
    margin: 14px 0 0;
    font-family: var(--font-ui);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .descricao :global(code) {
    font-size: 0.88em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags .pilula {
    min-height: 30px;
    padding: 3px 11px;
  }

  .botao-primario {
    margin-top: 22px;
  }

  /* Até 960px, o desenho vai para cima, na largura toda: lado a lado, ele ficaria pequeno no painel. */
  @media (max-width: 960px) {
    .cartao-destaque.com-ilustracao {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .ilustracao-destaque {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .corpo-destaque,
    .com-ilustracao .corpo-destaque {
      padding: 4px 8px 12px;
    }
  }
</style>

<script>
  import { desenharAoEntrar } from "../scripts/desenho-vivo";

  desenharAoEntrar();
</script>
