---
/**
 * Seletor Lista / Cards (D27, D33), com os ícones do blog atual. O modo fica no navegador
 * (`cs-post-view`, a mesma chave do blog atual) e é aplicado pelo script do <head> (Base.astro) em
 * `data-post-view` no <html>, sem piscar; as listas mostram uma forma ou a outra pelo CSS
 * (.lista-artigos-modo e .cartoes-modo, em base.css). Os cards vêm num <template> (D37): viram DOM
 * na página (script logo depois dele) se o modo já for Cards, ou aqui, na primeira troca para Cards.
 * A troca esmaece a forma atual e traz a nova com um deslize de 8px (D42, Web Animations; direta com
 * movimento reduzido). Sem JS, fica a lista e o seletor some.
 */
import { ICONES } from "../lib/icones";
---

<div class="modo" role="group" aria-label="Modo de exibição" data-modo hidden>
  <button type="button" data-valor="list"
    ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.lista} />Lista</button
  >
  <button type="button" data-valor="cards"
    ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.grade} />Cards</button
  >
</div>

<script>
  const CHAVE = "cs-post-view";
  const raiz = document.documentElement;
  const seletores = [...document.querySelectorAll<HTMLElement>("[data-modo]")];
  // O modo para onde a página vai (durante a troca, o <html> ainda mostra o anterior).
  let alvo = raiz.dataset.postView === "cards" ? "cards" : "list";
  const marcar = () => {
    for (const s of seletores)
      s.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.valor === alvo)));
  };
  const reduzir = matchMedia("(prefers-reduced-motion: reduce)");
  const formas = () => [...document.querySelectorAll<HTMLElement>(".lista-modo, .cartoes-modo")];
  const visiveis = () => formas().filter((f) => f.getClientRects().length > 0);
  // Some em 0,12s, troca e a forma nova aparece em 0,22s, subindo 8px. Um clique no meio da troca
  // cancela a anterior e começa de onde a tela está.
  let vez = 0;
  const trocar = async (valor: string) => {
    if (valor === alvo) return;
    alvo = valor;
    marcar();
    const minha = ++vez;
    formas().forEach((f) => f.getAnimations().forEach((a) => a.cancel()));
    if (!reduzir.matches) {
      const saindo = visiveis().map((f) => f.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: "ease-in", fill: "forwards" }));
      await Promise.all(saindo.map((a) => a.finished.catch(() => {})));
      if (minha !== vez) return;
      formas().forEach((f) => f.getAnimations().forEach((a) => a.cancel()));
    }
    raiz.dataset.postView = valor;
    if (reduzir.matches) return;
    for (const f of visiveis())
      f.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 220, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
  };

  for (const seletor of seletores) {
    seletor.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.valor === "cards") {
          const moldes = document.querySelectorAll<HTMLTemplateElement>("template[data-cartoes]");
          moldes.forEach((t) => t.replaceWith(t.content));
          if (moldes.length) dispatchEvent(new Event("cartoes:prontos"));
        }
        trocar(b.dataset.valor!);
        try {
          localStorage.setItem(CHAVE, b.dataset.valor!);
        } catch {
          // Sem armazenamento: o modo vale só nesta página.
        }
      }),
    );
    seletor.hidden = false;
  }
  marcar();
</script>

<style>
  .modo {
    display: inline-flex;
    flex: none;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-hi);
    font-family: var(--font-ui);
  }

  .modo[hidden] {
    display: none;
  }

  .modo button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 6px 14px 6px 12px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 14px;
    cursor: pointer;
  }

  .modo button:hover {
    color: var(--ink);
  }

  .modo button[aria-pressed="true"] {
    background: var(--acento);
    color: var(--sobre-acento);
  }

  .modo svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
