---
/**
 * Post-it das frases de autores (D33): um bloquinho de post-it amarelo apagado, colado meio torto,
 * com a frase em Newsreader itálico (a letra das frases dos livros) e o nome do autor levando à fonte.
 * A cada visita, a frase é sorteada (pedido do Cesar), sem repetir a última mostrada (guardada no
 * navegador) nem as já vistas na sessão; nos artigos, só entre as do assunto (D37). O texto aparece
 * desde o início (D38): na primeira visita, a frase do HTML (fraseDaPagina, também a de quem está
 * sem JS); depois de carregar, a lista vai para o navegador (cs-frases), e nas visitas seguintes o
 * script logo depois do post-it sorteia antes da primeira pintura. "outra frase", riscado à mão no pé
 * do papel, arranca a folha de cima (ela sai voando e revela a de baixo, com outra frase). Com
 * prefers-reduced-motion, a troca é direta.
 */
import "@fontsource-variable/newsreader/opsz-italic.css";
import { conjuntoDoArtigo, fraseDaPagina, tamanhoDaFrase } from "../lib/frases";
import { ICONES } from "../lib/icones";
import { url } from "../lib/url";

interface Props {
  /** Slug do artigo; sem ele, a frase da home. */
  chave?: string;
  /** Tags e livro do artigo: o sorteio fica entre as frases do assunto dele (D37). */
  temas?: string[];
  /** Giro do papel, em graus. */
  giro?: number;
  class?: string;
}

const { chave, temas, giro = -2.2, class: classe } = Astro.props;
const conjunto = temas ? conjuntoDoArtigo(temas) : undefined;
const { frase, indice } = fraseDaPagina(chave, conjunto);
---

<figure
  class:list={["postit", classe]}
  data-postit
  data-fonte={url("/frases.json")}
  data-indice={indice}
  data-conjunto={conjunto?.join(",")}
  style={`--giro:${giro}deg`}
>
  <div class="papel" data-papel data-tamanho={tamanhoDaFrase(frase.texto)}>
    <blockquote><p data-texto>{frase.texto}</p></blockquote>
    <figcaption>
      <a href={frase.url} title={frase.contexto} data-autor
        >{frase.autor}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.externo} /></a
      >
    </figcaption>
    <button type="button" class="outra" data-outra hidden>
      <span>outra frase</span>
      <svg class="rabisco" viewBox="0 0 104 12" aria-hidden="true" focusable="false">
        <path d="M2 7.2c8.5-3.1 15.8 2.4 25.4-.5 9.1-2.8 17.6-3.4 27.3-.2 9.2 3 18.4 2.1 27.8-1.3 6.6-2.4 12.4-2 19.5.4"></path>
      </svg>
      <svg class="seta" viewBox="0 0 24 14" aria-hidden="true" focusable="false">
        <path d="M2.5 7.6c5.6-.5 11.2-.4 16.6.1M14.4 2.8c1.9 1.7 3.6 3.2 5.3 4.8-1.8 1.6-3.7 3.1-5.7 4.6"></path>
      </svg>
    </button>
  </div>
</figure>
<script is:inline>
  // A frase da visita (D33, D38): com a lista guardada numa visita anterior (cs-frases), sorteia aqui,
  // antes da primeira pintura, sem esconder nada; na primeira visita, fica a do HTML. O corpo da letra
  // segue a regra de src/lib/tamanho-da-frase.ts.
  (function (p) {
    try {
      var l = JSON.parse(localStorage.getItem("cs-frases") || "null");
      if (!l || !l.length) return;
      var c = p.dataset.conjunto ? p.dataset.conjunto.split(",").map(Number) : l.map(function (_, i) { return i; });
      var vistas = JSON.parse(sessionStorage.getItem("cs-frases-vistas") || "[]");
      var ultima = Number(localStorage.getItem("cs-frase-ultima"));
      var livres = c.filter(function (i) { return l[i] && vistas.indexOf(i) < 0 && i !== ultima; });
      if (!livres.length) livres = c.filter(function (i) { return l[i] && i !== ultima; });
      if (!livres.length) return;
      var i = livres[Math.floor(Math.random() * livres.length)];
      var f = l[i], n = f[0].length;
      var papel = p.querySelector("[data-papel]"), autor = papel.querySelector("[data-autor]");
      papel.querySelector("[data-texto]").textContent = f[0];
      papel.dataset.tamanho = n <= 90 ? "curta" : n <= 140 ? "media" : n <= 170 ? "longa" : "muito-longa";
      autor.firstChild.textContent = f[1];
      autor.title = f[2];
      autor.href = f[3];
      p.dataset.indice = i;
    } catch (e) {}
  })(document.currentScript.previousElementSibling);
</script>

<script>
  import { tocarPapel } from "../scripts/som";
  import { tamanhoDaFrase } from "../lib/tamanho-da-frase";

  type Linha = [texto: string, autor: string, contexto: string, url: string];
  const CHAVE = "cs-frases-vistas";
  const ULTIMA = "cs-frase-ultima";
  const postits = [...document.querySelectorAll<HTMLElement>("[data-postit]")];
  const semMovimento = matchMedia("(prefers-reduced-motion: reduce)");
  let lista: Promise<Linha[]> | undefined;
  let atual = Number(postits[0]?.dataset.indice ?? 0);

  const vistas = (): number[] => {
    try {
      return JSON.parse(sessionStorage.getItem(CHAVE) ?? "[]");
    } catch {
      return [];
    }
  };
  const guardar = (v: number[]) => {
    try {
      sessionStorage.setItem(CHAVE, JSON.stringify(v.slice(-80)));
    } catch {
      // sem armazenamento: só não evita repetir entre páginas
    }
  };

  const ultima = (): number | undefined => {
    try {
      const v = localStorage.getItem(ULTIMA);
      return v === null ? undefined : Number(v);
    } catch {
      return undefined;
    }
  };
  const marcarUltima = (i: number) => {
    try {
      localStorage.setItem(ULTIMA, String(i));
    } catch {
      // sem armazenamento: a próxima visita pode repetir, sem outro efeito
    }
  };

  // No artigo, só as frases do assunto dele (data-conjunto, D37); na home, todas.
  const conjunto = postits[0]?.dataset.conjunto?.split(",").map(Number);
  function sortear(total: number): number {
    const todas = conjunto ?? Array.from({ length: total }, (_, i) => i);
    const ja = new Set([...vistas(), atual, ultima()]);
    const livres = todas.filter((i) => !ja.has(i));
    const opcoes = livres.length ? livres : todas.filter((i) => i !== atual);
    return opcoes.length ? opcoes[Math.floor(Math.random() * opcoes.length)] : atual;
  }

  function escrever(postit: HTMLElement, [texto, autor, contexto, endereco]: Linha) {
    const papel = postit.querySelector<HTMLElement>("[data-papel]")!;
    const link = papel.querySelector<HTMLAnchorElement>("[data-autor]")!;
    papel.querySelector("[data-texto]")!.textContent = texto;
    papel.dataset.tamanho = tamanhoDaFrase(texto);
    link.firstChild!.textContent = autor;
    link.href = endereco;
    link.title = contexto;
  }

  const buscar = (fonte: string) => (lista ??= fetch(fonte).then((r) => r.json() as Promise<Linha[]>));

  async function outra(origem: HTMLElement) {
    let frases: Linha[];
    try {
      frases = await buscar(origem.dataset.fonte!);
    } catch {
      lista = undefined;
      return;
    }
    atual = sortear(frases.length);
    guardar([...vistas(), atual]);
    marcarUltima(atual);
    tocarPapel();
    for (const postit of postits) {
      // A folha de cima sai voando (uma cópia dela); a de baixo já tem a frase nova.
      if (!semMovimento.matches) {
        const papel = postit.querySelector<HTMLElement>("[data-papel]")!;
        const folha = papel.cloneNode(true) as HTMLElement;
        folha.removeAttribute("data-papel");
        folha.classList.add("arrancada");
        folha.setAttribute("aria-hidden", "true");
        folha.querySelectorAll("a, button").forEach((e) => e.setAttribute("tabindex", "-1"));
        postit.append(folha);
        folha.addEventListener("animationend", () => folha.remove(), { once: true });
      }
      escrever(postit, frases[atual]);
    }
  }

  for (const postit of postits) {
    const botao = postit.querySelector<HTMLButtonElement>("[data-outra]")!;
    botao.addEventListener("click", () => outra(postit));
    botao.hidden = false;
  }

  // A frase da visita já foi escolhida pelo script logo depois do post-it (D38): aqui ela é
  // registrada, e a lista fica guardada para a próxima visita sortear antes de pintar.
  if (postits.length) {
    guardar([...vistas(), atual]);
    marcarUltima(atual);
    const guardarLista = () =>
      buscar(postits[0].dataset.fonte!)
        .then((frases) => {
          try {
            localStorage.setItem("cs-frases", JSON.stringify(frases));
          } catch {
            // Sem armazenamento: cada visita fica com a frase do HTML.
          }
        })
        .catch(() => {
          lista = undefined;
        });
    "requestIdleCallback" in window ? requestIdleCallback(guardarLista) : setTimeout(guardarLista, 1500);
  }
</script>

<style>
  .postit {
    --largura-postit: 206px;
    position: relative;
    width: var(--largura-postit);
    margin: 0;
    container-type: inline-size;
    rotate: var(--giro);
    perspective: 700px;
  }

  /*
   * O papel: amarelo apagado com o grão dos livros, a sombra das folhas de baixo do bloquinho (as
   * bordas deslocadas) e a sombra de um papel que descola um pouco embaixo.
   */
  .papel,
  .arrancada {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 4:5 cabe a frase mais longa das 125: a altura não muda quando a frase troca (D37). */
    aspect-ratio: 4 / 5;
    padding: 20px 18px 14px 20px;
    background:
      linear-gradient(172deg, transparent 62%, color-mix(in oklab, var(--postit-tinta) 7%, transparent)),
      var(--grao) 0 0 / 180px 180px,
      var(--postit);
    color: var(--postit-tinta);
    box-shadow:
      1px 1.5px 0 -0.5px color-mix(in oklab, var(--postit), black 10%),
      2.5px 3.5px 0 -1px color-mix(in oklab, var(--postit), black 16%),
      0 16px 18px -14px rgb(40 30 0 / 0.5),
      0 2px 4px rgb(40 30 0 / 0.08);
  }

  blockquote {
    margin: 0;
  }

  p {
    margin: 0;
    font-family: var(--font-livro-italico, "Newsreader Variable"), Georgia, serif;
    font-style: italic;
    font-weight: 430;
    font-variation-settings: "opsz" 18;
    line-height: 1.3;
    text-wrap: pretty;
  }

  /* Os corpos valem no papel de 206px e acompanham a largura dele (184 a 212px), em cqi (D37). */
  [data-tamanho="curta"] p {
    font-size: 9.47cqi;
  }

  [data-tamanho="media"] p {
    font-size: 8.01cqi;
  }

  [data-tamanho="longa"] p {
    font-size: 7.09cqi;
    line-height: 1.26;
  }

  [data-tamanho="muito-longa"] p {
    font-size: 6.6cqi;
    line-height: 1.24;
  }

  figcaption {
    margin-top: 8px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.3;
  }

  figcaption::before {
    content: "— ";
  }

  /* Alvo de toque de 24px (WCAG 2.5.8), sem mudar a linha. */
  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  figcaption svg {
    width: 11px;
    height: 11px;
    margin-left: 3px;
    vertical-align: -0.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  /* "outra frase", escrito e riscado à mão no pé do papel. */
  .outra {
    position: relative;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding: 4px 2px 7px 6px;
    border: 0;
    background: none;
    color: var(--postit-tinta);
    font-family: var(--font-livro-italico, "Newsreader Variable"), Georgia, serif;
    font-style: italic;
    font-variation-settings: "opsz" 18;
    font-size: 15.5px;
    line-height: 1;
    cursor: pointer;
  }

  .outra[hidden] {
    display: none;
  }

  .outra svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rabisco {
    position: absolute;
    left: 4px;
    right: 22px;
    bottom: 0;
    width: calc(100% - 26px);
    height: 8px;
    stroke-dasharray: 110;
    stroke-dashoffset: 0;
  }

  .seta {
    width: 22px;
    height: 13px;
    transition: translate 0.25s;
  }

  .outra:hover .rabisco,
  .outra:focus-visible .rabisco {
    animation: riscar 0.5s ease-out;
  }

  .outra:hover .seta,
  .outra:focus-visible .seta {
    translate: 3px 0;
  }

  .outra:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @keyframes riscar {
    from {
      stroke-dashoffset: 110;
    }
  }

  /* A folha arrancada: descola de baixo para cima e sai voando para o alto. */
  .arrancada {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: 50% 0;
    animation: arrancar 0.62s cubic-bezier(0.45, 0, 0.7, 0.4) forwards;
  }

  @keyframes arrancar {
    30% {
      transform: rotateX(-28deg) translateY(-2px);
    }

    100% {
      transform: translate(46px, -110px) rotate(16deg) rotateX(-40deg);
      opacity: 0;
    }
  }

  :global(:root[data-theme="dark"]) .papel {
    box-shadow:
      1px 1.5px 0 -0.5px color-mix(in oklab, var(--postit), black 18%),
      2.5px 3.5px 0 -1px color-mix(in oklab, var(--postit), black 26%),
      0 18px 20px -14px rgb(0 0 0 / 0.8);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .papel {
      box-shadow:
        1px 1.5px 0 -0.5px color-mix(in oklab, var(--postit), black 18%),
        2.5px 3.5px 0 -1px color-mix(in oklab, var(--postit), black 26%),
        0 18px 20px -14px rgb(0 0 0 / 0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .papel > :is(blockquote, figcaption) {
      transition: none;
    }

    .outra:hover .rabisco,
    .outra:focus-visible .rabisco {
      animation: none;
    }

    .seta {
      transition: none;
    }
  }
</style>
