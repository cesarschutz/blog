---
/**
 * Rodapé (rodada 3, área 3; rodada 4, R1 e R2): a ficha de empréstimo do 12 ("está perfeita") deitada num
 * tampo de feltro verde, com o "Cesar Schutz" gigante na página, atrás, cortado pela borda de cima do
 * feltro, e a cordinha de latão pendurada à direita, que sobe a página.
 *
 * De cima para baixo: o conteúdo da página termina, um respiro de 96px, o nome gigante (Besley 800 na
 * tinta da página, na largura do conteúdo) com 58% das maiúsculas à vista, e o feltro, que corta o resto.
 * O feltro (R1, a superfície que a rodada 4 escolheu: "sem madeira, mas não incompleto") é da cor da capa
 * do caderno "cs" da marca (o `--marca`, escurecido 20% no claro e 35% no escuro), com fibra fina (um
 * ruído de 2px feito de gradientes, sem imagem), a bainha de 1px mais clara a 6px das bordas e 2px de
 * sombra quente na borda de cima, onde ele encosta na página. A ficha fica deitada nele, a 48px da borda
 * de cima, girada −1°, com a sombra dela no feltro: a cabeça "Ficha de empréstimo" com o autor; as colunas
 * "Emprestado a: você", "Devolver: quando quiser", "Onde achar o autor" (GitHub, LinkedIn e RSS, com os
 * ícones que se mexem) e "Na biblioteca" (o texto que gira, T12); o carimbo "Biblioteca C.S." com a data
 * de hoje, que bate 0,6s depois de a ficha entrar na tela. Sem copyright e sem a marca repetida (F11-1).
 *
 * A cordinha (R2, do 19: "combina com o abajur"): pendurada da borda de cima do feltro, à direita, numa
 * roseta de latão, com o fio de algodão e o pingente de latão. No hover (ou no foco do teclado) ela balança
 * como um pêndulo que perde força (14°, −7°, 3°, −1°, em 1,2s) e mostra "Puxe para subir". O clique (ou
 * Enter, Espaço, a tecla T dos atalhos e o toque) estica o fio 10px em 0,12s, solta com mola, e a página
 * sobe; dá também para puxar arrastando para baixo. A bolinha com a seta (VoltarTopo) e a fita da ficha
 * saíram; nas páginas longas, a aba de fichário da borda direita (AbaTopo) sobe antes de chegar aqui, e
 * sai quando a cordinha entra na tela. A 390px o fio tem 60px, na faixa da direita do feltro, ao lado
 * da ficha (que abre espaço para ela); o ícone do computador fica no canto da esquerda, longe dela.
 *
 * O nome respira o peso, de 800 a 680 e de volta em 7s, nunca abaixo de 650 (N10), só enquanto está à
 * vista e nunca com movimento reduzido. Abaixo de 900px, as colunas da direita da ficha descem; o nome fica
 * numa linha só, como na tela larga (D82), quase de borda a borda.
 *
 * Ganchos (não renomear): o nome em `.rodape-parede` (`.nome-rodape`, `data-nome-rodape`), o chão em
 * `.rodape-chao`; as variáveis `--nome` (o tamanho), `--nome-visivel` (a caixa do nome, do alto das
 * maiúsculas ao feltro) e `--nome-sob-ficha` (o que o chão cobre do nome: zero, o feltro corta na linha).
 * O troca.js procura `body > .rodape`. A cordinha é `[data-cordinha]` e também `[data-voltar-topo]`, que
 * a tecla T dos atalhos aperta (Atalhos.astro).
 *
 * A amostra D5 (nas amostras do redesenho, fora do git) usa o mesmo componente com `superficie` ("feltro", "nicho", "tinta"
 * ou "pedra") e `amostra` (um `<div>` em vez do `<footer>`; a cordinha sobe até o alto da amostra).
 */
import { AUTOR } from "../data/site";
import { ICONES, MARCAS } from "../lib/icones";
import { url } from "../lib/url";
import "../styles/traco.css";

interface Props {
  /** A superfície sob a ficha. O protótipo usa o feltro; as outras são da amostra D5. */
  superficie?: "feltro" | "nicho" | "tinta" | "pedra";
  /** Numa página de amostra: sem o papel de rodapé da página, e a cordinha sobe até o alto da amostra. */
  amostra?: boolean;
}

const { superficie = "feltro", amostra = false } = Astro.props;
const Tag = amostra ? "div" : "footer";

const MESES = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const hoje = new Date();
// A data do build; o script troca pela do dia em que o leitor chega.
const dataDoCarimbo = `${hoje.getDate()} ${MESES[hoje.getMonth()]} ${hoje.getFullYear()}`;
const navegar = [
  { nome: "Artigos", href: url("/archive/") },
  { nome: "Livros", href: url("/categories/") },
  { nome: "Séries", href: url("/series/") },
  { nome: "Tags", href: url("/tags/") },
];
// O texto que gira (T12): cada letra tem a cópia dela uma linha abaixo.
const letras = (nome: string) => [...nome].map((c, k) => ({ c, k }));
---

<Tag class="rodape" data-rodape data-superficie={superficie} data-chao={superficie === "nicho" ? "nicho" : undefined} data-amostra={amostra ? "" : undefined}>
  <div class="rodape-parede" aria-hidden="true">
    <p class="nome-rodape" data-nome-rodape><span class="nome-linha">Cesar</span> <span class="nome-linha">Schutz</span></p>
  </div>
  <div class="rodape-chao">
    <span class="tampo-bainha" aria-hidden="true"></span>
    {
      superficie === "nicho" && (
        <span class="nicho" aria-hidden="true">
          <span class="nicho-parede" />
          <span class="nicho-teto" />
          <span class="nicho-friso" />
        </span>
      )
    }
    {/* R2: a cordinha, pendurada da borda de cima do tampo, à direita. */}
    <button type="button" class="cordinha" data-cordinha data-voltar-topo={amostra ? undefined : ""} aria-label="Puxe para subir: volta ao topo da página" title="Voltar ao topo">
      <span class="cordinha-roseta" aria-hidden="true"></span>
      <span class="cordinha-corpo" aria-hidden="true">
        <span class="cordinha-fio"></span>
        <span class="cordinha-pingente"></span>
      </span>
      <span class="cordinha-texto" aria-hidden="true">Puxe para subir</span>
    </button>
    <div class="wrap rodape-lugar">
      <div class="ficha-emprestimo" data-ficha-emprestimo>
        <div class="fe-cabeca">
          <p class="fe-titulo">Ficha de empréstimo</p>
          <p class="fe-dono">{AUTOR.nome} · {AUTOR.cargo}</p>
        </div>
        <div class="fe-grade">
          <div class="fe-coluna fe-emprestimo">
            <p class="fe-rotulo">Emprestado a</p>
            <p class="fe-valor fe-escrito">você</p>
          </div>
          <div class="fe-coluna fe-devolver">
            <p class="fe-rotulo">Devolver</p>
            <p class="fe-valor fe-escrito">quando quiser</p>
          </div>
          <div class="fe-coluna fe-perfis">
            <p class="fe-rotulo">Onde achar o autor</p>
            <ul>
              <li>
                <a href={AUTOR.github} rel="me" class="fe-perfil fe-github">
                  <svg class="fe-icone" viewBox={MARCAS.github.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.github.d} /></svg>
                  <span class="fe-nome">GitHub</span><span class="fe-nota"> · o código dos artigos</span>
                </a>
              </li>
              <li>
                <a href={AUTOR.linkedin} rel="me" class="fe-perfil fe-linkedin">
                  <svg class="fe-icone" viewBox={MARCAS.linkedin.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.linkedin.d} /></svg>
                  <span class="fe-nome">LinkedIn</span><span class="fe-nota"> · para conversar</span>
                </a>
              </li>
              <li>
                <a href={url("/rss.xml")} class="fe-perfil fe-rss">
                  <svg class="fe-icone traco-rss" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.rss} />
                  <span class="fe-nome">RSS</span><span class="fe-nota"> · para não perder nenhum</span>
                </a>
              </li>
            </ul>
          </div>
          <nav class="fe-coluna fe-navegar" aria-label={amostra ? undefined : "Na biblioteca"}>
            <p class="fe-rotulo">Na biblioteca</p>
            <ul>
              {
                navegar.map((l) => (
                  <li>
                    <a href={l.href}>
                      <span class="sr">{l.nome}</span>
                      <span class="rola" aria-hidden="true">
                        {letras(l.nome).map((x) => (
                          <span style={`--k:${x.k}`}>{x.c}</span>
                        ))}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <div class="fe-carimbo" aria-hidden="true" data-carimbo>
          <span class="fe-carimbo-nome">Biblioteca C.S.</span>
          <span class="fe-carimbo-data" data-carimbo-data>{dataDoCarimbo}</span>
        </div>
      </div>
    </div>
  </div>
</Tag>

<script>
  /*
   * Um script para todos os rodapés da página (o da página e os da amostra D5): o carimbo com a data de
   * hoje, que bate 0,6s depois de a ficha entrar na tela (uma vez); a respiração do nome, só com ele à
   * vista; o giro das letras de "Na biblioteca" no toque; e a cordinha.
   */
  const reduzido = matchMedia("(prefers-reduced-motion: reduce)");
  const MESES = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
  // A mola da volta (a mesma da cordinha do lustre, SeletorTema: passa ~16% e assenta).
  const MOLA =
    "linear(0, 0.09, 0.299, 0.548, 0.78, 0.964, 1.086, 1.148, 1.163, 1.145, 1.109, 1.069, 1.031, 1.003, 0.984, 0.975, 0.974, 0.977, 0.983, 0.99, 0.996, 1, 1.003, 1.004, 1.003, 1.001, 1)";
  /** O puxão do clique: 10px em 0,12s (R2). */
  const PUXAO = 10;
  /** Arrastando, o fio estica até aqui (com resistência). */
  const PUXAO_MAX = 26;

  function carimbar(rodape: HTMLElement) {
    const ficha = rodape.querySelector<HTMLElement>("[data-ficha-emprestimo]");
    const data = rodape.querySelector<HTMLElement>("[data-carimbo-data]");
    const carimbo = rodape.querySelector<HTMLElement>("[data-carimbo]");
    if (data) {
      const d = new Date();
      data.textContent = `${d.getDate()} ${MESES[d.getMonth()]} ${d.getFullYear()}`;
    }
    if (!ficha || !carimbo || reduzido.matches || !("IntersectionObserver" in window)) return;
    carimbo.classList.add("esperando");
    let relogio = 0;
    const olho = new IntersectionObserver(
      (entradas) => {
        const dentro = entradas.some((e) => e.isIntersecting);
        // Entrou e saiu antes de 0,6s (rolando depressa): espera a próxima vez.
        if (!dentro) {
          clearTimeout(relogio);
          relogio = 0;
          return;
        }
        if (relogio) return;
        relogio = window.setTimeout(() => {
          olho.disconnect();
          carimbo.classList.remove("esperando");
          carimbo.classList.add("batendo");
        }, 600);
      },
      { threshold: 0.5 },
    );
    olho.observe(ficha);
  }

  function respirar(rodape: HTMLElement) {
    const nome = rodape.querySelector<HTMLElement>("[data-nome-rodape]");
    if (nome && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => nome.classList.toggle("na-tela", e.isIntersecting)).observe(nome);
    }
  }

  // "Na biblioteca" no toque: o dedo que encosta no item gira as letras (o mouse e o teclado, pelo CSS).
  function girarNoToque(rodape: HTMLElement) {
    rodape.querySelector(".fe-navegar")?.addEventListener(
      "pointerdown",
      (e) => {
        const ev = e as PointerEvent;
        if (ev.pointerType !== "touch") return;
        const item = (ev.target as HTMLElement).closest("a");
        if (!item) return;
        item.classList.add("girando");
        const soltar = () => item.classList.remove("girando");
        item.addEventListener("pointercancel", soltar, { once: true });
        setTimeout(soltar, 900);
      },
      { passive: true },
    );
  }

  /*
   * A cordinha (R2). O fio estica (scaleY, do alto) e o pingente desce junto (translateY); a volta é a mola.
   * O clique curto, o teclado (Enter, Espaço, T) e o toque curto dão o puxão inteiro: 10px em 0,12s, soltam
   * e sobem a página. Com o mouse, arrastando para baixo, o fio vai com a mão (com resistência, até 26px) e
   * sobe a página ao soltar, se passou de 6px; para cima ou de lado, só solta. No toque, arrastar é rolar a
   * página (touch-action: pan-y). Com movimento reduzido, nada estica: só sobe, sem rolagem suave.
   */
  function cordinha(rodape: HTMLElement) {
    const botao = rodape.querySelector<HTMLButtonElement>("[data-cordinha]");
    const fio = botao?.querySelector<HTMLElement>(".cordinha-fio");
    const pingente = botao?.querySelector<HTMLElement>(".cordinha-pingente");
    if (!botao || !fio || !pingente) return;
    const comprimento = () => fio.offsetHeight || 1;
    const esticado = (dy: number) => `scaleY(${(1 + dy / comprimento()).toFixed(4)})`;
    const descido = (dy: number) => `translateY(${dy.toFixed(1)}px)`;
    let andamento: Animation[] = [];
    let inicio: number | null = null;
    let inicioX = 0;
    let puxou = 0;
    // Quanto o ponteiro andou para qualquer lado: arrastar para cima ou de lado não é clique (não sobe a página).
    let andou = 0;

    const parar = () => {
      andamento.forEach((a) => a.cancel());
      andamento = [];
    };
    const posar = (dy: number) => {
      fio.style.transform = dy ? esticado(dy) : "";
      pingente.style.transform = dy ? descido(dy) : "";
    };
    /** Solta de `de` px: volta com a mola. */
    const soltar = (de: number) => {
      parar();
      posar(0);
      botao.classList.remove("na-mao");
      if (reduzido.matches || de <= 0) return;
      const tempo = { duration: 620, easing: MOLA };
      andamento = [
        fio.animate([{ transform: esticado(de) }, { transform: "none" }], tempo),
        pingente.animate([{ transform: descido(de) }, { transform: "none" }], tempo),
      ];
    };
    /** Sobe a página (ou, na amostra, até o alto dela), com o foco no título, para o teclado recomeçar dali. */
    const subir = () => {
      const comportamento: ScrollBehavior = reduzido.matches ? "auto" : "smooth";
      const naAmostra = rodape.hasAttribute("data-amostra") ? rodape.closest<HTMLElement>("[data-amostra-alvo]") : null;
      if (naAmostra) {
        naAmostra.scrollIntoView({ behavior: comportamento, block: "start" });
      } else {
        scrollTo({ top: 0, behavior: comportamento });
      }
      const alvo = naAmostra?.querySelector<HTMLElement>("h2, h3") ?? document.querySelector<HTMLElement>("main h1") ?? document.querySelector<HTMLElement>("main");
      if (alvo) {
        if (!alvo.hasAttribute("tabindex")) alvo.setAttribute("tabindex", "-1");
        alvo.focus({ preventScroll: true });
      }
    };
    /** O puxão inteiro: desce até 10px em 0,12s (do ponto em que estiver), solta e sobe. */
    const puxarESoltar = (de = 0) => {
      if (reduzido.matches) {
        posar(0);
        botao.classList.remove("na-mao");
        return subir();
      }
      const falta = Math.max(0, PUXAO - de);
      if (falta < 0.5) {
        soltar(Math.max(de, PUXAO));
        return subir();
      }
      parar();
      posar(0);
      const tempo: KeyframeAnimationOptions = { duration: 120 * (falta / PUXAO), easing: "cubic-bezier(0.3, 0, 0.6, 1)", fill: "forwards" };
      andamento = [
        fio.animate([{ transform: esticado(de) }, { transform: esticado(PUXAO) }], tempo),
        pingente.animate([{ transform: descido(de) }, { transform: descido(PUXAO) }], tempo),
      ];
      const ultimo = andamento[1];
      ultimo.finished.then(
        () => {
          soltar(PUXAO);
          subir();
        },
        () => {},
      );
    };

    botao.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      inicio = e.clientY;
      inicioX = e.clientX;
      puxou = 0;
      andou = 0;
      try {
        botao.setPointerCapture(e.pointerId);
      } catch {
        // Sem captura (o ponteiro já saiu): o puxão fica só no soltar.
      }
      botao.classList.add("na-mao");
    });
    botao.addEventListener("pointermove", (e) => {
      if (inicio === null) return;
      andou = Math.max(andou, Math.hypot(e.clientX - inicioX, e.clientY - inicio));
      if (reduzido.matches) return;
      // Os primeiros pixels vão junto com a mão; depois o fio pesa.
      const d = Math.max(0, e.clientY - inicio);
      puxou = PUXAO_MAX * (1 - Math.exp(-d / PUXAO_MAX));
      parar();
      posar(puxou);
    });
    botao.addEventListener("pointerup", () => {
      if (inicio === null) return;
      inicio = null;
      // Clique curto: o puxão inteiro. Arrastou para baixo: solta de onde está e sobe se passou de 6px.
      // Arrastou para cima ou de lado: só solta.
      if (puxou <= 3 && andou <= 8) puxarESoltar(puxou);
      else if (puxou <= 3) soltar(puxou);
      else {
        const de = puxou;
        soltar(de);
        if (de > 6) subir();
      }
    });
    botao.addEventListener("pointercancel", () => {
      if (inicio === null) return;
      inicio = null;
      soltar(puxou);
      puxou = 0;
    });
    // Enter, Espaço e a tecla T (o clique do ponteiro já foi tratado no pointerup).
    botao.addEventListener("click", (e) => {
      if (e.detail === 0) puxarESoltar(0);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-rodape]").forEach((rodape) => {
    carimbar(rodape);
    respirar(rodape);
    girarNoToque(rodape);
    cordinha(rodape);
  });
</script>

<style>
  /* ---------- a composição: o nome na página e, embaixo, o tampo com a ficha ---------- */

  .rodape {
    /*
     * O nome: na largura do conteúdo ("Cesar Schutz" tem 7,09em em Besley 800), de 36 a 260px. As
     * maiúsculas têm 0,75em; 58% delas ficam à vista acima do tampo, e o tampo corta o resto. Medido no
     * desenho (E1): o "C" e o "S" passam 0,02em da linha das maiúsculas, então a caixa tem 0,416em (e não
     * 0,435) para o que se vê da letra dar 58%. O tampo corta na linha: nada dele cobre o nome
     * (`--nome-sob-ficha` é zero).
     */
    --nome: clamp(36px, calc((100vw - 2 * var(--pad) - 16px) / 7.1), 260px);
    --nome-sob-ficha: 0px;
    --nome-visivel: calc(var(--nome) * 0.416 + var(--nome-sob-ficha));
    /* A cordinha: o fio, o pingente e onde ela fica (a faixa da direita). */
    --fio: clamp(60px, 8vw, 116px);
    --cordinha-direita: clamp(20px, 3vw, 44px);
    /* As cores da cordinha sobre o feltro (cada superfície da amostra ajusta as suas). */
    --cordinha-algodao: color-mix(in oklab, var(--marca-letra) 88%, var(--latao));
    --cordinha-trama: color-mix(in oklab, var(--marca-letra) 62%, var(--latao-escuro));
    --sombra-no-tampo: color-mix(in oklab, var(--sombra-quente) 62%, transparent);
    position: relative;
    margin-top: 96px;
    overflow-x: clip;
    font-family: var(--font-ui);
  }

  .rodape-parede {
    position: relative;
    z-index: 0;
    min-width: 0;
    pointer-events: none;
    user-select: none;
  }

  /*
   * O nome gigante (T1): a caixa tem a altura do que aparece (58% das maiúsculas); o texto sobe 0,16em, para
   * o alto das maiúsculas encostar no alto da caixa (com altura de linha 1, a Besley põe a maiúscula 0,16em
   * abaixo do alto da linha). O pé da caixa é a borda de cima do tampo.
   *
   * Rodada 4, segunda parte (E1: "a parte de cima está cortando do texto"): o único corte é o de baixo, pelo
   * tampo. Antes, a caixa cortava os quatro lados (`overflow: clip` e `contain: paint`), e o que passa da
   * altura das maiúsculas sumia rente a ela: a haste do "h" e do "t", o arco do "C" e do "S". Agora o corte é
   * um `clip-path` que só fecha embaixo e se abre 0,5em para cima e 0,2em para os lados, onde o desenho
   * inteiro cabe (no respiro de 96px acima do rodapé). A respiração muda só o eixo de peso.
   */
  .nome-rodape {
    height: var(--nome-visivel);
    margin: 0;
    overflow: visible;
    contain: layout;
    clip-path: inset(-0.5em -0.2em 0 -0.2em);
    font-family: var(--font-titulo);
    font-size: var(--nome);
    font-weight: 800;
    font-variation-settings: "wght" 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    color: var(--ink);
  }

  .nome-rodape > .nome-linha {
    display: inline-block;
    translate: 0 -0.16em;
  }

  .nome-rodape.na-tela {
    animation: respira 3.5s cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
  }

  /* De 800 a 680 e de volta (7s a volta inteira), em seno; nunca abaixo de 650 (N10). */
  @keyframes respira {
    from {
      font-variation-settings: "wght" 800;
    }

    to {
      font-variation-settings: "wght" 680;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nome-rodape.na-tela {
      animation: none;
    }
  }

  /*
   * ---------- o tampo (R1): o feltro verde ----------
   * A faixa na largura toda, do pé do nome ao fim da página: 48px até a ficha, a ficha e uma margem embaixo
   * (com 220px de mínimo; a ficha de empréstimo tem ~275px a 1440, então ela manda na altura). A cor é a do
   * caderno "cs" (`--marca`), escurecida; a fibra é um ruído fino (fios de 0,4 a 0,6px a cada 2 a 5px, em
   * cinco direções com passos que não se repetem juntos, sem moiré), mais três manchas largas e soltas de
   * feltro batido (não repetidas, para não virar grade); na borda de cima, os 2px
   * de sombra quente onde o feltro encosta na página e a beira dele um nada na sombra.
   */
  .rodape-chao {
    --tampo: color-mix(in oklab, var(--marca) 80%, black);
    --fibra-clara: color-mix(in oklab, var(--marca-letra) 5%, transparent);
    --fibra-escura: color-mix(in oklab, black 11%, transparent);
    --mancha-clara: color-mix(in oklab, var(--marca-letra) 3%, transparent);
    --mancha-escura: color-mix(in oklab, black 7%, transparent);
    --bainha: color-mix(in oklab, var(--marca-letra) 22%, transparent);
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 220px;
    padding: 48px 0 calc(56px + env(safe-area-inset-bottom, 0px));
    background:
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--sombra-quente) 58%, transparent) 0 2px,
        color-mix(in oklab, var(--sombra-quente) 22%, transparent) 2px,
        transparent 26px
      ),
      repeating-linear-gradient(31deg, var(--fibra-clara) 0 0.6px, transparent 0.6px 2.3px),
      repeating-linear-gradient(-59deg, var(--fibra-clara) 0 0.6px, transparent 0.6px 2.9px),
      repeating-linear-gradient(121deg, var(--fibra-escura) 0 0.6px, transparent 0.6px 1.9px),
      repeating-linear-gradient(11deg, var(--fibra-escura) 0 0.6px, transparent 0.6px 3.7px),
      repeating-linear-gradient(77deg, var(--fibra-clara) 0 0.4px, transparent 0.4px 5.3px),
      radial-gradient(ellipse 38% 90% at 18% 30%, var(--mancha-clara), transparent),
      radial-gradient(ellipse 30% 80% at 64% 78%, var(--mancha-escura), transparent),
      radial-gradient(ellipse 26% 70% at 88% 20%, var(--mancha-clara), transparent),
      var(--tampo);
  }

  :global(:root[data-theme="dark"]) .rodape-chao {
    --tampo: color-mix(in oklab, var(--marca) 65%, black);
    --fibra-clara: color-mix(in oklab, var(--marca-letra) 4%, transparent);
    --fibra-escura: color-mix(in oklab, black 20%, transparent);
    --mancha-clara: color-mix(in oklab, var(--marca-letra) 2.5%, transparent);
    --mancha-escura: color-mix(in oklab, black 12%, transparent);
    --bainha: color-mix(in oklab, var(--marca-letra) 15%, transparent);
  }

  /* A bainha: o fio de 1px mais claro, a 6px da borda de cima e a 6px do pé da página. */
  .tampo-bainha,
  .rodape-chao::after {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--bainha);
    pointer-events: none;
  }

  .tampo-bainha {
    top: 6px;
  }

  .rodape-chao::after {
    content: "";
    bottom: calc(6px + env(safe-area-inset-bottom, 0px));
  }

  /* ---------- a ficha ---------- */

  /*
   * Até 980px de largura; acima de 900px de tela, ela deixa livres os dois cantos de baixo (84px de cada
   * lado): o ícone do computador à esquerda e a cordinha à direita. Abaixo de 900px, ela abre a faixa da
   * direita para a cordinha. Deitada no tampo: girada −1°, com a sombra curta de quem encosta e a longa
   * de quem está um nada acima do feltro.
   */
  .ficha-emprestimo {
    --linha: 34px;
    position: relative;
    max-width: min(980px, 100vw - 168px);
    margin: 0 auto;
    padding: 0 0 26px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-hi);
    box-shadow:
      0 1px 1px color-mix(in oklab, var(--sombra-no-tampo) 70%, transparent),
      0 3px 6px -2px color-mix(in oklab, var(--sombra-no-tampo) 55%, transparent),
      0 20px 28px -16px var(--sombra-no-tampo);
    rotate: -1deg;
  }

  .fe-cabeca {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 20px;
    padding: 20px clamp(18px, 3.4vw, 36px) 10px;
    border-bottom: 1.5px solid var(--pauta-cabeca);
  }

  .fe-titulo {
    margin: 0;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    color: var(--ink);
  }

  .fe-dono {
    margin: 0;
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-2);
  }

  /* As colunas da ficha, na pauta azul (uma linha da pauta por linha escrita). */
  .fe-grade {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 0.9fr) minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 0 clamp(14px, 2.4vw, 28px);
    padding: 12px clamp(18px, 3.4vw, 36px) 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--linha) - 1px),
      color-mix(in oklab, var(--pauta) 85%, transparent) calc(var(--linha) - 1px) var(--linha)
    );
    background-position: 0 calc(12px + 26px);
  }

  .fe-rotulo {
    margin: 0;
    height: 26px;
    font-family: var(--font-codigo);
    font-size: 11.5px;
    line-height: 26px;
    color: var(--ink-2);
  }

  .fe-valor,
  .fe-coluna ul {
    margin: 0;
  }

  .fe-escrito {
    font-family: var(--font-texto);
    font-style: italic;
    font-size: 19px;
    line-height: var(--linha);
    color: var(--ink);
  }

  .fe-coluna ul {
    padding: 0;
    list-style: none;
  }

  .fe-coluna li {
    min-height: var(--linha);
    display: flex;
    align-items: center;
  }

  /* Os perfis: o ícone que se mexe, o nome e o que se acha lá. */
  .fe-perfil {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }

  .fe-perfil .fe-nome {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent);
    text-underline-offset: 0.2em;
  }

  .fe-perfil .fe-nota {
    color: var(--ink-2);
    font-size: 14px;
  }

  .fe-perfil:hover .fe-nome,
  .fe-perfil:focus-visible .fe-nome {
    color: var(--acento);
    text-decoration-color: currentColor;
  }

  .fe-icone {
    flex: none;
    width: 18px;
    height: 18px;
    fill: currentColor;
    transform-origin: 50% 90%;
  }

  .traco-rss {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .traco-rss :global(circle) {
    fill: currentColor;
    stroke: none;
  }

  /* O gato pula, o LinkedIn balança (no hover e no foco do teclado); os arcos do RSS são do traco.css. */
  @media (prefers-reduced-motion: no-preference) {
    .fe-github:focus-visible .fe-icone {
      animation: pulinho 0.6s cubic-bezier(0.3, 0.1, 0.3, 1);
    }

    .fe-linkedin:focus-visible .fe-icone {
      animation: balanca 0.7s cubic-bezier(0.3, 0.1, 0.3, 1);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .fe-github:hover .fe-icone {
      animation: pulinho 0.6s cubic-bezier(0.3, 0.1, 0.3, 1);
    }

    .fe-linkedin:hover .fe-icone {
      animation: balanca 0.7s cubic-bezier(0.3, 0.1, 0.3, 1);
    }
  }

  @keyframes pulinho {
    0% {
      transform: none;
    }

    30% {
      transform: translateY(-5px) scale(1.05, 0.95);
    }

    55% {
      transform: translateY(0) scale(1.08, 0.9);
    }

    75% {
      transform: translateY(-2px);
    }

    100% {
      transform: none;
    }
  }

  @keyframes balanca {
    0% {
      transform: none;
    }

    25% {
      transform: rotate(-12deg);
    }

    50% {
      transform: rotate(8deg);
    }

    75% {
      transform: rotate(-4deg);
    }

    100% {
      transform: none;
    }
  }

  /* ---------- "Na biblioteca": o texto que gira, como o menu do cabeçalho (T12) ---------- */

  .fe-navegar a {
    display: inline-flex;
    padding: 4px 0;
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }

  .fe-navegar a:hover,
  .fe-navegar a:focus-visible {
    color: var(--acento);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .rola {
    display: inline-flex;
    height: 1.25em;
    overflow: clip;
    line-height: 1.25;
  }

  .rola > span {
    display: inline-block;
    text-shadow: 0 1.4em currentColor;
    transition: translate 0.32s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--k) * 12ms);
  }

  .fe-navegar a:focus-visible .rola > span {
    translate: 0 -1.4em;
  }

  @media (hover: hover) {
    .fe-navegar a:hover .rola > span {
      translate: 0 -1.4em;
    }
  }

  /* No toque, o dedo que encosta no item gira as letras (a classe vem do script). */
  .fe-navegar a.girando .rola > span {
    translate: 0 -1.4em;
  }

  @media (prefers-reduced-motion: reduce) {
    .rola > span {
      transition: none;
    }
  }

  /* ---------- o carimbo ---------- */

  /* O carimbo bate na coluna "Devolver", embaixo do "quando quiser", nas linhas vazias da ficha. */
  .fe-carimbo {
    position: absolute;
    left: clamp(110px, 17vw, 200px);
    bottom: 22px;
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 6px 14px 5px;
    border: 2px solid color-mix(in oklab, var(--caneta) 78%, transparent);
    border-radius: 6px;
    outline: 1px solid color-mix(in oklab, var(--caneta) 50%, transparent);
    outline-offset: 2px;
    color: color-mix(in oklab, var(--caneta) 82%, transparent);
    font-family: var(--font-codigo);
    rotate: -8deg;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  :global(html[data-theme="dark"]) .fe-carimbo {
    mix-blend-mode: normal;
  }

  .fe-carimbo-nome {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-style: italic;
    font-size: 12.5px;
  }

  .fe-carimbo-data {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .fe-carimbo:global(.esperando) {
    opacity: 0;
  }

  /*
   * A batida: o carimbo cai de 1,25 a 1 em 0,18s (a tinta aparece no caminho) e assenta: afunda um nada no
   * papel e volta (0,16s).
   */
  .fe-carimbo:global(.batendo) {
    animation: carimba 0.34s both;
  }

  @keyframes carimba {
    0% {
      opacity: 0;
      transform: scale(1.25);
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }

    25% {
      opacity: 0.85;
    }

    53% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.25, 0.6, 0.4, 1);
    }

    72% {
      transform: scale(0.975);
      animation-timing-function: cubic-bezier(0.3, 0, 0.3, 1);
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fe-carimbo:global(.batendo) {
      animation: none;
    }
  }

  /*
   * ---------- a cordinha (R2) ----------
   * A roseta de latão presa na borda de cima do tampo (metade na página, metade no feltro), o fio de
   * algodão trançado (cru, com a trama em diagonal) e o pingente de latão torneado: o anel, o colar e a
   * gota, com a luz de cima à esquerda. A cordinha e o pingente fazem sombra no feltro. O botão é a faixa
   * de 44px em volta do fio e do pingente.
   */
  .cordinha {
    position: absolute;
    top: -7px;
    right: var(--cordinha-direita);
    z-index: 3;
    display: grid;
    justify-items: center;
    width: 44px;
    padding: 0 0 10px;
    border: 0;
    background: none;
    cursor: grab;
    /* No toque, a rolagem continua com o navegador (nada de sequestrar o dedo): o toque curto puxa. */
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }

  .cordinha:global(.na-mao) {
    cursor: grabbing;
  }

  /* Sem JS, a cordinha não teria o que fazer: some (a tecla Home continua subindo a página). */
  :global(:root:not([data-js])) .cordinha {
    display: none;
  }

  /* A roseta: o disco de latão com o parafuso no meio. */
  .cordinha-roseta {
    position: relative;
    z-index: 1;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, var(--latao-escuro) 0 1.2px, transparent 1.7px),
      radial-gradient(circle at 36% 30%, var(--latao-luz), var(--latao) 52%, var(--latao-escuro) 100%);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--latao-escuro) 70%, transparent),
      0 2px 3px color-mix(in oklab, var(--sombra-quente) 55%, transparent);
  }

  .cordinha-corpo {
    display: grid;
    justify-items: center;
    margin-top: -5px;
    transform-origin: 50% 0;
    filter: drop-shadow(2px 4px 2px color-mix(in oklab, black 34%, transparent));
  }

  .cordinha-fio {
    display: block;
    width: 3px;
    height: var(--fio);
    border-radius: 1.5px;
    background:
      repeating-linear-gradient(152deg, var(--cordinha-algodao) 0 2px, var(--cordinha-trama) 2px 3px),
      var(--cordinha-algodao);
    transform-origin: 50% 0;
  }

  /* O pingente: o anel (onde o fio prende), o colar e a gota torneada, em latão. */
  .cordinha-pingente {
    position: relative;
    display: block;
    width: 14px;
    height: 28px;
    margin-top: 4px;
    border-radius: 42% 42% 50% 50% / 26% 26% 74% 74%;
    background:
      radial-gradient(ellipse 30% 22% at 34% 38%, color-mix(in oklab, var(--latao-luz) 85%, white), transparent 72%),
      linear-gradient(90deg, var(--latao-escuro), var(--latao) 30%, var(--latao-luz) 46%, var(--latao) 66%, var(--latao-escuro));
  }

  /* O colar: um aro mais largo no alto da gota. */
  .cordinha-pingente::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 50%;
    width: 10px;
    height: 4px;
    margin-left: -5px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--latao-escuro), var(--latao-luz) 45%, var(--latao-escuro));
  }

  /* O anel: o olhal por onde o fio passa. */
  .cordinha-pingente::after {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border: 1.5px solid var(--latao);
    border-radius: 50%;
  }

  /*
   * "Puxe para subir": uma etiqueta de papel à esquerda do fio, no hover e no foco do teclado. Fica no alto
   * do fio (a 30% dele), onde o balanço quase não anda: o pingente passa longe dela.
   */
  .cordinha-texto {
    position: absolute;
    top: calc(var(--fio) * 0.3);
    right: calc(100% + 2px);
    padding: 3px 8px 2px;
    border-radius: 2px;
    background: var(--paper-hi);
    box-shadow: 0 1px 1px var(--sombra-no-tampo), 0 6px 10px -6px var(--sombra-no-tampo);
    color: var(--ink-2);
    font-family: var(--font-codigo);
    font-size: 11.5px;
    line-height: 1.4;
    white-space: nowrap;
    opacity: 0;
    translate: 4px 0;
    rotate: -1.5deg;
    transition:
      opacity 0.2s,
      translate 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .cordinha:focus-visible .cordinha-texto {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: hover) {
    .cordinha:hover .cordinha-texto {
      opacity: 1;
      translate: 0 0;
    }
  }

  .cordinha:focus-visible {
    outline: none;
  }

  .cordinha:focus-visible .cordinha-pingente {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  /* O pêndulo que perde força (14°, −7°, 3°, −1°, em 1,2s), no hover e no foco do teclado. */
  @media (prefers-reduced-motion: no-preference) {
    .cordinha:focus-visible .cordinha-corpo {
      animation: cordinha-balanca 1.2s cubic-bezier(0.37, 0, 0.63, 1);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cordinha:hover .cordinha-corpo {
      animation: cordinha-balanca 1.2s cubic-bezier(0.37, 0, 0.63, 1);
    }
  }

  @keyframes cordinha-balanca {
    0% {
      rotate: 0deg;
    }

    18% {
      rotate: 14deg;
    }

    42% {
      rotate: -7deg;
    }

    64% {
      rotate: 3deg;
    }

    84% {
      rotate: -1deg;
    }

    100% {
      rotate: 0deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cordinha-texto {
      transition: none;
    }
  }

  @media print {
    .cordinha {
      display: none;
    }
  }

  /*
   * ---------- as outras superfícies (só na amostra D5) ----------
   * B, o nicho: a página desce um degrau (o rebaixo de V1, como os livros da home): a parede com 9% de tinta,
   * a sombra do teto de 48px e das laterais de 28px, e o friso de cima com o fio de luz. C, o tampo de tinta:
   * a faixa lisa na cor da cortina. D, o balcão de pedra: o cinza quente com a aresta de 12px à vista e o
   * veio discreto. A ficha, o nome e a cordinha são os mesmos.
   */
  /*
   * B, o nicho: as peças do nicho dos livros (nicho.css, do construtor A: `.nicho`, `.nicho-parede`,
   * `.nicho-teto`, `.nicho-friso` e as cores `--nicho-*`), com a geometria do rodapé: sem chão, a sombra do
   * teto de 48px e o friso no alto, onde a página desce o degrau e corta o nome. A amostra importa o
   * nicho.css.
   */
  .rodape[data-superficie="nicho"] {
    --cordinha-algodao: color-mix(in oklab, var(--ink) 66%, var(--paper));
    --cordinha-trama: color-mix(in oklab, var(--ink) 82%, var(--paper));
    --sombra-no-tampo: color-mix(in oklab, var(--sombra-quente) 40%, transparent);
    --k-chao-alto: 0px;
    --k-friso: 10px;
    --k-sombra-teto: 48px;
  }

  .rodape[data-superficie="nicho"] .rodape-chao {
    padding-top: calc(48px + var(--k-friso));
    background: var(--nicho-parede, color-mix(in oklab, var(--paper), var(--ink) 9%));
  }

  .rodape[data-superficie="nicho"] .nicho {
    inset: 0;
    border-radius: 0;
  }

  /* A parede vai até o pé; a sombra do teto começa logo abaixo do friso, que fica no alto. */
  .rodape[data-superficie="nicho"] .nicho-parede {
    bottom: 0;
  }

  .rodape[data-superficie="nicho"] .nicho-teto {
    top: var(--k-friso);
  }

  .rodape[data-superficie="nicho"] .nicho-friso {
    top: 0;
    bottom: auto;
  }

  .rodape[data-superficie="nicho"] .tampo-bainha,
  .rodape[data-superficie="nicho"] .rodape-chao::after,
  .rodape[data-superficie="tinta"] .rodape-chao::after,
  .rodape[data-superficie="pedra"] .tampo-bainha,
  .rodape[data-superficie="pedra"] .rodape-chao::after {
    display: none;
  }

  .rodape[data-superficie="tinta"] .rodape-chao {
    --tampo: var(--cortina);
    background:
      linear-gradient(to bottom, color-mix(in oklab, var(--sombra-quente) 58%, transparent) 0 2px, color-mix(in oklab, var(--sombra-quente) 20%, transparent) 2px, transparent 22px),
      var(--tampo);
  }

  :global(:root[data-theme="dark"]) .rodape[data-superficie="tinta"] .rodape-chao {
    --tampo: color-mix(in oklab, var(--cortina-tinta) 62%, black);
