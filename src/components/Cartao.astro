---
/**
 * Um artigo em modo "cards" (protótipo): a ilustração em 3:2 no topo, quando o post tem, data,
 * título, subtítulo, categoria e tempo de leitura.
 */
import Chip from "./Chip.astro";
import Ilustracao from "./Ilustracao.astro";
import { dataIso, dataPorExtenso } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
---

<li class="cartao">
  {
    temIlustracao(post.slug) && (
      <a class="ilustracao-cartao" href={post.url} tabindex="-1" aria-hidden="true">
        <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} tamanho="cartao" decorativa />
      </a>
    )
  }
  <div class="corpo-cartao">
    <p class="data"><time datetime={dataIso(post.publicado)}>{dataPorExtenso(post.publicado)}</time></p>
    <h3><a href={post.url}>{post.titulo}</a></h3>
    {post.subtitulo && <p class="subtitulo">{post.subtitulo}</p>}
    <p class="meta">
      <Chip cor={post.cor} nome={post.rotulo} href={post.urlRotulo} />
      <span>{post.minutos} min de leitura</span>
    </p>
  </div>
</li>

<style>
  .cartao {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  .ilustracao-cartao {
    display: block;
    aspect-ratio: 3 / 2;
    border-bottom: 1px solid var(--rule);
  }

  .corpo-cartao {
    padding: 16px 18px 20px;
  }

  .data {
    margin: 0;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  h3 {
    margin: 8px 0 6px;
    font-size: 21px;
    line-height: 1.2;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .subtitulo {
    margin: 0;
    font-size: 16px;
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin: 10px 0 0;
    font-size: 14.5px;
    color: var(--ink-2);
  }
</style>
