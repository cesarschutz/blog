---
/**
 * Um artigo em modo "cards", no formato do blog atual (D27): a ilustração em 3:2 no topo, num painel
 * tingido, quando o post tem; embaixo, categoria, data e tempo de leitura, o título inteiro, a
 * descrição completa e as tags, que descem até o pé do card. O card inteiro é clicável; é uma folha
 * que sobe 4px ao passar o mouse, com o título em azul-tinta (D26).
 */
import Ilustracao from "./Ilustracao.astro";
import MetaItem from "./MetaItem.astro";
import { mdEmLinha, tituloEmPartes } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import { urlTag, type Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
  /** Nível do título: um abaixo do título da seção (h2 quando a página tem só o h1 em cima). */
  nivel?: "h2" | "h3";
}

const { post, nivel = "h3" } = Astro.props;
const Titulo = nivel;
---

<li class="cartao folha" data-livro={post.livro}>
  {
    temIlustracao(post.slug) && (
      <div class="ilustracao-cartao painel" aria-hidden="true" data-vt-desenho style={`--cor:${post.cor}`}>
        <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} tamanho="cartao" decorativa />
      </div>
    )
  }
  <div class="corpo-cartao">
    <MetaItem post={post} />
    <Titulo class="titulo-cartao"><a href={post.url} set:html={tituloEmPartes(post.tituloCompleto)} /></Titulo>
    <p class="descricao" set:html={mdEmLinha(post.descricao)} />
    {
      post.tags.length > 0 && (
        <p class="tags">
          {post.tags.slice(0, 4).map((t) => (
            <a href={urlTag(t)}>#{t}</a>
          ))}
        </p>
      )
    }
  </div>
</li>

<style>
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .cartao:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-folha-alta);
  }

  /* O painel encosta nas bordas do card; o canto arredondado vem do card. */
  .ilustracao-cartao {
    aspect-ratio: 3 / 2;
    border-radius: 0;
  }

  .corpo-cartao {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 18px 20px 20px;
  }

  .titulo-cartao {
    margin: 8px 0 0;
    font-size: 21px;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .titulo-cartao a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  /* O link do título cobre o card inteiro; o chip da categoria fica por cima (MetaItem). */
  .titulo-cartao a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cartao:hover .titulo-cartao a {
    color: var(--acento);
  }

  .descricao {
    margin: 8px 0 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .descricao :global(code) {
    font-size: 0.88em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: auto 0 0;
    padding-top: 14px;
    font-family: var(--font-codigo);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  /* As tags são links para a página da tag (D38), por cima do link que cobre o item, com alvo de 24px. */
  .tags a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cartao:hover {
      transform: none;
    }
  }
</style>
