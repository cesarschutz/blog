---
/**
 * Um artigo em modo "cards", no formato do blog atual (D27): a ilustração em 3:2 no topo, num painel
 * tingido, quando o post tem; embaixo, categoria, data e tempo de leitura, o título inteiro, a
 * descrição completa e as tags, que descem até o pé do card. O card inteiro é clicável; é uma folha
 * que sobe 4px ao passar o mouse, com o título em azul-tinta (D26).
 */
import Ilustracao from "./Ilustracao.astro";
import MetaItem from "./MetaItem.astro";
import { mdEmLinha } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
---

<li class="cartao folha">
  {
    temIlustracao(post.slug) && (
      <div class="ilustracao-cartao painel" aria-hidden="true" style={`--cor:${post.cor}`}>
        <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} tamanho="cartao" decorativa />
      </div>
    )
  }
  <div class="corpo-cartao">
    <MetaItem post={post} />
    <h3><a href={post.url}>{post.tituloCompleto}</a></h3>
    <p class="descricao" set:html={mdEmLinha(post.descricao)} />
    {
      post.tags.length > 0 && (
        <p class="tags">
          {post.tags.slice(0, 4).map((t) => (
            <span>#{t}</span>
          ))}
        </p>
      )
    }
  </div>
</li>

<style>
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .cartao:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-folha-alta);
  }

  /* O painel encosta nas bordas do card; o canto arredondado vem do card. */
  .ilustracao-cartao {
    aspect-ratio: 3 / 2;
    border-radius: 0;
  }

  .corpo-cartao {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 18px 20px 20px;
  }

  h3 {
    margin: 8px 0 0;
    font-size: 21px;
    line-height: 1.2;
    text-wrap: pretty;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  /* O link do título cobre o card inteiro; o chip da categoria fica por cima (MetaItem). */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cartao:hover h3 a {
    color: var(--acento);
  }

  .descricao {
    margin: 8px 0 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .descricao :global(code) {
    font-size: 0.88em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: auto 0 0;
    padding-top: 14px;
    font-family: var(--font-codigo);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .cartao:hover {
      transform: none;
    }
  }
</style>
