---
/**
 * Lousa com linha do tempo de arrastar (briefing §7.2): uma comparação que avança no tempo. Botão
 * de reproduzir e pausar (percorre em ~7 s, para 1,5 s no resultado e recomeça), controle
 * deslizante, arrasto sobre o desenho e roda do mouse (com ou sem Shift; nas pontas, a roda volta a
 * rolar a página). Qualquer gesto manual pausa. O estado atual é lido por leitores de tela.
 * O texto do estado ocupa sempre o lugar do maior deles (todos na mesma célula da grade, só o atual
 * à vista, lousa.css): trocar de estado não muda a altura da lousa nem mexe no texto de baixo.
 * Sem JS: o desenho no fim, sem controles.
 *
 *   <LousaTempo desenho="<slug>/<nome>" rotulo="…" estados={[{ de: 0, texto: "Antes do pedido" }, …]} />
 */
import { quadroDaLousa } from "../lib/lousas";
import "../styles/lousa.css";

interface Props {
  desenho: string;
  rotulo: string;
  /** Texto do estado a partir de cada instante (de 0 a 1), em ordem. */
  estados: { de: number; texto: string }[];
  legenda?: string;
}

const {
  desenho,
  rotulo,
  estados,
  legenda,
} = Astro.props;
const { svg } = quadroDaLousa(desenho, rotulo);
const id = `tempo-${desenho.replace(/[^a-z0-9]+/gi, "-")}`;
const rss = Astro.locals.rss;
---

{
  rss ? (
    <p>
      <em>{rotulo}</em> <a href={rss.endereco}>A linha do tempo interativa está no site.</a>
    </p>
  ) : (
    <figure class="lousa-tempo" data-lousa-tempo data-estados={JSON.stringify(estados)} data-pagefind-ignore>
      <div class="lousa area" set:html={svg} />
      <div class="controles" hidden>
        <button type="button" class="tocar" aria-pressed="false" aria-label="Reproduzir">
          <svg class="icone-tocar" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z"></path></svg>
          <svg class="icone-pausar" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z"></path></svg>
        </button>
        <label class="sr" for={id}>Tempo</label>
        <input id={id} type="range" min="0" max="1000" step="1" value="0" />
        <span class="estado">
          <span class="atual" aria-live="polite">{estados[0]?.texto}</span>
          {estados.map((e) => <span class="reserva" aria-hidden="true">{e.texto}</span>)}
        </span>
      </div>
      {/* A legenda fala dos controles, que só existem com JS: aparece junto com eles (D54). */}
      <figcaption hidden>
        {legenda ?? (
          <>
            <span class="legenda-mouse">Aperte o play, arraste sobre o desenho, gire a roda do mouse em cima dele (ou com Shift) ou use o controle.</span>
            <span class="legenda-toque">Aperte o play, arraste sobre o desenho ou use o controle.</span>
          </>
        )}
      </figcaption>
    </figure>
  )
}

<script>
  import { prepararLousa } from "../scripts/lousa";

  const DURACAO = 7000;
  const PAUSA_NO_FIM = 1500;

  for (const figura of document.querySelectorAll<HTMLElement>("[data-lousa-tempo]")) {
    const area = figura.querySelector<HTMLElement>(".area")!;
    const svg = area.querySelector("svg")!;
    const lousa = prepararLousa(svg);
    const controles = figura.querySelector<HTMLElement>(".controles")!;
    const botao = figura.querySelector<HTMLButtonElement>(".tocar")!;
    const faixa = figura.querySelector<HTMLInputElement>("input[type=range]")!;
    const rotuloDoEstado = figura.querySelector<HTMLElement>(".estado .atual")!;
    const estados: { de: number; texto: string }[] = JSON.parse(figura.dataset.estados ?? "[]");
    controles.hidden = false;
    figura.querySelector("figcaption")!.hidden = false;

    let t = 0;
    const mostrar = (novo: number) => {
      t = Math.min(1, Math.max(0, novo));
      faixa.value = String(Math.round(t * 1000));
      lousa.desenhar(t * lousa.fim, tocando);
      const texto = [...estados].reverse().find((e) => t >= e.de)?.texto ?? "";
      if (rotuloDoEstado.textContent !== texto) rotuloDoEstado.textContent = texto;
      if (faixa.getAttribute("aria-valuetext") !== texto) faixa.setAttribute("aria-valuetext", texto);
    };

    let tocando = false;
    let quadro = 0;
    let anterior = 0;
    let segurarAte = 0;
    const passo = (agora: number) => {
      if (!tocando) return;
      const dt = anterior ? Math.min(agora - anterior, 64) : 0;
      anterior = agora;
      if (segurarAte) {
        if (agora >= segurarAte) {
          segurarAte = 0;
          mostrar(0);
        }
      } else {
        mostrar(t + dt / DURACAO);
        if (t >= 1) segurarAte = agora + PAUSA_NO_FIM;
      }
      quadro = requestAnimationFrame(passo);
    };
    const tocar = () => {
      if (t >= 1) mostrar(0);
      tocando = true;
      anterior = 0;
      segurarAte = 0;
      botao.setAttribute("aria-pressed", "true");
      botao.setAttribute("aria-label", "Pausar");
      // Tocando sozinha, a lousa não fala a cada estado (em loop, até fora da tela); o leitor de tela
      // volta a ouvir nos gestos da pessoa e ao pausar (D54).
      rotuloDoEstado.setAttribute("aria-live", "off");
      cancelAnimationFrame(quadro);
      quadro = requestAnimationFrame(passo);
    };
    const parar = () => {
      tocando = false;
      cancelAnimationFrame(quadro);
      botao.setAttribute("aria-pressed", "false");
      botao.setAttribute("aria-label", "Reproduzir");
      rotuloDoEstado.setAttribute("aria-live", "polite");
      lousa.desenhar(t * lousa.fim, false);
    };
    botao.addEventListener("click", () => (tocando ? parar() : tocar()));

    // As setas do controle vão de um estado para o vizinho (o passo de 1/1000 quase não andava, D54);
    // PageUp/PageDown e Home/End continuam como no navegador.
    const marcas = [...new Set([...estados.map((e) => e.de), 1])].sort((a, b) => a - b);
    faixa.addEventListener("keydown", (e) => {
      const frente = e.key === "ArrowRight" || e.key === "ArrowUp";
      const tras = e.key === "ArrowLeft" || e.key === "ArrowDown";
      if (!frente && !tras) return;
      const alvo = frente ? marcas.find((m) => m > t + 0.001) : marcas.findLast((m) => m < t - 0.001);
      if (alvo === undefined) return;
      e.preventDefault();
      parar();
      mostrar(alvo);
    });

    // O gesto da pessoa tem prioridade e pausa a reprodução.
    faixa.addEventListener("input", () => {
      parar();
      mostrar(Number(faixa.value) / 1000);
    });
    area.addEventListener(
      "wheel",
      (e) => {
        const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (!d || (t <= 0 && d < 0) || (t >= 1 && d > 0)) return; // nas pontas, a página volta a rolar
        e.preventDefault();
        parar();
        mostrar(t + d * (e.deltaMode === 1 ? 0.03 : 0.0012));
      },
      { passive: false },
    );
    const noDesenho = (e: PointerEvent) => {
      const caixa = svg.getBoundingClientRect();
      return (e.clientX - caixa.left) / caixa.width;
    };
    let arrastando = false;
    area.addEventListener("pointerdown", (e) => {
      parar();
      arrastando = true;
      area.classList.add("arrastando");
      area.setPointerCapture(e.pointerId);
      mostrar(noDesenho(e));
    });
    area.addEventListener("pointermove", (e) => arrastando && mostrar(noDesenho(e)));
    for (const tipo of ["pointerup", "pointercancel", "lostpointercapture"]) {
      area.addEventListener(tipo, () => {
        arrastando = false;
        area.classList.remove("arrastando");
      });
    }
    // Na impressão, o desenho sai inteiro (o quadro do fim), e volta a ser o que era depois (D54).
    let antesDaImpressao: { t: number; tocando: boolean } | null = null;
    addEventListener("beforeprint", () => {
      antesDaImpressao = { t, tocando };
      parar();
      lousa.desenhar(lousa.fim, false);
    });
    addEventListener("afterprint", () => {
      if (!antesDaImpressao) return;
      mostrar(antesDaImpressao.t);
      if (antesDaImpressao.tocando) tocar();
      antesDaImpressao = null;
    });
    // Com movimento reduzido, a lousa começa no estado final, com todos os passos à vista (skill lousa);
    // começava vazia, no primeiro estado (D54).
    mostrar(matchMedia("(prefers-reduced-motion: reduce)").matches ? 1 : 0);
  }
</script>
