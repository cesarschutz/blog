---
/**
 * Um artigo numa lista, no formato do blog atual (pedido do Cesar em 24/09/2026, D27): em cima a
 * categoria, a data e o tempo de leitura; o título inteiro, grande; a descrição completa; as tags; e,
 * à direita, a miniatura quadrada da ilustração num painel tingido. A linha inteira é clicável e
 * ganha um fundo leve ao passar o mouse, com o título em azul-tinta. A lista fica numa folha
 * (.lista-artigos.folha, D26). O `data-livro` serve ao filtro por livro do arquivo e das tags (D33).
 */
import Ilustracao from "./Ilustracao.astro";
import MetaItem from "./MetaItem.astro";
import { mdEmLinha, tituloComQuebras } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import { urlTag, type Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
  /** Nível do título, para a lista respeitar a hierarquia da página. */
  nivel?: "h2" | "h3";
}

const { post, nivel = "h3" } = Astro.props;
const Titulo = nivel;
const comMiniatura = temIlustracao(post.slug);
---

<li class:list={["item", "completo", { "com-miniatura": comMiniatura }]} data-livro={post.livro}>
  <div class="texto">
    <MetaItem post={post} />
    <Titulo class="titulo">
      <a href={post.url} set:html={tituloComQuebras(post.tituloCompleto)} />
    </Titulo>
    <p class="descricao" set:html={mdEmLinha(post.descricao)} />
    {post.tags.length > 0 && (
      <p class="tags">
        {post.tags.slice(0, 4).map((t) => (
          <a href={urlTag(t)}>#{t}</a>
        ))}
      </p>
    )}
  </div>
  {comMiniatura && (
    <div class="miniatura painel" aria-hidden="true" style={`--cor:${post.cor}`}>
      <Ilustracao slug={post.slug} recorte="quadrado" cor={post.cor} tamanho="miniatura" decorativa />
    </div>
  )}
</li>

<style>
  .item {
    position: relative;
    transition: background-color 0.15s;
  }

  /* O fio só entre itens à vista: com o filtro por livro (D33), o primeiro visível fica sem fio. */
  .item:not([hidden], [data-fora]) ~ .item:not([hidden], [data-fora]) {
    border-top: 1px solid var(--rule);
  }

  .item:hover {
    background: color-mix(in oklab, var(--acento) 5%, transparent);
  }

  .titulo {
    margin: 0;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .titulo a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .item:hover .titulo a {
    color: var(--acento);
  }

  /* ---------- home, arquivo, categorias, tags e séries ---------- */

  .completo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: start;
    padding: 22px clamp(18px, 2vw, 26px);
  }

  .completo.com-miniatura {
    grid-template-columns: minmax(0, 1fr) clamp(104px, 11vw, 148px);
  }

  /* O link do título cobre a linha inteira; o chip da categoria fica por cima (MetaItem). */
  .completo .titulo a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .completo .titulo {
    margin-top: 8px;
    font-size: clamp(21px, 1.8vw, 25px);
  }

  /* Linha de até ~70 caracteres; com 92ch, a lista larga chegava a 110 (D37). */
  .descricao {
    max-width: 68ch;
    margin: 8px 0 0;
    font-family: var(--font-ui);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .descricao :global(code) {
    font-size: 0.88em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 10px 0 0;
    font-family: var(--font-codigo);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  /* As tags são links para a página da tag (D38), por cima do link que cobre o item, com alvo de 24px. */
  .tags a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .miniatura {
    aspect-ratio: 1;
  }


  @media (max-width: 640px) {
    .completo,
    .completo.com-miniatura {
      gap: 14px;
      padding: 18px 16px;
    }

    .completo.com-miniatura {
      grid-template-columns: minmax(0, 1fr) 84px;
    }

    .completo .titulo {
      font-size: 20px;
    }

    .descricao {
      font-size: 15px;
    }

    .tags {
      display: none;
    }

    .miniatura {
      margin-top: 4px;
    }
  }
</style>
