---
/**
 * Um artigo numa lista, no formato do blog atual (pedido do Cesar em 24/09/2026, D27): em cima a
 * categoria, a data e o tempo de leitura; o título inteiro, grande; a descrição completa; as tags; e,
 * à direita, a miniatura quadrada da ilustração num painel tingido. A linha inteira é clicável e
 * ganha um fundo leve ao passar o mouse, com o título em azul-tinta. A lista fica numa folha
 * (.lista-artigos.folha, D26). O `data-livro` serve ao filtro por livro do arquivo e das tags (D33).
 *
 * O colchete na margem (D49, protótipo E2): com o mouse (ou o foco no título), a caneta escreve um
 * colchete na margem esquerda, de cima para baixo (0,34s), em azul-tinta, o mesmo gesto das marcações
 * do texto dizendo "este aqui"; ao sair, ele termina de passar e some por baixo (0,2s). O tremor é o
 * de cada título (src/lib/traco.ts), e o SVG estica até a altura do item. Só CSS.
 *
 * O destaque (D52, C02): o primeiro item da primeira página da home é o mais recente, com o rótulo
 * "Mais recente", o título e a descrição maiores e, no lugar da miniatura, o desenho no recorte médio,
 * grande, que se desenha ao entrar na tela (D41, desenho-vivo.ts). Até 860px, o desenho vai para cima,
 * na largura toda: no tablet, o recorte largo com as anotações (como o card do destaque); no celular,
 * o médio.
 */
import Ilustracao from "./Ilustracao.astro";
import MaisRecente from "./MaisRecente.astro";
import MetaItem from "./MetaItem.astro";
import { mdEmLinha, tituloEmPartes } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import { urlTag, type Resumo } from "../lib/posts";
import { colcheteDeCaneta } from "../lib/traco";

interface Props {
  post: Resumo;
  /** Nível do título, para a lista respeitar a hierarquia da página. */
  nivel?: "h2" | "h3";
  /** O mais recente, na primeira página da home (D52). */
  destaque?: boolean;
}

const { post, nivel = "h3", destaque = false } = Astro.props;
const Titulo = nivel;
const comMiniatura = temIlustracao(post.slug);
// A altura típica de um item; o SVG estica até a de verdade.
const ALTURA = 170;
---

<li class:list={["item", "completo", { "com-miniatura": comMiniatura, destaque }]} data-livro={post.livro}>
  <svg class="colchete" viewBox={`0 0 14 ${ALTURA}`} preserveAspectRatio="none" aria-hidden="true" focusable="false"
    ><path d={colcheteDeCaneta(post.tituloCompleto, ALTURA)} /></svg
  >
  <div class="texto">
    {destaque && <MaisRecente />}
    <MetaItem post={post} />
    <Titulo class="titulo">
      <a href={post.url} set:html={tituloEmPartes(post.tituloCompleto)} />
    </Titulo>
    <p class="descricao" set:html={mdEmLinha(post.descricao)} />
    {post.tags.length > 0 && (
      <p class="tags">
        {post.tags.slice(0, 4).map((t) => (
          <a href={urlTag(t)}>#{t}</a>
        ))}
      </p>
    )}
  </div>
  {comMiniatura && (destaque ? (
    <div class="miniatura painel" aria-hidden="true" data-desenhar style={`--cor:${post.cor}`}>
      <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} tamanho="cartao" decorativa class="recorte-medio" />
      <Ilustracao slug={post.slug} recorte="largo" cor={post.cor} tamanho="cartao" anotacoes decorativa class="recorte-largo" />
    </div>
  ) : (
    <div class="miniatura painel" aria-hidden="true" style={`--cor:${post.cor}`}>
      <Ilustracao slug={post.slug} recorte="quadrado" cor={post.cor} tamanho="miniatura" decorativa />
    </div>
  ))}
</li>

<style>
  .item {
    position: relative;
    transition: background-color 0.15s;
  }

  /* O fio só entre itens à vista: com o filtro por livro (D33), o primeiro visível fica sem fio. */
  .item:not([hidden]) ~ .item:not([hidden]) {
    border-top: 1px solid var(--rule);
  }

  .item:hover {
    background: color-mix(in oklab, var(--acento) 5%, transparent);
  }

  .titulo {
    margin: 0;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .titulo a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .item:hover .titulo a {
    color: var(--acento);
  }

  /* O colchete: escondido por cima (clip-path, com a folga de 4px da espessura do traço); ao chegar, se
     escreve para baixo; ao sair, a ponta de cima desce até sumir. */
  .colchete {
    position: absolute;
    top: 14px;
    left: 4px;
    width: 14px;
    height: calc(100% - 28px);
    overflow: visible;
    pointer-events: none;
    clip-path: inset(calc(100% + 4px) -4px -4px -4px);
    transition: clip-path 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53);
  }

  .colchete path {
    fill: none;
    stroke: var(--acento);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (hover: hover) {
    .item:hover .colchete {
      clip-path: inset(-4px);
      transition: none;
      animation: colchete-escreve 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
  }

  .item:has(.titulo a:focus-visible) .colchete {
    clip-path: inset(-4px);
    transition: none;
    animation: colchete-escreve 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @keyframes colchete-escreve {
    from {
      clip-path: inset(-4px -4px calc(100% + 4px) -4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .colchete,
    .item:hover .colchete,
    .item:has(.titulo a:focus-visible) .colchete {
      transition: none;
      animation: none;
    }
  }

  /* ---------- home, arquivo, categorias, tags e séries ---------- */

  .completo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: start;
    padding: 22px clamp(18px, 2vw, 26px);
  }

  .completo.com-miniatura {
    grid-template-columns: minmax(0, 1fr) clamp(104px, 11vw, 148px);
  }

  /* O link do título cobre a linha inteira; o chip da categoria fica por cima (MetaItem). */
  .completo .titulo a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .completo .titulo {
    margin-top: 8px;
    font-size: clamp(21px, 1.8vw, 25px);
  }

  /* A descrição vai até perto da miniatura, sem vão branco no meio da linha (pedido de 26/09/2026). */
  .descricao {
    margin: 8px 0 0;
    font-family: var(--font-ui);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .descricao :global(code) {
    font-size: 0.88em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 10px 0 0;
    font-family: var(--font-codigo);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  /* As tags são links para a página da tag (D38), por cima do link que cobre o item, com alvo de 24px. */
  .tags a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .miniatura {
    aspect-ratio: 1;
  }


  @media (max-width: 640px) {
    .completo,
    .completo.com-miniatura {
      gap: 14px;
      padding: 18px 16px;
    }

    .completo.com-miniatura {
      grid-template-columns: minmax(0, 1fr) 84px;
    }

    .completo .titulo {
      font-size: 20px;
    }

    .descricao {
      font-size: 15px;
    }

    .tags {
      display: none;
    }

    .miniatura {
      margin-top: 4px;
    }
  }

  /* ---------- o destaque (D52, C02) ---------- */

  .destaque.completo {
    padding-block: 28px;
  }

  .destaque.completo.com-miniatura {
    grid-template-columns: minmax(0, 1fr) clamp(260px, 36%, 460px);
    column-gap: clamp(24px, 3vw, 44px);
    align-items: center;
  }

  .destaque .miniatura {
    aspect-ratio: 3 / 2;
  }

  .destaque :global(.recorte-largo) {
    display: none;
  }

  .destaque.completo .titulo {
    margin-top: 10px;
    font-size: clamp(26px, 2.5vw, 33px);
    line-height: 1.12;
  }

  .destaque .descricao {
    max-width: 62ch;
    margin-top: 10px;
    font-size: 16.5px;
  }

  .destaque .tags {
    margin-top: 14px;
  }

  /* Até 860px, a coluna do texto ficaria estreita ao lado do desenho: ele vai para cima, largo. */
  @media (max-width: 860px) {
    .destaque.completo.com-miniatura {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 18px;
    }

    .destaque .miniatura {
      order: -1;
      margin-top: 0;
    }
  }

  @media (min-width: 641px) and (max-width: 860px) {
    .destaque .miniatura {
      aspect-ratio: 1100 / 468;
    }

    .destaque :global(.recorte-largo) {
      display: block;
    }

    .destaque :global(.recorte-medio) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .destaque.completo,
    .destaque.completo.com-miniatura {
      padding: 16px 16px 22px;
    }

    .destaque.completo .titulo {
      font-size: 24px;
    }

    .destaque .descricao {
      font-size: 15.5px;
    }
  }
</style>
