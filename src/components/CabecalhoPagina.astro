---
/** Cabeçalho das páginas de apoio: trilha opcional, título e descrição. */
interface Props {
  titulo: string;
  descricao?: string;
  trilha?: { nome: string; href: string };
}

const { titulo, descricao, trilha } = Astro.props;
---

<header class="cabecalho-pagina">
  {trilha && <a class="trilha" href={trilha.href}>{trilha.nome}</a>}
  <h1>{titulo}</h1>
  {descricao && <p class="descricao">{descricao}</p>}
  <slot />
</header>

<style>
  .cabecalho-pagina {
    padding: 44px 0 26px;
  }

  .trilha {
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .trilha:hover {
    color: var(--acento);
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.012em;
  }

  .descricao {
    max-width: 60ch;
    margin: 12px 0 0;
    font-size: 18px;
    color: var(--ink-2);
  }
</style>
