---
/** Cabeçalho das páginas de apoio: trilha opcional, título e descrição. */
interface Props {
  titulo: string;
  descricao?: string;
  trilha?: { nome: string; href: string };
}

const { titulo, descricao, trilha } = Astro.props;
---

<header class="cabecalho-pagina">
  {trilha && <a class="trilha" href={trilha.href}>{trilha.nome}</a>}
  <h1>{titulo}</h1>
  <div class="pe-titulo">
    {descricao && <p class="descricao">{descricao}</p>}
    <slot />
  </div>
</header>

<style>
  /*
   * Protótipo 14 (G1): o título das páginas na tipografia grande do 01, em Besley, com um fio de tinta
   * embaixo, como a linha do topo da home; a descrição fica no pé, à esquerda.
   */
  .cabecalho-pagina {
    padding: clamp(28px, 4vw, 52px) 0 28px;
  }

  .pe-titulo {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .trilha {
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .trilha:hover {
    color: var(--acento);
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(46px, 8.4vw, 124px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .descricao {
    max-width: 60ch;
    margin: 0;
    font-size: 18px;
    color: var(--ink-2);
  }
</style>
