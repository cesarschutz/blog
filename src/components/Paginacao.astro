---
/**
 * Paginação da home, como no blog atual (D27): "Anteriores", os números das páginas e "Mais
 * artigos". A página atual fica em azul-tinta.
 *
 * A caneta circula o número (D49, protótipo E2): com o mouse (ou o foco), os outros números ganham um
 * círculo à mão, que começa um pouco antes do topo e passa do ponto de partida (0,42s); ao sair, ele
 * some pela ponta (0,2s; traco.css). Nos botões, a seta avança 3px no hover e, no clique, sai pela frente e volta
 * por trás (0,32s) enquanto a página nova chega. Só CSS, fora a classe do clique.
 *
 * Rodada 4 (P16-2, vindo da linha 16; E6, a escolha do Cesar na amostra D4), três formas (`variante`):
 * - "papeis" (o padrão, a do protótipo desde a E6): um papel por botão. Os números em quadradinhos de
 *   36px, cada um colado com a sua fita e girado um nada; "Anteriores" e "Mais artigos" em papéis mais
 *   largos. No hover, o papel endireita e sobe 2px, e a sombra cresce (só a opacidade dela muda).
 * - "papel" (amostra D4, A): um papel só, centrado, colado na página com fita nos dois cantos de cima
 *   (no 16 eram alfinetes, na cortiça), com tudo dentro e o disco azul na página atual.
 * Nas duas, em tela estreita, os números ficam numa linha e os botões na de baixo.
 * - "solta" (amostra D4, antes): a do 18, sem papel.
 */
import { ICONES } from "../lib/icones";
import { circuloDeCaneta } from "../lib/traco";
import { url } from "../lib/url";
import "../styles/traco.css";

interface Props {
  atual: number;
  ultima: number;
  anterior?: string;
  proxima?: string;
  variante?: "papel" | "papeis" | "solta";
}

const { atual, ultima, anterior, proxima, variante = "papeis" } = Astro.props;
const endereco = (n: number) => url(n === 1 ? "/" : `/${n}/`);
const papeis = variante === "papeis";
// O giro de cada papel (forma "papeis"): fixo por posição, para não mudar a cada visita.
const GIROS = [-1.4, 0.9, -0.5, 1.2, -0.9];
const giro = (i: number) => `--giro:${GIROS[i % GIROS.length]}deg`;
---

{
  ultima > 1 && (
    <nav class:list={["paginacao", `paginacao-${variante}`, { "papel-colado": variante === "papel" }]} aria-label="Paginação">
      {variante === "papel" && (
        <>
          <span class="fita-adesiva canto-esq" aria-hidden="true" />
          <span class="fita-adesiva canto-dir" aria-hidden="true" />
        </>
      )}
      {anterior ? (
        <a class:list={["botao anterior", { "papel-colado papel-botao": papeis }]} href={anterior} rel="prev" data-seta style={papeis ? giro(3) : undefined}>
          {papeis && <span class="fita-adesiva" aria-hidden="true" />}
          <span class="seta">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
          </span>
          Anteriores
        </a>
      ) : (
        variante === "solta" && <span />
      )}
      <ol class="numeros">
        {Array.from({ length: ultima }, (_, i) => i + 1).map((n) => (
          <li class:list={{ "papel-colado papel-numero": papeis }} style={papeis ? giro(n - 1) : undefined}>
            {papeis && <span class="fita-adesiva" aria-hidden="true" />}
            <a href={endereco(n)} aria-current={n === atual ? "page" : undefined}>
              <span class="sr">Página </span>
              {n}
              {n !== atual && (
                <svg class="circulo" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                  <path pathLength="1" d={circuloDeCaneta(`pagina${n}`)} />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ol>
      {proxima ? (
        <a class:list={["botao proxima", { "papel-colado papel-botao": papeis }]} href={proxima} rel="next" data-seta style={papeis ? giro(4) : undefined}>
          {papeis && <span class="fita-adesiva" aria-hidden="true" />}
          Mais artigos
          <span class="seta">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
          </span>
        </a>
      ) : (
        variante === "solta" && <span />
      )}
    </nav>
  )
}

<script>
  // No clique, a seta sai pela frente e volta por trás (a animação é do CSS, .indo).
  document.querySelectorAll<HTMLElement>(".paginacao [data-seta]").forEach((botao) => {
    botao.addEventListener("pointerdown", () => {
      botao.classList.remove("indo");
      void botao.offsetWidth;
      botao.classList.add("indo");
    });
    botao.addEventListener("animationend", () => botao.classList.remove("indo"));
  });
</script>

<style>
  .paginacao {
    font-family: var(--font-ui);
  }

  /* ---------- antes (o 18): a linha solta, os botões nas pontas ---------- */
  .paginacao-solta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }

  .paginacao-solta .botao {
    justify-self: start;
  }

  .paginacao-solta .proxima {
    justify-self: end;
  }

  /* ---------- A: um papel com tudo ---------- */
  .paginacao-papel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 18px;
    width: fit-content;
    max-width: calc(100% - 12px);
    margin: clamp(34px, 3.6vw, 48px) auto 4px;
    padding: 20px 24px 16px;
    rotate: 0.5deg;
  }

  /* As duas fitas, uma em cada canto de cima, menores que a da etiqueta e giradas uma para cada lado. */
  .paginacao-papel > .fita-adesiva {
    --fita-largura: 52px;
    --fita-x: -17px;
    --fita-y: -7px;
  }

  .paginacao-papel > .fita-adesiva.canto-esq {
    --fita-giro: -32deg;
  }

  .paginacao-papel > .fita-adesiva.canto-dir {
    --fita-giro: 36deg;
  }

  /* ---------- B: um papel por botão ---------- */
  .paginacao-papeis {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 20px;
    margin-top: clamp(34px, 3.6vw, 48px);
    padding-top: 6px;
  }

  .paginacao-papeis .numeros {
    gap: 12px;
  }

  .papel-numero,
  .papel-botao {
    rotate: var(--giro, 0deg);
    transition:
      rotate 0.3s cubic-bezier(0.2, 0.75, 0.2, 1),
      translate 0.3s cubic-bezier(0.2, 0.75, 0.2, 1),
      color 0.15s;
  }

  /* A sombra maior do papel erguido, pronta e apagada: no hover só a opacidade muda. */
  .papel-numero::after,
  .papel-botao::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow:
      0 1px 1px color-mix(in oklab, var(--sombra-quente) 10%, transparent),
      0 7px 10px -4px color-mix(in oklab, var(--sombra-quente) 26%, transparent);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .papel-numero .fita-adesiva,
  .papel-botao .fita-adesiva {
    --fita-largura: 26px;
    left: calc(50% - 13px);
    --fita-y: -8px;
    height: 14px;
    --fita-giro: calc(var(--giro, 0deg) * -4);
  }

  .papel-numero {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
  }

  .paginacao-papeis .botao.papel-botao {
    position: relative;
    min-height: 40px;
    padding: 9px 16px;
    border: 0;
    border-radius: 2px;
  }

  @media (hover: hover) {
    .papel-numero:hover,
    .papel-botao:hover {
      rotate: 0deg;
      translate: 0 -2px;
    }

    .papel-numero:hover::after,
    .papel-botao:hover::after {
      opacity: 1;
    }
  }

  .papel-numero:focus-within,
  .papel-botao:focus-visible {
    rotate: 0deg;
  }

  /* ---------- as peças, nas três formas ---------- */

  /* A seta numa janela: sai por um lado e volta pelo outro sem aparecer fora dela. A margem negativa
     devolve o espaço da folga, que só existe para a ponta arredondada não ser cortada. */
  .seta {
    --rumo: 1;
    display: inline-grid;
    margin-inline: -3px;
    padding-inline: 3px;
    overflow: hidden;
  }

  .anterior .seta {
    --rumo: -1;
  }

  .botao svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .anterior svg {
    rotate: 180deg;
  }

  .botao:is(:hover, :focus-visible) svg {
    translate: calc(3px * var(--rumo));
  }

  .indo svg {
    animation: seta-vai 0.32s both;
  }

  /* Sai pela frente (0,14s, power2.in) e volta por trás (0,18s, power2.out). */
  @keyframes seta-vai {
    0% {
      translate: calc(3px * var(--rumo));
      animation-timing-function: cubic-bezier(0.55, 0.085, 0.68, 0.53);
    }

    43.7% {
      translate: calc(130% * var(--rumo));
      animation-timing-function: steps(1, end);
    }

    43.8% {
      translate: calc(-130% * var(--rumo));
      animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    100% {
      translate: 0;
    }
  }

  .numeros {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .numeros a {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    text-decoration: none;
  }

  .papel-numero a {
    width: 36px;
    height: 36px;
    border-radius: 2px;
    color: var(--ink);
  }

  /* O disco azul cabe no quadradinho, com o papel em volta. */
  .papel-numero a[aria-current="page"] {
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  /*
   * Rodada 4 (H8): o círculo de caneta do hover do tamanho do disco azul da página atual, rente ao número
   * ("menor, mais próximo do número, como o pintado no 1"): a caixa dele passa só 1px do quadradinho (o
   * traço desenhado fica com uns 29px, contra os 28 do disco), e o traço engrossa na mesma proporção,
   * para a caneta continuar com a mesma espessura na tela.
   */
  .papel-numero .circulo {
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
  }

  .papel-numero .circulo :global(path) {
    stroke-width: 2.05;
  }

  .numeros a:hover {
    color: var(--acento);
  }

  .numeros a[aria-current="page"] {
    background: var(--acento);
    color: var(--sobre-acento);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .botao svg,
    .papel-numero,
    .papel-botao,
    .papel-numero::after,
    .papel-botao::after {
      transition: none;
    }

    .papel-numero:hover,
    .papel-botao:hover {
      translate: none;
    }

    .indo svg {
      animation: none;
    }
  }

  /*
   * Em tela estreita, os números ficam numa linha (centrados) e os botões na de baixo: no papel, um em
   * cada ponta; com um botão só, no meio.
   */
  @media (max-width: 560px) {
    .paginacao-papel,
    .paginacao-papeis {
      justify-content: space-between;
    }

    .paginacao-papel .numeros,
    .paginacao-papeis .numeros {
      order: -1;
      flex-basis: 100%;
      justify-content: center;
    }

    .paginacao-papel:not(:has(.anterior)),
    .paginacao-papeis:not(:has(.anterior)) {
      justify-content: center;
    }

    .paginacao-papel {
      padding: 18px 18px 14px;
    }
  }

  /* Nos celulares mais estreitos (320), os dois botões não cabem lado a lado: um embaixo do outro, na
     largura do papel. */
  @media (max-width: 360px) {
    .paginacao-papel .botao,
    .paginacao-papeis .botao {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .paginacao-solta {
      grid-template-columns: 1fr 1fr;
    }

    .paginacao-solta .numeros {
      display: none;
    }
  }
</style>
