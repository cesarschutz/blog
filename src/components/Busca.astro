---
/**
 * Busca (briefing §3): abre com ⌘K, Ctrl+K ou "/"; aceita #tag (as tags do site levam às páginas
 * delas desde a D33, e não mais à busca);
 * link compartilhável /?q=termo. O motor (Pagefind, D2) e o índice só são baixados quando a busca
 * abre. O índice sai no build (`pagefind --site dist`, no postbuild), então no `npm run dev` a busca
 * avisa que não há índice. Marca o tempo até o primeiro resultado (performance "busca:aberta" e
 * "busca:resultado") para a medição de scripts/bench-busca.
 */
---

<dialog class="busca" data-busca aria-labelledby="busca-titulo">
  <form method="dialog" class="caixa" role="search">
    <h2 id="busca-titulo" class="sr">Buscar nos artigos</h2>
    <div class="campo">
      <label for="busca-campo" class="sr">Termo da busca</label>
      <input
        id="busca-campo"
        type="search"
        data-busca-campo
        placeholder="Buscar nos artigos…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button type="submit" class="fechar" data-busca-fechar>Fechar</button>
    </div>
    <p class="estado" data-busca-estado aria-live="polite">A busca ignora acentos. Use # para procurar por tag.</p>
    <ul class="resultados" data-busca-resultados></ul>
  </form>
</dialog>

<script>
  import type { MotorDeBusca, ResultadoBusca } from "../lib/busca/tipos";
  import { escaparHtml } from "../lib/busca/tipos";
  import { adiantar, carregarFlip, movimentoReduzido } from "../scripts/gsap";

  const dialogo = document.querySelector<HTMLDialogElement>("[data-busca]")!;
  const campo = dialogo.querySelector<HTMLInputElement>("[data-busca-campo]")!;
  const estado = dialogo.querySelector<HTMLElement>("[data-busca-estado]")!;
  const lista = dialogo.querySelector<HTMLUListElement>("[data-busca-resultados]")!;
  const DICA = estado.textContent ?? "";

  const FALHOU = import.meta.env.DEV
    ? "No npm run dev não há índice: ele sai no build (npm run build e npm run preview)."
    : "Não consegui carregar a busca. Tente de novo.";

  // Se o carregamento falhar (rede), a próxima abertura tenta de novo.
  let motor: Promise<MotorDeBusca> | undefined;
  const obterMotor = () =>
    (motor ??= import("../lib/busca/pagefind")
      .then((m) => m.motorPagefind)
      .catch((erro) => {
        motor = undefined;
        throw erro;
      }));

  const consultaValida = (q: string) => q.trim().startsWith("#") ? q.trim().length > 1 : q.trim().length >= 2;

  function atualizarEndereco(q: string | null) {
    const endereco = new URL(location.href);
    if (q) endereco.searchParams.set("q", q);
    else endereco.searchParams.delete("q");
    history.replaceState(history.state, "", endereco);
  }

  // O termo buscado também ganha o marca-texto no título (sem acento e sem caixa, como a busca).
  const semAcento = (t: string) => t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  function marcarTitulo(titulo: string, consulta: string) {
    const termos = semAcento(consulta.replace(/^#/, "")).split(/\s+/).filter((t) => t.length >= 2);
    const base = semAcento(titulo);
    // Cada letra de `titulo` vira uma só em `base` (NFD + remover acentos mantém o comprimento em pt-BR).
    if (!termos.length || base.length !== titulo.length) return escaparHtml(titulo);
    const marcado = new Array<boolean>(titulo.length).fill(false);
    for (const t of termos) for (let i = base.indexOf(t); i >= 0; i = base.indexOf(t, i + t.length)) marcado.fill(true, i, i + t.length);
    let html = "";
    for (let i = 0; i < titulo.length; ) {
      let j = i;
      while (j < titulo.length && marcado[j] === marcado[i]) j++;
      const pedaco = escaparHtml(titulo.slice(i, j));
      html += marcado[i] ? `<mark>${pedaco}</mark>` : pedaco;
      i = j;
    }
    return html;
  }

  function desenhar(resultados: ResultadoBusca[], consulta: string) {
    lista.innerHTML = resultados
      .map(
        (r) => `<li><a class="resultado" href="${r.url}">
          <span class="r-titulo">${marcarTitulo(r.titulo, consulta)}</span>
          <span class="r-meta">${escaparHtml([r.rotulo, r.data].filter(Boolean).join(", "))}</span>
          <span class="r-trecho">${r.trecho}</span>
        </a></li>`,
      )
      .join("");
    const n = resultados.length;
    estado.textContent = !n
      ? `Nenhum artigo encontrado para “${consulta}”.`
      : resultados[0].aproximado
        ? `Nada exato para “${consulta}”. ${n === 1 ? "Parecido" : "Parecidos"}:`
        : n === 1
          ? "1 artigo"
          : `${n} artigos`;
    // Os resultados entram em sequência e o marca-texto passa pelo termo (D41).
    if (flip && !movimentoReduzido.matches) {
      const { gsap } = flip;
      gsap.from([...lista.children].slice(0, 8), { opacity: 0, y: 6, duration: 0.3, stagger: 0.035, ease: "power2.out", clearProps: "opacity,transform" });
      gsap.fromTo(lista.querySelectorAll("mark"), { backgroundSize: "0% 100%" }, { backgroundSize: "100% 100%", duration: 0.45, delay: 0.15, ease: "power2.out" });
    }
  }

  let vez = 0;
  let primeiroResultadoMarcado = false;
  async function buscar() {
    const consulta = campo.value;
    const minha = ++vez;
    atualizarEndereco(consultaValida(consulta) ? consulta.trim() : null);
    if (!consultaValida(consulta)) {
      lista.innerHTML = "";
      estado.textContent = consulta.trim() ? "Digite ao menos 2 letras." : DICA;
      return;
    }
    const inicio = performance.now();
    let resultados: ResultadoBusca[];
    try {
      resultados = await (await obterMotor()).buscar(consulta);
    } catch {
      if (minha === vez) estado.textContent = FALHOU;
      return;
    }
    if (minha !== vez) return;
    desenhar(resultados, consulta.trim());
    if (!primeiroResultadoMarcado) {
      primeiroResultadoMarcado = true;
      performance.mark("busca:resultado");
    }
    dispatchEvent(new CustomEvent("busca:resultado", { detail: { consulta, n: resultados.length, ms: performance.now() - inicio } }));
  }

  // A janela nasce do campo do cabeçalho e volta para ele (D41, Flip). O campo é o botão à vista
  // (no celular, só o ícone). Sem o GSAP ainda, ou com movimento reduzido, abre e fecha direto.
  let flip: Awaited<ReturnType<typeof carregarFlip>> | null = null;
  const botoes = [...document.querySelectorAll<HTMLElement>("[data-busca-abrir]")];
  if (!movimentoReduzido.matches) botoes.forEach((b) => adiantar(b, () => carregarFlip().then((f) => (flip = f))));
  const botaoAVista = () => botoes.find((b) => b.getBoundingClientRect().width > 0);
  const conteudo = () => [...dialogo.querySelectorAll<HTMLElement>(".campo, .estado, .resultados")];

  function nascer() {
    const botao = botaoAVista();
    if (!flip || !botao || movimentoReduzido.matches) return;
    const { gsap, Flip } = flip;
    botao.dataset.flipId = dialogo.dataset.flipId = "busca";
    gsap.killTweensOf([dialogo, ...conteudo()]);
    gsap.set(dialogo, { clearProps: "transform,opacity" });
    Flip.from(Flip.getState(botao), { targets: dialogo, duration: 0.5, ease: "power3.out", scale: true, clearProps: "transform" });
    gsap.from(conteudo(), { opacity: 0, duration: 0.3, delay: 0.2, clearProps: "opacity" });
  }

  let fechando = false;
  function fechar() {
    if (!dialogo.open || fechando) return;
    const botao = botaoAVista();
    const fim = () => {
      fechando = false;
      dialogo.classList.remove("fechando");
      dialogo.close();
      flip?.gsap.set([dialogo, ...conteudo()], { clearProps: "transform,opacity,width,height" });
      botao?.focus();
    };
    if (!flip || !botao || movimentoReduzido.matches) return fim();
    const { gsap, Flip } = flip;
    fechando = true;
    dialogo.classList.add("fechando");
    gsap.to(conteudo(), { opacity: 0, duration: 0.15 });
    Flip.fit(dialogo, botao, { duration: 0.35, ease: "power2.in", scale: true, onComplete: fim });
  }

  function abrir(consulta?: string) {
    if (!dialogo.open) {
      primeiroResultadoMarcado = false;
      performance.mark("busca:aberta");
      dialogo.showModal();
      nascer();
      obterMotor()
        .then((m) => m.preparar())
        .catch(() => (estado.textContent = FALHOU));
    }
    if (consulta !== undefined) {
      campo.value = consulta;
      buscar();
    }
    campo.focus();
    campo.select();
  }

  dialogo.addEventListener("close", () => atualizarEndereco(null));
  dialogo.addEventListener("click", (e) => {
    if (e.target === dialogo) fechar();
  });
  // Esc e "Fechar" também encolhem de volta para o campo.
  dialogo.addEventListener("cancel", (e) => {
    e.preventDefault();
    fechar();
  });
  dialogo.addEventListener("submit", (e) => {
    e.preventDefault();
    fechar();
  });
  // Espera uma pausa curta na digitação: buscar cada prefixo ("id", "ide"…) só baixaria índice à toa.
  let pausa: ReturnType<typeof setTimeout> | undefined;
  campo.addEventListener("input", () => {
    clearTimeout(pausa);
    pausa = setTimeout(buscar, 160);
  });

  document.addEventListener("click", (e) => {
    const alvo = e.target as HTMLElement;
    const botao = alvo.closest<HTMLElement>("[data-busca-abrir]");
    if (botao) {
      e.preventDefault();
      abrir();
    }
  });

  document.addEventListener("keydown", (e) => {
    const digitando = (e.target as HTMLElement).closest("input, textarea, select, [contenteditable]");
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialogo.open ? fechar() : abrir();
    } else if (e.key === "/" && !digitando && !dialogo.open) {
      e.preventDefault();
      abrir();
    }
  });

  // Setas percorrem os resultados; Enter no campo abre o primeiro.
  dialogo.addEventListener("keydown", (e) => {
    const itens = [...lista.querySelectorAll<HTMLAnchorElement>(".resultado")];
    if (!itens.length) return;
    const atual = itens.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === "ArrowDown") {
      e.preventDefault();
      itens[Math.min(atual + 1, itens.length - 1)].focus();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      atual <= 0 ? campo.focus() : itens[atual - 1].focus();
    } else if (e.key === "Enter" && document.activeElement === campo) {
      e.preventDefault();
      itens[0].click();
    }
  });

  const inicial = new URLSearchParams(location.search).get("q");
  if (inicial) abrir(inicial);
</script>

<style>
  /* Uma folha sobre a página (D26), com a interface em IBM Plex Sans e os títulos em Besley. */
  .busca {
    --altura-busca: min(620px, calc(100vh - 64px));
    width: min(640px, calc(100vw - 32px));
    max-height: var(--altura-busca);
    margin: 64px auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--raio-folha);
    background: var(--paper-hi);
    box-shadow: var(--sombra-folha-alta);
    color: var(--ink);
    font-family: var(--font-ui);
  }

  .busca::backdrop {
    background: rgb(20 26 28 / 0.45);
    transition: opacity 0.3s;
  }

  /* O véu acompanha a janela: aparece ao abrir e some enquanto ela volta para o campo (D41). */
  @starting-style {
    .busca[open]::backdrop {
      opacity: 0;
    }
  }

  .busca.fechando::backdrop {
    opacity: 0;
    transition-duration: 0.25s;
  }

  @media (prefers-reduced-motion: reduce) {
    .busca::backdrop {
      transition: none;
    }
  }

  /* Desconta a borda do diálogo: sem isso ele rola 2px e aparece uma segunda barra ao lado da lista. */
  .caixa {
    display: flex;
    flex-direction: column;
    max-height: calc(var(--altura-busca) - 2px);
  }

  .campo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 18px;
    border-bottom: 1px solid var(--rule);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 18px;
    outline: none;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .fechar {
    padding: 5px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: 14px;
    cursor: pointer;
  }

  .fechar:hover {
    border-color: var(--acento);
    color: var(--acento);
  }

  .estado {
    margin: 0;
    padding: 12px 18px 6px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .resultados {
    margin: 0;
    padding: 0 8px 10px;
    overflow-y: auto;
    list-style: none;
    overscroll-behavior: contain;
  }

  .resultados :global(.resultado) {
    display: grid;
    gap: 2px;
    padding: 10px 10px;
    border-radius: var(--raio-painel);
    color: var(--ink);
    text-decoration: none;
  }

  .resultados :global(.resultado:hover),
  .resultados :global(.resultado:focus-visible) {
    background: color-mix(in oklab, var(--acento) 6%, transparent);
    outline-offset: 0;
  }

  .resultados :global(.resultado:hover .r-titulo),
  .resultados :global(.resultado:focus-visible .r-titulo) {
    color: var(--acento);
  }

  .resultados :global(.r-titulo) {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
  }

  .resultados :global(.r-meta) {
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .resultados :global(.r-trecho) {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* O marca-texto é uma camada de fundo própria, que o GSAP estica da esquerda para a direita. */
  .resultados :global(mark) {
    background: linear-gradient(color-mix(in oklab, var(--aviso-atencao) 28%, transparent), color-mix(in oklab, var(--aviso-atencao) 28%, transparent)) no-repeat 0 0 / 100% 100%;
    color: var(--ink);
    border-radius: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
