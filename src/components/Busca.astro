---
/**
 * Busca (briefing §3): abre com ⌘K ou Ctrl+K (e o botão do cabeçalho), nunca com uma tecla só: o "/"
 * saiu na B06 (D52), porque em muitos teclados ele é a tecla do "?", que abre os atalhos do artigo
 * (Atalhos.astro). Aceita #tag (as tags do site levam às páginas
 * delas desde a D33, e não mais à busca);
 * link compartilhável /?q=termo. O motor (Pagefind, D2) e o índice só são baixados quando a busca
 * abre. O índice sai no build (`pagefind --site dist`, no postbuild), então no `npm run dev` a busca
 * avisa que não há índice. Marca o tempo até o primeiro resultado (performance "busca:aberta" e
 * "busca:resultado") para a medição de scripts/bench-busca.
 *
 * D49 (protótipo E4): nos resultados, um marcador só (o fundo e o fio azul) desliza até o item da vez,
 * seguindo as setas, o foco e o mouse (0,28s; seguindo depressa, ele só muda de destino); o primeiro
 * já vem marcado, e o Enter no campo abre o marcado. Sem resultado, o termo ganha a ondinha de revisor
 * (na cor de Cuidado: é aviso, não erro do leitor), e embaixo vem uma saída: termo mais curto ou as tags.
 */
import { url } from "../lib/url";
---

<dialog class="busca" data-busca aria-labelledby="busca-titulo">
  <form method="dialog" class="caixa" role="search">
    <h2 id="busca-titulo" class="sr">Buscar nos artigos</h2>
    <div class="campo">
      <label for="busca-campo" class="sr">Termo da busca</label>
      <input
        id="busca-campo"
        type="search"
        data-busca-campo
        placeholder="Buscar nos artigos…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button type="submit" class="fechar" data-busca-fechar>Fechar</button>
    </div>
    <p class="estado" data-busca-estado aria-live="polite">A busca ignora acentos. Use # para procurar por tag.</p>
    <ul class="resultados" data-busca-resultados></ul>
    <p class="dica-vazia" data-busca-dica hidden>Tente um termo mais curto ou veja <a href={url("/tags/")}>todas as tags</a>.</p>
  </form>
</dialog>

<script>
  import type { MotorDeBusca, ResultadoBusca } from "../lib/busca/tipos";
  import { escaparHtml } from "../lib/busca/tipos";
  import { ICONES } from "../lib/icones";
  import { ondaDeCaneta } from "../lib/traco";
  import { adiantar, carregarFlip, movimentoReduzido } from "../scripts/gsap";

  const dialogo = document.querySelector<HTMLDialogElement>("[data-busca]")!;
  const campo = dialogo.querySelector<HTMLInputElement>("[data-busca-campo]")!;
  const estado = dialogo.querySelector<HTMLElement>("[data-busca-estado]")!;
  const lista = dialogo.querySelector<HTMLUListElement>("[data-busca-resultados]")!;
  const dicaVazia = dialogo.querySelector<HTMLElement>("[data-busca-dica]")!;
  const DICA = estado.textContent ?? "";

  // O marcador (D49): um fundo só, que desliza até o resultado da vez (a transição é do CSS).
  const marcador = document.createElement("li");
  marcador.className = "marcador";
  marcador.setAttribute("aria-hidden", "true");
  const resultadosNaTela = () => [...lista.querySelectorAll<HTMLAnchorElement>(".resultado")];
  function marcar(alvo: HTMLAnchorElement | undefined, direto = false) {
    const itens = resultadosNaTela();
    if (!alvo || !itens.includes(alvo)) return;
    itens.forEach((a) => a.classList.toggle("ativo", a === alvo));
    if (!marcador.isConnected) lista.prepend(marcador);
    const li = alvo.parentElement!;
    marcador.classList.toggle("direto", direto);
    marcador.style.transform = `translateY(${li.offsetTop}px)`;
    marcador.style.height = `${li.offsetHeight}px`;
    if (direto) {
      void marcador.offsetWidth;
      marcador.classList.remove("direto");
    }
  }

  // Sem resultado (D49): o termo com a ondinha de revisor, escrita da esquerda para a direita.
  function ondinha(consulta: string) {
    const termo = estado.querySelector<HTMLElement>(".termo");
    const onda = termo?.querySelector("svg");
    if (!termo || !onda) return;
    const largura = termo.getBoundingClientRect().width;
    onda.setAttribute("viewBox", `0 0 ${largura.toFixed(1)} 6`);
    onda.style.width = `${largura}px`;
    onda.querySelector("path")!.setAttribute("d", ondaDeCaneta(largura, consulta));
  }

  const FALHOU = import.meta.env.DEV
    ? "No npm run dev não há índice: ele sai no build (npm run build e npm run preview)."
    : "Não consegui carregar a busca. Tente de novo.";

  // Se o carregamento falhar (rede), a próxima abertura tenta de novo.
  let motor: Promise<MotorDeBusca> | undefined;
  const obterMotor = () =>
    (motor ??= import("../lib/busca/pagefind")
      .then((m) => m.motorPagefind)
      .catch((erro) => {
        motor = undefined;
        throw erro;
      }));

  const consultaValida = (q: string) => q.trim().startsWith("#") ? q.trim().length > 1 : q.trim().length >= 2;

  function atualizarEndereco(q: string | null) {
    const endereco = new URL(location.href);
    if (q) endereco.searchParams.set("q", q);
    else endereco.searchParams.delete("q");
    history.replaceState(history.state, "", endereco);
  }

  // O termo buscado também ganha o marca-texto no título (sem acento e sem caixa, como a busca).
  const semAcento = (t: string) => t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  function marcarTitulo(titulo: string, consulta: string) {
    const termos = semAcento(consulta.replace(/^#/, "")).split(/\s+/).filter((t) => t.length >= 2);
    const base = semAcento(titulo);
    // Cada letra de `titulo` vira uma só em `base` (NFD + remover acentos mantém o comprimento em pt-BR).
    if (!termos.length || base.length !== titulo.length) return escaparHtml(titulo);
    const marcado = new Array<boolean>(titulo.length).fill(false);
    for (const t of termos) for (let i = base.indexOf(t); i >= 0; i = base.indexOf(t, i + t.length)) marcado.fill(true, i, i + t.length);
    let html = "";
    for (let i = 0; i < titulo.length; ) {
      let j = i;
      while (j < titulo.length && marcado[j] === marcado[i]) j++;
      const pedaco = escaparHtml(titulo.slice(i, j));
      html += marcado[i] ? `<mark>${pedaco}</mark>` : pedaco;
      i = j;
    }
    return html;
  }

  function desenhar(resultados: ResultadoBusca[], consulta: string) {
    lista.innerHTML = resultados
      .map(
        (r) => `<li><a class="resultado" href="${r.url}">
          <span class="r-titulo">${marcarTitulo(r.titulo, consulta)}</span>
          <span class="r-meta">${escaparHtml([r.rotulo, r.data].filter(Boolean).join(", "))}${
            r.codigo ? `<span class="r-codigo"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICONES.codigo}</svg>código-fonte</span>` : ""
          }</span>
          <span class="r-trecho">${r.trecho}</span>
        </a></li>`,
      )
      .join("");
    const n = resultados.length;
    dicaVazia.hidden = n > 0;
    if (!n) {
      estado.innerHTML = `Nenhum artigo encontrado para “<span class="termo">${escaparHtml(consulta)}<svg class="ondinha" aria-hidden="true" focusable="false"><path pathLength="1" /></svg></span>”.`;
      ondinha(consulta);
      return;
    }
    marcar(resultadosNaTela()[0], true);
    estado.textContent = resultados[0].aproximado
      ? `Nada exato para “${consulta}”. ${n === 1 ? "Parecido" : "Parecidos"}:`
      : n === 1
        ? "1 artigo"
        : `${n} artigos`;
    // Os resultados entram em sequência e o marca-texto passa pelo termo (D44).
    if (flip && !movimentoReduzido.matches) {
      const { gsap } = flip;
      gsap.from([...lista.children].filter((li) => li !== marcador).slice(0, 8), { opacity: 0, y: 6, duration: 0.3, stagger: 0.035, ease: "power2.out", clearProps: "opacity,transform" });
      gsap.fromTo(lista.querySelectorAll("mark"), { backgroundSize: "0% 100%" }, { backgroundSize: "100% 100%", duration: 0.45, delay: 0.15, ease: "power2.out" });
    }
  }

  let vez = 0;
  let primeiroResultadoMarcado = false;
  async function buscar() {
    const consulta = campo.value;
    const minha = ++vez;
    atualizarEndereco(consultaValida(consulta) ? consulta.trim() : null);
    if (!consultaValida(consulta)) {
      lista.innerHTML = "";
      dicaVazia.hidden = true;
      estado.textContent = consulta.trim() ? "Digite ao menos 2 letras." : DICA;
      return;
    }
    const inicio = performance.now();
    let resultados: ResultadoBusca[];
    try {
      resultados = await (await obterMotor()).buscar(consulta);
    } catch {
      if (minha === vez) estado.textContent = FALHOU;
      return;
    }
    if (minha !== vez) return;
    desenhar(resultados, consulta.trim());
    if (!primeiroResultadoMarcado) {
      primeiroResultadoMarcado = true;
      performance.mark("busca:resultado");
    }
    dispatchEvent(new CustomEvent("busca:resultado", { detail: { consulta, n: resultados.length, ms: performance.now() - inicio } }));
  }

  // A janela nasce do campo do cabeçalho e volta para ele (D44, Flip). O campo é o botão à vista
  // (no celular, só o ícone). Sem o GSAP ainda, ou com movimento reduzido, abre e fecha direto.
  let flip: Awaited<ReturnType<typeof carregarFlip>> | null = null;
  const botoes = [...document.querySelectorAll<HTMLElement>("[data-busca-abrir]")];
  if (!movimentoReduzido.matches) botoes.forEach((b) => adiantar(b, () => carregarFlip().then((f) => (flip = f))));
  const botaoAVista = () => botoes.find((b) => b.getBoundingClientRect().width > 0);
  const conteudo = () => [...dialogo.querySelectorAll<HTMLElement>(".campo, .estado, .resultados")];

  function nascer() {
    const botao = botaoAVista();
    if (!flip || !botao || movimentoReduzido.matches) return;
    const { gsap, Flip } = flip;
    botao.dataset.flipId = dialogo.dataset.flipId = "busca";
    gsap.killTweensOf([dialogo, ...conteudo()]);
    gsap.set(dialogo, { clearProps: "transform,opacity" });
    Flip.from(Flip.getState(botao), { targets: dialogo, duration: 0.5, ease: "power3.out", scale: true, clearProps: "transform" });
    gsap.from(conteudo(), { opacity: 0, duration: 0.3, delay: 0.2, clearProps: "opacity" });
  }

  let fechando = false;
  function fechar() {
    if (!dialogo.open || fechando) return;
    const botao = botaoAVista();
    const fim = () => {
      fechando = false;
      dialogo.classList.remove("fechando");
      dialogo.close();
      flip?.gsap.set([dialogo, ...conteudo()], { clearProps: "transform,opacity,width,height" });
      botao?.focus();
    };
    if (!flip || !botao || movimentoReduzido.matches) return fim();
    const { gsap, Flip } = flip;
    fechando = true;
    dialogo.classList.add("fechando");
    // Fechando logo depois de abrir: o nascer (a janela crescendo e o conteúdo chegando) para aqui, senão o
    // conteúdo voltava enquanto a janela encolhia (D54).
    gsap.killTweensOf([dialogo, ...conteudo()]);
    gsap.to(conteudo(), { opacity: 0, duration: 0.15 });
    Flip.fit(dialogo, botao, { duration: 0.35, ease: "power2.in", scale: true, onComplete: fim });
  }

  // A tecla desenhada responde à de verdade (D49): afunda por 120ms, e o campo dá um toque no instante
  // em que a janela nasce dele (Cabecalho.astro, .apertada e .tocado). Pelo atalho ou pelo clique.
  function apertarTecla() {
    const botao = botaoAVista();
    if (!botao || movimentoReduzido.matches) return;
    const tecla = botao.querySelector<HTMLElement>("[data-atalho]");
    tecla?.classList.add("apertada");
    setTimeout(() => tecla?.classList.remove("apertada"), 120);
    botao.classList.remove("tocado");
    void botao.offsetWidth;
    botao.classList.add("tocado");
    botao.addEventListener("animationend", () => botao.classList.remove("tocado"), { once: true });
  }

  function abrir(consulta?: string) {
    if (!dialogo.open) {
      primeiroResultadoMarcado = false;
      performance.mark("busca:aberta");
      apertarTecla();
      dialogo.showModal();
      nascer();
      obterMotor()
        .then((m) => m.preparar())
        .catch(() => (estado.textContent = FALHOU));
    }
    if (consulta !== undefined) {
      campo.value = consulta;
      buscar();
    }
    campo.focus();
    campo.select();
  }

  dialogo.addEventListener("close", () => atualizarEndereco(null));
  dialogo.addEventListener("click", (e) => {
    if (e.target === dialogo) fechar();
  });
  // Esc e "Fechar" também encolhem de volta para o campo.
  dialogo.addEventListener("cancel", (e) => {
    e.preventDefault();
    fechar();
  });
  dialogo.addEventListener("submit", (e) => {
    e.preventDefault();
    fechar();
  });
  // Espera uma pausa curta na digitação: buscar cada prefixo ("id", "ide"…) só baixaria índice à toa.
  let pausa: ReturnType<typeof setTimeout> | undefined;
  campo.addEventListener("input", () => {
    clearTimeout(pausa);
    pausa = setTimeout(buscar, 160);
  });

  document.addEventListener("click", (e) => {
    const alvo = e.target as HTMLElement;
    const botao = alvo.closest<HTMLElement>("[data-busca-abrir]");
    if (botao) {
      e.preventDefault();
      abrir();
    }
  });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialogo.open ? fechar() : abrir();
    }
  });

  // Esc fecha a busca de uma vez, mesmo com texto no campo (no Chrome, o type="search" gastava o primeiro
  // Esc limpando o campo, D54).
  campo.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    e.preventDefault();
    fechar();
  });

  // O marcador segue o foco (as setas e o Tab) e o mouse (ou o dedo).
  lista.addEventListener("focusin", (e) => marcar((e.target as HTMLElement).closest<HTMLAnchorElement>(".resultado") ?? undefined));
  lista.addEventListener("pointerover", (e) => marcar((e.target as HTMLElement).closest<HTMLAnchorElement>(".resultado") ?? undefined));

  // Setas percorrem os resultados; Enter no campo abre o marcado (o primeiro, até o leitor escolher outro).
  dialogo.addEventListener("keydown", (e) => {
    const itens = [...lista.querySelectorAll<HTMLAnchorElement>(".resultado")];
    if (!itens.length) return;
    const atual = itens.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === "ArrowDown") {
      e.preventDefault();
      itens[Math.min(atual + 1, itens.length - 1)].focus();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      atual <= 0 ? campo.focus() : itens[atual - 1].focus();
    } else if (e.key === "Enter" && document.activeElement === campo) {
      e.preventDefault();
      (lista.querySelector<HTMLAnchorElement>(".resultado.ativo") ?? itens[0]).click();
    }
  });

  const inicial = new URLSearchParams(location.search).get("q");
  if (inicial) abrir(inicial);
  // Voltando de um resultado pelo histórico (bfcache), a busca volta aberta, com o foco no campo (D54).
  addEventListener("pageshow", (e) => {
    if (e.persisted && dialogo.open && !dialogo.contains(document.activeElement)) campo.focus();
  });
</script>

<style>
  /* Uma folha sobre a página (D26), com a interface em IBM Plex Sans e os títulos em Besley. */
  .busca {
    --altura-busca: min(620px, calc(100vh - 64px));
    width: min(640px, calc(100vw - 32px));
    max-height: var(--altura-busca);
    margin: 64px auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--raio-folha);
    background: var(--paper-hi);
    box-shadow: var(--sombra-folha-alta);
    color: var(--ink);
    font-family: var(--font-ui);
  }

  .busca::backdrop {
    background: rgb(20 26 28 / 0.45);
    transition: opacity 0.3s;
  }

  /* O véu acompanha a janela: aparece ao abrir e some enquanto ela volta para o campo (D44). */
  @starting-style {
    .busca[open]::backdrop {
      opacity: 0;
    }
  }

  .busca.fechando::backdrop {
    opacity: 0;
    transition-duration: 0.25s;
  }

  /* Fechando, o conteúdo sai e não volta, mesmo que a janela ainda estivesse nascendo (o conteúdo chegava
     com atraso e aparecia enquanto ela encolhia, D54). */
  .busca.fechando :is(.campo, .estado, .resultados) {
    opacity: 0 !important;
    transition: opacity 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    .busca::backdrop {
      transition: none;
    }
  }

  /* Desconta a borda do diálogo: sem isso ele rola 2px e aparece uma segunda barra ao lado da lista. */
  .caixa {
    display: flex;
    flex-direction: column;
    max-height: calc(var(--altura-busca) - 2px);
  }

  .campo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 18px;
    border-bottom: 1px solid var(--rule);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 18px;
    outline: none;
  }

  /* O cinza padrão do navegador dava 3,5:1 no tema escuro (D54). */
  input::placeholder {
    color: var(--ink-2);
    opacity: 1;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .fechar {
    padding: 5px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: 14px;
    cursor: pointer;
  }

  .fechar:hover {
    border-color: var(--acento);
    color: var(--acento);
  }

  .estado {
    margin: 0;
    padding: 12px 18px 6px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .resultados {
    position: relative;
    margin: 0;
    padding: 0 8px 10px;
    overflow-y: auto;
    list-style: none;
    overscroll-behavior: contain;
  }

  /* O marcador (D49): o fundo e o fio azul, deslizando até o resultado da vez (0,28s, power3.out). */
  .resultados :global(.marcador) {
    position: absolute;
    top: 0;
    right: 8px;
    left: 8px;
    border-radius: var(--raio-painel);
    background: color-mix(in oklab, var(--acento) 6%, transparent);
    pointer-events: none;
    transition:
      transform 0.28s cubic-bezier(0.215, 0.61, 0.355, 1),
      height 0.28s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .resultados :global(.marcador::before) {
    content: "";
    position: absolute;
    top: 9px;
    bottom: 9px;
    left: 4px;
    width: 2px;
    border-radius: 2px;
    background: var(--acento);
  }

  .resultados :global(.marcador.direto) {
    transition: none;
  }

  .resultados :global(.resultado) {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    padding: 10px 10px;
    border-radius: var(--raio-painel);
    color: var(--ink);
    text-decoration: none;
  }

  .resultados :global(.resultado:focus-visible) {
    outline-offset: 0;
  }

  .resultados :global(.resultado.ativo .r-titulo) {
    color: var(--acento);
  }

  .resultados :global(.r-titulo) {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
  }

  .resultados :global(.r-meta) {
    font-size: 13.5px;
    color: var(--ink-2);
  }

  /* O sinal do código-fonte (D52, C03), como nas listas: o ícone e "código-fonte". */
  .resultados :global(.r-codigo) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 12px;
    white-space: nowrap;
  }

  .resultados :global(.r-codigo svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .resultados :global(.r-trecho) {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Sem resultado (D49): a ondinha de revisor sob o termo (0,45s) e a saída chegando depois. */
  .estado :global(.termo) {
    position: relative;
    display: inline-block;
    color: var(--ink);
  }

  .estado :global(.ondinha) {
    position: absolute;
    top: 100%;
    left: 0;
    height: 6px;
    overflow: visible;
    pointer-events: none;
  }

  .estado :global(.ondinha path) {
    fill: none;
    stroke: var(--aviso-cuidado);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 2;
    animation: ondinha 0.45s cubic-bezier(0.445, 0.05, 0.55, 0.95) 0.1s backwards;
  }

  @keyframes ondinha {
    from {
      stroke-dashoffset: 1.001;
    }
  }

  .dica-vazia {
    margin: 0;
    padding: 4px 18px 16px;
    font-size: 14px;
    color: var(--ink-2);
    animation: dica-chega 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.45s backwards;
  }

  /* Só a opacidade: deslocada, a dica passaria do fim da janela e a barra de rolagem piscaria. */
  @keyframes dica-chega {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resultados :global(.marcador),
    .estado :global(.ondinha path),
    .dica-vazia {
      transition: none;
      animation: none;
    }
  }

  /* O marca-texto é uma camada de fundo própria, que o GSAP estica da esquerda para a direita. */
  .resultados :global(mark) {
    background: linear-gradient(color-mix(in oklab, var(--aviso-atencao) 28%, transparent), color-mix(in oklab, var(--aviso-atencao) 28%, transparent)) no-repeat 0 0 / 100% 100%;
    color: var(--ink);
    border-radius: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
