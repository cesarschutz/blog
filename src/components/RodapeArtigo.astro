---
/**
 * Rodapé do post (briefing §5.3, D33), nesta ordem: tags (com o ícone de cada uma, D52);
 * compartilhar (copiar link, LinkedIn, WhatsApp e o compartilhar nativo quando existir); aviso sobre
 * IA; o livro do artigo, na ficha do volume (C05, D52: a mesma ficha de fichário da lateral, com o
 * título à mão, a foto do livro deitado com uma etiqueta por artigo, D57, e os dados datilografados na
 * pauta; no desktop com o sumário lateral, ela fica embaixo do sumário, D39); anterior e próximo,
 * em ordem cronológica global (D52, B03), com o título inteiro e, quando o artigo tem código-fonte
 * (D52, C03), o sinal no fim do título.
 *
 * Os gestos pequenos (D49, protótipo E3): "Copiar link" faz o gesto de copiar do site, o mesmo do
 * código (os elos se juntam, a caneta faz o visto e o rótulo rola até "Link copiado", com a pílula
 * crescendo sem pular; copiado.ts).
 *
 * Rodada 3 (área 5 da direção):
 * - Anterior e próximo com a imagem do post (T10, a ideia do 02): dois cartões lado a lado, cada um com
 *   a ilustração do post à esquerda (160px) e o rótulo, o título e o complemento à direita, sem a
 *   orelha que dobrava. No hover (ou no foco, ou no dedo), o cartão sobe 2px, a seta anda 3px para onde
 *   se vai e o detalhe da capa viva se mexe (artigo.css e artigo.ts). Sem o próximo (o artigo mais
 *   novo), o lugar fica com o quadro tracejado e a frase do 02; sem o anterior (o primeiro), o mesmo.
 *   No celular, um embaixo do outro.
 * - A ficha "Do livro" do fim do artigo (telas sem a lateral) é a mesma ficha colada da lateral, com a
 *   fita e a pintura na cor do livro (ficha-do-livro.css).
 *
 * Rodada 4 (P16-9 e E8): o anterior e o próximo viram fichas de catálogo, como os cards, coladas com a
 * fita crepe (Vizinhos.astro, "o B com a fita do C"), e a ficha "Do livro" fica como está
 * (LivroDoArtigo.astro), cada uma no seu componente.
 *
 * Ganchos estáveis (não renomear): `.vizinhos`, `a.vizinho.anterior[rel=prev]` e
 * `a.vizinho.proximo[rel=next]` (os atalhos do teclado e a troca de página os usam),
 * `.vizinho-figura`, `.vizinho-texto`, `.dir`, `.nome`, `.sub`, `.vizinho-vazio`; e, na ficha,
 * `.livro-do-artigo.ficha-colada`, `.fita`, `.cabeca-ficha`, `.corpo-ficha`, `.foto`.
 */
import LivroDoArtigo from "./LivroDoArtigo.astro";
import PilulaTag from "./PilulaTag.astro";
import Vizinhos from "./Vizinhos.astro";
import { ICONES } from "../lib/icones";
import { montarLivros } from "../lib/estante";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
  endereco: string;
  anterior?: Resumo;
  proximo?: Resumo;
}

const { post, endereco, anterior, proximo } = Astro.props;
const tituloCompleto = post.tituloCompleto;
const livros = await montarLivros();
const livro = post.serie
  ? livros.find((l) => l.id === `serie-${post.serie!.chave}`)
  : livros.find((l) => post.categoria && l.slug === post.categoria.slug);
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(endereco)}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${tituloCompleto} ${endereco}`)}`;
---

<footer class="rodape-artigo">
  <ul class="tags" aria-label="Tags">
    {
      post.tags.map((t) => (
        <li>
          <PilulaTag nome={t} />
        </li>
      ))
    }
  </ul>

  <div class="compartilhar" data-compartilhar data-titulo={tituloCompleto} data-endereco={endereco}>
    <span class="rotulo">Compartilhar</span>
    <button type="button" class="pilula gesto-copiar" data-copiar aria-label="Copiar link" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
        ><g class="frente" set:html={ICONES.link} /><path class="visto" pathLength="1" d="M4.5 12.8 9.4 17.4 19.5 6.6" /></svg
      ><span class="rotulo-rola" aria-hidden="true"><span>Copiar link</span></span>
    </button>
    <span class="sr" aria-live="polite" data-aviso-copiar></span>
    <a class="pilula" href={linkedin} target="_blank" rel="noopener" aria-label="Compartilhar no LinkedIn (abre em nova aba)">LinkedIn</a>
    <a class="pilula" href={whatsapp} target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp (abre em nova aba)">WhatsApp</a>
    <button type="button" class="pilula" data-nativo hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES.compartilhar} /><span class="no-largo">Mais opções</span
      ><span class="no-celular">Compartilhar</span>
    </button>
  </div>

  <aside class="aviso aviso-ia" data-aviso="atencao" aria-label="Aviso sobre IA">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.nota} />
    <p>
      Artigo escrito com apoio de IA, revisado pelo autor, com o código testado. Ainda assim pode conter imprecisões:
      confirme nas fontes citadas e na documentação oficial antes de aplicar.
    </p>
  </aside>

  <div class="fim-do-artigo">{livro && <LivroDoArtigo livro={livro} post={post} />}</div>
</footer>

<Vizinhos anterior={anterior} proximo={proximo} />

<script>
  import { mostrarCopiado } from "../scripts/copiado";

  const caixa = document.querySelector<HTMLElement>("[data-compartilhar]");
  if (caixa) {
    const { titulo = "", endereco = location.href } = caixa.dataset;
    const copiar = caixa.querySelector<HTMLButtonElement>("[data-copiar]");
    const nativo = caixa.querySelector<HTMLButtonElement>("[data-nativo]");

    if (copiar && navigator.clipboard) {
      const aviso = caixa.querySelector<HTMLElement>("[data-aviso-copiar]")!;
      copiar.hidden = false;
      copiar.addEventListener("click", async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(endereco);
        } catch {
          ok = false;
        }
        const texto = ok ? "Link copiado" : "Não deu para copiar";
        aviso.textContent = texto;
        mostrarCopiado(copiar, texto, "Copiar link", ok);
      });
    }

    if (nativo && typeof navigator.share === "function") {
      nativo.hidden = false;
      caixa.classList.add("com-nativo");
      nativo.addEventListener("click", () => navigator.share({ title: titulo, url: endereco }).catch(() => {}));
    }
  }
</script>

<style>
  .rodape-artigo {
    max-width: var(--coluna);
    margin-top: 2.6em;
    padding-top: 1.6em;
    border-top: 1px solid var(--rule);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  .compartilhar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
  }

  .no-celular {
    display: none;
  }

  /* No celular, com o compartilhar do sistema, fica só ele, com o nome "Compartilhar" (D38). */
  @media (max-width: 640px) {
    .compartilhar.com-nativo > :not([data-nativo]) {
      display: none;
    }

    .compartilhar.com-nativo .no-largo {
      display: none;
    }

    .compartilhar.com-nativo .no-celular {
      display: inline;
    }
  }

  /* No link, o decalque é os elos se juntando (copiado.css). */
  [data-copiar] {
    --decalque: scale(0.8);
  }

  .rotulo {
    margin-right: 4px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

  /* O parágrafo sem margem, para o ícone ficar na altura da primeira linha. */
  .aviso-ia {
    align-items: start;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .aviso-ia p {
    margin: 0;
  }

  .aviso-ia svg {
    margin-top: 1px;
  }

  /* A ficha "Do livro" do fim do artigo (LivroDoArtigo.astro) e o anterior e próximo (Vizinhos.astro). */
  .fim-do-artigo {
    margin-top: 36px;
  }
</style>
