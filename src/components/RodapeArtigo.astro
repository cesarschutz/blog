---
/**
 * Rodapé do post (briefing §5.3, D33), nesta ordem: tags; compartilhar (copiar link, LinkedIn,
 * WhatsApp e o compartilhar nativo quando existir); aviso sobre IA; o livro do artigo (o livro 3D da
 * categoria ou da série, em três quartos, que voa até a página do livro ao clicar) com o post-it das
 * frases ao lado; anterior e
 * próximo (ou dentro da série), com o título inteiro. O post-it daqui só aparece quando o do sumário
 * lateral não está à vista.
 */
import LivroEmPe from "./LivroEmPe.astro";
import PostIt from "./PostIt.astro";
import { ICONES } from "../lib/icones";
import { montarLivros } from "../lib/estante";
import { urlTag, type Resumo } from "../lib/posts";
import { tituloComQuebras } from "../lib/formato";
import type { Serie } from "../data/series";

interface Props {
  post: Resumo;
  endereco: string;
  anterior?: Resumo;
  proximo?: Resumo;
  naSerie?: Serie;
}

const { post, endereco, anterior, proximo, naSerie } = Astro.props;
const tituloCompleto = post.tituloCompleto;
const livros = await montarLivros();
const livro = post.serie
  ? livros.find((l) => l.id === `serie-${post.serie!.chave}`)
  : livros.find((l) => post.categoria && l.slug === post.categoria.slug);
const quantos = livro
  ? livro.serie
    ? `${livro.posts.length} ${livro.posts.length === 1 ? "edição" : "edições"}`
    : `${livro.posts.length} ${livro.posts.length === 1 ? "artigo" : "artigos"}`
  : "";
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(endereco)}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${tituloCompleto} ${endereco}`)}`;
const rotulos = naSerie
  ? { anterior: "Anterior na série", proximo: "Próxima na série" }
  : { anterior: "Artigo anterior", proximo: "Próximo artigo" };
---

<footer class="rodape-artigo">
  <ul class="tags" aria-label="Tags">
    {
      post.tags.map((t) => (
        <li>
          <a class="pilula" href={urlTag(t)}>
            #{t}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="compartilhar" data-compartilhar data-titulo={tituloCompleto} data-endereco={endereco}>
    <span class="rotulo">Compartilhar</span>
    <button type="button" class="pilula" data-copiar hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES.link} /><span>Copiar link</span>
    </button>
    <a class="pilula" href={linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a class="pilula" href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
    <button type="button" class="pilula" data-nativo hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES.compartilhar} /><span>Mais opções</span>
    </button>
  </div>

  <aside class="aviso aviso-ia" data-aviso="atencao" aria-label="Aviso sobre IA">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.atencao} />
    <p>
      Artigo escrito com apoio de IA, revisado pelo autor, com o código testado. Ainda assim pode conter imprecisões:
      confirme nas fontes citadas e na documentação oficial antes de aplicar.
    </p>
  </aside>

  <div class="fim-do-artigo">
    {
      livro && (
        <a class="livro-do-artigo" href={livro.href}>
          <span class="livro-3d-pequeno" aria-hidden="true">
            <LivroEmPe livro={livro} altura={150} transicao="ao-clicar" />
          </span>
          <span class="sobre-livro">
            <span class="rotulo-livro">{livro.serie ? "Da série" : "Do livro"}</span>
            <span class="nome-livro">{livro.nome}</span>
            <span class="dados-livro">
              {livro.serie ? "Série" : `Volume ${String(livro.volume).padStart(2, "0")}`} · {quantos}
            </span>
            <span class="ver-livro">
              {livro.serie ? "Ver a série" : "Ver o livro"}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
            </span>
          </span>
        </a>
      )
    }
    <PostIt chave={post.slug} giro={2.2} class="postit-fim" />
  </div>
</footer>

{
  (anterior || proximo) && (
    <nav class="vizinhos" aria-label={naSerie ? `Na série ${naSerie.nome}` : "Outros artigos"}>
      {anterior ? (
        <a href={anterior.url} rel="prev">
          <span class="dir">{rotulos.anterior}</span>
          <span class="nome" set:html={tituloComQuebras(anterior.tituloCompleto)} />
        </a>
      ) : (
        <span />
      )}
      {proximo && (
        <a href={proximo.url} rel="next" class="proximo">
          <span class="dir">{rotulos.proximo}</span>
          <span class="nome" set:html={tituloComQuebras(proximo.tituloCompleto)} />
        </a>
      )}
    </nav>
  )
}

<script>
  const caixa = document.querySelector<HTMLElement>("[data-compartilhar]");
  if (caixa) {
    const { titulo = "", endereco = location.href } = caixa.dataset;
    const copiar = caixa.querySelector<HTMLButtonElement>("[data-copiar]");
    const nativo = caixa.querySelector<HTMLButtonElement>("[data-nativo]");

    if (copiar && navigator.clipboard) {
      const texto = copiar.querySelector("span")!;
      copiar.hidden = false;
      copiar.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(endereco);
          texto.textContent = "Link copiado";
        } catch {
          texto.textContent = "Não deu para copiar";
        }
        setTimeout(() => (texto.textContent = "Copiar link"), 1600);
      });
    }

    if (nativo && typeof navigator.share === "function") {
      nativo.hidden = false;
      nativo.addEventListener("click", () => navigator.share({ title: titulo, url: endereco }).catch(() => {}));
    }
  }
</script>

<style>
  .rodape-artigo {
    max-width: var(--coluna);
    margin-top: 2.6em;
    padding-top: 1.6em;
    border-top: 1px solid var(--rule);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  .compartilhar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
  }

  .rotulo {
    margin-right: 4px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

  /* O parágrafo sem margem, para o ícone ficar na altura da primeira linha. */
  .aviso-ia {
    align-items: start;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .aviso-ia p {
    margin: 0;
  }

  .aviso-ia svg {
    margin-top: 1px;
  }

  /* ---------- o livro do artigo e o post-it ---------- */

  .fim-do-artigo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 36px;
    align-items: center;
    margin-top: 30px;
  }

  .livro-do-artigo {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 24px;
    border: 1px solid var(--rule);
    border-radius: var(--raio-painel);
    background: color-mix(in oklab, var(--well) 60%, var(--paper-hi));
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  /* O livro 3D em três quartos, como no topo da página do livro; ao passar o mouse, sobe um pouco. */
  .livro-3d-pequeno {
    flex: none;
    transition: transform 0.35s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .livro-do-artigo:hover {
    border-color: var(--acento);
  }

  .livro-do-artigo:hover .livro-3d-pequeno {
    transform: translateY(-4px) rotate(-1deg);
  }

  /* A coluna encolhe e o nome quebra com hífen: "Desenvolvimento" não cabe inteiro ao lado do livro em 375px. */
  .sobre-livro {
    display: grid;
    gap: 3px;
    min-width: 0;
    font-family: var(--font-ui);
  }

  .rotulo-livro {
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .nome-livro {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .dados-livro {
    font-size: 14px;
    color: var(--ink-2);
  }

  .ver-livro {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--acento);
  }

  .ver-livro svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.2s;
  }

  .livro-do-artigo:hover .ver-livro svg {
    translate: 3px 0;
  }

  .fim-do-artigo :global(.postit-fim) {
    margin: 4px 8px 8px 0;
  }

  /* Com o sumário lateral numa tela alta, o post-it já está ao lado dele. */
  @media (min-width: 1300px) and (min-height: 720px) {
    :global(.artigo-grade.com-sumario) .fim-do-artigo {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.artigo-grade.com-sumario) .fim-do-artigo :global(.postit-fim) {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .fim-do-artigo {
      grid-template-columns: minmax(0, 1fr);
    }

    .fim-do-artigo :global(.postit-fim) {
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .livro-3d-pequeno,
    .ver-livro svg {
      transition: none;
    }

    .livro-do-artigo:hover .livro-3d-pequeno {
      transform: none;
    }
  }

  .vizinhos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    max-width: var(--coluna);
    margin-top: 28px;
  }

  .vizinhos a {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: var(--raio-painel);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .vizinhos a:hover {
    border-color: var(--acento);
    background: color-mix(in oklab, var(--acento) 5%, transparent);
  }

  .vizinhos a:hover .nome {
    color: var(--acento);
  }

  .proximo {
    text-align: right;
  }

  .dir {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

  .nome {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
    transition: color 0.15s;
  }

  @media (max-width: 600px) {
    .vizinhos {
      grid-template-columns: 1fr;
    }

    .proximo {
      text-align: left;
    }
  }
</style>
