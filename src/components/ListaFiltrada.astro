---
/**
 * Página de lista com filtro por livro (D33): "Todos os artigos" (/archive/) e cada tag
 * (/tags/<Nome>/). No topo, numa folha, a trilha, o título, a descrição e o que a página quiser
 * acrescentar (slot); ao lado, a estante de filtro, só com os livros que têm artigos na página, cada
 * um com o número deles. Clicar num livro mostra só os artigos dele (a URL ganha ?livro=<slug>, para
 * compartilhar); clicar de novo, ou em "Ver todos", volta à lista inteira. Sem JS, o livro leva à
 * página dele. Embaixo, a contagem, o seletor Lista / Cards e os artigos no formato da home (D27),
 * agrupados por ano quando `porAno` (os ids #y2026 vêm do blog atual).
 */
import Cartao from "./Cartao.astro";
import Estante from "./Estante.astro";
import ItemLista from "./ItemLista.astro";
import SeletorModo from "./SeletorModo.astro";
import { montarLivros } from "../lib/estante";
import type { Resumo } from "../lib/posts";

interface Props {
  posts: Resumo[];
  titulo: string;
  descricao: string;
  trilha?: { nome: string; href: string };
  porAno?: boolean;
}

const { posts, titulo, descricao, trilha, porAno = false } = Astro.props;
// Os livros com artigos nesta página, com o número deles aqui (é o que a lombada mostra).
const livros = (await montarLivros())
  .map((l) => ({ ...l, posts: posts.filter((p) => p.livro === l.id) }))
  .filter((l) => l.posts.length > 0);
const plural = (n: number) => `${n} ${n === 1 ? "artigo" : "artigos"}`;
const grupos = porAno
  ? [...new Set(posts.map((p) => p.publicado.getUTCFullYear()))].map((ano) => ({
      ano,
      posts: posts.filter((p) => p.publicado.getUTCFullYear() === ano),
    }))
  : [{ ano: undefined, posts }];
const nivelDoItem = porAno ? "h3" : "h2";
---

<div class="folha topo-filtrado">
  <header class="texto-topo">
    {trilha && <a class="trilha" href={trilha.href}>{trilha.nome}</a>}
    <h1>{titulo}</h1>
    <p class="descricao">{descricao}</p>
    <slot />
  </header>
  {
    livros.length > 0 && (
      <div class="lado-estante">
        <Estante livros={livros} modo="filtro" />
        <p class="dica">Clique num livro para ver só os artigos dele.</p>
      </div>
    )
  }
</div>

<section class="lista-filtrada" aria-label="Artigos" data-lista-filtrada>
  <div class="barra-lista">
    <p class="status" aria-live="polite" data-status data-total={posts.length}>{plural(posts.length)}</p>
    <button type="button" class="pilula limpar" data-limpar hidden>Ver todos</button>
    <SeletorModo />
  </div>
  {
    grupos.map((g) => (
      <section class="grupo" data-grupo aria-labelledby={g.ano ? `y${g.ano}` : undefined}>
        {g.ano && (
          <h2 id={`y${g.ano}`} class="ano">
            <span>{g.ano}</span>
            <small data-contagem>{plural(g.posts.length)}</small>
          </h2>
        )}
        <ol class="lista-modo lista-artigos folha">
          {g.posts.map((p) => (
            <ItemLista post={p} nivel={nivelDoItem} />
          ))}
        </ol>
        <ul class="cartoes-modo">
          {g.posts.map((p) => (
            <Cartao post={p} />
          ))}
        </ul>
      </section>
    ))
  }
</section>

<script>
  import { tocarToque } from "../scripts/som";

  const lista = document.querySelector<HTMLElement>("[data-lista-filtrada]");
  const estante = document.querySelector<HTMLElement>("[data-estante-filtro]");
  if (lista && estante) {
    const livros = [...estante.querySelectorAll<HTMLAnchorElement>("[data-filtro]")];
    const itens = [...lista.querySelectorAll<HTMLElement>("[data-livro]")];
    const grupos = [...lista.querySelectorAll<HTMLElement>("[data-grupo]")];
    const status = lista.querySelector<HTMLElement>("[data-status]")!;
    const limpar = lista.querySelector<HTMLButtonElement>("[data-limpar]")!;
    const total = Number(status.dataset.total);
    const plural = (n: number) => `${n} ${n === 1 ? "artigo" : "artigos"}`;
    // O nome do livro vem do rótulo da lombada ("Mostrar só o livro X (N artigos)").
    const nome = (a: HTMLAnchorElement) => a.getAttribute("aria-label")!.replace(/^Mostrar só (o livro|a série) | \(.*\)$/g, "");
    let atual = "";

    function aplicar(id: string) {
      atual = id;
      for (const item of itens) item.hidden = Boolean(id) && item.dataset.livro !== id;
      for (const grupo of grupos) {
        const n = grupo.querySelectorAll(".lista-modo > [data-livro]:not([hidden])").length;
        grupo.hidden = n === 0;
        const contagem = grupo.querySelector("[data-contagem]");
        if (contagem) contagem.textContent = plural(n);
      }
      for (const livro of livros) {
        if (livro.dataset.filtro === id) livro.setAttribute("aria-current", "true");
        else livro.removeAttribute("aria-current");
      }
      estante!.classList.toggle("filtrando", Boolean(id));
      const escolhido = livros.find((l) => l.dataset.filtro === id);
      const n = itens.filter((i) => !i.hidden && i.matches(".lista-modo > *")).length;
      status.textContent = escolhido ? `${plural(n)} em ${nome(escolhido)}` : plural(total);
      limpar.hidden = !escolhido;
      const endereco = new URL(location.href);
      if (escolhido) endereco.searchParams.set("livro", id.replace(/^(livro|serie)-/, ""));
      else endereco.searchParams.delete("livro");
      history.replaceState(history.state, "", endereco);
    }

    livros.forEach((livro, i) => {
      livro.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        aplicar(atual === livro.dataset.filtro ? "" : livro.dataset.filtro!);
      });
      livro.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") tocarToque(livros.length > 1 ? i / (livros.length - 1) : 0.5);
      });
    });
    limpar.addEventListener("click", () => aplicar(""));

    const pedido = new URL(location.href).searchParams.get("livro");
    const inicial = pedido && livros.find((l) => l.dataset.filtro!.replace(/^(livro|serie)-/, "") === pedido);
    if (inicial) aplicar(inicial.dataset.filtro!);
  }
</script>

<style>
  /* ---------- topo ---------- */

  .topo-filtrado {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: center;
    margin-top: 26px;
    padding: 30px 40px 26px;
  }

  .trilha {
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .trilha:hover {
    color: var(--acento);
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.012em;
    overflow-wrap: anywhere;
  }

  .descricao {
    max-width: 52ch;
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .lado-estante {
    display: grid;
    justify-items: end;
    gap: 10px;
    min-width: 0;
  }

  .dica {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-2);
  }

  /* ---------- barra e grupos ---------- */

  .lista-filtrada {
    margin-top: 30px;
  }

  .barra-lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 18px;
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--ink-2);
  }

  .limpar {
    min-height: 32px;
    padding: 3px 12px;
  }

  .barra-lista :global(.modo) {
    margin-left: auto;
  }

  .grupo[hidden] {
    display: none;
  }

  .grupo + .grupo {
    margin-top: 40px;
  }

  /* O ano: o número grande, a contagem ao lado e um fio até o fim da linha. */
  .ano {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 16px;
    font-size: clamp(28px, 3vw, 36px);
    font-variant-numeric: lining-nums;
  }

  .ano::after {
    content: "";
    flex: 1;
    align-self: center;
    height: 1px;
    background: var(--rule);
  }

  .ano small {
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 15px;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .topo-filtrado {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 22px 20px;
    }

    .lado-estante {
      justify-items: start;
    }
  }
</style>
