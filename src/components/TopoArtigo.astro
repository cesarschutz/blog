---
/**
 * Topo do artigo (briefing §5.3), numa folha (D26): a ilustração antes do título, no painel tingido
 * que encosta nas bordas da folha (recorte largo, com anotações, no computador; 3:2 no celular),
 * depois a trilha "Artigos › Categoria" (ou "Séries › Nome"), o título inteiro e a descrição, como no
 * blog atual (D33), e a assinatura: a foto e o nome do autor, a data com o calendário, "Atualizado
 * em" quando houver e o tempo de leitura com o relógio. No canto de baixo, bem clarinho, o desenho da
 * capa do livro do artigo, como marca d'água (a xícara, na série do Java).
 */
import Chip from "./Chip.astro";
import DataLeitura from "./DataLeitura.astro";
import Ilustracao from "./Ilustracao.astro";
import { AUTOR } from "../data/site";
import { temIlustracao } from "../lib/ilustracoes";
import { desenhoDaCapa, iconeDoLivro, temDesenho } from "../lib/livros-svg";
import { mdEmLinha, tituloComQuebras } from "../lib/formato";
import { url } from "../lib/url";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
const raiz = post.serie ? { nome: "Séries", href: url("/series/") } : { nome: "Artigos", href: url("/archive/") };
const marcaDagua = post.serie
  ? iconeDoLivro(post.serie.emblema)
  : post.categoria && temDesenho(post.categoria.slug)
    ? desenhoDaCapa(post.categoria.slug)
    : undefined;
---

<div class="folha topo-folha">
  {
    temIlustracao(post.slug) && (
      <figure class="ilustracao-topo painel" data-pagefind-ignore style={`--cor:${post.cor}`}>
        <div class="largo">
          <Ilustracao slug={post.slug} recorte="largo" cor={post.cor} anotacoes />
        </div>
        <div class="medio">
          <Ilustracao slug={post.slug} recorte="medio" cor={post.cor} />
        </div>
      </figure>
    )
  }
  <header class="topo">
    {marcaDagua && <span class:list={["marca-dagua", { emblema: post.serie }]} aria-hidden="true" set:html={marcaDagua} />}
    <nav class="trilha" aria-label="Trilha" data-pagefind-ignore>
      <a href={raiz.href}>{raiz.nome}</a>
      <span aria-hidden="true">›</span>
      <Chip cor={post.cor} nome={post.rotulo} href={post.urlRotulo} />
    </nav>
    <h1 data-pagefind-meta="title" tabindex="-1" set:html={tituloComQuebras(post.tituloCompleto)} />
    <p class="lede" set:html={mdEmLinha(post.descricao)} />
    <div class="assinatura" data-pagefind-ignore>
      <span class="autor">
        <img class="foto" src={url(AUTOR.foto)} alt="" width="32" height="32" decoding="async" />
        {AUTOR.nome}
      </span>
      <DataLeitura data={post.publicado} atualizado={post.atualizado} minutos={post.minutos} longo />
    </div>
  </header>
</div>

<style>
  .topo-folha {
    overflow: hidden;
  }

  /* O painel ocupa o alto da folha; o canto arredondado vem dela. */
  .ilustracao-topo {
    margin: 0;
    border-radius: 0;
  }

  /* Com o site em até 1320px, o painel ocupa a folha toda e o desenho fica em até 1100px, no centro. */
  .largo {
    max-width: 1100px;
    margin-inline: auto;
    aspect-ratio: 1100 / 468;
  }

  .medio {
    display: none;
    aspect-ratio: 3 / 2;
  }

  @media (max-width: 600px) {
    .largo {
      display: none;
    }

    .medio {
      display: block;
    }
  }

  .topo {
    position: relative;
    max-width: calc(var(--coluna) + 184px);
    margin-inline: auto;
    padding: 32px 32px 30px;
  }

  /*
   * Marca d'água: o desenho da capa do livro, na cor dele, quase apagado, no canto de baixo da folha,
   * cortado pela borda. Fica atrás do texto (z-index) e some da leitura de tela.
   */
  .marca-dagua {
    position: absolute;
    z-index: 0;
    right: -250px;
    bottom: -64px;
    width: 400px;
    height: 350px;
    color: color-mix(in oklab, var(--cor), #fff var(--branco-no-escuro));
    opacity: 0.1;
    pointer-events: none;
  }

  .marca-dagua.emblema {
    right: -190px;
    bottom: -34px;
    width: 240px;
    height: 260px;
  }

  .marca-dagua :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .marca-dagua :global(:is(path, circle)) {
    vector-effect: non-scaling-stroke;
  }

  .marca-dagua :global(:is(.cz-ln, .cz-gh, .cz-ghs)) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .marca-dagua :global(.cz-w3) {
    stroke-width: 0.8px;
  }

  .marca-dagua :global(.cz-gh) {
    stroke-dasharray: 2px 5px;
  }

  .marca-dagua :global(.cz-fi) {
    fill: currentColor;
    stroke: none;
  }

  .topo > :not(.marca-dagua) {
    position: relative;
    z-index: 1;
  }

  .trilha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  /* Só o link da raiz: o chip é de outro componente e tem a própria cor. */
  .trilha a {
    color: var(--ink-2);
  }

  .trilha a:hover {
    color: var(--acento);
  }

  h1 {
    margin: 14px 0 0;
    font-size: clamp(32px, 4.3vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }

  /*
   * No celular, o título encolhe com a tela: com o travessão preso à palavra seguinte (D39), o pedaço
   * mais longo ("— desembrulhando") precisa caber numa linha sem quebrar no meio da palavra.
   */
  @media (max-width: 640px) {
    h1 {
      font-size: clamp(24px, 7.6vw, 32px);
    }
  }

  .lede {
    max-width: 66ch;
    margin: 16px 0 0;
    font-family: var(--font-ui);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .lede :global(code) {
    font-size: 0.86em;
  }

  /* A assinatura, como no blog atual: um fio em cima, a foto e o nome, a data e o tempo. */
  .assinatura {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .autor {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    color: var(--ink);
  }

  .foto {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--well);
    box-shadow: 0 0 0 1px var(--rule);
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .topo {
      padding: 22px 20px 24px;
    }

    .assinatura {
      gap: 8px 14px;
      font-size: 13.5px;
    }

    .marca-dagua {
      right: -200px;
      width: 320px;
      height: 280px;
    }
  }
</style>
