---
/**
 * A abertura do site (D51, protótipos 01 e 02 de docs/prototipos/animacoes): toca ao chegar de fora
 * (link de outro site, endereço digitado, favorito) e ao recarregar, sem movimento reduzido. Quem decide
 * é o script do <head> (Base.astro), antes da primeira pintura: ele põe `data-abertura` no <html> ("estante"
 * ou "caderno") e o tira sozinho depois de 7s, por segurança, se este script não assumir. Andando por
 * dentro do site, vale a troca de página (troca.js).
 *
 * - Na home, a estante se monta (A3): uma folha de papel cobre a página, a caneta risca um fio onde vai
 *   ficar a tábua, o fio engrossa e vira a tábua, e a coleção é posta nela, livro a livro, da esquerda
 *   para a direita (cada um entra pela direita, desliza até encostar no anterior, inclinado pelo atrito,
 *   e assenta), com a contagem da coleção embaixo ("Volume 01"… "E a revista"). A estante é a de
 *   verdade, levantada por cima do papel. Montada, ela volta para a folha da abertura e o papel esmaece.
 * - Nas outras páginas, o caderno "cs" carrega (a caneta escreve o fio, contando até 100), abre e fecha
 *   (contracapa, miolo pautado e capa com frente e verso, no papel dos livros, igual nos dois temas) e
 *   pousa na marca do cabeçalho; o papel esmaece e as folhas da página chegam do fundo, como na troca de
 *   página (em Categorias, com o desfile e a pilha da página).
 *
 * Até o script montar a cena, o CSS esconde as peças dela e os livros da estante (sem isso, a estante
 * pronta e o caderno grande no canto apareciam por um instante). Um clique ou uma tecla pulam para o
 * fim, também durante o carregamento. Tudo por transformações e opacidade; a página continua inteira no
 * HTML por baixo (leitor de tela e busca não percebem a abertura).
 */
import { MARCA_SVG, MARCA_VIEWBOX } from "../lib/marca";

interface Props {
  modo: "estante" | "caderno";
}

const { modo } = Astro.props;
const CANETA = `<path class="corpo" d="M8.2 13.2 17.4 4a1.4 1.4 0 0 1 2 0l.6.6a1.4 1.4 0 0 1 0 2l-9.2 9.2Z"/><path class="anel" d="m15.6 5.8 2.6 2.6"/><path class="ponta" d="M8.2 13.2 10.8 15.8 4 20Z"/>`;
---

<div class="abertura-site" aria-hidden="true" data-abertura-site data-modo={modo}>
  <div class="abertura-papel"></div>
  {
    modo === "caderno" && (
      <div class="abertura-caderno">
        <span class="caderno-contra" />
        <span class="caderno-miolo"><i /><i /><i /><i /><i /></span>
        <div class="caderno-capa">
          <svg class="capa-frente" viewBox={MARCA_VIEWBOX} focusable="false" set:html={MARCA_SVG} />
          <span class="capa-verso" />
        </div>
      </div>
    )
  }
  <div class="abertura-fio">
    <svg class="fio" preserveAspectRatio="none" focusable="false"><path class="fio-tinta"></path></svg>
    <svg class="abertura-caneta" viewBox="0 0 24 24" focusable="false" set:html={CANETA} />
  </div>
  <p class="abertura-conta">{modo === "estante" ? "Volume 01" : "0"}</p>
</div>

<script>
  import { carregarTraco, type GSAP } from "../scripts/gsap";

  type Troca = {
    unidades: () => { el: HTMLElement; texto: boolean }[];
    chegar: (novas: { el: HTMLElement; texto: boolean }[], opcoes?: { t0?: number }) => number;
  };
  /** O que a cena compartilha com cada modo: o pular e o fim. */
  type Controle = { pulou: () => boolean; pulado: Promise<void>; fim: () => void };

  const raiz = document.documentElement;
  const cena = document.querySelector<HTMLElement>("[data-abertura-site]");
  const modo = raiz.dataset.abertura;
  if (cena && (modo === "estante" || modo === "caderno")) void abrir(cena, modo);
  else cena?.remove();

  const esperar = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  async function abrir(cena: HTMLElement, modo: "estante" | "caderno") {
    // A abertura começa do alto da página (ao recarregar, o navegador devolveria o lugar de antes).
    const rolagem = history.scrollRestoration;
    history.scrollRestoration = "manual";
    scrollTo(0, 0);

    let tl: gsap.core.Timeline | null = null;
    let pulou = false;
    let avisarPulo = () => {};
    const pulado = new Promise<void>((r) => (avisarPulo = r));
    const pular = () => {
      pulou = true;
      avisarPulo();
      tl?.progress(1);
    };
    cena.addEventListener("pointerdown", pular);
    const tecla = (e: KeyboardEvent) => { if (!e.metaKey && !e.ctrlKey && e.key !== "Tab") pular(); };
    addEventListener("keydown", tecla);
    let terminou = false;
    const fim = () => {
      if (terminou) return;
      terminou = true;
      removeEventListener("keydown", tecla);
      history.scrollRestoration = rolagem;
      delete raiz.dataset.abertura;
      cena.remove();
      dispatchEvent(new CustomEvent("cs:aberto"));
    };

    try {
      const gsap = await carregarTraco();
      // Daqui em diante, quem termina a abertura é este script (a trava de 7s do <head> sai).
      clearTimeout((window as unknown as { csTravaDaAbertura?: number }).csTravaDaAbertura);
      const controle: Controle = { pulou: () => pulou, pulado, fim };
      // A timeline vem dentro de um objeto: ela é "thenable", e devolvê-la direto de uma função async
      // faria o await esperar a abertura inteira (e o clique não pularia nada).
      const r = modo === "estante" ? await estante(gsap, cena, controle) : await caderno(gsap, cena, controle);
      tl = r.tl;
      if (!tl) return fim();
      if (pulou) tl.progress(1);
    } catch {
      // Sem o GSAP (rede, bloqueio), a página aparece como está.
      fim();
    }
  }

  /** O fio, com o caminho em pixels (sem vector-effect: com ele, o DrawSVG media numa escala e o
   *  navegador pintava noutra, e o risco saía em três pedaços). */
  function montarFio(gsap: GSAP, cena: HTMLElement, x: number, y: number, w: number) {
    const fio = cena.querySelector<HTMLElement>(".abertura-fio")!;
    const svg = cena.querySelector<SVGSVGElement>(".fio")!;
    const tinta = cena.querySelector<SVGPathElement>(".fio-tinta")!;
    const caneta = cena.querySelector<SVGElement>(".abertura-caneta")!;
    svg.setAttribute("viewBox", `0 0 ${w} 8`);
    tinta.setAttribute("d", `M1 4.3C${w * 0.17} 3.5 ${w * 0.35} 4.9 ${w * 0.5} 4.1S${w * 0.82} 3.6 ${w - 1} 4.3`);
    gsap.set(fio, { left: x, top: y - 4, width: w });
    gsap.set(tinta, { drawSVG: "0%" });
    const L = tinta.getTotalLength();
    return (v: number) => {
      gsap.set(tinta, { drawSVG: `0% ${v * 100}%` });
      const p = tinta.getPointAtLength(v * L);
      gsap.set(caneta, { x: p.x, y: p.y - 4 });
    };
  }

  /* ---------- A3: a estante se monta (home) ---------- */
  async function estante(gsap: GSAP, cena: HTMLElement, { fim }: Controle) {
    const prat = document.querySelector<HTMLElement>("[data-estante]");
    if (!prat) return { tl: null };
    const { CustomEase } = await import("gsap/CustomEase");
    gsap.registerPlugin(CustomEase);
    // O livro inclina pelo atrito enquanto desliza e, ao parar, passa um pouco do prumo e assenta.
    const assenta = CustomEase.create("assenta", "M0,0 C0.2,0 0.35,1.22 0.55,1.1 0.7,1.02 0.82,0.98 1,1");
    await document.fonts.ready;
    const papel = cena.querySelector<HTMLElement>(".abertura-papel")!;
    const conta = cena.querySelector<HTMLElement>(".abertura-conta")!;
    const celular = matchMedia("(max-width: 640px)").matches;
    const W = innerWidth, H = innerHeight;
    const soLivros = [...prat.querySelectorAll<HTMLElement>(".prateleira-livros > .lombada")];
    const aparador = prat.querySelector<HTMLElement>(".prateleira-livros > .aparador");
    const tabua = prat.querySelector<HTMLElement>(".tabua")!;
    const r = prat.getBoundingClientRect();
    // A estante de verdade vai para o meio da tela, maior (é ela que volta ao lugar no fim).
    const s = Math.min(celular ? 1.05 : 1.4, (W * 0.84) / r.width, (H * 0.5) / r.height);
    gsap.set(prat, { x: W / 2 - (r.left + r.width / 2), y: H * 0.47 - (r.top + r.height / 2), scale: s, transformOrigin: "50% 50%" });
    const rt = tabua.getBoundingClientRect();
    const pintar = montarFio(gsap, cena, rt.left, rt.top + rt.height / 2, rt.width);
    gsap.set(conta, { top: rt.bottom + 26, opacity: 0 });
    const p = { v: 0 };
    pintar(0);
    cena.dataset.pronto = "";

    const tl = gsap.timeline({
      onComplete: () => {
        // No mesmo instante em que o CSS da abertura sai (os livros estão escondidos por ele até aqui).
        gsap.set([prat, ...soLivros, tabua, ...(aparador ? [aparador] : [])], { clearProps: "transform,opacity" });
        fim();
      },
    });
    // 1. a caneta risca o fio (é o carregamento); o fio engrossa e vira a tábua
    tl.to(p, { v: 1, duration: celular ? 0.4 : 0.55, ease: "power1.inOut", onUpdate: () => pintar(p.v) }, 0.15)
      .to(".abertura-caneta", { y: "-=10", rotation: 16, opacity: 0, duration: 0.25, ease: "power2.in" })
      .to(tabua, { opacity: 1, duration: 0.2 }, "<")
      .fromTo(tabua, { scaleY: 0.15 }, { scaleY: 1, duration: 0.3, ease: "power2.out", transformOrigin: "50% 50%" }, "<")
      .to(".abertura-fio", { opacity: 0, duration: 0.2 }, "<");
    // 2. a coleção é posta na prateleira, um livro por vez, deslizando até o vizinho
    const t0 = tl.duration() - 0.1;
    const passo = celular ? 0.065 : 0.075, dur = celular ? 0.5 : 0.55;
    // A contagem aparece com o primeiro livro, e não com a tábua vazia.
    tl.to(conta, { opacity: 1, duration: 0.2 }, t0 + 0.05);
    // Da esquerda para a direita (Volume 01 primeiro): cada um entra pela direita, desliza pela tábua
    // vazia até encostar no anterior, que sente o baque; o livro inclinado assenta no giro dele.
    soLivros.forEach((b, i) => {
      const rb = b.getBoundingClientRect();
      const x0 = Number(gsap.getProperty(b, "x")) || 0;
      const r0 = Number(gsap.getProperty(b, "rotation")) || 0;
      const fora = x0 + (W - rb.left) / s + 24;
      const t = t0 + i * passo;
      const revista = b.classList.contains("de-serie");
      const rotulo = revista ? "E a revista" : `Volume ${String(i + 1).padStart(2, "0")}`;
      tl.set(b, { opacity: 1 }, t)
        .fromTo(b, { x: fora }, { x: x0, duration: dur, ease: "power3.out" }, t)
        .fromTo(b, { rotation: r0 - 3.5 }, { rotation: r0, duration: dur, ease: assenta, transformOrigin: "50% 100%" }, t)
        .call(() => { conta.textContent = rotulo; }, undefined, t + 0.12);
      // O aparador só aparece quando a revista está chegando nele.
      if (revista && aparador) tl.to(aparador, { opacity: 1, duration: 0.2 }, t + dur * 0.6);
      if (i > 0) tl.to(soLivros[i - 1], { xPercent: -3, duration: 0.07, yoyo: true, repeat: 1, ease: "power1.out" }, t + dur * 0.6);
    });
    // 3. a estante volta para a folha da abertura; o papel se desfaz em volta depois que ela já passou
    //    pelo título (senão, ela cruzava o nome meio esmaecido)
    const t1 = t0 + (soLivros.length - 1) * passo + dur + 0.05;
    tl.to(conta, { opacity: 0, duration: 0.2 }, t1 - 0.05)
      .to(prat, { x: 0, y: 0, scale: 1, duration: celular ? 0.8 : 0.95, ease: "power3.inOut" }, t1)
      .to(papel, { opacity: 0, duration: 0.45, ease: "power1.inOut" }, t1 + 0.5);
    return { tl };
  }

  /* ---------- 02: o caderno carrega, abre e fecha e pousa no cabeçalho (outras páginas) ---------- */
  async function caderno(gsap: GSAP, cena: HTMLElement, { pulou, pulado, fim }: Controle) {
    const papel = cena.querySelector<HTMLElement>(".abertura-papel")!;
    const fio = cena.querySelector<HTMLElement>(".abertura-fio")!;
    const caneta = cena.querySelector<SVGElement>(".abertura-caneta")!;
    const conta = cena.querySelector<HTMLElement>(".abertura-conta")!;
    const livro = cena.querySelector<HTMLElement>(".abertura-caderno")!;
    const contra = cena.querySelector<HTMLElement>(".caderno-contra")!;
    const capa = cena.querySelector<HTMLElement>(".caderno-capa")!;
    const W = innerWidth, H = innerHeight;
    const lw = Math.min(96, Math.max(72, H * 0.12)), lh = (lw * 52) / 40;
    const cx = W / 2, cy = H * 0.42;
    gsap.set(livro, { left: cx - lw / 2, top: cy - lh / 2, width: lw, height: lh, opacity: 0, scale: 0.92 });
    const w = Math.min(240, W * 0.6);
    const pintar = montarFio(gsap, cena, cx - w / 2, cy + lh / 2 + 38, w);
    gsap.set(conta, { top: cy + lh / 2 + 58 });
    const p = { v: 0 };
    const escrever = () => { pintar(p.v); conta.textContent = String(Math.round(p.v * 100)); };
    escrever();
    cena.dataset.pronto = "";

    // 1. o caderno aparece e a caneta escreve o fio (o carregamento), contando até 100
    const pronto = Promise.all([document.fonts.ready, document.readyState === "complete" ? null : new Promise((r) => addEventListener("load", r, { once: true }))]);
    const carga = gsap.timeline()
      .to(livro, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.out" }, 0)
      .to(p, { v: 0.85, duration: 0.55, ease: "power1.inOut", onUpdate: escrever }, 0.12);
    await Promise.race([Promise.all([carga.then(), Promise.race([pronto, esperar(2200)])]), pulado]);
    if (pulou()) carga.progress(1);
    else await gsap.to(p, { v: 1, duration: 0.15, ease: "power2.out", onUpdate: escrever }).then();

    const marca = document.querySelector<HTMLElement>(".cabecalho .marca-livro-3d");
    const rm = marca?.getBoundingClientRect();
    const troca = (window as unknown as { csTroca?: Troca }).csTroca;
    const propria = document.getElementById("conteudo")?.dataset.chegada === "propria";
    const tl = gsap.timeline({ onComplete: fim });
    // 2. o caderno abre e fecha (a capa gira pela lombada, com peso) e o fio sai
    tl.to(caneta, { y: "-=10", rotation: 16, opacity: 0, duration: 0.22, ease: "power2.in" }, 0)
      .to([fio, conta], { opacity: 0, duration: 0.25 }, 0.1)
      .to(capa, { rotationY: -150, duration: 0.36, ease: "power2.out", transformOrigin: "0% 50%" }, 0.05)
      .to(capa, { rotationY: 0, duration: 0.3, ease: "power2.in" }, 0.46)
      .to(livro, { scale: 0.97, duration: 0.06, ease: "power1.out", yoyo: true, repeat: 1 }, 0.76);
    // 3. ele pousa na marca do cabeçalho (a sombra some no caminho, como a da marca, chapada), o papel sai
    //    e as folhas da página chegam do fundo
    const t3 = 0.85;
    if (marca && rm && rm.width > 0) {
      tl.to(livro, { x: rm.left + rm.width / 2 - cx, y: rm.top + rm.height / 2 - cy, scale: rm.height / lh, duration: 0.6, ease: "power2.inOut" }, t3)
        .to(contra, { boxShadow: "0 0 0 0 rgb(0 0 0 / 0)", duration: 0.5 }, t3)
        .call(() => raiz.classList.add("caderno-pousou"), undefined, t3 + 0.6)
        .set(livro, { opacity: 0 }, t3 + 0.6);
    } else tl.to(livro, { opacity: 0, duration: 0.3 }, t3);
    tl.to(papel, { opacity: 0, duration: 0.45, ease: "power1.inOut" }, t3 + 0.1)
      .call(() => {
        if (propria) dispatchEvent(new CustomEvent("cs:abertura-chega"));
        else if (troca) {
          // Quando a última folha pousa, o desenho do artigo pode se desenhar (desenho-vivo.ts).
          const pousa = troca.chegar(troca.unidades(), { t0: 0 });
          setTimeout(() => dispatchEvent(new CustomEvent("cs:chegou")), pousa);
        }
      }, undefined, t3 + 0.08);
    return { tl };
  }
</script>

<style>
  .abertura-site {
    display: none;
  }

  /* Só com a abertura ligada (script do <head>): por cima de tudo, a página não rola. */
  :global(:root[data-abertura]) {
    overflow: hidden;
  }

  /* As transições do CSS atrapalham o GSAP a ler o estado final: durante a abertura, só ele anima. */
  :global(:root[data-abertura] *) {
    transition: none !important;
  }

  :global(:root[data-abertura]) .abertura-site {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    cursor: pointer;
  }

  /* Até o script montar a cena, as peças dela esperam escondidas (a posição vem dele). */
  .abertura-site:not([data-pronto]) :is(.abertura-fio, .abertura-conta, .abertura-caderno) {
    visibility: hidden;
  }

  /* Na home, a estante de verdade fica por cima do papel enquanto se monta (A3); os livros e a tábua
     esperam escondidos, e o script os mostra um a um. */
  :global(:root[data-abertura="estante"] [data-estante]) {
    position: relative;
    z-index: 101;
  }

  :global(:root[data-abertura="estante"] [data-estante] :is(.prateleira-livros > *, .tabua)) {
    opacity: 0;
  }

  /* O caderno pousa na marca do cabeçalho: até lá, a marca espera. */
  :global(:root[data-abertura="caderno"]:not(.caderno-pousou) .cabecalho .marca-livro-3d) {
    visibility: hidden;
  }

  .abertura-papel {
    position: absolute;
    inset: 0;
    background: var(--paper);
  }

  .abertura-fio {
    position: absolute;
    left: 0;
    top: 0;
    height: 8px;
  }

  .fio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fio-tinta {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* Na estante, o fio já tem a cor da borda da tábua em que ele vai virar (no escuro, não troca de cor). */
  [data-modo="estante"] .fio-tinta {
    stroke: var(--tabua-borda);
    stroke-width: 2;
  }

  /* A caneta da leitura (D45): a ponta (4, 20 no desenho de 24) encosta no fim do fio. */
  .abertura-caneta {
    position: absolute;
    left: -3.7px;
    top: -14.3px;
    width: 22px;
    height: 22px;
    overflow: visible;
  }

  .abertura-caneta :global(.corpo) {
    fill: var(--paper-hi);
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .abertura-caneta :global(.anel) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }

  .abertura-caneta :global(.ponta) {
    fill: var(--marca);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  /* A contagem: na estante, a da coleção, na tipografia dos livros; no caderno, até 100. */
  .abertura-conta {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  [data-modo="estante"] .abertura-conta {
    font: 700 13.5px/1 var(--font-livro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  [data-modo="caderno"] .abertura-conta {
    font: 500 12.5px/1 var(--font-codigo);
  }

  /*
   * O caderno "cs" (como o do protótipo 02): a contracapa, um pouco mais escura, com a sombra; o miolo
   * pautado, recuado; e a capa, presa pela lombada, com a marca na frente e o lado de dentro liso atrás.
   * No papel dos livros (--marca-letra), igual nos dois temas, como os livros (D39).
   */
  .abertura-caderno {
    position: absolute;
    perspective: 520px;
  }

  .caderno-contra,
  .caderno-miolo,
  .caderno-capa {
    position: absolute;
    inset: 0;
  }

  .caderno-contra {
    border-radius: 7.5% / 5.8%;
    background: color-mix(in oklab, var(--marca), black 18%);
    box-shadow: 0 14px 22px -12px rgb(0 0 0 / 0.45);
  }

  .caderno-miolo {
    inset: 4% 4% 4% 8%;
    display: grid;
    align-content: start;
    gap: 9%;
    padding: 20% 12% 0;
    border-radius: 2px 5px 5px 2px;
    background: var(--marca-letra);
    box-shadow: inset 3px 0 4px -2px rgb(0 0 0 / 0.25);
  }

  .caderno-miolo i {
    height: 1px;
    background: color-mix(in oklab, var(--marca) 26%, transparent);
  }

  .caderno-capa {
    transform-style: preserve-3d;
  }

  .capa-frente,
  .capa-verso {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    backface-visibility: hidden;
  }

  .capa-verso {
    transform: rotateY(180deg);
    border-radius: 7.5% / 5.8%;
    background: color-mix(in oklab, var(--marca) 50%, var(--marca-letra));
  }

  .capa-frente :global(.marca-capa) {
    fill: var(--marca);
  }

  .capa-frente :global(.marca-dobra) {
    fill: black;
    opacity: 0.24;
  }

  .capa-frente :global(.marca-letras) {
    fill: var(--marca-letra);
  }
</style>
