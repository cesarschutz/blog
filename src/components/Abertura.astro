---
/**
 * A abertura do site (D51, protótipos 01 e 02 de docs/prototipos/animacoes): toca ao chegar de fora
 * (link de outro site, endereço digitado, favorito) e ao recarregar, sem movimento reduzido. Quem decide
 * é o script do <head> (Base.astro), antes da primeira pintura: ele põe `data-abertura` no <html> ("estante"
 * ou "caderno") e o tira sozinho depois de 7s, por segurança, se este script não assumir. Andando por
 * dentro do site, vale a troca de página (troca.js).
 *
 * - Na home (rodada 4, A1, E3 e E12: a sequência do 18, melhorada, com o nome do 20): uma folha de papel cobre
 *   a página; a caneta risca o fio da aresta da lâmina de vidro; a lâmina aparece; os livros chegam um a um
 *   pela direita, com a contagem embaixo ("Volume 01"… "Série"); quando eles param, os dois cadernos
 *   acenam; a fileira desce para o lugar, a página aparece em volta e o nome gigante entra da direita para a
 *   esquerda (uma frente desfocada; os números rodam quando ela passa por eles); a assinatura se escreve
 *   quando os cadernos fecham; e as luzes acendem uma a uma, seguidas só da onda de molas e, depois dela, só do
 *   brilho (~4,9s, `A1` abaixo). A fileira é a de verdade, levantada por cima do papel. Durante a abertura, a
 *   estante não responde ao mouse (B12, D52).
 * - Nas outras páginas, o caderno "cs" carrega (a caneta escreve o fio, contando até 100), abre e fecha
 *   (contracapa, miolo pautado e capa com frente e verso, no papel dos livros, igual nos dois temas) e
 *   voa em arco até a marca do cabeçalho, subindo por baixo dela, sobre a folha ainda limpa (revisão 14,
 *   D52); o papel esmaece em volta dele e as folhas da página chegam do fundo, como na troca de página
 *   (em Categorias, com o desfile e a pilha da página).
 *
 * Até o script montar a cena, o CSS esconde as peças dela e os livros da estante (sem isso, a estante
 * pronta e o caderno grande no canto apareciam por um instante). Um clique ou uma tecla pulam para o
 * fim, também durante o carregamento. Tudo por transformações e opacidade; a página continua inteira no
 * HTML por baixo (leitor de tela e busca não percebem a abertura).
 */
import { MARCA_SVG, MARCA_VIEWBOX } from "../lib/marca";
import { MIOLO_SVG } from "../lib/caderno";

interface Props {
  modo: "estante" | "caderno";
}

const { modo } = Astro.props;
const CANETA = `<path class="corpo" d="M8.2 13.2 17.4 4a1.4 1.4 0 0 1 2 0l.6.6a1.4 1.4 0 0 1 0 2l-9.2 9.2Z"/><path class="anel" d="m15.6 5.8 2.6 2.6"/><path class="ponta" d="M8.2 13.2 10.8 15.8 4 20Z"/>`;
---

<div class="abertura-site" aria-hidden="true" data-abertura-site data-modo={modo}>
  <div class="abertura-papel"></div>
  {
    modo === "caderno" && (
      <div class="abertura-caderno">
        <span class="caderno-contra" />
        <svg class="caderno-miolo" viewBox={MARCA_VIEWBOX} focusable="false" set:html={MIOLO_SVG} />
        <div class="caderno-capa">
          <svg class="capa-frente" viewBox={MARCA_VIEWBOX} focusable="false" set:html={MARCA_SVG} />
          <span class="capa-verso" />
        </div>
      </div>
    )
  }
  <div class="abertura-fio">
    <svg class="fio" preserveAspectRatio="none" focusable="false"><path class="fio-tinta"></path></svg>
    <svg class="abertura-caneta" viewBox="0 0 24 24" focusable="false" set:html={CANETA} />
  </div>
  <p class="abertura-conta">{modo === "estante" ? "Volume 01" : "0"}</p>
</div>

<script>
  import { carregarTraco, type GSAP } from "../scripts/gsap";

  type Troca = {
    unidades: () => { el: HTMLElement; texto: boolean }[];
    chegar: (novas: { el: HTMLElement; texto: boolean }[], opcoes?: { t0?: number }) => number;
  };
  /** O que a cena compartilha com cada modo: o pular e o fim. */
  type Controle = { pulou: () => boolean; pulado: Promise<void>; fim: () => void };

  const raiz = document.documentElement;
  const cena = document.querySelector<HTMLElement>("[data-abertura-site]");
  const modo = raiz.dataset.abertura;
  if (cena && (modo === "estante" || modo === "caderno")) void abrir(cena, modo);
  else {
    cena?.remove();
    // A home chegando pela troca de página: o aceno e a assinatura logo que ela chega (E12).
    if (raiz.hasAttribute("data-vai-chegar") && !matchMedia("(prefers-reduced-motion: reduce)").matches) acenoNaChegada();
  }

  const esperar = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  /**
   * Na home (rodada 4), o aviso do fim (`cs:aberto`) espera o nome começar a entrar: quem o ouve (os números
   * da página, que rodam 0,2s depois dele) não se adianta à frente de luz, e o quadro em que o CSS da abertura
   * sai (o mais pesado) fica sozinho.
   */
  let avisoDaHome: Promise<void> | null = null;
  /** Se a abertura já pôs as folhas da página para chegar (no fim do caderno). */
  let chegadaPedida = false;

  /**
   * Com #título na URL (um link para a seção, ou o recarregar em cima dela), a página vai até ele, que a
   * abertura começou do alto; se a pessoa já rolou, fica onde está. Vai antes de as folhas chegarem, ainda
   * embaixo do papel (e elas chegam dali): medido com as folhas em voo, o título caía longe (D54).
   */
  function irAoAlvo() {
    let alvo: HTMLElement | null = null;
    try {
      alvo = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    } catch {
      alvo = null;
    }
    if (alvo && scrollY === 0) alvo.scrollIntoView({ block: "start", behavior: "instant" });
  }

  async function abrir(cena: HTMLElement, modo: "estante" | "caderno") {
    // Daqui em diante, o pular é deste script (o do <head>, para quando ele ainda não tinha chegado, sai).
    (window as unknown as { csAberturaAssumiu?: boolean }).csAberturaAssumiu = true;
    // A abertura começa do alto da página (ao recarregar, o navegador devolveria o lugar de antes).
    const rolagem = history.scrollRestoration;
    history.scrollRestoration = "manual";
    scrollTo(0, 0);

    let tl: gsap.core.Timeline | null = null;
    let pulou = false;
    let avisarPulo = () => {};
    const pulado = new Promise<void>((r) => (avisarPulo = r));
    const pular = () => {
      pulou = true;
      avisarPulo();
      // Antes de a cena montar (o GSAP, as fontes e a curva ainda chegando), a página embaixo já está
      // pronta: termina na hora, em vez de esperar tudo chegar para então pular (D54).
      if (tl) tl.progress(1);
      else fim();
    };
    // O toque (ou o clique) que pula só pula: o clique que o navegador gera em seguida cairia no que está
    // embaixo da cena, que some na hora (abria o livro da gaveta, navegava), e é engolido (D54).
    cena.addEventListener("pointerdown", () => {
      const engolir = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
      };
      addEventListener("click", engolir, { capture: true, once: true });
      setTimeout(() => removeEventListener("click", engolir, { capture: true }), 700);
      pular();
    });
    // A tecla que pula também não rola a página (Espaço, PageDown, End, setas), D54.
    const ROLAM = new Set([" ", "PageDown", "PageUp", "End", "Home", "ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight"]);
    const tecla = (e: KeyboardEvent) => {
      if (e.metaKey || e.ctrlKey || e.key === "Tab") return;
      if (ROLAM.has(e.key)) e.preventDefault();
      pular();
    };
    addEventListener("keydown", tecla);
    // A roda do mouse também pula, como o dedo que começa a rolar no celular (D54).
    addEventListener("wheel", pular, { passive: true });
    // Girar a tela também: a cena foi medida na orientação de antes (D54).
    const retrato = matchMedia("(orientation: portrait)");
    retrato.addEventListener("change", pular);
    let terminou = false;
    const fim = () => {
      if (terminou) return;
      terminou = true;
      removeEventListener("keydown", tecla);
      removeEventListener("wheel", pular);
      retrato.removeEventListener("change", pular);
      history.scrollRestoration = rolagem;
      // Sem a cena (pulada antes de ela montar, ou sem o GSAP), a estante que o CSS da abertura escondia
      // aparece de uma vez: a trava das transições sai junto, e os livros apareciam esmaecendo (D54).
      if (!tl) {
        const pecas = [...document.querySelectorAll<HTMLElement>("[data-estante] :is(.prateleira-livros > *, .tabua, .nicho > *, .luzes-fileira)")];
        pecas.forEach((p) => (p.style.transition = "none"));
        requestAnimationFrame(() => requestAnimationFrame(() => pecas.forEach((p) => p.style.removeProperty("transition"))));
      }
      delete raiz.dataset.abertura;
      cena.remove();
      irAoAlvo();
      const avisar = () => {
        dispatchEvent(new CustomEvent("cs:aberto"));
        // Pulada antes de as folhas chegarem, a página já está no lugar: quem espera a chegada (o desenho do
        // topo do artigo) começa agora, e não pela reserva (D54).
        if (!chegadaPedida) dispatchEvent(new CustomEvent("cs:chegou"));
      };
      if (avisoDaHome && tl && !pulou) void avisoDaHome.then(avisar);
      else avisar();
    };

    try {
      const gsap = await carregarTraco();
      // Se o GSAP chegou depois da trava de 7s do <head>, a página já está à vista: a abertura não toca
      // mais por cima dela (D54).
      if (!raiz.dataset.abertura) return fim();
      const controle: Controle = { pulou: () => pulou, pulado, fim };
      // A timeline vem dentro de um objeto: ela é "thenable", e devolvê-la direto de uma função async
      // faria o await esperar a abertura inteira (e o clique não pularia nada).
      const r = modo === "estante" ? await estante(gsap, cena, controle) : await caderno(gsap, cena, controle);
      tl = r.tl;
      if (!tl) return fim();
      // Com a cena montada, quem termina a abertura é este script: a trava de 7s do <head> sai. Antes,
      // ela saía antes das esperas (a curva e as fontes), e com a fonte lenta o papel ficava 11s (D54).
      clearTimeout((window as unknown as { csTravaDaAbertura?: number }).csTravaDaAbertura);
      if (pulou) tl.progress(1);
    } catch {
      // Sem o GSAP (rede, bloqueio), a página aparece como está.
      fim();
    }
  }

  /** O fio, com o caminho em pixels (sem vector-effect: com ele, o DrawSVG media numa escala e o
   *  navegador pintava noutra, e o risco saía em três pedaços). */
  function montarFio(gsap: GSAP, cena: HTMLElement, x: number, y: number, w: number) {
    const fio = cena.querySelector<HTMLElement>(".abertura-fio")!;
    const svg = cena.querySelector<SVGSVGElement>(".fio")!;
    const tinta = cena.querySelector<SVGPathElement>(".fio-tinta")!;
    const caneta = cena.querySelector<SVGElement>(".abertura-caneta")!;
    svg.setAttribute("viewBox", `0 0 ${w} 8`);
    tinta.setAttribute("d", `M1 4.3C${w * 0.17} 3.5 ${w * 0.35} 4.9 ${w * 0.5} 4.1S${w * 0.82} 3.6 ${w - 1} 4.3`);
    gsap.set(fio, { left: x, top: y - 4, width: w });
    gsap.set(tinta, { drawSVG: "0%" });
    const L = tinta.getTotalLength();
    return (v: number) => {
      gsap.set(tinta, { drawSVG: `0% ${v * 100}%` });
      const p = tinta.getPointAtLength(v * L);
      gsap.set(caneta, { x: p.x, y: p.y - 4 });
    };
  }

  /**
   * O aceno dos cadernos e a assinatura (B13 e C04, D52; rodada 4, E12): o caderno do cabeçalho e o grande da
   * home abrem um pouco e fecham, juntos e uma vez, com o mesmo movimento do hover (a classe `acena`,
   * Marca.astro); quando a capa começa a fechar (0,8s depois), a caneta preta assina embaixo de "Schutz", em
   * 0,7s. Antes (até a rodada 4) isso esperava o fim da abertura e o desenho do destaque, e vinha a 2,95s e de
   * 3,75 a 4,7s; o Cesar achou demorado (E12): agora vem quando os livros param (na abertura, ~1,8s; na troca
   * de página, logo que a página chega). Com o mouse já num deles, ele fica aberto: a classe só soma ao hover.
   *
   * Até a hora dela, a assinatura espera escondida (`a-escrever`, Marca.astro). Devolve o controle: `acenar()`
   * começa, `pular()` põe tudo no fim (sem aceno, assinatura à vista).
   */
  function aceno() {
    const assinatura = document.querySelector<SVGElement>(".marca-grande .assinatura");
    assinatura?.classList.add("a-escrever");
    const marcas = () => [...document.querySelectorAll<HTMLElement>(".cabecalho .marca, .marca-grande")];
    let assinando: Animation | null = null;
    let relogios: number[] = [];
    let feito = false;
    const assinar = () => {
      if (!assinatura) return;
      assinatura.classList.remove("a-escrever");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      assinando = assinatura.animate(
        [{ clipPath: "inset(-60% 100% -60% -4%)" }, { clipPath: "inset(-60% -4% -60% -4%)" }],
        { duration: 700, easing: "cubic-bezier(0.5, 0.05, 0.25, 1)" },
      );
    };
    return {
      acenar() {
        if (feito) return;
        feito = true;
        // A assinatura começa quando a capa começa a fechar (ela fica aberta 0,75s).
        relogios.push(window.setTimeout(assinar, 800));
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const ms = marcas();
        for (const m of ms) m.classList.add("acena");
        // Aberto por um instante (a capa chega aos 38° em ~0,5s) e fecha com a volta do hover.
        relogios.push(window.setTimeout(() => ms.forEach((m) => m.classList.remove("acena")), 750));
      },
      pular() {
        feito = true;
        relogios.forEach(clearTimeout);
        relogios = [];
        marcas().forEach((m) => m.classList.remove("acena"));
        assinatura?.classList.remove("a-escrever");
        assinando?.finish();
      },
    };
  }

  /*
   * Chegando à home por dentro do site (a cortina, troca.js): os cadernos acenam e a assinatura se escreve
   * logo que a página chega (`cs:chegou`), como na abertura (E12). O CSS já esconde a assinatura desde a
   * primeira pintura (`data-vai-chegar`, posto no <head>).
   */
  function acenoNaChegada() {
    if (!document.querySelector("[data-colecao='home']") || !document.querySelector(".marca-grande")) return;
    const a = aceno();
    addEventListener("cs:chegou", () => a.acenar(), { once: true });
    // Se a chegada não avisar (interrompida), a assinatura aparece mesmo assim.
    setTimeout(() => a.pular(), 6000);
  }

  /* ---------- A1 (rodada 4): a lâmina aparece, os livros chegam, o nome entra e as luzes acendem (home) ---------- */

  /**
   * Os tempos da abertura da home (rodada 4, A1 e E3, E12), em segundos a partir do primeiro risco:
   *
   *  1. 0 a 0,28        o fio da aresta da lâmina de vidro se risca da esquerda para a direita (E3: o chão é a
   *                     lâmina; com `chao="nicho"`, o fio do chão do nicho);
   *  2. 0,26 a 0,66     a lâmina aparece, crescendo do fio (com o nicho, ele se abre), e os abajures
   *                     (apagados) aparecem;
   *  3. 0,62 a ~1,80    os livros chegam um a um pela direita, com "Volume 01"… "Série";
   *  4. ~1,82 a ~2,26   os livros param, e os dois cadernos ("cs" do cabeçalho e o grande) abrem e fecham
   *                     (E12); a fileira desce para o lugar dela e a página aparece em volta (o papel sai);
   *  5. ~1,96 a ~2,41   o nome gigante entra da direita para a esquerda (a frente desfocada, por cima do papel
   *                     que sai); os números rodam quando ela passa por eles;
   *  6. ~2,46           a abertura acaba: o quadro mais pesado (o CSS da abertura sai, a página acorda) fica
   *                     num momento parado (os cadernos abertos, nada correndo);
   *  7. ~2,62 a ~3,32   a assinatura embaixo de "Schutz", quando os cadernos começam a fechar (E12);
   *  8. ~2,62           as luzes acendem uma a uma; depois, só a onda de molas e, depois dela, só o brilho
   *                     (estante-moderna.ts, `sequencia`): acaba em ~4,9s.
   *
   * No celular, os livros chegam um nada mais depressa. Pulada (clique, tecla, roda), tudo vai ao fim: o nome
   * à vista, os números no lugar, a assinatura escrita, as luzes acesas, sem aceno, sem onda e sem brilho.
   */
  const A1 = { fio: 0.28, chao: 0.26, livros: 0.62, passo: 0.085, dur: 0.5, desce: 0.44, nomeDepois: 0.14, nome: 0.45, fimDepois: 0.05, luzesDepois: 0.21 };

  async function estante(gsap: GSAP, cena: HTMLElement, { pulou, fim }: Controle) {
    const prat = document.querySelector<HTMLElement>("[data-estante]");
    if (!prat) return { tl: null };
    const acenos = aceno();
    const [{ CustomEase }, { sequencia, acenderJa }, { mudarContador }] = await Promise.all([
      import("gsap/CustomEase"),
      import("../scripts/estante-moderna"),
      import("../scripts/contador"),
    ]);
    gsap.registerPlugin(CustomEase);
    // O livro inclina pelo atrito enquanto desliza e, ao parar, passa um pouco do prumo e assenta.
    const assenta = CustomEase.create("assenta", "M0,0 C0.2,0 0.35,1.22 0.55,1.1 0.7,1.02 0.82,0.98 1,1");
    // As fontes, no máximo 2,2s (como no caderno): a estante se monta com a de reserva, se preciso (D54).
    await Promise.race([document.fonts.ready, esperar(2200)]);
    // As esperas acima podem passar da trava de 7s do <head>: com a página já à vista, não toca (D54).
    if (!raiz.dataset.abertura) {
      acenos.pular();
      return { tl: null };
    }
    const papel = cena.querySelector<HTMLElement>(".abertura-papel")!;
    const conta = cena.querySelector<HTMLElement>(".abertura-conta")!;
    const celular = matchMedia("(max-width: 640px)").matches;
    const W = innerWidth, H = innerHeight;
    const livros = [...prat.querySelectorAll<HTMLElement>(".prateleira-livros > .livro-colecao")];
    const tabua = prat.querySelector<HTMLElement>(".tabua")!;
    const comNicho = prat.matches("[data-chao^='nicho']");
    const nicho = comNicho ? prat.querySelector<HTMLElement>(".nicho") : null;
    const parte = (nome: string) => nicho?.querySelector<HTMLElement>(`.nicho-${nome}`) ?? null;
    const [parede, teto, chao, friso] = ["parede", "teto", "chao", "friso"].map(parte);
    const luzes = prat.querySelector<HTMLElement>(".luzes-fileira");
    // A partir daqui, as luzes, a onda e o brilho da fileira são da abertura (estante-moderna.ts a deixa).
    prat.setAttribute("data-conduzida", "");

    // A coleção de verdade vai para o meio da tela (é ela que volta ao lugar no fim).
    const r = prat.getBoundingClientRect();
    const s = Math.min(celular ? 1.05 : 1.4, (W * 0.84) / r.width, (H * 0.5) / r.height);
    gsap.set(prat, { x: W / 2 - (r.left + r.width / 2), y: H * 0.47 - (r.top + r.height / 2), scale: s, transformOrigin: "50% 50%" });
    // O fio corre na quina de cima da frente do chão: a aresta do vidro (ou o friso do nicho), de ponta a ponta.
    const kc = parseFloat(getComputedStyle(prat).getPropertyValue("--kc")) || 1;
    const frente = (parseFloat(getComputedStyle(prat).getPropertyValue("--friso-alto")) || 6) * kc;
    const rt = tabua.getBoundingClientRect();
    const rn = (nicho ?? tabua).getBoundingClientRect();
    const yFio = friso ? friso.getBoundingClientRect().top + 0.5 : rt.bottom - frente * s + 0.5;
    const pintar = montarFio(gsap, cena, rn.left, yFio, rn.width);
    gsap.set(conta, { top: Math.max(rn.bottom, rt.bottom) + 30, opacity: 0 });
    const p = { v: 0 };
    pintar(0);

    // O nome gigante espera coberto (o papel da página, com a frente desfocada na ponta direita), para entrar
    // depois dos livros, da direita para a esquerda (o 20). Coberto, ele sobe para cima do papel da abertura
    // (CSS, `data-capa-nome`): a frente passa nítida enquanto o papel ainda sai.
    const nome = document.querySelector<HTMLElement>(".nome-gigante");
    let capaNome: HTMLElement | null = null;
    if (nome) {
      capaNome = document.createElement("span");
      capaNome.className = "abertura-capa-nome";
      capaNome.setAttribute("aria-hidden", "true");
      nome.append(capaNome);
      nome.dataset.capaNome = "";
    }
    const tirarCapa = () => {
      capaNome?.remove();
      capaNome = null;
      if (nome) delete nome.dataset.capaNome;
    };
    // Os números da coleção (a página os montou no zero, contador.ts): rodam quando a frente passa por eles.
    const numeros = [...document.querySelectorAll<HTMLElement>("[data-odometro]")]
      .filter((el) => el.querySelector(".coluna"))
      .map((el) => {
        const b = el.getBoundingClientRect();
        return { el, x: b.left + b.width / 2, rodou: false };
      });
    const rodarAte = (x: number) => {
      for (const n of numeros) {
        if (n.rodou || n.x < x) continue;
        n.rodou = true;
        // Pulada a abertura, o número vai direto ao fim, sem rodar.
        const fitas = pulou() ? [...n.el.querySelectorAll<HTMLElement>(".fita")] : [];
        fitas.forEach((f) => (f.style.transition = "none"));
        mudarContador(n.el, Number(n.el.dataset.odometro));
        if (fitas.length) {
          void n.el.offsetWidth;
          requestAnimationFrame(() => fitas.forEach((f) => f.style.removeProperty("transition")));
        }
      }
    };
    cena.dataset.pronto = "";

    const pecasDaCena = [prat, ...livros, tabua, ...([parede, teto, chao, friso, luzes].filter(Boolean) as HTMLElement[])];
    let conduziu = false;
    let soltarAviso = () => {};
    avisoDaHome = new Promise<void>((r) => (soltarAviso = r));
    const tl = gsap.timeline({
      onComplete: () => {
        tirarCapa();
        rodarAte(-Infinity);
        soltarAviso();
        if (pulou()) acenos.pular();
        if (!conduziu) acenderJa(prat);
      },
    });
    // 1. a caneta risca o fio da aresta
    tl.to(p, { v: 1, duration: celular ? 0.26 : A1.fio, ease: "power1.inOut", onUpdate: () => pintar(p.v) }, 0)
      .to(".abertura-caneta", { y: "-=10", rotation: 16, opacity: 0, duration: 0.22, ease: "power2.in" }, A1.fio)
      .to(".abertura-fio", { opacity: 0, duration: 0.2 }, A1.chao + 0.06);
    // 2. o chão aparece: a lâmina cresce do fio (para cima, o tampo; o fio vira a aresta) e a sombra dela
    //    vem junto; com o nicho, ele se abre (o friso nasce do fio, a parede escurece, a sombra do teto cresce)
    if (comNicho) {
      if (friso) tl.fromTo(friso, { opacity: 0, scaleY: 0.2 }, { opacity: 1, scaleY: 1, duration: 0.3, ease: "power2.out" }, A1.chao);
      if (chao) tl.fromTo(chao, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power1.out" }, A1.chao + 0.02);
      if (parede) tl.fromTo(parede, { opacity: 0 }, { opacity: 1, duration: 0.42, ease: "power1.inOut" }, A1.chao + 0.02);
      if (teto) tl.fromTo(teto, { opacity: 0, scaleY: 0 }, { opacity: 1, scaleY: 1, duration: 0.4, ease: "power2.out" }, A1.chao + 0.04);
    }
    const origem = `50% ${(tabua.offsetHeight - frente).toFixed(1)}px`;
    tl.fromTo(tabua, { opacity: 0 }, { opacity: 1, duration: 0.24, ease: "power1.out" }, A1.chao)
      .fromTo(tabua, { scaleY: 0.12 }, { scaleY: 1, duration: 0.4, ease: "power2.out", transformOrigin: origem }, A1.chao);
    if (luzes) tl.fromTo(luzes, { opacity: 0 }, { opacity: 1, duration: 0.28, ease: "power1.out" }, A1.chao + 0.14);
    // 3. os livros chegam um a um, entrando pela direita (no nicho, pela parede da direita: o recorte dele os
    //    esconde antes) e deslizando até o lugar; o vizinho sente o baque; o inclinado assenta.
    const passo = celular ? 0.08 : A1.passo, dur = celular ? 0.48 : A1.dur;
    tl.to(conta, { opacity: 1, duration: 0.2 }, A1.livros + 0.05);
    livros.forEach((b, i) => {
      const rb = b.getBoundingClientRect();
      const fora = comNicho ? (rn.right - rb.left) / s + 6 : (W - rb.left) / s + 24;
      const t = A1.livros + i * passo;
      // A série é livro também (H2, rodada 4): o rótulo dela é "Série", como o da fileira.
      const rotulo = b.classList.contains("de-serie") ? "Série" : `Volume ${String(i + 1).padStart(2, "0")}`;
      tl.set(b, { opacity: 1 }, t)
        .fromTo(b, { x: fora }, { x: 0, duration: dur, ease: "power3.out" }, t)
        .fromTo(b, { rotation: -3.5 }, { rotation: 0, duration: dur, ease: assenta, transformOrigin: "50% 100%" }, t)
        .call(() => { conta.textContent = rotulo; }, undefined, t + 0.12);
      if (i > 0) tl.to(livros[i - 1], { xPercent: -3, duration: 0.07, yoyo: true, repeat: 1, ease: "power1.out" }, t + dur * 0.6);
    });
    // 4. os livros param: os cadernos acenam (E12); a fileira desce para o lugar dela e a página aparece em volta
    const t1 = A1.livros + Math.max(0, livros.length - 1) * passo + dur + 0.02;
    tl.call(() => { if (!pulou()) acenos.acenar(); }, undefined, t1)
      .to(conta, { opacity: 0, duration: 0.18 }, t1 - 0.06)
      .to(prat, { x: 0, y: 0, scale: 1, duration: A1.desce, ease: "power3.inOut" }, t1)
      .to(papel, { opacity: 0, duration: 0.4, ease: "power1.inOut" }, t1 + 0.06);
    // 5. o nome entra da direita para a esquerda: a capa (papel, com a frente desfocada) anda para a
    //    esquerda e o descobre; os números rodam quando a frente passa por eles
    const tNome = t1 + A1.nomeDepois;
    if (capaNome && nome) {
      // A frente começa e termina fora do recorte do nome (que passa dele `--pad`, até 32px): 56px de folga
      // de cada lado, para ela não aparecer parada na borda antes de entrar nem ficar no "C" depois.
      const folga = 56;
      const capa = capaNome;
      tl.fromTo(
        capa,
        { x: folga },
        {
          x: -1.22 * nome.offsetWidth - folga,
          duration: A1.nome,
          ease: "power2.inOut",
          onStart: () => soltarAviso(),
          onUpdate: () => {
            const c = capa.getBoundingClientRect();
            rodarAte(c.left + c.width * 0.955);
          },
          onComplete: tirarCapa,
        },
        tNome,
      );
    } else tl.call(() => (rodarAte(-Infinity), soltarAviso()), undefined, tNome);
    // 6. a página está à vista e o nome também: a abertura acaba (o resto não prende a página)
    const tFim = Math.max(t1 + A1.desce, tNome + A1.nome) + A1.fimDepois;
    tl.call(() => {
      gsap.set(pecasDaCena, { clearProps: "transform" });
      fim();
      gsap.set(pecasDaCena, { clearProps: "opacity" });
    }, undefined, tFim);
    // 7 e 8. a assinatura vem com o aceno (0,8s depois dele); as luzes acendem uma a uma; depois, só a onda de
    //    molas e, depois dela, só o brilho
    tl.call(() => {
      conduziu = true;
      if (pulou()) acenderJa(prat);
      else sequencia(prat, { molas: true });
    }, undefined, tFim + A1.luzesDepois - 0.05);
    return { tl };
  }

  /**
   * O voo do caderno até a marca do cabeçalho (revisão 14, D52), em arco: em linha reta, ele cruzava
   * "Cesar Schutz" antes de pousar. Ele sai de lado, pouco acima do meio da tela, faz a curva e sobe por
   * baixo da marca (uma curva de Bézier com o ponto de controle embaixo dela): só entra na altura do
   * cabeçalho quando já está sob a marca, pequeno. Inclina para o lado do voo, mais quanto mais rápido
   * anda de lado, e se endireita ao subir, como um objeto posto no lugar; pousa reto, na marca exata.
   */
  function voarAteAMarca(gsap: GSAP, livro: HTMLElement, dx: number, dy: number, escala: number) {
    const curva = gsap.parseEase("power2.inOut");
    const cy = dy * 0.35;
    // A inclinação máxima (quando ele anda mais depressa de lado), menor nos voos curtos (celular).
    const giro = Math.sign(dx) * Math.min(9, Math.abs(dx) / 24);
    const voo = { t: 0 };
    return gsap.to(voo, {
      t: 1,
      duration: 0.6,
      ease: "none",
      onUpdate: () => {
        const t = voo.t, p = curva(t), q = 1 - p;
        // A velocidade de lado: 2(1 - p) no caminho vezes a da curva no tempo (máximo ~2,18 em t = 0,4).
        const deLado = 2 * q * (t < 0.5 ? 4 * t : 4 * (1 - t));
        gsap.set(livro, {
          x: dx * (1 - q * q),
          y: 2 * p * q * cy + p * p * dy,
          scale: 1 + (escala - 1) * p,
          rotation: (giro * deLado) / 2.18,
        });
      },
    });
  }

  /* ---------- 02: o caderno carrega, abre e fecha e pousa no cabeçalho (outras páginas) ---------- */
  async function caderno(gsap: GSAP, cena: HTMLElement, { pulou, pulado, fim }: Controle) {
    const papel = cena.querySelector<HTMLElement>(".abertura-papel")!;
    const fio = cena.querySelector<HTMLElement>(".abertura-fio")!;
    const caneta = cena.querySelector<SVGElement>(".abertura-caneta")!;
    const conta = cena.querySelector<HTMLElement>(".abertura-conta")!;
    const livro = cena.querySelector<HTMLElement>(".abertura-caderno")!;
    const contra = cena.querySelector<HTMLElement>(".caderno-contra")!;
    const capa = cena.querySelector<HTMLElement>(".caderno-capa")!;
    const W = innerWidth, H = innerHeight;
    const lw = Math.min(96, Math.max(72, H * 0.12)), lh = (lw * 52) / 40;
    const cx = W / 2, cy = H * 0.42;
    gsap.set(livro, { left: cx - lw / 2, top: cy - lh / 2, width: lw, height: lh, opacity: 0, scale: 0.92 });
    const w = Math.min(240, W * 0.6);
    const pintar = montarFio(gsap, cena, cx - w / 2, cy + lh / 2 + 38, w);
    gsap.set(conta, { top: cy + lh / 2 + 58 });
    const p = { v: 0 };
    const escrever = () => { pintar(p.v); conta.textContent = String(Math.round(p.v * 100)); };
    escrever();
    cena.dataset.pronto = "";

    // 1. o caderno aparece e a caneta escreve o fio (o carregamento), contando até 100
    const pronto = Promise.all([document.fonts.ready, document.readyState === "complete" ? null : new Promise((r) => addEventListener("load", r, { once: true }))]);
    const carga = gsap.timeline()
      .to(livro, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.out" }, 0)
      .to(p, { v: 0.85, duration: 0.55, ease: "power1.inOut", onUpdate: escrever }, 0.12);
    await Promise.race([Promise.all([carga.then(), Promise.race([pronto, esperar(2200)])]), pulado]);
    if (pulou()) carga.progress(1);
    else await gsap.to(p, { v: 1, duration: 0.15, ease: "power2.out", onUpdate: escrever }).then();
    // Pulada (ou vencida a trava de 7s) durante a carga, a página já está à vista: a cena não segue,
    // senão as folhas chegariam de novo por cima dela (D54).
    if (!raiz.dataset.abertura) return { tl: null };

    const marca = document.querySelector<HTMLElement>(".cabecalho .marca-livro-3d");
    const rm = marca?.getBoundingClientRect();
    const troca = (window as unknown as { csTroca?: Troca }).csTroca;
    const propria = document.getElementById("conteudo")?.dataset.chegada === "propria";
    const tl = gsap.timeline({ onComplete: fim });
    // 2. o caderno abre e fecha (a capa gira pela lombada, com peso) e o fio sai
    tl.to(caneta, { y: "-=10", rotation: 16, opacity: 0, duration: 0.22, ease: "power2.in" }, 0)
      .to([fio, conta], { opacity: 0, duration: 0.25 }, 0.1)
      .to(capa, { rotationY: -150, duration: 0.36, ease: "power2.out", transformOrigin: "0% 50%" }, 0.05)
      .to(capa, { rotationY: 0, duration: 0.3, ease: "power2.in" }, 0.46)
      .to(livro, { scale: 0.97, duration: 0.06, ease: "power1.out", yoyo: true, repeat: 1 }, 0.76);
    // 3. ele pousa na marca do cabeçalho em arco (a sombra some no caminho, como a da marca, chapada); as
    //    folhas da página chegam do fundo ainda embaixo do papel, e o papel só sai quando o caderno já
    //    passou pelo título dela (ele sobe por baixo da marca): o voo é sobre a folha limpa, sem cruzar
    //    texto nenhum, e a página aparece em volta dele quando ele pousa (revisão 14, D52). A marca de
    //    verdade toma o lugar do caderno quando o papel acaba de sair.
    const t3 = 0.85;
    const tPapel = t3 + 0.42, tTroca = tPapel + 0.35;
    if (marca && rm && rm.width > 0) {
      tl.add(voarAteAMarca(gsap, livro, rm.left + rm.width / 2 - cx, rm.top + rm.height / 2 - cy, rm.height / lh), t3)
        .to(contra, { boxShadow: "0 0 0 0 rgb(0 0 0 / 0)", duration: 0.5 }, t3)
        .call(() => raiz.classList.add("caderno-pousou"), undefined, tTroca)
        .set(livro, { opacity: 0 }, tTroca);
    } else tl.to(livro, { opacity: 0, duration: 0.3 }, t3);
    // Rodada 3 (revisão final, correção comum 4): em Livros (a chegada própria), o desfile dos cartões começa
    // quando o caderno levanta voo (t3), 0,3s antes: os cartões chegam do fundo ainda embaixo do papel, e a
    // montagem assenta até ~3,5s depois da chegada de fora (antes, ~4,8s).
    if (propria) tl.call(() => dispatchEvent(new CustomEvent("cs:abertura-chega")), undefined, t3);
    tl.to(papel, { opacity: 0, duration: 0.35, ease: "power1.inOut" }, tPapel)
      .call(() => {
        chegadaPedida = true;
        irAoAlvo();
        if (propria) return;
        if (troca) {
          // Quando a última folha pousa, o desenho do artigo pode se desenhar (desenho-vivo.ts).
          const pousa = troca.chegar(troca.unidades(), { t0: 0 });
          setTimeout(() => dispatchEvent(new CustomEvent("cs:chegou")), pousa);
        }
      }, undefined, t3 + 0.3);
    return { tl };
  }
</script>

<style>
  .abertura-site {
    display: none;
  }

  /* Só com a abertura ligada (script do <head>): por cima de tudo, a página não rola. */
  :global(:root[data-abertura]) {
    overflow: hidden;
  }

  /* As transições do CSS atrapalham o GSAP a ler o estado final: durante a abertura, só ele anima. As fitas
     dos números da home e a capa dos cadernos são a exceção (rodada 4, A1 e E12): rodam e acenam ainda na
     abertura. */
  :global(:root[data-abertura] *:not(.fita, .marca-capa-3d)) {
    transition: none !important;
  }

  :global(:root[data-abertura]) .abertura-site {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    cursor: pointer;
  }

  /* Até o script montar a cena, as peças dela esperam escondidas (a posição vem dele). */
  .abertura-site:not([data-pronto]) :is(.abertura-fio, .abertura-conta, .abertura-caderno) {
    visibility: hidden;
  }

  /* Na home, a estante de verdade fica por cima do papel enquanto se monta (A3); os livros e a tábua
     esperam escondidos, e o script os mostra um a um. */
  :global(:root[data-abertura="estante"] [data-estante]) {
    position: relative;
    z-index: 101;
  }

  /* Ela é a cena, não a estante da home (B12, D52): o mouse passa por ela até o papel (sem tombar o
     livro nem mostrar a legenda, e o clique pula a abertura, como no resto da tela). */
  :global(:root[data-abertura="estante"] :is([data-estante], [data-estante] *)) {
    pointer-events: none;
  }

  /* Rodada 4 (A1): as peças do nicho, os livros e os abajures esperam escondidos; o script os mostra. */
  :global(:root[data-abertura="estante"] [data-estante] :is(.prateleira-livros > *, .tabua, .nicho > *, .luzes-fileira)) {
    opacity: 0;
  }

  /* Os livros entram pela parede da direita do nicho: fora dele, o recorte os esconde. */
  :global(:root[data-abertura="estante"] .colecao-home[data-chao^="nicho"] .fileira) {
    clip-path: inset(-400px calc(50% - var(--nicho-largura) / 2));
  }

  /*
   * A capa do nome gigante (rodada 4, A1; a frente do 20): o papel da página por cima do nome, com a frente
   * desfocada na ponta direita, que o script leva para a esquerda (1,22 nome e mais as folgas, 0,45s). Ela tem
   * 2,44 vezes a largura do nome e começa com a frente logo depois da borda direita dele; no claro, a frente é de sombra
   * quente clareando, e no escuro, de luz quente. Em cima e embaixo, a capa passa do nome e se perde
   * (máscara), e o nome a recorta perto da borda (sem rolagem lateral).
   */
  :global(.nome-gigante[data-capa-nome]) {
    position: relative;
    overflow: clip;
    overflow-clip-margin: var(--pad, 16px);
  }

  /* Coberto pela capa, o nome sobe para cima do papel da abertura (E12: ele entra enquanto o papel sai). */
  :global(:root[data-abertura="estante"] .nome-gigante[data-capa-nome]) {
    z-index: 101;
  }

  /* Chegando à home pela troca de página, a assinatura espera escondida até os cadernos acenarem (E12). */
  :global(:root[data-vai-chegar] .marca-grande .assinatura) {
    clip-path: inset(-60% 100% -60% -4%);
  }

  :global(.abertura-capa-nome) {
    --frente: color-mix(in oklab, var(--sombra-quente) 12%, var(--paper));
    position: absolute;
    z-index: 5;
    top: -30%;
    bottom: -30%;
    left: -122%;
    width: 244%;
    background: linear-gradient(
      90deg,
      var(--paper) 0 90.5%,
      var(--frente) 93%,
      color-mix(in oklab, var(--frente) 45%, transparent) 96.5%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    mask: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    pointer-events: none;
  }

  :global(:root[data-theme="dark"] .abertura-capa-nome) {
    --frente: color-mix(in oklab, var(--luz-quente) 24%, var(--paper));
  }

  /* O caderno pousa na marca do cabeçalho: até lá, a marca espera. */
  :global(:root[data-abertura="caderno"]:not(.caderno-pousou) .cabecalho .marca-livro-3d) {
    visibility: hidden;
  }

  .abertura-papel {
    position: absolute;
    inset: 0;
    background: var(--paper);
  }

  .abertura-fio {
    position: absolute;
    left: 0;
    top: 0;
    height: 8px;
  }

  .fio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fio-tinta {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /*
   * Na home, o fio é um risco de caneta legível (--ink-2), na aresta da lâmina de vidro (rodada 4, E3; no nicho,
   * no alto do friso): quando a caneta levanta, a lâmina cresce dele e ele se apaga.
   */
  [data-modo="estante"] .fio-tinta {
    stroke: var(--ink-2);
    stroke-width: 2;
  }

  /* A caneta da leitura (D45): a ponta (4, 20 no desenho de 24) encosta no fim do fio. */
  .abertura-caneta {
    position: absolute;
    left: -3.7px;
    top: -14.3px;
    width: 22px;
    height: 22px;
    overflow: visible;
  }

  .abertura-caneta :global(.corpo) {
    fill: var(--paper-hi);
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .abertura-caneta :global(.anel) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }

  .abertura-caneta :global(.ponta) {
    fill: var(--marca);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  /* A contagem: na estante, a da coleção, na tipografia dos livros; no caderno, até 100. */
  .abertura-conta {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  [data-modo="estante"] .abertura-conta {
    font: 700 13.5px/1 var(--font-livro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  [data-modo="caderno"] .abertura-conta {
    font: 500 12.5px/1 var(--font-codigo);
  }

  /*
   * O caderno "cs" (como o do protótipo 02): a contracapa, um pouco mais escura, com a sombra; o miolo,
   * a página creme e pautada de caderno (src/lib/caderno.ts, a mesma da marca, A01, D52), recuada; e a
   * capa, presa pela lombada, com a marca na frente e o lado de dentro liso atrás. No papel dos livros
   * (--marca-letra), igual nos dois temas, como os livros (D39).
   */
  .abertura-caderno {
    position: absolute;
    perspective: 520px;
  }

  .caderno-contra,
  .caderno-miolo,
  .caderno-capa {
    position: absolute;
    inset: 0;
  }

  .caderno-contra {
    border-radius: 7.5% / 5.8%;
    background: color-mix(in oklab, var(--marca), black 18%);
    box-shadow: 0 14px 22px -12px rgb(0 0 0 / 0.45);
  }

  /* O miolo é o mesmo da marca do cabeçalho e da home (src/lib/caderno.ts): creme e pautado. */
  .caderno-miolo {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .caderno-capa {
    transform-style: preserve-3d;
  }

  .capa-frente,
  .capa-verso {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    backface-visibility: hidden;
  }

  .capa-verso {
    transform: rotateY(180deg);
    border-radius: 7.5% / 5.8%;
    background: color-mix(in oklab, var(--marca) 50%, var(--marca-letra));
  }

  .capa-frente :global(.marca-capa) {
    fill: var(--marca);
  }

  .capa-frente :global(.marca-dobra) {
    fill: black;
    opacity: 0.24;
  }

  .capa-frente :global(.marca-letras) {
    fill: var(--marca-letra);
  }
</style>
