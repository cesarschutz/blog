---
/**
 * Linha de cima de um artigo na lista e no card, como no blog atual: categoria (chip), a data com o
 * calendário e o tempo de leitura com o relógio (D33). O chip fica acima do link que cobre o item
 * inteiro (ver ItemLista). Com código-fonte (frontmatter `codigo`, D52), o sinal no fim da linha,
 * preso ao tempo de leitura: se não couber depois do chip, desce com a data, e nunca sozinho (C04).
 * A linha é um contêiner (`meta-item`): estreita, o sinal fica só no ícone (SinalCodigo).
 */
import Chip from "./Chip.astro";
import DataLeitura from "./DataLeitura.astro";
import SinalCodigo from "./SinalCodigo.astro";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
---

<p class="meta-item">
  <Chip cor={post.cor} nome={post.rotulo} href={post.urlRotulo} />
  {
    post.codigo ? (
      <span class="com-codigo">
        <DataLeitura data={post.publicado} minutos={post.minutos} />
        <SinalCodigo />
      </span>
    ) : (
      <DataLeitura data={post.publicado} minutos={post.minutos} />
    )
  }
</p>

<style>
  .meta-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-2);
    container: meta-item / inline-size;
  }

  .com-codigo {
    display: inline-flex;
    align-items: center;
    gap: 4px 14px;
  }

  .meta-item :global(.chip) {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .meta-item,
    .com-codigo {
      gap: 2px 10px;
    }

    .meta-item {
      font-size: 12.5px;
    }
  }
</style>
