---
/**
 * Linha de cima de um artigo na lista e no card, como no blog atual: categoria (chip), a data com o
 * calendário e o tempo de leitura com o relógio (D33). O chip fica acima do link que cobre o item
 * inteiro (ver ItemLista).
 */
import Chip from "./Chip.astro";
import DataLeitura from "./DataLeitura.astro";
import type { Resumo } from "../lib/posts";

interface Props {
  post: Resumo;
}

const { post } = Astro.props;
---

<p class="meta-item">
  <Chip cor={post.cor} nome={post.rotulo} href={post.urlRotulo} />
  <DataLeitura data={post.publicado} minutos={post.minutos} />
</p>

<style>
  .meta-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .meta-item :global(.chip) {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .meta-item {
      gap: 2px 10px;
      font-size: 12.5px;
    }
  }
</style>
