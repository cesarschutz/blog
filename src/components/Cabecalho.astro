---
/**
 * Cabeçalho (briefing §5.1, D26, D31): nome à esquerda; à direita Artigos, Categorias, Séries e
 * Tags, a busca como campo (ícone, "Buscar" e ⌘K) e o botão de tema. Fica fixo no alto enquanto a
 * página rola (sticky), com fundo translúcido e um fio embaixo que aparece depois de rolar. No
 * celular, nome, busca (só o ícone) e tema na primeira linha; o menu na segunda. A altura dele fica
 * em --altura-topo (base.css), que as outras peças fixas e as âncoras descontam.
 */
import { ICONES } from "../lib/icones";
import { url } from "../lib/url";

interface Props {
  atual?: "artigos" | "categorias" | "series" | "tags";
}

const { atual } = Astro.props;
---

<div class="topo-fixo">
<header class="cabecalho wrap">
  <a class="marca" href={url("/")}>Cesar Schutz</a>
  <nav class="menu" aria-label="Principal">
    <a href={url("/archive/")} aria-current={atual === "artigos" ? "page" : undefined}>Artigos</a>
    <a href={url("/categories/")} aria-current={atual === "categorias" ? "page" : undefined}>Categorias</a>
    <a href={url("/series/")} aria-current={atual === "series" ? "page" : undefined}>Séries</a>
    <a href={url("/tags/")} aria-current={atual === "tags" ? "page" : undefined}>Tags</a>
  </nav>
  <button type="button" class="campo-busca" data-busca-abrir aria-label="Buscar" aria-keyshortcuts="Meta+K Control+K">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.busca} />
    <span>Buscar</span>
    <kbd data-atalho>⌘K</kbd>
  </button>
  <!-- Alterna claro e escuro (o rodapé também oferece "Sistema"). Sem JS, fica escondido. -->
  <button type="button" class="botao-tema" data-tema-alternar aria-label="Tema escuro" title="Tema escuro" aria-pressed="false" hidden>
    <svg class="lua" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.lua} />
    <svg class="sol" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.sol} />
  </button>
</header>
</div>

<script>
  import { aoMudarTema, aplicarTema, temaNaTela } from "../scripts/tema";

  // Fora do macOS e do iOS, o atalho é Ctrl+K.
  const apple = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
  if (!apple) {
    document.querySelectorAll("[data-atalho]").forEach((tecla) => (tecla.textContent = "Ctrl K"));
  }

  const botao = document.querySelector<HTMLButtonElement>("[data-tema-alternar]");
  if (botao) {
    botao.addEventListener("click", () => aplicarTema(temaNaTela() === "dark" ? "light" : "dark"));
    aoMudarTema(() => botao.setAttribute("aria-pressed", String(temaNaTela() === "dark")));
    botao.hidden = false;
  }
</script>

<style>
  /*
   * Fixo no alto: fundo da página translúcido, com desfoque. O fio embaixo aparece depois dos
   * primeiros pixels de rolagem (animação ligada à rolagem, onde houver; sem ela, fica sem fio).
   */
  .topo-fixo {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 transparent;
  }

  @supports (animation-timeline: scroll()) {
    .topo-fixo {
      animation: fio-do-topo linear both;
      animation-timeline: scroll(root);
      animation-range: 0 24px;
    }
  }

  @keyframes fio-do-topo {
    to {
      box-shadow:
        0 1px 0 var(--rule),
        0 8px 20px -16px rgb(0 0 0 / 0.35);
    }
  }

  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    min-height: var(--altura-topo);
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .marca {
    margin-right: auto;
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 21px;
    color: var(--ink);
    text-decoration: none;
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-family: var(--font-ui);
    font-size: 15.5px;
  }

  .menu a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  .menu a:hover {
    color: var(--ink);
  }

  .menu [aria-current="page"] {
    color: var(--acento);
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  /* A busca parece um campo, mas é um botão: abre o diálogo (Busca.astro). */
  .campo-busca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 210px;
    min-height: 40px;
    padding: 7px 10px 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-hi);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }

  .campo-busca:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .campo-busca svg,
  .botao-tema svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .campo-busca svg {
    width: 16px;
    height: 16px;
  }

  .campo-busca kbd {
    margin-left: auto;
  }

  .botao-tema {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-hi);
    color: var(--ink-2);
    cursor: pointer;
  }

  .botao-tema:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .botao-tema svg {
    width: 17px;
    height: 17px;
  }

  /* Lua no claro (vai para o escuro), sol no escuro. Pelo CSS, para não piscar ao carregar. */
  .botao-tema .sol {
    display: none;
  }

  :global(:root[data-theme="dark"]) .botao-tema .sol {
    display: block;
  }

  :global(:root[data-theme="dark"]) .botao-tema .lua {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .botao-tema .sol {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .botao-tema .lua {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .campo-busca {
      min-width: 150px;
    }
  }

  /* Celular: nome, busca e tema na primeira linha; o pseudo-elemento força a quebra antes do menu. */
  @media (max-width: 640px) {
    .cabecalho {
      gap: 6px 12px;
      padding-top: 8px;
      padding-bottom: 6px;
    }

    .cabecalho::after {
      content: "";
      order: 2;
      flex-basis: 100%;
      height: 0;
    }

    .marca {
      order: 1;
    }

    .botao-tema {
      order: 2;
    }

    .menu {
      order: 3;
      gap: 4px 18px;
    }

    /* A busca vira só o ícone, redondo como o botão de tema. */
    .campo-busca {
      order: 1;
      display: grid;
      place-items: center;
      width: 40px;
      min-width: 0;
      height: 40px;
      padding: 0;
      border-radius: 50%;
    }

    .campo-busca span,
    .campo-busca kbd {
      display: none;
    }
  }
</style>
