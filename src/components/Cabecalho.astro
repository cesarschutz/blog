---
/**
 * Cabeçalho (briefing §5.1, D26, D31, D33): a marca à esquerda; à direita Artigos, Categorias,
 * Séries e Tags, a busca como campo (ícone, "Buscar" e ⌘K), o GitHub e o LinkedIn (só os ícones, como
 * no blog atual) e o botão de tema (D39). Fica fixo no alto enquanto a página rola
 * (sticky), com fundo translúcido e um fio embaixo que aparece depois de rolar. A altura dele fica em
 * --altura-cabecalho e o quanto as outras peças fixas e as âncoras descontam, em --altura-topo
 * (base.css). No celular (até 860px, D46), fica sempre à vista, numa linha só: a marca, a busca (só o
 * ícone), o tema e o botão do menu, que abre as seções numa folha que desce do cabeçalho.
 *
 * Nos artigos com sumário (C2, D49), nas telas sem a lateral (até 1299px), o nome da seção atual toma
 * o lugar da marca depois que a leitura chega à primeira seção: a seção nova entra por baixo ao descer
 * e por cima ao subir, e o toque abre o sumário numa folha (Sumario.astro, variante "folha"). O
 * script que acompanha a leitura é o do artigo (src/scripts/artigo.ts).
 *
 * A caneta também navega (D49, protótipo E1): a seção atual é sublinhada por um traço de caneta, torto
 * de um jeito próprio em cada item, que desliza de um item para o outro na troca de página (View
 * Transition); o mouse escreve um traço leve (traco.css). A lupa da busca se inclina no hover, e a
 * tecla ⌘K afunda quando é usada (Busca.astro). No GitHub e no LinkedIn, a caneta circula o ícone,
 * com o mesmo círculo da paginação (E2, traco.css).
 *
 * A caneta preta desenha; a azul marca (C04, D52): a seção atual segue no traço azul, e o rascunho do
 * mouse (o traço leve e o círculo) é preto. GitHub e LinkedIn são as marcas oficiais, em preto.
 */
import Marca from "./Marca.astro";
import SeletorTema from "./SeletorTema.astro";
import { AUTOR } from "../data/site";
import { ICONES, MARCAS } from "../lib/icones";
import { circuloDeCaneta, contornoDeCaneta, pilulaDeCaneta, tracoDeCaneta } from "../lib/traco";
import { url } from "../lib/url";
import "../styles/traco.css";

interface Props {
  atual?: "artigos" | "categorias" | "series" | "tags";
  /** Artigo com sumário: o nome da seção atual pode ocupar o lugar da marca (C2, D49). */
  sumario?: boolean;
}

const { atual, sumario = false } = Astro.props;
// O texto do menu rola no hover (protótipo 14, G20): cada letra sobe e a cópia dela (a sombra do texto,
// uma linha abaixo) entra no lugar, uma depois da outra.
const letras = (nome: string) => [...nome].map((c, k) => ({ c: c === " " ? "\u00a0" : c, k }));
const seta = '<path d="M3.5 5.5 7 9l3.5-3.5"/>';
// As seções; a nota só aparece no menu do celular (D46).
const ITENS = [
  { chave: "artigos", nome: "Artigos", nota: "Todos, do mais novo ao mais antigo", href: url("/archive/") },
  // Rodada 2 (protótipo 14, O10): "Livros" e "Séries", separados; o endereço continua /categories/.
  { chave: "categorias", nome: "Livros", nota: "Os livros da coleção", href: url("/categories/") },
  { chave: "series", nome: "Séries", nota: "Para ler em ordem", href: url("/series/") },
  { chave: "tags", nome: "Tags", nota: "Por assunto", href: url("/tags/") },
] as const;
---

<div class="topo-fixo">
<header class="cabecalho wrap">
  <div class="lugar-marca" data-lugar-marca>
    <Marca traco />
    {
      sumario && (
        <button type="button" class="secao-atual" aria-expanded="false" aria-controls="folha-sumario" tabindex="-1" hidden data-abrir-sumario>
          <span class="vaga" data-vaga data-pos="baixo"><span class="num" /><span class="nome" /><svg viewBox="0 0 14 14" aria-hidden="true" focusable="false" set:html={seta} /></span>
          <span class="vaga" data-vaga data-pos="baixo"><span class="num" /><span class="nome" /><svg viewBox="0 0 14 14" aria-hidden="true" focusable="false" set:html={seta} /></span>
        </button>
      )
    }
  </div>
  <nav class="menu" id="menu-principal" aria-label="Principal">
    {
      ITENS.map((item, i) => (
        <a href={item.href} aria-current={atual === item.chave ? "page" : undefined} style={`--i:${i}`}>
          <span class="nome">
            <span class="sr">{item.nome}</span>
            <span class="rola" aria-hidden="true">{letras(item.nome).map((l) => <span style={`--k:${l.k}`}>{l.c}</span>)}</span>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <svg class="traco traco-leve traco-preto" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"
              ><path d={tracoDeCaneta(item.nome, 101)} /></svg
            >
            {
              atual === item.chave && (
                <svg class="traco traco-atual" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"
                  ><path d={tracoDeCaneta(item.nome)} /></svg
                >
              )
            }
          </span>
          <span class="nota">{item.nota}</span>
        </a>
      ))
    }
    <div class="menu-perfis" style={`--i:${ITENS.length}`}>
      <a href={AUTOR.github} rel="me">
        <svg class="marca-perfil" viewBox={MARCAS.github.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.github.d} /></svg>GitHub
      </a>
      <a href={AUTOR.linkedin} rel="me">
        <svg class="marca-perfil" viewBox={MARCAS.linkedin.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.linkedin.d} /></svg>LinkedIn
      </a>
      <a href="#computador" role="button" aria-haspopup="dialog" data-abrir-computador hidden>
        <svg class="marca-perfil" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M6 1.5h12a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2Zm1.6 2.6v7.6h8.8V4.1ZM13 14.2h3.4v1.4H13ZM5 20h14v2.4H5Z" /></svg>Computador
      </a>
    </div>
  </nav>
  <button type="button" class="campo-busca" data-busca-abrir aria-label="Buscar" aria-keyshortcuts="Meta+K Control+K">
    <svg class="contorno contorno-pilula" viewBox="0 0 210 40" aria-hidden="true" focusable="false"><path d={pilulaDeCaneta(210, 40, "Buscar")} /></svg>
    <svg class="contorno contorno-roda" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d={contornoDeCaneta("Buscar")} /></svg>
    <svg class="circulo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path pathLength="1" d={circuloDeCaneta("Buscar")} /></svg>
    <svg class="lupa-busca" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.busca} />
    <span>Buscar</span>
    <kbd data-atalho><span class="tecla-mac">⌘K</span><span class="tecla-ctrl">Ctrl K</span></kbd>
  </button>
  <div class="perfis">
    <a href={AUTOR.github} aria-label="GitHub de Cesar Schutz" title="GitHub" rel="me">
      <svg class="marca-perfil" viewBox={MARCAS.github.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.github.d} /></svg>
      <svg class="circulo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path pathLength="1" d={circuloDeCaneta("GitHub")} /></svg>
    </a>
    <a href={AUTOR.linkedin} aria-label="LinkedIn de Cesar Schutz" title="LinkedIn" rel="me">
      <svg class="marca-perfil linkedin" viewBox={MARCAS.linkedin.viewBox} aria-hidden="true" focusable="false"><path d={MARCAS.linkedin.d} /></svg>
      <svg class="circulo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path pathLength="1" d={circuloDeCaneta("LinkedIn")} /></svg>
    </a>
  </div>
  <SeletorTema />
  <button type="button" class="botao-menu" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir o menu" data-botao-menu>
    <svg class="contorno" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d={contornoDeCaneta("menu")} /></svg>
    <svg class="circulo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path pathLength="1" d={circuloDeCaneta("Menu")} /></svg>
    <span class="tracos" aria-hidden="true"
      ><svg viewBox="0 0 100 8" preserveAspectRatio="none" focusable="false"><path d={tracoDeCaneta("menu de cima", 0, 0.45, 3)} /></svg><svg
        viewBox="0 0 100 8"
        preserveAspectRatio="none"
        focusable="false"><path d={tracoDeCaneta("menu de baixo", 0, 0.45, 3)} /></svg
      ></span
    >
  </button>
</header>
</div>
<div class="veu-menu" data-veu-menu aria-hidden="true"></div>

<script>
  // O menu do celular (D46): o botão abre as seções numa folha que desce do cabeçalho, com o véu
  // sobre a página. Fecha no botão, com Esc, num toque fora, ao escolher um item e se a tela alargar.
  {
    const raiz = document.documentElement;
    const botao = document.querySelector<HTMLButtonElement>("[data-botao-menu]")!;
    const menu = document.getElementById("menu-principal")!;
    const veu = document.querySelector<HTMLElement>("[data-veu-menu]")!;
    const celular = matchMedia("(max-width: 860px)");
    const aberto = () => botao.getAttribute("aria-expanded") === "true";
    // Aberto pelo teclado, o foco vai para o primeiro item; pelo toque, fica no botão.
    const alternar = (abrir: boolean, devolverFoco = false, focarItem = false) => {
      botao.setAttribute("aria-expanded", String(abrir));
      botao.setAttribute("aria-label", abrir ? "Fechar o menu" : "Abrir o menu");
      if (abrir) raiz.dataset.menuAberto = "";
      else delete raiz.dataset.menuAberto;
      if (abrir && focarItem) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      else if (!abrir && devolverFoco) botao.focus({ preventScroll: true });
    };
    botao.addEventListener("click", (e) => alternar(!aberto(), false, e.detail === 0));
    veu.addEventListener("click", () => alternar(false));
    menu.addEventListener("click", (e) => (e.target as HTMLElement).closest("a") && alternar(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && aberto()) alternar(false, true);
    });
    // O foco que sai do menu aberto (Tab depois do último item) fecha.
    menu.addEventListener("focusout", (e) => {
      const para = e.relatedTarget as Node | null;
      if (aberto() && para && !menu.contains(para) && para !== botao) alternar(false);
    });
    celular.addEventListener("change", () => alternar(false));
    // Voltar pelo histórico (bfcache) não pode trazer o menu aberto.
    addEventListener("pageshow", () => alternar(false));
    // Rodada 3 (área 7, T12): sem hover, o dedo que encosta num item do menu gira as letras dele (o mouse
    // e o teclado giram pelo CSS, no hover e no foco).
    menu.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType !== "touch") return;
        const item = (e.target as HTMLElement).closest("a");
        if (!item) return;
        item.classList.add("girando");
        const soltar = () => item.classList.remove("girando");
        item.addEventListener("pointercancel", soltar, { once: true });
        setTimeout(soltar, 900);
      },
      { passive: true },
    );
    addEventListener("pageshow", () => menu.querySelectorAll(".girando").forEach((a) => a.classList.remove("girando")));
  }
</script>

<style>
  /*
   * Fixo no alto: fundo da página translúcido, com desfoque, e um fio embaixo (D44). Depois dos
   * primeiros pixels de rolagem, uma sombra suave se junta ao fio (animação ligada à rolagem, onde
   * houver; sem ela, fica só o fio).
   */
  .topo-fixo {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    /* O fio que separa o cabeçalho da página (D44), sempre à vista; por dentro, sem mudar a altura. */
    box-shadow: inset 0 -1px 0 var(--rule);
  }

  @supports (animation-timeline: scroll()) {
    .topo-fixo {
      animation: fio-do-topo linear both;
      animation-timeline: scroll(root);
      animation-range: 0 24px;
    }
  }

  /* Com a página rolada, o fio ganha uma sombra suave embaixo. */
  @keyframes fio-do-topo {
    to {
      box-shadow:
        inset 0 -1px 0 var(--rule),
        0 8px 20px -16px rgb(0 0 0 / 0.35);
    }
  }

  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    min-height: var(--altura-cabecalho);
    padding-top: 10px;
    padding-bottom: 10px;
  }

  /*
   * O lugar da marca: nos artigos com sumário (C2, D49), a marca e o nome da seção atual se revezam
   * nele, deslizando na direção da leitura (artigo.ts põe o data-pos: "meio" é o que está à vista).
   */
  .lugar-marca {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-width: 0;
    min-height: 40px;
    margin-right: auto;
    /* Só corta na vertical (a seção desliza); o livro da marca pode abrir para os lados. */
    overflow-x: visible;
    overflow-y: clip;
  }

  .lugar-marca > :global(.marca),
  .vaga {
    transition:
      translate 0.35s cubic-bezier(0.55, 0, 1, 0.45),
      opacity 0.35s cubic-bezier(0.55, 0, 1, 0.45),
      visibility 0s linear 0.35s;
  }

  .lugar-marca > :global(.marca[data-pos="meio"]),
  .vaga[data-pos="meio"] {
    visibility: visible;
    transition:
      translate 0.35s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      opacity 0.35s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      visibility 0s;
  }

  .lugar-marca > :global(.marca[data-pos="cima"]),
  .vaga[data-pos="cima"] {
    translate: 0 -100%;
    opacity: 0;
    visibility: hidden;
  }

  .lugar-marca > :global(.marca[data-pos="baixo"]),
  .vaga[data-pos="baixo"] {
    translate: 0 100%;
    opacity: 0;
    visibility: hidden;
  }

  .secao-atual {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }

  .secao-atual[hidden] {
    display: none;
  }

  .vaga {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .vaga .num {
    flex: none;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .vaga .nome {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-titulo);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .vaga svg {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate 0.25s;
  }

  .secao-atual[aria-expanded="true"] svg {
    rotate: 180deg;
  }

  .secao-atual:focus-visible {
    outline-offset: -2px;
  }

  /* Com a lateral (≥ 1300px), o sumário já está à vista: a marca fica sempre. */
  @media (min-width: 1300px) {
    .secao-atual {
      display: none;
    }

    .lugar-marca > :global(.marca) {
      translate: none !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-family: var(--font-ui);
    font-size: 15.5px;
  }

  .menu a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  /* A nota de cada seção e os perfis só existem no menu do celular. */
  .menu .nota,
  .menu-perfis,
  .botao-menu {
    display: none;
  }

  .menu a:hover {
    color: var(--ink);
  }

  /* A seção atual: o nome em azul-tinta, sublinhado pelo traço de caneta (traco.css). */
  .menu [aria-current="page"] {
    color: var(--acento);
  }

  .menu .nome {
    position: relative;
    display: inline-block;
  }

  /*
   * O texto que rola (protótipo 14, G20): cada letra tem a cópia dela uma linha abaixo (a sombra do
   * texto); no hover, as letras sobem uma depois da outra e a cópia entra no lugar. O traço do mouse
   * (o rascunho preto) saiu daqui: o gesto agora é o texto. O traço azul da seção atual continua.
   */
  .rola {
    display: inline-flex;
    height: 1.25em;
    overflow: clip;
    line-height: 1.25;
    vertical-align: bottom;
  }

  /* Rodada 3 (área 7, T12): 0,32s por letra, 12ms entre elas. Gira no hover (mouse), no foco do teclado e,
     no toque, enquanto o dedo encosta. */
  .rola > span {
    display: inline-block;
    text-shadow: 0 1.4em currentColor;
    transition: translate 0.32s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--k) * 12ms);
  }

  .menu a:focus-visible .rola > span {
    translate: 0 -1.4em;
  }

  @media (hover: hover) {
    .menu a:hover .rola > span {
      translate: 0 -1.4em;
    }
  }

  /* No toque, o dedo que encosta no item gira as letras (a classe vem do script, abaixo). */
  .menu a.girando .rola > span {
    translate: 0 -1.4em;
  }

  .menu .traco-leve,
  .menu .num {
    display: none;
  }

  /* Entre as páginas, o traço da seção atual desliza para o item novo (base.css). */
  @media (min-width: 860.02px) {
    .traco-atual {
      view-transition-name: traco-do-menu;
    }
  }

  /*
   * A busca parece um campo, mas é um botão: abre o diálogo (Busca.astro). À caneta (C04, D52): a
   * pílula continua (é o que diz "campo" de longe), com o fundo de papel, mas o contorno é feito à mão,
   * a lápis (a tinta do botão, fraca), numa volta só que passa um nada do começo; no hover, a caneta
   * passa por cima (o contorno escurece). A lupa é da caneta preta. O tamanho é fixo (210 × 40), o
   * mesmo da caixa do desenho, para o traço não esticar.
   */
  .campo-busca {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    width: 210px;
    height: 40px;
    padding: 7px 10px 7px 13px;
    border: 0;
    border-radius: 2px; /* papel (rodada 4, H5): a etiqueta das pílulas (base.css, .pilula) */
    background: var(--paper-hi);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ink) 9%, transparent),
      0 1px 1px color-mix(in oklab, var(--sombra-quente) 16%, transparent);
    color: var(--ink-2);
    transition:
      box-shadow 0.15s,
      color 0.15s;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }

  .campo-busca:hover {
    color: var(--ink);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--acento) 55%, transparent),
      0 1px 2px color-mix(in oklab, var(--sombra-quente) 22%, transparent);
  }

  :global(:root[data-theme="dark"]) .campo-busca {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ink) 9%, transparent),
      0 1px 1px color-mix(in oklab, var(--sombra-quente) 50%, transparent);
  }

  :global(:root[data-theme="dark"]) .campo-busca:hover {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--acento) 55%, transparent),
      0 1px 2px color-mix(in oklab, var(--sombra-quente) 50%, transparent);
  }

  /* Rodada 4: a pílula a lápis saiu (o campo é papel, com o canto reto); a roda do celular continua. */
  .contorno-pilula {
    display: none;
  }

  /* O contorno a lápis dos botões do cabeçalho (a pílula da busca, a roda dela e o menu no celular). */
  .contorno {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-opacity: 0.42;
    transition: stroke-opacity 0.2s;
  }

  .campo-busca:hover .contorno-pilula {
    stroke-opacity: 0.8;
  }

  .contorno-roda,
  .campo-busca .circulo {
    display: none;
  }

  /* O círculo da caneta que passa por cima dos botões redondos (traco.css), na tinta do botão. */
  :is(.campo-busca, .botao-menu) .circulo path {
    stroke: currentColor;
  }

  .lupa-busca {
    flex: none;
    width: 16px;
    height: 16px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A lupa inclina e sobe um nada no hover, como quem pega a lupa (D49). */
  .lupa-busca {
    transform-box: fill-box;
    transform-origin: 40% 40%;
    transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .campo-busca:is(:hover, :focus-visible) .lupa-busca {
    transform: rotate(-14deg) translateY(-1px);
  }

  /* A tecla desenhada responde à de verdade: afunda 1,5px e perde a sombra (Busca.astro, .apertada). */
