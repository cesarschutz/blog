---
/**
 * Cabeçalho (briefing §5.1, D26, D31, D33): a marca à esquerda; à direita Artigos, Categorias,
 * Séries e Tags, a busca como campo (ícone, "Buscar" e ⌘K), o GitHub e o LinkedIn (só os ícones, como
 * no blog atual) e o botão de tema (D39). Fica fixo no alto enquanto a página rola
 * (sticky), com fundo translúcido e um fio embaixo que aparece depois de rolar. A altura dele fica em
 * --altura-cabecalho e o quanto as outras peças fixas e as âncoras descontam, em --altura-topo
 * (base.css). No celular (até 860px, D46), fica sempre à vista, numa linha só: a marca, a busca (só o
 * ícone), o tema e o botão do menu, que abre as seções numa folha que desce do cabeçalho.
 */
import Marca from "./Marca.astro";
import SeletorTema from "./SeletorTema.astro";
import { AUTOR } from "../data/site";
import { ICONES } from "../lib/icones";
import { url } from "../lib/url";

interface Props {
  atual?: "artigos" | "categorias" | "series" | "tags";
}

const { atual } = Astro.props;
// As seções; a nota só aparece no menu do celular (D46).
const ITENS = [
  { chave: "artigos", nome: "Artigos", nota: "Todos, do mais novo ao mais antigo", href: url("/archive/") },
  { chave: "categorias", nome: "Categorias", nota: "Os livros da coleção", href: url("/categories/") },
  { chave: "series", nome: "Séries", nota: "Para ler em ordem", href: url("/series/") },
  { chave: "tags", nome: "Tags", nota: "Por assunto", href: url("/tags/") },
] as const;
---

<div class="topo-fixo">
<header class="cabecalho wrap">
  <Marca />
  <nav class="menu" id="menu-principal" aria-label="Principal">
    {
      ITENS.map((item, i) => (
        <a href={item.href} aria-current={atual === item.chave ? "page" : undefined} style={`--i:${i}`}>
          <span class="nome">{item.nome}</span>
          <span class="nota">{item.nota}</span>
        </a>
      ))
    }
    <div class="menu-perfis" style={`--i:${ITENS.length}`}>
      <a href={AUTOR.github} rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.github} />GitHub
      </a>
      <a href={AUTOR.linkedin} rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.linkedin} />LinkedIn
      </a>
    </div>
  </nav>
  <button type="button" class="campo-busca" data-busca-abrir aria-label="Buscar" aria-keyshortcuts="Meta+K Control+K">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.busca} />
    <span>Buscar</span>
    <kbd data-atalho>⌘K</kbd>
  </button>
  <div class="perfis">
    <a href={AUTOR.github} aria-label="GitHub de Cesar Schutz" title="GitHub" rel="me">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.github} />
    </a>
    <a href={AUTOR.linkedin} aria-label="LinkedIn de Cesar Schutz" title="LinkedIn" rel="me">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.linkedin} />
    </a>
  </div>
  <SeletorTema />
  <button type="button" class="botao-menu" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir o menu" data-botao-menu>
    <span class="tracos" aria-hidden="true"><span></span><span></span></span>
  </button>
</header>
</div>
<div class="veu-menu" data-veu-menu aria-hidden="true"></div>

<script>
  // O menu do celular (D46): o botão abre as seções numa folha que desce do cabeçalho, com o véu
  // sobre a página. Fecha no botão, com Esc, num toque fora, ao escolher um item e se a tela alargar.
  {
    const raiz = document.documentElement;
    const botao = document.querySelector<HTMLButtonElement>("[data-botao-menu]")!;
    const menu = document.getElementById("menu-principal")!;
    const veu = document.querySelector<HTMLElement>("[data-veu-menu]")!;
    const celular = matchMedia("(max-width: 860px)");
    const aberto = () => botao.getAttribute("aria-expanded") === "true";
    // Aberto pelo teclado, o foco vai para o primeiro item; pelo toque, fica no botão.
    const alternar = (abrir: boolean, devolverFoco = false, focarItem = false) => {
      botao.setAttribute("aria-expanded", String(abrir));
      botao.setAttribute("aria-label", abrir ? "Fechar o menu" : "Abrir o menu");
      if (abrir) raiz.dataset.menuAberto = "";
      else delete raiz.dataset.menuAberto;
      if (abrir && focarItem) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      else if (!abrir && devolverFoco) botao.focus({ preventScroll: true });
    };
    botao.addEventListener("click", (e) => alternar(!aberto(), false, e.detail === 0));
    veu.addEventListener("click", () => alternar(false));
    menu.addEventListener("click", (e) => (e.target as HTMLElement).closest("a") && alternar(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && aberto()) alternar(false, true);
    });
    // O foco que sai do menu aberto (Tab depois do último item) fecha.
    menu.addEventListener("focusout", (e) => {
      const para = e.relatedTarget as Node | null;
      if (aberto() && para && !menu.contains(para) && para !== botao) alternar(false);
    });
    celular.addEventListener("change", () => alternar(false));
    // Voltar pelo histórico (bfcache) não pode trazer o menu aberto.
    addEventListener("pageshow", () => alternar(false));
  }

  // Fora do macOS e do iOS, o atalho é Ctrl+K.
  const apple = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
  if (!apple) {
    document.querySelectorAll("[data-atalho]").forEach((tecla) => (tecla.textContent = "Ctrl K"));
  }
</script>

<style>
  /*
   * Fixo no alto: fundo da página translúcido, com desfoque, e um fio embaixo (D44). Depois dos
   * primeiros pixels de rolagem, uma sombra suave se junta ao fio (animação ligada à rolagem, onde
   * houver; sem ela, fica só o fio).
   */
  .topo-fixo {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    /* O fio que separa o cabeçalho da página (D44), sempre à vista; por dentro, sem mudar a altura. */
    box-shadow: inset 0 -1px 0 var(--rule);
  }

  @supports (animation-timeline: scroll()) {
    .topo-fixo {
      animation: fio-do-topo linear both;
      animation-timeline: scroll(root);
      animation-range: 0 24px;
    }
  }

  /* Com a página rolada, o fio ganha uma sombra suave embaixo. */
  @keyframes fio-do-topo {
    to {
      box-shadow:
        inset 0 -1px 0 var(--rule),
        0 8px 20px -16px rgb(0 0 0 / 0.35);
    }
  }

  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    min-height: var(--altura-cabecalho);
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .cabecalho > :global(.marca) {
    margin-right: auto;
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-family: var(--font-ui);
    font-size: 15.5px;
  }

  .menu a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  /* A nota de cada seção e os perfis só existem no menu do celular. */
  .menu .nota,
  .menu-perfis,
  .botao-menu {
    display: none;
  }

  .menu a:hover {
    color: var(--ink);
  }

  .menu [aria-current="page"] {
    color: var(--acento);
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  /* A busca parece um campo, mas é um botão: abre o diálogo (Busca.astro). */
  .campo-busca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 210px;
    min-height: 40px;
    padding: 7px 10px 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-hi);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }

  .campo-busca:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .campo-busca svg,
  .perfis svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .campo-busca svg {
    width: 16px;
    height: 16px;
  }

  .campo-busca kbd {
    margin-left: auto;
  }

  /* GitHub e LinkedIn: só os ícones, sem borda, colados ao botão de tema. */
  .perfis {
    display: flex;
    flex: none;
    gap: 2px;
    margin-right: -8px;
  }

  .perfis a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--ink-2);
  }

  .perfis a:hover {
    background: var(--well);
    color: var(--ink);
  }

  .perfis svg {
    width: 18px;
    height: 18px;
  }

  /* Até 1100px, a busca vira só o ícone, redonda como o botão de tema. */
  @media (max-width: 1100px) {
    .campo-busca {
      display: grid;
      place-items: center;
      width: 38px;
      min-width: 0;
      height: 38px;
      min-height: 0;
      padding: 0;
      border-radius: 50%;
    }

    .campo-busca span,
    .campo-busca kbd {
      display: none;
    }
  }

  /*
   * Até 860px (D46): uma linha só, sempre à vista. A marca, a busca, o tema e o botão do menu; as
   * seções vão para uma folha que desce do cabeçalho (recorte de cima para baixo, com os itens
   * chegando em sequência) e um véu escurece a página por baixo.
   */
  @media (max-width: 860px) {
    .cabecalho {
      flex-wrap: nowrap;
      gap: 8px;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .perfis {
      display: none;
    }

    .botao-menu {
      display: grid;
      flex: none;
      place-items: center;
      width: 38px;
      height: 38px;
      padding: 0;
      border: 1px solid var(--rule);
      border-radius: 50%;
      background: var(--paper-hi);
      color: var(--ink);
      cursor: pointer;
    }

    .botao-menu:hover {
      border-color: var(--ink-3);
    }

    /* Dois traços que viram um X. */
    .tracos {
      position: relative;
      width: 16px;
      height: 10px;
    }

    .tracos span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.6px;
      border-radius: 1px;
      background: currentColor;
      transition:
        translate 0.3s cubic-bezier(0.2, 0.75, 0.2, 1),
        rotate 0.3s cubic-bezier(0.2, 0.75, 0.2, 1);
    }

    .tracos span:first-child {
      top: 0;
    }

    .tracos span:last-child {
      bottom: 0;
    }

    [aria-expanded="true"] .tracos span:first-child {
      translate: 0 4.2px;
      rotate: 45deg;
    }

    [aria-expanded="true"] .tracos span:last-child {
      translate: 0 -4.2px;
      rotate: -45deg;
    }

    .menu {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: block;
      padding: 4px var(--pad) 20px;
      border-bottom: 1px solid var(--rule);
      background: var(--paper-hi);
      box-shadow: 0 28px 40px -30px rgb(0 0 0 / 0.45);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition:
        clip-path 0.34s cubic-bezier(0.6, 0, 0.8, 0.4),
        visibility 0s linear 0.34s;
    }

    :global(:root[data-menu-aberto]) .menu {
      clip-path: inset(0 0 -60px 0);
      visibility: visible;
      transition: clip-path 0.46s cubic-bezier(0.2, 0.75, 0.2, 1);
    }

    .menu a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 15px 2px 14px;
      border-bottom: 1px solid var(--rule);
      color: var(--ink);
    }

    .menu a,
    .menu-perfis {
      opacity: 0;
      translate: 0 -8px;
      transition:
        opacity 0.2s,
        translate 0.2s;
    }

    :global(:root[data-menu-aberto]) .menu :is(a, .menu-perfis) {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.4s calc(0.08s + var(--i) * 0.05s),
        translate 0.5s cubic-bezier(0.2, 0.75, 0.2, 1) calc(0.08s + var(--i) * 0.05s);
    }

    .menu .nome {
      font-family: var(--font-titulo);
      font-weight: 700;
      font-size: 24px;
      line-height: 1.15;
      letter-spacing: -0.01em;
    }

    .menu .nota {
      display: block;
      font-family: var(--font-ui);
      font-size: 13.5px;
      color: var(--ink-2);
      text-align: right;
    }

    /* A seção atual: o nome em azul-tinta, com um traço à esquerda. */
    .menu [aria-current="page"] {
      text-decoration: none;
    }

    .menu [aria-current="page"] .nome {
      color: var(--acento);
    }

    .menu [aria-current="page"] .nome::before {
      content: "";
      display: inline-block;
      width: 14px;
      height: 2px;
      margin-right: 10px;
      vertical-align: 0.32em;
      background: var(--acento);
    }

    .menu-perfis {
      display: flex;
      gap: 22px;
      padding-top: 16px;
    }

    .menu-perfis a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 0;
      border: 0;
      font-family: var(--font-ui);
      font-size: 14.5px;
      color: var(--ink-2);
    }

    .menu-perfis svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* O véu sobre a página, abaixo do cabeçalho. */
    .veu-menu {
      position: fixed;
      inset: 0;
      z-index: 29;
      background: rgb(20 22 24 / 0.32);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s,
        visibility 0s linear 0.3s;
    }

    :global(:root[data-menu-aberto]) .veu-menu {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.35s;
    }
  }

  @media (min-width: 860.02px) {
    .veu-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu a,
    .menu-perfis,
    .veu-menu,
    .tracos span {
      transition: none !important;
    }
  }

  /* Telefones de 320px: a marca encolhe um pouco para a linha caber. */
  @media (max-width: 400px) {
    .cabecalho > :global(.marca) {
      font-size: 18px;
    }
  }
</style>
