---
/**
 * Cabeçalho (briefing §5.1, D26, D31, D33): a marca à esquerda; à direita Artigos, Categorias,
 * Séries e Tags, a busca como campo (ícone, "Buscar" e ⌘K), o GitHub e o LinkedIn (só os ícones, como
 * no blog atual) e o menu de aparência (tema e som). Fica fixo no alto enquanto a página rola
 * (sticky), com fundo translúcido e um fio embaixo que aparece depois de rolar. No celular, marca,
 * busca (só o ícone) e aparência na primeira linha; o menu na segunda. A altura dele fica em
 * --altura-cabecalho e o quanto as outras peças fixas e as âncoras descontam, em --altura-topo
 * (base.css). No celular (até 860px), ele some ao rolar para baixo e volta ao rolar para cima (D38):
 * sobe por translate, sem mudar a altura da página, e --altura-topo vai a 0 enquanto isso.
 */
import Marca from "./Marca.astro";
import SeletorTema from "./SeletorTema.astro";
import { AUTOR } from "../data/site";
import { ICONES } from "../lib/icones";
import { url } from "../lib/url";

interface Props {
  atual?: "artigos" | "categorias" | "series" | "tags";
}

const { atual } = Astro.props;
---

<div class="topo-fixo">
<header class="cabecalho wrap">
  <Marca />
  <nav class="menu" aria-label="Principal">
    <a href={url("/archive/")} aria-current={atual === "artigos" ? "page" : undefined}>Artigos</a>
    <a href={url("/categories/")} aria-current={atual === "categorias" ? "page" : undefined}>Categorias</a>
    <a href={url("/series/")} aria-current={atual === "series" ? "page" : undefined}>Séries</a>
    <a href={url("/tags/")} aria-current={atual === "tags" ? "page" : undefined}>Tags</a>
  </nav>
  <button type="button" class="campo-busca" data-busca-abrir aria-label="Buscar" aria-keyshortcuts="Meta+K Control+K">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.busca} />
    <span>Buscar</span>
    <kbd data-atalho>⌘K</kbd>
  </button>
  <div class="perfis">
    <a href={AUTOR.github} aria-label="GitHub de Cesar Schutz" title="GitHub" rel="me">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.github} />
    </a>
    <a href={AUTOR.linkedin} aria-label="LinkedIn de Cesar Schutz" title="LinkedIn" rel="me">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.linkedin} />
    </a>
  </div>
  <SeletorTema />
</header>
</div>

<script>
  // No celular, o cabeçalho some ao rolar para baixo e volta ao rolar para cima (D38). Volta também
  // perto do topo, com o foco dentro dele (teclado) e com o menu de aparência aberto.
  {
    const raiz = document.documentElement;
    const celular = matchMedia("(max-width: 860px)");
    const topo = document.querySelector<HTMLElement>(".topo-fixo")!;
    let ultimo = scrollY;
    let pedido = 0;
    const mostrar = () => delete raiz.dataset.topoOculto;
    const conferir = () => {
      pedido = 0;
      const y = scrollY;
      const aberto = topo.contains(document.activeElement) || topo.querySelector("[aria-expanded='true']");
      if (!celular.matches || y < 120 || aberto) mostrar();
      else if (y > ultimo + 8) raiz.dataset.topoOculto = "";
      else if (y < ultimo - 8) mostrar();
      if (Math.abs(y - ultimo) > 8 || y < 120) ultimo = y;
    };
    addEventListener("scroll", () => (pedido ||= requestAnimationFrame(conferir)), { passive: true });
    topo.addEventListener("focusin", mostrar);
    celular.addEventListener("change", mostrar);
  }

  // Fora do macOS e do iOS, o atalho é Ctrl+K.
  const apple = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
  if (!apple) {
    document.querySelectorAll("[data-atalho]").forEach((tecla) => (tecla.textContent = "Ctrl K"));
  }
</script>

<style>
  /*
   * Fixo no alto: fundo da página translúcido, com desfoque. O fio embaixo aparece depois dos
   * primeiros pixels de rolagem (animação ligada à rolagem, onde houver; sem ela, fica sem fio).
   */
  .topo-fixo {
    position: sticky;
    top: 0;
    z-index: 30;
    transition: translate 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 transparent;
  }

  @supports (animation-timeline: scroll()) {
    .topo-fixo {
      animation: fio-do-topo linear both;
      animation-timeline: scroll(root);
      animation-range: 0 24px;
    }
  }

  @media (max-width: 860px) {
    :global(:root[data-topo-oculto]) .topo-fixo {
      translate: 0 -100%;
    }
  }

  @keyframes fio-do-topo {
    to {
      box-shadow:
        0 1px 0 var(--rule),
        0 8px 20px -16px rgb(0 0 0 / 0.35);
    }
  }

  .cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    min-height: var(--altura-cabecalho);
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .cabecalho > :global(.marca) {
    margin-right: auto;
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-family: var(--font-ui);
    font-size: 15.5px;
  }

  .menu a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  .menu a:hover {
    color: var(--ink);
  }

  .menu [aria-current="page"] {
    color: var(--acento);
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  /* A busca parece um campo, mas é um botão: abre o diálogo (Busca.astro). */
  .campo-busca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 210px;
    min-height: 40px;
    padding: 7px 10px 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-hi);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }

  .campo-busca:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .campo-busca svg,
  .perfis svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .campo-busca svg {
    width: 16px;
    height: 16px;
  }

  .campo-busca kbd {
    margin-left: auto;
  }

  /* GitHub e LinkedIn: só os ícones, sem borda, colados ao botão de aparência. */
  .perfis {
    display: flex;
    flex: none;
    gap: 2px;
    margin-right: -8px;
  }

  .perfis a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--ink-2);
  }

  .perfis a:hover {
    background: var(--well);
    color: var(--ink);
  }

  .perfis svg {
    width: 18px;
    height: 18px;
  }

  /* Até 1100px, a busca vira só o ícone, redonda como o botão de aparência. */
  @media (max-width: 1100px) {
    .campo-busca {
      display: grid;
      place-items: center;
      width: 38px;
      min-width: 0;
      height: 38px;
      min-height: 0;
      padding: 0;
      border-radius: 50%;
    }

    .campo-busca span,
    .campo-busca kbd {
      display: none;
    }
  }

  /* Até 860px, duas linhas: marca, busca, perfis e aparência na primeira; o menu na segunda (o
     pseudo-elemento força a quebra). */
  @media (max-width: 860px) {
    .cabecalho {
      gap: 6px 12px;
      padding-top: 8px;
      padding-bottom: 6px;
    }

    .cabecalho::after {
      content: "";
      order: 2;
      flex-basis: 100%;
      height: 0;
    }

    .cabecalho > :global(.marca) {
      order: 1;
    }

    .campo-busca,
    .perfis,
    .cabecalho > :global(.aparencia) {
      order: 1;
    }

    .menu {
      order: 3;
      gap: 4px 18px;
    }
  }

  /* Telefones estreitos: o GitHub e o LinkedIn ficam só no rodapé, para a primeira linha caber. */
  @media (max-width: 520px) {
    .perfis {
      display: none;
    }
  }

  /* Telefones de 320px: a marca encolhe um pouco para a primeira linha não quebrar. */
  @media (max-width: 400px) {
    .cabecalho > :global(.marca) {
      font-size: 18px;
    }
  }
</style>
