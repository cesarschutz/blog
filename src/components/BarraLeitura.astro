---
/**
 * Barra de progresso da leitura (briefing §5.3, D45): um traço de 2px sobre o fio embaixo do cabeçalho,
 * escrito por uma caneta pequena que vai na ponta dele. Desde a B05 (D52), é a caneta azul (`--caneta`,
 * a do caderno, D48): a mesma que escreve o fio do sumário e sublinha a seção atual, e não mais a cor
 * da categoria (que fica no livro). O cabeçalho fica sempre à vista, também no celular (D46).
 * Quem move é src/scripts/artigo.ts (a variável --lido, de 0 a 1, e a classe "escrevendo", que mostra
 * a caneta depois do início); sem JS, fica vazia.
 */
---

<div class="barra-leitura" aria-hidden="true" data-barra-leitura>
  <div class="risco"></div>
  <svg class="caneta" viewBox="0 0 24 24" focusable="false">
    <path class="corpo" d="M8.2 13.2 17.4 4a1.4 1.4 0 0 1 2 0l.6.6a1.4 1.4 0 0 1 0 2l-9.2 9.2Z" />
    <path class="anel" d="m15.6 5.8 2.6 2.6" />
    <path class="ponta" d="M8.2 13.2 10.8 15.8 4 20Z" />
  </svg>
</div>

<style>
  .barra-leitura {
    position: fixed;
    /* Sobre o fio do cabeçalho. */
    top: calc(env(safe-area-inset-top, 0px) + var(--altura-topo) - 2px);
    left: 0;
    right: 0;
    z-index: 40;
    height: 2px;
    container-type: inline-size;
    pointer-events: none;
  }

  .risco {
    position: absolute;
    inset: 0;
    background: var(--caneta);
    transform: scaleX(var(--lido, 0));
    transform-origin: 0 50%;
  }

  /* A ponta da caneta (4, 20 no desenho de 24) encosta no fim do traço. */
  .caneta {
    position: absolute;
    top: -17.3px;
    left: -3.7px;
    width: 22px;
    height: 22px;
    overflow: visible;
    opacity: 0;
    transform: translateX(calc(var(--lido, 0) * 100cqw));
    transition: opacity 0.2s;
  }

  .escrevendo .caneta {
    opacity: 1;
  }

  /* A caneta azul: o corpo com um pouco da tinta, a ponta e o anel na tinta dela. */
  .corpo {
    fill: color-mix(in oklab, var(--caneta) 16%, var(--paper-hi));
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .anel {
    fill: none;
    stroke: var(--caneta);
    stroke-width: 1.6;
  }

  .ponta {
    fill: var(--caneta);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .caneta {
      transition: none;
    }
  }

  @media print {
    .barra-leitura {
      display: none;
    }
  }
</style>
