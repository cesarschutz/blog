---
/**
 * A marca do blog (D33, D47): o livro "cs" (a capa do Volume 01, com o "c" acima e o "s" abaixo, sem
 * a fita), o nome e "blog" em itálico. Em linha no cabeçalho e no rodapé. Na abertura da home, onde ela
 * é o h1 (variante "grande", D47), o livro fica grande, da altura de duas linhas, com "Cesar" e
 * "Schutz" um embaixo do outro ao lado dele e o "blog" depois do sobrenome. O ícone do navegador é o
 * mesmo livro sobre um quadrado de papel. O traçado do livro e do "blog" vem de src/lib/marca.ts, e os
 * ícones de public/, todos gerados por scripts/marca.mjs.
 *
 * O livro abre (D41): ao passar o mouse (ou focar o link), a capa entreabre 38° sobre as páginas, só
 * com CSS. Para isso o livro são duas camadas: atrás, o miolo do caderno (a página creme e pautada de
 * src/lib/caderno.ts, A01, D52); na frente, a capa. No fim da abertura da home, depois do desenho do
 * destaque, o do cabeçalho e o grande acenam juntos, uma vez: a classe `acena` (posta pela
 * Abertura.astro, B13, D52) abre a capa como o hover e, ao sair, ela fecha.
 *
 * A caneta preta (C04, D52): na abertura da home, embaixo de "Schutz", a assinatura, o único traço
 * grande do site (largura que muda, src/lib/traco.ts). Com a abertura, ela é escrita uma vez, quando o
 * caderno termina de acenar (Abertura.astro, classes `a-escrever` e `escreve`); sem a abertura, já
 * está pronta. No cabeçalho (`traco`), um traço curto de caneta passa embaixo do "blog" no hover,
 * junto com a capa que entreabre (o traço leve do menu, traco.css). No rodapé, nada.
 */
import { BLOG_DESCENDENTE, BLOG_SVG, BLOG_VIEWBOX, MARCA_SVG, MARCA_VIEWBOX } from "../lib/marca";
import { MIOLO_SVG } from "../lib/caderno";
import { assinaturaDeCaneta, tracoDeCaneta } from "../lib/traco";
import { url } from "../lib/url";

interface Props {
  /** "gigante" (protótipo 14, G1): a grande, com o nome numa linha só, na largura da página. */
  variante?: "linha" | "grande" | "gigante";
  /** Sem link: na abertura da home, que já é a página inicial. */
  semLink?: boolean;
  /** O traço da caneta embaixo do "blog" no hover (só o cabeçalho, C04). */
  traco?: boolean;
}

const { variante = "linha", semLink = false, traco = false } = Astro.props;
const Elemento = semLink ? "span" : "a";
---

<Elemento
  class:list={["marca", `marca-${variante}`, { "marca-grande": variante === "gigante" }]}
  href={semLink ? undefined : url("/")}
  style={`--descendente:${BLOG_DESCENDENTE}`}
>
  <span class="marca-livro-3d" aria-hidden="true">
    <svg class="marca-livro marca-miolo" viewBox={MARCA_VIEWBOX} focusable="false" set:html={MIOLO_SVG} />
    <svg class="marca-livro marca-capa-3d" viewBox={MARCA_VIEWBOX} focusable="false" set:html={MARCA_SVG} />
  </span>
  {
    variante !== "linha" ? (
      <span class="marca-texto">
        <span class="marca-nome">
          <span class="marca-linha-nome">Cesar</span> <span class="marca-linha-nome"><span class="sobrenome">Schutz<svg class="assinatura" viewBox="0 0 260 22" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={assinaturaDeCaneta("Cesar Schutz")} /></svg></span><svg class="marca-blog" viewBox={BLOG_VIEWBOX} role="img" aria-label="blog" set:html={BLOG_SVG} /></span>
        </span>
      </span>
    ) : (
      <span class="marca-texto">
        <span class="marca-nome">Cesar Schutz</span>
        {
          traco ? (
            <span class="blog-com-traco">
              <svg class="marca-blog" viewBox={BLOG_VIEWBOX} role="img" aria-label="blog" set:html={BLOG_SVG} />
              <svg class="traco traco-leve traco-preto" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d={tracoDeCaneta("blog", 5, 0.7)} />
              </svg>
            </span>
          ) : (
            <svg class="marca-blog" viewBox={BLOG_VIEWBOX} role="img" aria-label="blog" set:html={BLOG_SVG} />
          )
        }
      </span>
    )
  }
</Elemento>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    color: var(--ink);
    font-family: var(--font-titulo);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .marca-linha {
    font-size: 21px;
  }

  /* O livro fica centrado nas maiúsculas. */
  .marca-livro-3d {
    display: inline-grid;
    flex: none;
    perspective: 12em;
  }

  .marca-livro {
    grid-area: 1 / 1;
    width: auto;
    height: 1.27em;
    overflow: visible;
  }

  /*
   * Atrás, o miolo do caderno (A01, D52; src/lib/caderno.ts): a página creme e pautada, a mesma do
   * caderno da abertura, igual nos dois temas. Na frente, a capa, presa pela lombada (à esquerda). No
   * cabeçalho, pequeno, só a pauta, sem as entrelinhas e com o traço mais fino.
   */
  .marca-linha .marca-miolo :global(.caderno-entrelinha) {
    display: none;
  }

  .marca-linha .marca-miolo :global(:is(.caderno-pagina, .caderno-pauta)) {
    stroke-width: 0.5px;
  }

  .marca-capa-3d {
    position: relative;
    z-index: 1;
    transform-origin: 0 50%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* O aceno do fim da abertura da home (B13, D52, Abertura.astro): o mesmo abrir do hover, uma vez. */
  a.marca:is(:hover, :focus-visible) .marca-capa-3d,
  .marca.acena .marca-capa-3d {
    transform: rotateY(-38deg);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .marca-livro :global(.marca-capa) {
    fill: var(--marca);
  }

  /* No escuro, um contorno claro bem leve separa a capa verde do fundo. */
  :global(:root[data-theme="dark"]) .marca-livro :global(.marca-capa) {
    stroke: color-mix(in oklab, var(--marca-letra) 30%, transparent);
    stroke-width: 1.2px;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .marca-livro :global(.marca-capa) {
      stroke: color-mix(in oklab, var(--marca-letra) 30%, transparent);
      stroke-width: 1.2px;
      vector-effect: non-scaling-stroke;
    }
  }

  .marca-livro :global(.marca-dobra) {
    fill: black;
    opacity: 0.24;
  }

  .marca-livro :global(.marca-letras) {
    fill: var(--marca-letra);
  }

  /* "blog" em traçado, com a linha de base na do nome (a perna do g desce, como na letra). */
  .marca-blog {
    width: auto;
    height: 0.66em;
    margin-left: 0.3em;
    vertical-align: calc(-0.66em * var(--descendente));
    color: var(--ink-2);
    fill: currentColor;
  }

  a.marca:hover .marca-nome {
    color: var(--ink);
  }

  /*
   * A abertura da home (D47): o livro grande, da altura das duas linhas do nome, com "Cesar" e
   * "Schutz" empilhados ao lado e o "blog" depois do sobrenome, na linha de base dele. O livro abre ao
   * passar o mouse, como o do cabeçalho.
   */
  .marca-grande {
    gap: 0.34em;
    font-size: clamp(40px, 5.4vw, 62px);
    letter-spacing: -0.018em;
    white-space: normal;
  }

  .marca-grande .marca-livro-3d {
    filter: drop-shadow(0 0.05em 0.07em rgb(0 0 0 / 0.2));
  }

  .marca-grande .marca-livro {
    height: 2.02em;
  }

  /*
   * No livro grande, o bloco das páginas fica atrás da capa, sem aparecer na borda (rodada 4: com ele um
   * pouco à direita e embaixo, a pauta aparecia de lado e parecia defeito). Ele só se vê quando a capa abre.
   */
  .marca-grande .marca-miolo {
    translate: none;
  }

  .marca-grande .marca-nome {
    display: grid;
    line-height: 0.98;
  }

  .marca-linha-nome {
    white-space: nowrap;
  }

  .marca-grande .marca-blog {
    height: 0.5em;
    margin-left: 0.22em;
    vertical-align: calc(-0.5em * var(--descendente));
  }

  /*
   * A assinatura (C04): embaixo do sobrenome, da largura dele e um nada além, na caneta preta. Com a
   * abertura da home (data-abertura, posto antes da primeira pintura), ela espera escondida até a
   * Abertura.astro mandar escrever: o recorte abre da esquerda para a direita, como a mão que assina.
   */
  .sobrenome {
    position: relative;
  }

  .assinatura {
    position: absolute;
    left: -0.05em;
    bottom: 0.01em;
    width: calc(100% + 0.16em);
    height: 0.3em;
    overflow: visible;
    pointer-events: none;
    fill: var(--ink);
  }

  :global(:root[data-abertura="estante"]) .assinatura,
  .assinatura:global(.a-escrever) {
    clip-path: inset(-60% 100% -60% -4%);
  }

  .assinatura:global(.escreve) {
    animation: assinar 0.9s cubic-bezier(0.5, 0.05, 0.25, 1) both;
  }

  @keyframes assinar {
    from {
      clip-path: inset(-60% 100% -60% -4%);
    }

    to {
      clip-path: inset(-60% -4% -60% -4%);
    }
  }

  /* O "blog" do cabeçalho: o traço curto da caneta passa embaixo dele no hover (traco.css). */
  .blog-com-traco {
    position: relative;
    display: inline-block;
    margin-left: 0.3em;
  }

  .blog-com-traco .marca-blog {
    margin-left: 0;
  }

  /* Embaixo da perna do "g", sem cortá-la. */
  .blog-com-traco :global(.traco) {
    bottom: -9px;
  }

  .marca-grande:is(:hover, :focus-visible) .marca-capa-3d {
    transform: rotateY(-38deg);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
   * A gigante (protótipo 14, G1): o caderno e "Cesar Schutz" numa linha, na largura da coluna (quem a usa
   * dá o tamanho da letra). O caderno fica da altura das maiúsculas e um pouco mais; o "blog" vira o carimbo
   * sobre o Z (D84) e a assinatura continua embaixo do sobrenome. Em tela estreita, o nome quebra em duas
   * linhas e o caderno cresce para a altura delas, como na grande.
   */
  .marca-gigante {
    gap: 0.16em;
    font-size: inherit;
    letter-spacing: -0.04em;
    align-items: flex-end;
  }

  .marca-gigante .marca-nome {
    display: flex;
    column-gap: 0.22em;
    line-height: 0.9;
  }

  .marca-gigante .marca-livro {
    height: 0.84em;
  }

  .marca-gigante .marca-livro-3d {
    margin-bottom: 0.02em;
    filter: drop-shadow(0 0.02em 0.03em rgb(0 0 0 / 0.2));
  }

  /*
   * O carimbo (D84, pedido do Cesar): o "blog" cinza do cabeçalho, inclinado, um pouco por cima do canto do Z,
   * como um carimbo. Fica fora do fluxo (absoluto, preso ao fim de "Schutz"): o nome não sai do lugar por
   * causa dele. Um contorno da cor do papel (por baixo do traço) o separa do preto do Z onde os dois se cruzam.
   * Na abertura da home, ele carimba depois da assinatura (Abertura.astro, `a-carimbar`).
   */
  .marca-gigante .marca-linha-nome:last-child {
    position: relative;
  }

  .marca-gigante .marca-blog {
    position: absolute;
    top: 0.07em;
    right: -0.19em;
    height: 0.29em;
    margin: 0;
    vertical-align: baseline;
    rotate: -13deg;
    pointer-events: none;
  }

  .marca-gigante .marca-blog :global(path) {
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke;
    vector-effect: non-scaling-stroke;
  }

  :global(:root[data-abertura="estante"]) .marca-gigante .marca-blog,
  .marca-gigante .marca-blog:global(.a-carimbar) {
    opacity: 0;
  }

  .marca-gigante .assinatura {
    bottom: 0.1em;
    height: 0.15em;
  }

  @media (max-width: 700px) {
    .marca-gigante {
      align-items: center;
    }

    .marca-gigante .marca-nome {
      display: grid;
    }

    .marca-gigante .marca-livro {
      height: 1.62em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marca-capa-3d {
      transition: none;
    }

    .assinatura:global(.escreve) {
      animation: none;
    }

    .marca:is(:hover, :focus-visible, .acena) .marca-capa-3d {
      transform: none;
    }
  }
</style>
