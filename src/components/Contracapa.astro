---
/**
 * A contracapa do livro (D78, a ideia 1 do Cesar): o verso do livro grande da página do livro, que o botão
 * "Virar o livro" mostra (LivroEmPe, `contracapa`). Vai na face de trás do livro 3D (o slot "contracapa" do
 * Livro3D) e escala com ela, como a capa: referência de 480 × 720, com `--k` = 100cqw / 480.
 *
 * A moldura na cor do livro e, dentro, o papel do livro com o texto, em dois lados:
 * - **o livro**: a frase, "Este livro abrange" com a lista, e embaixo "Sobre a capa" com o texto curto do
 *   desenho e "Ler mais";
 * - **a capa**: o texto completo do desenho, a cor (o nome e o motivo) e o link "Para saber mais", com
 *   "Voltar".
 * No pé, na cor do livro, o volume e o autor. Os livros não mudam com o tema (D39): o papel, a tinta e o
 * destaque são os do livro.
 *
 * O texto tem de caber na face: o tamanho de cada lado (`--f`) sai de uma conta das linhas, aqui no build
 * (a largura média das letras de cada fonte), para o livro de lista mais longa diminuir um pouco a letra em
 * vez de cortar. Nasce `inert` (de frente, o verso não está à vista); quem vira o livro tira (LivroEmPe).
 */
import type { Livro } from "../lib/estante";

interface Props {
  livro: Livro;
}

const { livro } = Astro.props;
const cc = livro.contracapa!;
const volume = String(livro.volume ?? 1).padStart(2, "0");

// A conta das linhas, em unidades da referência (480 × 720). A largura de dentro do papel e a altura dele.
const LARGURA = 480 - 2 * 20 - 2 * 24;
const ALTURA = 720 - 20 - 46 - 2 * 22;
/** Linhas de um texto numa largura, com a letra de `corpo` e a largura média `media` (em ems). */
const linhas = (texto: string, largura: number, corpo: number, media: number) => {
  const porLinha = Math.max(8, Math.floor(largura / (corpo * media)));
  // Quebra por palavras, como o navegador.
  let n = 1;
  let atual = 0;
  for (const palavra of texto.split(/\s+/)) {
    const l = palavra.length + (atual ? 1 : 0);
    if (atual + l > porLinha && atual > 0) {
      n++;
      atual = palavra.length;
    } else atual += l;
  }
  return n;
};
// As larguras médias (em ems) das fontes, medidas no Chrome com os textos dos 13 livros: Literata, Literata
// itálica, Newsreader itálica (a frase) e o título do link (palavras longas, que quebram cedo).
const MEDIA = { texto: 0.54, italico: 0.57, frase: 0.6, link: 0.64 };
const alturaDoLivro = (f: number) =>
  linhas(livro.frase ?? "", LARGURA, 32 * f, MEDIA.frase) * 32 * f * 1.14 +
  14 * f +
  14 * f * 1.25 +
  7 * f +
  cc.abrange.reduce((soma, item) => soma + linhas(item, LARGURA - 16 * f, 17 * f, MEDIA.texto) * 17 * f * 1.3 + 3 * f, 0) +
  30 * f +
  14 * f * 1.25 +
  6 * f +
  linhas(cc.capa.curto, LARGURA, 15 * f, MEDIA.italico) * 15 * f * 1.34 +
  8 * f +
  15 * f * 1.3;
const alturaDaCapa = (f: number) =>
  14 * f * 1.25 +
  8 * f +
  linhas(cc.capa.completo, LARGURA, 15.5 * f, MEDIA.texto) * 15.5 * f * 1.38 +
  14 * f +
  linhas(`A cor: ${cc.cor.nome}. ${cc.cor.motivo}`, LARGURA - 22 * f, 14 * f, MEDIA.texto) * 14 * f * 1.34 +
  12 * f +
  linhas(`Para saber mais: ${cc.capa.link.titulo}`, LARGURA, 14 * f, MEDIA.link) * 14 * f * 1.34 +
  12 * f +
  15 * f * 1.3;
/** O maior tamanho (de 1,25 para baixo) em que o lado cabe, com 5% de folga para a conta. */
const tamanho = (altura: (f: number) => number) => {
  for (let f = 1.25; f > 0.7; f -= 0.01) if (altura(f) <= ALTURA * 0.95) return Math.round(f * 100) / 100;
  return 0.7;
};
const fLivro = tamanho(alturaDoLivro);
const fCapa = tamanho(alturaDaCapa);
---

<div class="contracapa" data-contracapa inert>
  <div class="cc-dentro">
  <div class="cc-papel">
    <section class="cc-lado" data-cc-lado="livro" style={`--f:${fLivro}`}>
      <p class="cc-frase">{livro.frase}</p>
      <h2 class="cc-rotulo" tabindex="-1">Este livro abrange</h2>
      <ul class="cc-abrange">
        {cc.abrange.map((item) => <li>{item}</li>)}
      </ul>
      <div class="cc-sobre">
        <h2 class="cc-rotulo">Sobre a capa</h2>
        <p class="cc-curto">{cc.capa.curto}</p>
        <button type="button" class="cc-botao" data-cc-ir="capa">Ler mais<span class="sr"> sobre a capa</span></button>
      </div>
    </section>
    <section class="cc-lado" data-cc-lado="capa" style={`--f:${fCapa}`} hidden>
      <h2 class="cc-rotulo" tabindex="-1">Sobre a capa</h2>
      <p class="cc-completo">{cc.capa.completo}</p>
      <p class="cc-cor"><span class="cc-amostra" aria-hidden="true"></span><span>A cor: <strong>{cc.cor.nome}</strong>. {cc.cor.motivo}</span></p>
      <p class="cc-link">Para saber mais: <a href={cc.capa.link.url} target="_blank" rel="noopener">{cc.capa.link.titulo}</a></p>
      <button type="button" class="cc-botao" data-cc-ir="livro">Voltar<span class="sr"> ao que o livro abrange</span></button>
    </section>
  </div>
  <p class="cc-pe" aria-hidden="true">Volume {volume} · Cesar Schutz</p>
  </div>
</div>

<style>
  /* A face de trás inteira (o contêiner das medidas): a moldura na cor do livro (o fundo da `.contra`,
     livro.css) e o papel dentro. */
  .contracapa {
    position: absolute;
    inset: 0;
    container-type: size;
    overflow: hidden;
    border-radius: inherit;
  }

  .cc-dentro {
    --k: calc(100cqw / 480);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    padding: calc(20 * var(--k)) calc(20 * var(--k)) 0;
    color: var(--revista-tinta);
    text-align: left;
  }

  .cc-papel {
    position: relative;
    min-height: 0;
    padding: calc(22 * var(--k)) calc(24 * var(--k));
    border-radius: calc(3 * var(--k));
    background:
      var(--grao) 0 0 / 180px 180px,
      var(--cima);
    box-shadow: 0 0 0 calc(1 * var(--k)) color-mix(in oklab, var(--revista-tinta) 10%, transparent);
    overflow: hidden;
  }

  .cc-lado {
    --t: calc(var(--k) * var(--f, 1));
    display: grid;
    align-content: start;
  }

  .cc-lado[hidden] {
    display: none;
  }

  .cc-frase {
    margin: 0 0 calc(14 * var(--t));
    font-family: var(--font-livro-italico);
    font-style: italic;
    font-size: calc(32 * var(--t));
    font-variation-settings: "opsz" 36;
    line-height: 1.14;
    color: var(--cima-tinta);
    text-wrap: balance;
  }

  .cc-rotulo {
    margin: 0 0 calc(7 * var(--t));
    font-family: var(--font-livro);
    font-size: calc(14 * var(--t));
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--cima-tinta);
    outline: none;
  }

  .cc-abrange {
    display: grid;
    gap: calc(3 * var(--t));
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-texto);
    font-size: calc(17 * var(--t));
    line-height: 1.3;
  }

  .cc-abrange li {
    position: relative;
    padding-left: calc(16 * var(--t));
  }

  /* O marcador: um traço curto no destaque do livro, na altura do meio da primeira linha. */
  .cc-abrange li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(17 * var(--t) * 0.68);
    width: calc(8 * var(--t));
    height: max(1px, calc(2 * var(--t)));
    border-radius: 1px;
    background: var(--cima-tinta);
  }

  .cc-sobre {
    margin-top: calc(16 * var(--t));
    padding-top: calc(14 * var(--t));
    border-top: max(1px, calc(1 * var(--t))) solid color-mix(in oklab, var(--cima-tinta) 40%, transparent);
  }

  .cc-curto {
    margin: 0 0 calc(8 * var(--t));
    font-family: var(--font-texto);
    font-style: italic;
    font-size: calc(15 * var(--t));
    line-height: 1.34;
  }

  .cc-completo {
    margin: 0 0 calc(14 * var(--t));
    font-family: var(--font-texto);
    font-size: calc(15.5 * var(--t));
    line-height: 1.38;
    hyphens: auto;
  }

  .cc-cor {
    display: flex;
    gap: calc(8 * var(--t));
    margin: 0 0 calc(12 * var(--t));
    font-family: var(--font-texto);
    font-size: calc(14 * var(--t));
    line-height: 1.34;
  }

  .cc-amostra {
    flex: none;
    width: calc(14 * var(--t));
    height: calc(14 * var(--t));
    margin-top: calc(14 * var(--t) * 0.18);
    border-radius: 50%;
    background: var(--baixo);
    box-shadow: inset 0 0 0 max(1px, calc(1 * var(--t))) color-mix(in oklab, var(--revista-tinta) 25%, transparent);
  }

  .cc-link {
    margin: 0 0 calc(12 * var(--t));
    font-family: var(--font-texto);
    font-size: calc(14 * var(--t));
    line-height: 1.34;
    overflow-wrap: anywhere;
  }

  /* Os links e os botões do verso: no destaque do livro (os livros não mudam com o tema), sublinhados. */
  .cc-link a,
  .cc-botao {
    color: var(--cima-tinta);
    text-decoration: underline;
    text-decoration-thickness: max(1px, calc(1.4 * var(--t)));
    text-underline-offset: 0.18em;
  }

  /* O botão segura o próprio texto `.sr` (dentro do livro 3D, com perspectiva; interface.md, D73). */
  .cc-botao {
    position: relative;
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-livro);
    font-size: calc(15 * var(--t));
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
  }

  .cc-link a:hover,
  .cc-botao:hover {
    text-decoration-thickness: max(2px, calc(2.4 * var(--t)));
  }

  .cc-link a:focus-visible,
  .cc-botao:focus-visible {
    outline: max(2px, calc(2 * var(--t))) solid var(--cima-tinta);
    outline-offset: calc(3 * var(--t));
    border-radius: 2px;
  }

  /* O pé, na moldura: o volume e o autor, na tinta do livro sobre a cor dele (como a capa). */
  .cc-pe {
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(46 * var(--k));
    margin: 0;
    font-family: var(--font-livro);
    font-size: calc(13 * var(--k));
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--baixo-tinta);
  }
</style>
