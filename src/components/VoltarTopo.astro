---
/**
 * Botão "voltar ao topo" (briefing §5.3; em todas as páginas longas desde a D49): aparece depois de
 * uma tela de rolagem, no canto de baixo, e leva ao topo (suave, sem movimento reduzido), com o foco
 * no título da página. Numa página curta, nunca aparece. Começa escondido: sem JS, não aparece (o
 * Home do teclado continua valendo).
 *
 * Chega assentando e a seta sobe junto (D49, protótipo E3): entra subindo 14px com um nada de
 * passada (0,4s, como o back.out do GSAP) e sai mais depressa (0,25s, power2.in), invertendo do ponto
 * em que estiver quando a rolagem vai e volta. No clique, a seta sai por cima (0,18s) e volta por
 * baixo (0,26s) enquanto a página sobe. Escondido, fica fora do Tab. Só CSS, fora a classe do clique.
 */
import { ICONES } from "../lib/icones";
---

<button type="button" class="voltar-topo" aria-label="Voltar ao topo" hidden data-voltar-topo>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.subir} />
</button>

<script>
  const botao = document.querySelector<HTMLButtonElement>("[data-voltar-topo]");
  if (botao) {
    const reduzir = matchMedia("(prefers-reduced-motion: reduce)");
    let agendado = false;
    const atualizar = () => {
      agendado = false;
      botao.classList.toggle("visivel", scrollY > innerHeight);
    };
    addEventListener(
      "scroll",
      () => {
        if (agendado) return;
        agendado = true;
        requestAnimationFrame(atualizar);
      },
      { passive: true },
    );
    botao.hidden = false;
    atualizar();
    botao.addEventListener("animationend", () => botao.classList.remove("subindo"));
    botao.addEventListener("click", () => {
      botao.classList.remove("subindo");
      void botao.offsetWidth;
      botao.classList.add("subindo");
      scrollTo({ top: 0, behavior: reduzir.matches ? "auto" : "smooth" });
      // O foco volta ao título da página (ou ao conteúdo), para o teclado recomeçar do alto.
      const alvo = document.querySelector<HTMLElement>("main h1") ?? document.querySelector<HTMLElement>("main");
      if (alvo) {
        if (!alvo.hasAttribute("tabindex")) alvo.setAttribute("tabindex", "-1");
        alvo.focus({ preventScroll: true });
      }
    });
  }
</script>

<style>
  .voltar-topo {
    position: fixed;
    right: max(18px, env(safe-area-inset-right, 0px));
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-hi);
    box-shadow: var(--ergue);
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 0.25s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      transform 0.25s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      visibility 0s 0.25s;
  }

  /* A entrada assenta: a curva do back.out(1.4) do GSAP, passando 7% do ponto e voltando. */
  .voltar-topo:global(.visivel) {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 0.2s,
      transform 0.4s linear(0, 0.384, 0.667, 0.863, 0.986, 1.05, 1.07, 1.061, 1.037, 1.012, 1),
      visibility 0s;
  }

  .voltar-topo:global(.subindo) svg {
    animation: seta-sobe 0.44s both;
  }

  /* Sai por cima (0,18s, power2.in) e volta por baixo (0,26s, power3.out). */
  @keyframes seta-sobe {
    0% {
      translate: 0 0;
      animation-timing-function: cubic-bezier(0.55, 0.085, 0.68, 0.53);
    }

    40.8% {
      translate: 0 -160%;
      animation-timing-function: steps(1, end);
    }

    40.9% {
      translate: 0 160%;
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    100% {
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voltar-topo,
    .voltar-topo:global(.visivel) {
      transition: visibility 0s;
    }

    .voltar-topo:global(.subindo) svg {
      animation: none;
    }
  }

  svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .voltar-topo:hover {
    border-color: var(--acento);
  }

  .voltar-topo:hover svg {
    stroke: var(--acento);
  }
</style>
