---
/**
 * Chip da categoria (ou da série), D26: um quadradinho na cor, seguido do nome tingido pela mesma
 * cor (no claro, com 30% de tinta; no escuro, com 50% de branco: --chip-tinta e --chip-branco, dos
 * tokens). No tema escuro, o quadradinho leva 42% de branco (D22). Com `href`, vira link.
 */
interface Props {
  cor: string;
  nome: string;
  href?: string;
}

const { cor, nome, href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="chip" href={href} style={`--cor:${cor}`}><span class="quadradinho" aria-hidden="true"></span>{nome}</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    color: color-mix(in oklab, color-mix(in oklab, var(--cor), #fff var(--chip-branco)), var(--ink) var(--chip-tinta));
    text-decoration: none;
  }

  /* Alvo de toque de 24px (WCAG 2.5.8): no celular, o chip fica em cima do link que cobre o card. */
  a.chip {
    min-height: 24px;
  }

  a.chip:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .quadradinho {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--cor), #fff var(--branco-no-escuro));
  }
</style>
