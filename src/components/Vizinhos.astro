---
/**
 * Anterior e próximo do post (D52, B03: em ordem cronológica global), no fim do artigo.
 *
 * Rodada 4 (P16-9: "talvez possa parecer ficha, papel, algo assim aqueles cards do post"): os dois viram
 * **fichas de catálogo**, como os cards do site (Cartao): no alto, a tira em mono com a chamada do artigo
 * ("Vol. 05 · ficha 1", ou "Coleção Java · ed. 7") à esquerda e o tombo ("nº 027") à direita, sobre o fio
 * na cor do livro dele (src/lib/ficha.ts); embaixo, a ilustração colada na ficha à esquerda, com a margem
 * de papel em volta, e à direita a direção, o título e o complemento. No hover (ou no foco, ou no dedo), a
 * ficha sobe 4px e ganha a sombra, como os cards; o título fica azul-tinta, a seta anda 3px para onde se
 * vai e o detalhe da capa viva se mexe (artigo.css e artigo.ts). A tira embaralha uma vez ao entrar na
 * tela, como a dos cards (embaralha.ts). Sem o vizinho (o mais novo, ou o primeiro), o lugar é uma ficha
 * em branco: a tira "Ficha em branco" (com o próximo tombo, no caso do mais novo) sobre um fio tracejado,
 * a pauta azul e a frase do 02 no meio.
 *
 * Rodada 4, segunda parte (E8: "quero o B, mas com a fita do C"): a ficha de catálogo ganha a fita crepe do
 * papel colado, atravessando a borda de cima, no meio (a mesma da ficha "Do livro", ficha-do-livro.css); a
 * ficha em branco também. A ficha fica reta, como a "Do livro". É o `forma="ficha-fita"`, o padrão.
 *
 * As outras formas ficam na amostra D6 (nas amostras do redesenho, fora do git): `forma="ficha"`, a ficha sem a fita; `"folha"`,
 * a folha lisa de antes (a ilustração na altura toda, sem tira); e `"papel"`, o papel colado na folha com um
 * pedaço de fita, um nada torto.
 *
 * Ganchos estáveis (não renomear): `.vizinhos`, `a.vizinho.anterior[rel=prev]` e
 * `a.vizinho.proximo[rel=next]` (os atalhos ← e →, a troca de página e a capa viva os usam),
 * `.vizinho-figura`, `.vizinho-texto`, `.dir`, `.nome`, `.sub`, `.vizinho-vazio`, `.tira-ficha`.
 */
import Ilustracao from "./Ilustracao.astro";
import SinalCodigo from "./SinalCodigo.astro";
import { ICONES } from "../lib/icones";
import { chamadaDe } from "../lib/ficha";
import { tituloComQuebras } from "../lib/formato";
import { temIlustracao } from "../lib/ilustracoes";
import { getResumos, type Resumo } from "../lib/posts";
// A fita do papel colado (forma "papel", da amostra D6) é a da ficha "Do livro".
import "../styles/ficha-do-livro.css";

interface Props {
  anterior?: Resumo;
  proximo?: Resumo;
  /** "ficha" (o protótipo), "folha" (como era) ou "papel" (colado com fita); as duas últimas, da amostra D6. */
  forma?: "ficha-fita" | "ficha" | "folha" | "papel";
  /** O nome do bloco para o leitor de tela (a amostra tem três, cada um com o seu). */
  rotulo?: string;
}

const { anterior, proximo, forma = "ficha-fita", rotulo = "Outros artigos" } = Astro.props;
// A ficha de catálogo (com ou sem a fita) e as formas coladas com fita.
const comTira = forma === "ficha" || forma === "ficha-fita";
const comFita = forma === "papel" || forma === "ficha-fita";
// Sempre em ordem cronológica global, sem olhar o livro (D52, B03): os rótulos não falam mais de série.
const rotulos = { anterior: "Artigo anterior", proximo: "Próximo artigo" };
// O tombo que o próximo artigo vai ganhar ("nº 029"): o número de artigos mais um.
const proximoTombo = `nº ${String((await getResumos()).length + 1).padStart(3, "0")}`;
const lados = await Promise.all(
  (
    [
      { lado: "anterior", rel: "prev", v: anterior, vazio: "Este é o primeiro artigo.", tomboVazio: "" },
      { lado: "proximo", rel: "next", v: proximo, vazio: "Este é o mais novo. O próximo ainda está no escuro.", tomboVazio: proximoTombo },
    ] as const
  ).map(async (l) => ({ ...l, ficha: l.v ? await chamadaDe(l.v) : undefined })),
);
---

{
  (anterior || proximo) && (
    <nav class="vizinhos" data-forma={forma} aria-label={rotulo}>
      {lados.map(({ lado, rel, v, vazio, tomboVazio, ficha }) =>
        v ? (
          <a href={v.url} rel={rel} class:list={["vizinho", lado]} style={`--cor:${v.cor}`}>
            {comTira && ficha && (
              <span class="tira-ficha" aria-hidden="true">
                <span>{ficha.chamada}</span>
                <span>{ficha.tombo}</span>
              </span>
            )}
            {comFita && <span class="fita" aria-hidden="true" />}
            {temIlustracao(v.slug) && (
              <span class="vizinho-figura painel" aria-hidden="true">
                <Ilustracao slug={v.slug} recorte="quadrado" cor={v.cor} tamanho="cartao" decorativa />
              </span>
            )}
            <span class="vizinho-texto">
              <span class="dir">
                {lado === "anterior" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />}
                {rotulos[lado]}
                {lado === "proximo" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />}
              </span>
              <span class="nome">
                <span set:html={tituloComQuebras(v.titulo)} />
                {v.subtitulo && <span class="sr"> — </span>}
                {!v.subtitulo && v.codigo && <SinalCodigo curto />}
              </span>
              {v.subtitulo && (
                <span class="sub">
                  <span set:html={tituloComQuebras(v.subtitulo)} />
                  {v.codigo && <SinalCodigo curto />}
                </span>
              )}
            </span>
          </a>
        ) : (
          <p class:list={["vizinho-vazio", lado]}>
            {comTira && (
              <span class="tira-ficha" aria-hidden="true">
                <span>Ficha em branco</span>
                <span>{tomboVazio}</span>
              </span>
            )}
            {comFita && <span class="fita" aria-hidden="true" />}
            <em>{vazio}</em>
          </p>
        ),
      )}
    </nav>
  )
}

<style>
  /*
   * ---------- a grade: lado a lado quando a folha dá a cada um espaço para o título ----------
   * Pela largura da folha, que é o contêiner (artigo.css); senão, um embaixo do outro.
   */
  .vizinhos {
    --sobe: cubic-bezier(0.2, 0.75, 0.2, 1);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    max-width: var(--coluna);
    margin-top: 28px;
  }

  @container (min-width: 820px) {
    .vizinhos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  /* ---------- o que as três formas têm em comum ---------- */

  .vizinho {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    min-height: 136px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-hi);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: translate 0.3s var(--sobe);
  }

  .vizinho:not(:has(.vizinho-figura)) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* A sombra de quem levanta do papel: pronta, só aparece (opacidade). */
  .vizinho::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1px;
    border-radius: inherit;
    box-shadow: var(--sombra-folha-alta);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--sobe);
  }

  /* A ilustração, recortada no quadrado do desenho (o centro é a área segura). */
  .vizinho-figura {
    position: relative;
    min-height: 0;
    border-radius: 2px 0 0 2px;
  }

  .vizinho-figura :global(svg.ilustracao) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* A coluna na largura do card: sem ela, o título com uma palavra longa ("MessageAttributes") alargava a
     coluna e saía cortado pela borda em 320px (D82). */
  .vizinho-texto {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 5px;
    min-width: 0;
    padding: 16px 20px 17px;
  }

  .dir {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .dir svg {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s var(--sobe);
  }

  .anterior .dir svg {
    rotate: 180deg;
  }

  .nome {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17.5px;
    line-height: 1.25;
    text-wrap: balance;
    overflow-wrap: break-word;
    transition: color 0.15s;
  }

  .sub {
    font-family: var(--font-texto);
    font-size: 15px;
    line-height: 1.38;
    color: var(--ink-2);
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  /* O sinal do código-fonte (D52): só o ícone, colado ao fim do título, na tinta 2. */
  .vizinho :global(.sinal-codigo) {
    margin-left: 0.4em;
    color: var(--ink-2);
    vertical-align: -0.1em;
  }

  /* Com o mouse, o foco do teclado ou o dedo na ficha: sobe, ganha a sombra, o título fica azul. */
  @media (hover: hover) {
    .vizinho:hover {
      translate: 0 -2px;
    }

    .vizinho:hover::after {
      opacity: 1;
    }

    .vizinho:hover .nome {
      color: var(--acento);
    }

    .anterior:hover .dir svg {
      translate: -3px 0;
    }

    .proximo:hover .dir svg {
      translate: 3px 0;
    }
  }

  .vizinho:is(:focus-visible, :active) {
    translate: 0 -2px;
  }

  .vizinho:is(:focus-visible, :active)::after {
    opacity: 1;
  }

  .vizinho:is(:focus-visible, :active) .nome {
    color: var(--acento);
  }

  .anterior:is(:focus-visible, :active) .dir svg {
    translate: -3px 0;
  }

  .proximo:is(:focus-visible, :active) .dir svg {
    translate: 3px 0;
  }

  .vizinho:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  /* Sem vizinho: o lugar vazio, onde estaria a ficha, com a frase do 02. */
  .vizinho-vazio {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 136px;
    margin: 0;
    padding: 22px 28px;
    border: 1px dashed color-mix(in oklab, var(--ink) 22%, transparent);
    border-radius: 3px;
    color: var(--ink-2);
    font-family: var(--font-texto);
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  /*
   * ---------- B e D, a ficha de catálogo (D, com a fita, é o protótipo) ----------
   * A ficha dos cards: os cantos de 6px, a tira em mono sobre o fio na cor do livro, a ilustração colada
   * com a margem de papel, sem borda desenhada e com a sombra curta do papel encostado (a família do papel
   * da rodada 4, H5), na folha do artigo e, no celular, direto no papel da página.
   */
  [data-forma^="ficha"] .vizinho {
    --fio-ficha: var(--cor, var(--ink-2));
    grid-template-columns: 150px minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-height: 0;
    border-radius: 6px;
    transition:
      translate 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s;
  }

  /*
   * Rodada 4 (H5, a família do papel): a ficha sem a borda desenhada (transparente, para nada mudar de
   * tamanho), com a sombra curta do papel colado, como os cards; no escuro, o anel de 1px a 7%.
   */
  [data-forma^="ficha"] :is(.vizinho, .vizinho-vazio) {
    border-color: transparent;
    box-shadow:
      0 1px 1px color-mix(in oklab, var(--sombra-quente) 16%, transparent),
      0 2px 4px -1px color-mix(in oklab, var(--sombra-quente) 22%, transparent);
  }

  :global(:root[data-theme="dark"]) [data-forma^="ficha"] :is(.vizinho, .vizinho-vazio) {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ink) 7%, transparent),
      0 1px 1px color-mix(in oklab, var(--sombra-quente) 50%, transparent),
      0 2px 5px -1px color-mix(in oklab, var(--sombra-quente) 60%, transparent);
  }

  :global(:root[data-theme="dark"]) [data-forma^="ficha"] .vizinho {
    --fio-ficha: color-mix(in oklab, var(--cor, var(--ink-2)) 72%, var(--ink));
  }

  [data-forma^="ficha"] .vizinho::after {
    transition: opacity 0.2s;
  }

  .tira-ficha {
    position: relative;
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    padding: 9px 14px 8px;
    font-family: var(--font-codigo);
    font-size: 11.5px;
    font-style: normal;
    line-height: 1.3;
    color: var(--ink-2);
    font-variant-numeric: lining-nums tabular-nums;
    text-align: left;
    white-space: nowrap;
  }

  .tira-ficha > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tira-ficha::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--fio-ficha);
  }

  [data-forma^="ficha"] .vizinho-figura {
    aspect-ratio: 1;
    margin: 10px 0 10px 10px;
    border-radius: 4px;
  }

  [data-forma^="ficha"] .vizinho-texto {
    padding: 14px 20px 16px 18px;
  }

  @media (hover: hover) {
    [data-forma^="ficha"] .vizinho:hover {
      translate: 0 -4px;
    }
  }

  [data-forma^="ficha"] .vizinho:is(:focus-visible, :active) {
    translate: 0 -4px;
  }

  /*
   * A ficha em branco: a mesma ficha, com o fio tracejado (ainda sem livro), a pauta azul e a frase escrita
   * nela. A pauta é do bloco da frase, com a linha 3px abaixo da base de cada linha escrita (a altura de
   * linha é a da pauta): com uma ou duas linhas, a frase fica sempre sobre a pauta.
   */
  [data-forma^="ficha"] .vizinho-vazio {
    --fio-ficha: repeating-linear-gradient(90deg, color-mix(in oklab, var(--ink) 34%, transparent) 0 6px, transparent 6px 10px);
    --linha: 28px;
    grid-template-rows: auto 1fr;
    place-items: stretch;
    padding: 0;
    border-style: solid;
    border-radius: 6px;
    background: var(--paper-hi);
  }

  /* A frase na segunda linha da pauta (a primeira fica em branco, como numa ficha nova). */
  [data-forma^="ficha"] .vizinho-vazio > em {
    --pauta-y: 18px;
    display: block;
    padding: 50px 24px 18px;
    line-height: var(--linha);
    background: repeating-linear-gradient(to bottom, transparent 0 calc(var(--linha) - 1px), color-mix(in oklab, var(--pauta) 85%, transparent) calc(var(--linha) - 1px) var(--linha))
      0 var(--pauta-y) / 100% calc(100% - var(--pauta-y) - 10px) no-repeat;
  }

  /*
   * ---------- C, o papel colado (só na amostra D6) ----------
   * Um pedaço de papel colado na folha com uma tira de fita crepe no alto, cada um um nada torto para um
   * lado, com a sombra curta de quem está colado. A fita é a da ficha "Do livro" (ficha-do-livro.css).
   */
  [data-forma="papel"] {
    gap: 26px 22px;
    padding-top: 10px;
  }

  /* D, a ficha com a fita (o protótipo): a fita passa 11px acima da ficha; um embaixo do outro, as fichas
     se afastam para ela caber. */
  [data-forma="ficha-fita"] {
    row-gap: 28px;
    padding-top: 10px;
  }

  [data-forma="papel"] .vizinho,
  [data-forma="papel"] .vizinho-vazio {
    border-radius: 1px;
    box-shadow: 0 1px 1px color-mix(in oklab, var(--sombra-quente) 14%, transparent), 0 8px 14px -10px color-mix(in oklab, var(--sombra-quente) 45%, transparent);
  }

  [data-forma="papel"] .anterior {
    rotate: -0.8deg;
  }

  [data-forma="papel"] .proximo {
    rotate: 0.6deg;
  }

  [data-forma="papel"] .vizinho-figura {
    margin: 10px 0 10px 10px;
    border-radius: 0;
  }

  [data-forma="papel"] .vizinho-vazio {
    border: 1px solid var(--rule);
    background: var(--paper-hi);
  }

  @media (prefers-reduced-motion: reduce) {
    .vizinho,
    .vizinho::after,
    .dir svg,
    .nome {
      transition: none;
    }

    .vizinho:is(:hover, :focus-visible, :active),
    [data-forma^="ficha"] .vizinho:is(:hover, :focus-visible, :active) {
      translate: none;
    }
  }

  /* Celular: a ilustração um pouco menor; sem a folha do artigo, a ficha pousa no papel com a sombra curta. */

  @media (max-width: 600px) {
    .vizinhos {
      gap: 14px;
    }

    /* Com a fita, um embaixo do outro: espaço para a fita de baixo não encostar na ficha de cima. */
    :is([data-forma="ficha-fita"], [data-forma="papel"]).vizinhos {
      row-gap: 28px;
    }

    .vizinho {
      grid-template-columns: 116px minmax(0, 1fr);
      min-height: 116px;
    }

    [data-forma^="ficha"] .vizinho {
      grid-template-columns: 112px minmax(0, 1fr);
    }

    [data-forma^="ficha"] .vizinho-figura {
      margin: 8px 0 8px 8px;
    }

    .vizinho-texto,
    [data-forma^="ficha"] .vizinho-texto {
      padding: 12px 14px 13px;
    }

    .nome {
      font-size: 16.5px;
    }

    .sub {
      font-size: 14.5px;
    }

    .vizinho-vazio {
      min-height: 116px;
      padding: 18px 20px;
      font-size: 15px;
    }
  }
</style>
