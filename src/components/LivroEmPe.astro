---
/**
 * O livro aberto no topo da página do livro (D29, D30): o mesmo livro 3D da gaveta, já girado até os
 * três quartos (a lombada à esquerda e a capa de frente), com o desenho da capa inline. Tem o mesmo
 * `view-transition-name` do livro deitado do painel (PainelHome): ao abrir a página, o navegador leva
 * o livro da pilha até aqui.
 */
import Livro3D from "./Livro3D.astro";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import { medidasDoLivro3D } from "../lib/livro-3d";
import "../styles/livro.css";

interface Props {
  livro: Livro;
  /** Altura do livro em px. */
  altura?: number;
  /**
   * "fixa": o nome de transição vai no HTML (o livro do topo da página do livro). "ao-clicar": só
   * `data-vt`, e o script do <head> dá o nome quando o link leva à página dele (a grade de livros).
   */
  transicao?: "fixa" | "ao-clicar";
}

const { livro, altura = 300, transicao = "fixa" } = Astro.props;
const m = medidasDoLivro3D(livro.emPe.largura, altura);
const px = (v: number) => `${Math.round(v * 100) / 100}px`;
const estilo = [
  coresDoLivroCss(livro),
  `--u:${m.u}px`,
  `--bh:${px(m.bh)}`,
  `--cw:${px(m.cw)}`,
  `--sw:${px(m.sw)}`,
  `--x0:${px(m.x0)}`,
  `--x1:${px(m.x1)}`,
  transicao === "fixa" ? `view-transition-name:${livro.id}` : "",
  "view-transition-class:livro",
]
  .filter(Boolean)
  .join(";");
---

<div class="livro-em-pe" style={estilo} data-vt={transicao === "ao-clicar" ? livro.id : undefined}>
  <Livro3D livro={livro} desenho={livro.serie ? "adiado" : "inline"} virado />
</div>

<style>
  .livro-em-pe {
    width: var(--cw);
    height: var(--bh);
  }

  /* Parado: sem a transição do giro. */
  .livro-em-pe :global(.livro-3d) {
    transition: none;
  }
</style>
