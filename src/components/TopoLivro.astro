---
/**
 * O painel do livro, no topo da página do livro e da série (rodada 3, área 4; o palco do 15, que o Cesar
 * "GOSTOU MUITOOO", embaixo da fileira com todos os livros, FileiraTopo).
 *
 * - À esquerda, o texto: "Livros / Volume 05", o nome grande, a frase do livro e "N artigos · o último
 *   em 2026", com o número rodando para cima ao chegar (o contador, T3), e embaixo os vizinhos de estante
 *   como links de texto ("← Vol. 04 IA" e "Vol. 06 DevOps →"), que trocam de livro como a fileira.
 * - À direita, o livro grande (P2; a capa com até 300px a 1440) com as tags do livro em volta: no
 *   máximo seis à vista, as mais usadas no alto, e "+N" embaixo, que abre as demais. Cada tag leva à
 *   tag já filtrada por este livro (`/tags/<Nome>/?livro=<chave>`, O5). A lupa no canto do livro abre o
 *   livro ampliado (A9). O hover do livro é o de todo livro 3D (área 1, livro.css), por `data-livro-gira`.
 * - A marca d'água do desenho continua, no canto de cima à direita (D39, O4).
 *
 * Rodada 4, H5 (S1; docs/redesenho/rodada-4/direcao-papel.md): o painel é a ficha de catálogo do livro,
 * colada com fita (catalogo.css): canto de 6px, sem borda, a sombra curta do papel e o grão; no alto, a tira
 * em mono ("Volume 03 · 2 artigos · o último em 2026", com o número rodando ao chegar, e o autor à direita)
 * sobre o fio de 2px na cor do livro, e a fita da ficha "Do livro" no meio, cruzando a borda de cima. A
 * trilha "Livros / Volume 03" e a linha da contagem saíram: a tira já diz as duas coisas. Na série, a
 * tira diz "Série 01 · 7 artigos" (a série também é livro; nada de "edições"). A marca d'água fica num
 * recorte próprio (o painel não corta mais nada, para a fita poder passar da borda).
 *
 * As tags saem de trás do livro quando a página termina de chegar (a abertura, a cortina ou a troca de
 * livro): o estado de espera vem dos atributos que o <head> já põe (`data-abertura`, `data-vai-chegar`),
 * então não há piscada e, sem JS, elas estão no lugar. O livro chega da fileira pela transição de
 * página (LivroEmPe, nome fixo). O slot recebe o que for próprio da página (na série Java, as LTS).
 */
import LivroAmpliado from "./LivroAmpliado.astro";
import LivroEmPe from "./LivroEmPe.astro";
import MarcaDagua from "./MarcaDagua.astro";
import PilulaTag from "./PilulaTag.astro";
import { ICONES } from "../lib/icones";
import type { Livro } from "../lib/estante";
import "../styles/catalogo.css";

interface Props {
  livro: Livro;
  /** Os vizinhos na fileira (o volume de antes e o de depois; a série vem depois do último volume). */
  anterior?: Livro;
  proximo?: Livro;
  /** Para onde a trilha volta; por padrão, os livros. */
  trilha?: { nome: string; href: string };
  /** Texto abaixo do nome; por padrão, o subtítulo do livro. */
  descricao?: string;
}

const { livro, anterior, proximo, descricao = livro.descricao } = Astro.props;

const dois = (n?: number) => String(n ?? 1).padStart(2, "0");
const lugar = livro.serie ? `Série ${dois(livro.revista?.numero)}` : `Volume ${dois(livro.volume)}`;
const rotulo = (l: Livro) => (l.serie ? "Série" : `Vol. ${dois(l.volume)}`);
const rotuloLongo = (l: Livro) => (l.serie ? "Série" : `Volume ${dois(l.volume)}`);

// O nome acompanha a coluna: o tamanho sai da palavra mais longa (Desenvolvimento cabe inteiro).
const letras = Math.max(...livro.nome.split(/\s+/).map((p) => p.length), 4);

// A tira da ficha (rodada 4, S1): "Volume 03 · 2 artigos · o último em 2026". O número vira contador
// (contador.ts). Na série também são artigos (o Cesar: "a série é livro também").
const n = livro.posts.length;
const anos = livro.posts.map((p) => p.publicado.getUTCFullYear());
const [primeiroAno, ultimoAno] = [Math.min(...anos), Math.max(...anos)];
const palavraDaConta = n === 1 ? "artigo" : "artigos";
const quando = n === 0 ? "" : primeiroAno !== ultimoAno ? `de ${primeiroAno} a ${ultimoAno}` : n === 1 ? `de ${ultimoAno}` : `o último em ${ultimoAno}`;

// As tags do livro, das mais usadas para as menos (empate: a ordem do alfabeto).
const contagem = new Map<string, number>();
for (const p of livro.posts) for (const t of p.tags) contagem.set(t, (contagem.get(t) ?? 0) + 1);
const tags = [...contagem].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "pt-BR")).map(([nome, qtd]) => ({ nome, qtd }));
const NO_ANEL = 6;
const noAnel = tags.slice(0, NO_ANEL);
const resto = tags.slice(NO_ANEL);
// Os lados alternam (a mais usada à direita, no alto; a segunda à esquerda, no alto…): as duas de cima
// são sempre as mais usadas. Em cada lado, os ângulos na elipse em volta do livro.
const ANGULOS: Record<number, number[]> = { 1: [0], 2: [-30, 30], 3: [-42, 0, 42] };
const naDireita = Math.ceil(noAnel.length / 2);
const naEsquerda = noAnel.length - naDireita;
const noLado = noAnel.map((t, i) => {
  const direita = i % 2 === 0;
  const k = Math.floor(i / 2);
  const graus = ANGULOS[direita ? naDireita : naEsquerda][k];
  const rad = (graus * Math.PI) / 180;
  // Quase na vertical, com uma curva leve: as de cima e as de baixo chegam um nada mais perto da capa.
  const cx = (direita ? 1 : -1) * (0.84 + 0.16 * Math.cos(rad));
  const cy = Math.sin(rad);
  return { ...t, estilo: `--cx:${cx.toFixed(3)};--cy:${cy.toFixed(3)};--ancora:${direita ? "0%" : "-100%"};--i:${i}` };
});
const filtro = { chave: livro.id.replace(/^(livro|serie)-/, ""), nome: livro.nome };
---

<header class="topo-livro folha ficha-catalogo" style={`--cor:${livro.cores.cor};--letras:${letras}`} data-topo-livro>
  <span class="fita-catalogo" aria-hidden="true"></span>
  <div class="recorte-marca" aria-hidden="true">
    <MarcaDagua livro={livro} />
  </div>
  <p class="tira-catalogo tira-livro">
    <span>
      {lugar} ·{" "}
      {
        n > 0 ? (
          <>
            <span class="numero" data-conta={n}>
              {n}
            </span>{" "}
            {palavraDaConta} · {quando}
          </>
        ) : (
          "Ainda sem artigos"
        )
      }
    </span>
    <span>Cesar Schutz</span>
  </p>
  <div class="texto">
    <h1>{livro.nome}</h1>
    <p class="descricao">{descricao}</p>
    <slot />
  </div>

  <div class:list={["anel", { "sem-tags": tags.length === 0 }]} data-palco-virar>
    <div class="livro-centro" data-livro-gira>
      <LivroEmPe livro={livro} altura={450} ampliavel fluido contracapa />
    </div>
    {
      tags.length > 0 && (
        <ul class="tags-anel" aria-label={`Tags de ${livro.nome} (abrem a tag só com os artigos deste livro)`}>
          {noLado.map((t) => (
            <li style={t.estilo}>
              <PilulaTag nome={t.nome} contagem={t.qtd} livro={filtro} />
            </li>
          ))}
          {resto.length > 0 && (
            <li class="mais" style={`--i:${noAnel.length}`}>
              <details class="mais-tags" data-mais-tags>
                <summary aria-label={`Mais ${resto.length} ${resto.length === 1 ? "tag" : "tags"} de ${livro.nome}`}>+{resto.length}</summary>
                <ul>
                  {resto.map((t) => (
                    <li>
                      <PilulaTag nome={t.nome} contagem={t.qtd} livro={filtro} />
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          )}
        </ul>
      )
    }
  </div>

  {
    (anterior || proximo) && (
      <nav class="vizinhos-livro" aria-label="Os livros ao lado na estante">
        {/* O nome de cada vizinho vem do texto `.sr` ("Livro anterior: Volume 03, Dados"), e não de um
            aria-label (D73): o que se vê ("Vol. 03" e o nome) fica fora do nome, com aria-hidden, e um
            aria-label que não contém o texto da tela falha na auditoria de nome do Lighthouse. */}
        {anterior && (
          <a class="vizinho-livro para-tras" href={anterior.href} rel="prev" data-vizinho-livro>
            <span class="sr">{`Livro anterior: ${rotuloLongo(anterior)}, ${anterior.nome}`}</span>
            <span class="seta" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" set:html={ICONES.seta} />
            </span>
            <span class="vizinho-vol" aria-hidden="true">{rotulo(anterior)}</span>
            <span class="vizinho-nome" aria-hidden="true">{anterior.nome}</span>
          </a>
        )}
        {proximo && (
          <a class="vizinho-livro para-frente" href={proximo.href} rel="next" data-vizinho-livro>
            <span class="sr">{`Próximo livro: ${rotuloLongo(proximo)}, ${proximo.nome}`}</span>
            <span class="vizinho-vol" aria-hidden="true">{rotulo(proximo)}</span>
            <span class="vizinho-nome" aria-hidden="true">{proximo.nome}</span>
            <span class="seta" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" set:html={ICONES.seta} />
            </span>
          </a>
        )}
      </nav>
    )
  }
</header>

<LivroAmpliado />

<script>
  import { criarContador, mudarContador } from "../scripts/contador";

  const raiz = document.documentElement;
  const topo = document.querySelector<HTMLElement>("[data-topo-livro]");
  const reduzido = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /*
   * Os vizinhos trocam de livro como a fileira: o grande volta para o vão dele e o escolhido desce
   * (troca.js, tipo "livro"; o script do <head> dá o nome ao livro da fileira que leva à página nova). A
   * seta sai pela frente e volta por trás, como na paginação.
   */
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-vizinho-livro]")) {
    a.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      raiz.setAttribute("data-troca-livro", "");
      a.classList.remove("indo");
      void a.offsetWidth;
      a.classList.add("indo");
    });
    a.addEventListener("animationend", () => a.classList.remove("indo"));
  }

  /*
   * A troca de livro (pela fileira ou pelos vizinhos) fica anotada na sessão: na página nova, o contador
   * roda enquanto o livro desce, e não depois do pouso (antes, "0 artigos" ficava parado um segundo).
   */
  const CHAVE = "cs-troca-de-livro";
  addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".estante-topo a[data-troca-livro], a[data-vizinho-livro]");
    if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    try {
      sessionStorage.setItem(CHAVE, JSON.stringify({ para: new URL(a.href).pathname, t: Date.now() }));
    } catch {}
  });
  let veioDaFileira = false;
  try {
    const d = JSON.parse(sessionStorage.getItem(CHAVE) || "null");
    sessionStorage.removeItem(CHAVE);
    veioDaFileira = !!d && d.para === location.pathname && Date.now() - d.t < 8000;
  } catch {}

  /*
   * "N artigos" roda para cima ao chegar (T3): as fitas partem do zero e vão ao número quando a página
   * aparece: na troca de livro, enquanto o livro desce; depois da cortina, quando ela sai; depois da
   * abertura, quando ela acaba; sem troca, logo depois da primeira pintura. Com movimento reduzido, o
   * número fica escrito, parado.
   */
  const numero = topo?.querySelector<HTMLElement>("[data-conta]");
  if (numero && !reduzido) {
    const alvo = Number(numero.dataset.conta);
    criarContador(numero, 0, String(alvo).length);
    let rodou = false;
    const rodar = () => {
      if (rodou) return;
      rodou = true;
      mudarContador(numero, alvo);
    };
    if (raiz.dataset.abertura) addEventListener("cs:aberto", () => setTimeout(rodar, 200), { once: true });
    else if (raiz.hasAttribute("data-vai-chegar")) {
      if (veioDaFileira) requestAnimationFrame(() => setTimeout(rodar, 380));
      // A cortina avisa quando começa a sair (a página nova aparece por baixo).
      addEventListener("cs:cortina-saindo", () => setTimeout(rodar, 120), { once: true });
      addEventListener("cs:chegou", rodar, { once: true });
    } else requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(rodar, 120)));
    setTimeout(rodar, 3200);
  }

  // O "+N": fecha com Esc (o foco volta para ele) e com um clique fora.
  for (const mais of document.querySelectorAll<HTMLDetailsElement>("[data-mais-tags]")) {
    mais.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !mais.open) return;
      e.stopPropagation();
      mais.open = false;
      mais.querySelector("summary")?.focus();
    });
    document.addEventListener("pointerdown", (e) => {
      if (mais.open && !mais.contains(e.target as Node)) mais.open = false;
    });
  }
</script>

<style is:global>
  /* A contracapa (D78): 0 de frente e 1 virado; animada, faz o livro do anel crescer enquanto gira. */
  @property --virado {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
</style>

<style>
  /* ---------- o painel ---------- */

  .topo-livro {
    --pad-alto: clamp(22px, 2.4vw, 34px);
    --pad-lado: clamp(20px, 3vw, 44px);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "tira tira"
      "texto anel"
      "vizinhos anel";
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(20px, 3vw, 48px);
    padding: var(--pad-alto) var(--pad-lado) clamp(22px, 2.4vw, 32px);
  }

  /*
   * A tira de catálogo, de ponta a ponta no alto da ficha (catalogo.css): as margens negativas a levam às
   * bordas, e o conteúdo começa abaixo dela com a folga de antes.
   */
  .tira-livro {
    grid-area: tira;
    z-index: 2;
    margin: calc(-1 * var(--pad-alto)) calc(-1 * var(--pad-lado)) var(--pad-alto);
    padding-inline: max(14px, calc(var(--pad-lado) - 6px));
  }

  /* O número da tira roda ao chegar (o contador): na tinta, um nada mais forte que o resto da linha. */
  .tira-livro .numero {
    color: var(--ink);
  }

  /* A marca d'água no seu recorte, do tamanho da ficha e com os cantos dela: só ela é cortada. */
  .recorte-marca {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .recorte-marca > :global(.marca-dagua) {
    right: -90px;
    top: -60px;
    width: 600px;
  }

  .recorte-marca > :global(.marca-dagua.emblema) {
    right: -40px;
    top: -30px;
    width: 340px;
  }

  /* ---------- o texto ---------- */

  .texto {
    grid-area: texto;
    position: relative;
    z-index: 1;
    align-self: center;
    container-type: inline-size;
    min-width: 0;
    max-width: 640px;
    padding-top: 8px;
  }

  /* O nome grande do 14: o tamanho sai da palavra mais longa (--letras) e da largura da coluna. */
  h1 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(34px, calc(100cqi / (var(--letras) * 0.68)), 100px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
    /* Palavra nunca parte no meio: o tamanho já garante que a mais longa cabe (Besley 800: até 0,65em por letra). */
    overflow-wrap: normal;
    hyphens: manual;
  }

  .descricao {
    max-width: 46ch;
    margin: 16px 0 0;
    font-size: clamp(17px, 1.45vw, 20.5px);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }


  /* ---------- os vizinhos de estante ---------- */

  .vizinhos-livro {
    grid-area: vizinhos;
    position: relative;
    z-index: 1;
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
    max-width: 640px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
  }

  .vizinho-livro {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding-block: 4px;
    color: var(--ink-2);
    font-size: 14.5px;
    text-decoration: none;
  }

  .vizinho-vol {
    font-size: 13px;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .vizinho-nome {
    font-weight: 600;
    color: var(--ink);
    transition: color 0.15s;
  }

  .vizinho-livro:is(:hover, :focus-visible) .vizinho-nome {
    color: var(--acento);
  }

  .vizinho-livro:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* A seta numa janela (como na paginação): anda 3px no hover e, no clique, sai pela frente e volta por trás. */
  .seta {
    --rumo: 1;
    display: inline-grid;
    align-self: center;
    margin-inline: -3px;
    padding-inline: 3px;
    overflow: hidden;
  }

  .para-tras .seta {
    --rumo: -1;
  }

  .seta svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .para-tras .seta svg {
    rotate: 180deg;
  }

  .vizinho-livro:is(:hover, :focus-visible) .seta svg {
    translate: calc(3px * var(--rumo));
  }

  .vizinho-livro.indo .seta svg {
    animation: seta-vai 0.32s both;
  }

  @keyframes seta-vai {
    0% {
      translate: calc(3px * var(--rumo));
      animation-timing-function: cubic-bezier(0.55, 0.085, 0.68, 0.53);
    }

    43.7% {
      translate: calc(130% * var(--rumo));
      animation-timing-function: steps(1, end);
    }

    43.8% {
      translate: calc(-130% * var(--rumo));
      animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    100% {
      translate: 0;
    }
  }

  /* ---------- o livro e o anel de tags ---------- */

  /*
   * O anel: a caixa do livro com espaço em volta para as tags. --rx e --ry são as distâncias, a partir do
   * centro do livro, onde as tags se apoiam (a de cada lado encosta pela ponta de dentro). --kc é a
   * escala do livro (LivroEmPe fluido): 1 a 1280px (a capa com 300px), menos nas telas menores.
   *
   * A contracapa (D78): virado (`data-virado`, LivroEmPe), o livro cresce de --kc-base a --kc-virado
   * enquanto gira, para o texto do verso ficar legível (no celular, quase a largura da ficha), e as tags
   * saem. O anel guarda a largura de sempre (--rx e --ry ficam na escala de base); só a altura cresce.
   */
  .anel {
    --kc-base: 1;
    --kc-virado: 1.2;
    --kc: calc(var(--kc-base) + (var(--kc-virado) - var(--kc-base)) * var(--virado));
    --rx: calc(186px * var(--kc-base));
    --ry: calc(176px * var(--kc-base));
    --lado-tag: 176px;
    grid-area: anel;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    /* A coluna fica no meio mesmo quando passa da largura (o livro virado no celular usa a folga da ficha). */
    justify-content: center;
    width: calc(2 * var(--rx) + 2 * var(--lado-tag));
    max-width: 100%;
    min-height: calc(450px * var(--kc) + 84px);
    padding: 4px 0 44px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .anel {
      transition: --virado 0.9s cubic-bezier(0.45, 0.05, 0.2, 1);
    }
  }

  .anel[data-virado] {
    --virado: 1;
  }

  /* Virado, as tags saem (no anel; no celular, elas ficam na fileira de baixo). */
  .tags-anel {
    transition:
      opacity 0.3s,
      visibility 0s linear 0s;
  }

  @media (min-width: 641px) {
    .anel[data-virado] .tags-anel {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s,
        visibility 0s linear 0.25s;
    }
  }

  .anel.sem-tags {
    --lado-tag: 72px;
    padding-bottom: 24px;
  }

  /* O halo da cor do livro atrás dele (o palco do 15), mais forte no escuro. */
  .anel::before {
    content: "";
    position: absolute;
    inset: -8% -4%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--cor) 13%, transparent), transparent);
    pointer-events: none;
  }

  :global(:root[data-theme="dark"]) .anel::before {
    background: radial-gradient(closest-side, color-mix(in oklab, var(--cor) 18%, transparent), transparent);
  }

  /*
   * O livro fica no meio pelo que se vê dele, e não pela caixa (D57): de lado e visto de um pouco acima, a
   * lombada, mais perto do olho, passa da caixa embaixo e à esquerda. O padding desigual compensa.
   */
  .livro-centro {
    position: relative;
    display: grid;
    place-items: center;
    padding: 18px 19px 30px 29px;
    border-radius: 12px;
  }

