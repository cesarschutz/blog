---
/**
 * Topo da página do livro, de categoria ou de série (D29, D30, D31): uma folha com o livro aberto em
 * três quartos num painel tingido pela cor dele e, ao lado, a trilha, o nome, o subtítulo, a
 * contagem e as tags mais usadas. O livro chega da pilha do painel ou da grade de livros por
 * transição de página (LivroEmPe). O slot recebe o que for próprio da página (na série Java, os
 * números das LTS).
 */
import LivroEmPe from "./LivroEmPe.astro";
import type { Livro } from "../lib/estante";
import { urlTag } from "../lib/posts";
import { url } from "../lib/url";

interface Props {
  livro: Livro;
  /** Para onde a trilha volta; por padrão, as categorias. */
  trilha?: { nome: string; href: string };
  /** Texto abaixo do nome; por padrão, o subtítulo do livro. */
  descricao?: string;
}

const { livro, trilha = { nome: "Categorias", href: url("/categories/") }, descricao = livro.descricao } = Astro.props;
// As tags mais usadas nos artigos desta categoria.
const contagem = new Map<string, number>();
for (const p of livro.posts) for (const t of p.tags) contagem.set(t, (contagem.get(t) ?? 0) + 1);
const tags = [...contagem]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "pt-BR"))
  .slice(0, 6)
  .map(([nome]) => nome);
---

<header class="topo-livro folha" style={`--cor:${livro.cores.cor}`}>
  <div class="palco painel">
    <LivroEmPe livro={livro} />
  </div>
  <div class="texto">
    <a class="trilha" href={trilha.href}>{trilha.nome}</a>
    <h1>{livro.nome}</h1>
    <p class="descricao">{descricao}</p>
    <p class="conta">{livro.contagem}</p>
    <slot />
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Tags mais usadas neste livro">
          {tags.map((t) => (
            <li>
              <a class="pilula" href={urlTag(t)} data-busca-tag={t}>
                #{t}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</header>

<style>
  .topo-livro {
    display: grid;
    grid-template-columns: minmax(250px, 34%) minmax(0, 1fr);
    gap: clamp(22px, 3vw, 40px);
    align-items: center;
    padding: 14px clamp(22px, 3vw, 40px) 14px 14px;
  }

  /* O palco do livro: o painel tingido, como o dos desenhos (D26). */
  .palco {
    display: grid;
    place-items: center;
    min-height: 360px;
    padding: 30px 24px;
  }

  /* O título acompanha a largura da coluna: "Observabilidade" cabe inteiro no celular. */
  .texto {
    container-type: inline-size;
    min-width: 0;
  }

  .trilha {
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .trilha:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  h1 {
    margin: 6px 0 0;
    font-weight: 800;
    font-size: clamp(24px, 10cqi, 56px);
    line-height: 1.02;
    letter-spacing: -0.012em;
  }

  .descricao {
    max-width: 48ch;
    margin: 12px 0 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* O quadradinho na cor da categoria, como no chip (D26). */
  .conta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }

  .conta::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--cor), #fff var(--branco-no-escuro));
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags .pilula {
    min-height: 30px;
    padding: 3px 11px;
    font-size: 13.5px;
  }

  @media (max-width: 760px) {
    .topo-livro {
      grid-template-columns: minmax(0, 1fr);
      padding: 12px 12px 24px;
    }

    .palco {
      min-height: 340px;
    }

    .texto {
      padding: 0 10px;
    }
  }
</style>
