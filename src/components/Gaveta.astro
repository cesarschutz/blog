---
/**
 * A gaveta da estante (briefing §5.1, D43, D49): tirar o livro da estante como numa estante de verdade
 * (protótipo D1, src/scripts/estante-gesto.ts). No clique, toque ou Enter numa lombada, o livro tomba
 * pela cabeça dentro do próprio vão, vem para a frente (e o vizinho da direita, sem apoio, tomba até
 * encostar no outro) e só então anda até a gaveta, girando da lombada até os 38° (fechado, com a
 * lombada bem à vista); o lugar dele fica vazio. Com mouse, dá também para puxar a cabeça do livro e
 * arrastá-lo até a gaveta. Ao lado aparece o sumário, como antes da D40: "Neste livro" (ou "Ordem de
 * leitura", nas séries) e os artigos por ano, com "Ver o livro" (a página do livro) e "Fechar livro".
 * A gaveta abre crescendo, e o que está embaixo desce junto; fecha recolhendo, enquanto o livro volta;
 * na troca de livro, vai da altura de um para a do outro (D47). Clicar no livro, ou na lupa, abre o
 * livro ampliado (D33, D43). "Fechar livro", Esc ou a mesma lombada guardam o livro: ele volta até a
 * frente do lugar dele, entra empurrando o vizinho de volta e assenta. Outro livro primeiro guarda o
 * aberto e só depois sai da estante (D49). Com movimento reduzido, tudo direto no estado final.
 *
 * O livro que voa é o próprio livro da gaveta, já no lugar final: o GSAP o põe em cima da lombada e o
 * traz de volta ao lugar dele (só transformações). Cada livro vem pronto num <template>; o script só
 * monta. O desenho da capa só é buscado quando o livro abre (/livros/<slug>.svg) e entra inline. Sem
 * JS, a lombada leva à página do livro.
 */
import Livro3D from "./Livro3D.astro";
import LivroAmpliado from "./LivroAmpliado.astro";
import SinalCodigo from "./SinalCodigo.astro";
import { ICONES } from "../lib/icones";
import { coresDoLivroCss, dadosDoLivro, paginasDoLivro, type Livro } from "../lib/estante";
import { diaEMes } from "../lib/formato";
import type { Resumo } from "../lib/posts";
import "../styles/estante.css";

interface Props {
  livros: Livro[];
}

const { livros } = Astro.props;

type Linha = { tipo: "ano"; ano: number } | { tipo: "post"; post: Resumo; parte?: number };
function linhas(l: Livro): Linha[] {
  if (l.serie) return l.posts.map((post, i) => ({ tipo: "post", post, parte: i + 1 }));
  const saida: Linha[] = [];
  let ano: number | undefined;
  for (const post of l.posts) {
    const a = post.publicado.getUTCFullYear();
    if (a !== ano) saida.push({ tipo: "ano", ano: (ano = a) });
    saida.push({ tipo: "post", post });
  }
  return saida;
}
---

<div class="gaveta" id="gaveta" data-gaveta hidden></div>
<LivroAmpliado />

{
  livros.map((l) => (
    <template data-modelo={l.id}>
      <div
        class="livro-aberto"
        data-largura={l.emPe.largura}
        data-ampliar-livro
        data-nome={l.nome}
        data-dados={dadosDoLivro(l)}
        data-href={l.href}
        data-paginas={paginasDoLivro(l)}
        style={`${coresDoLivroCss(l)};--h:${l.emPe.altura}`}
      >
        <div class="livro-na-gaveta">
          {/* O livro e a lupa abrem o livro ampliado (D43); a lupa serve ao teclado. */}
          <Livro3D livro={l} desenho="adiado" />
          <button type="button" class="lupa" data-ampliar aria-label={`Ampliar o livro ${l.nome}`} title="Ampliar"
            ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.ampliar} /></button
          >
        </div>
        <div class="sumario-livro">
          <div class="topo-sumario">
            <h2 id={`sumario-${l.id}`} tabindex="-1">{l.serie ? "Ordem de leitura" : "Neste livro"}</h2>
            <span class="meta-sumario">{l.posts.length > 0 ? `${l.nome}, ${l.contagem}` : l.nome}</span>
            <div class="acoes-livro">
              <a class="botao-primario" href={l.href}
                >{l.serie ? "Ver a série" : "Ver o livro"}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} /></a
              >
              <button type="button" class="botao" data-fechar-livro>Fechar livro</button>
            </div>
          </div>
          {l.posts.length === 0 && <p class="sem-artigos">Este livro ainda não tem artigos.</p>}
          <ul class="indice-livro" aria-labelledby={`sumario-${l.id}`} hidden={l.posts.length === 0}>
            {linhas(l).map((linha) =>
              linha.tipo === "ano" ? (
                <li class="ano" aria-hidden="true">{linha.ano}</li>
              ) : (
                <li>
                  <a href={linha.post.url}>
                    <span class="titulo-item">{linha.parte && <span class="parte">Parte {linha.parte}</span>}{linha.post.tituloCompleto}{linha.post.codigo && <SinalCodigo curto />}</span>
                    <span class="pontilhado" aria-hidden="true" />
                    <span class="dia">{diaEMes(linha.post.publicado)}</span>
                  </a>
                </li>
              ),
            )}
          </ul>
        </div>
      </div>
    </template>
  ))
}

<script>
  import { GIRO, medidasDoLivro3D } from "../lib/livro-3d";
  import { descanso, endireitar, levantar, profundidade, quemTomba, tombar, type Tombado } from "../scripts/estante-gesto";
  import { prepararPrateleira } from "../scripts/estante-viva";
  import { carregarArrastar, carregarGsap, movimentoReduzido, temMouse, type GSAP } from "../scripts/gsap";

  const gaveta = document.querySelector<HTMLElement>("[data-gaveta]");
  const estante = document.querySelector<HTMLElement>("[data-estante]");
  const prateleira = estante?.querySelector<HTMLElement>(".prateleira-livros");
  if (gaveta && estante && prateleira) {
    const lombadas = [...estante.querySelectorAll<HTMLElement>("[data-livro]")];
    const pequeno = matchMedia("(max-width: 760px)");
    // No celular, o gesto é um pouco mais rápido (D49).
    const DUR = () => (pequeno.matches ? 0.8 : 1);

    // O desenho da capa (ou o emblema da revista) só vem quando o livro abre (D30, D32).
    const desenhos = new Map<string, Promise<string>>();
    function trazerDesenho(no: HTMLElement) {
      for (const alvo of no.querySelectorAll<HTMLElement>("[data-desenho]")) {
        const endereco = alvo.dataset.desenho!;
        if (!desenhos.has(endereco)) {
          desenhos.set(endereco, fetch(endereco).then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status))))));
        }
        desenhos
          .get(endereco)!
          .then((svg) => (alvo.innerHTML = svg))
          .catch(() => desenhos.delete(endereco));
      }
    }

    function montar(id: string) {
      const modelo = document.querySelector<HTMLTemplateElement>(`template[data-modelo="${id}"]`)!;
      const no = modelo.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const m = medidasDoLivro3D(Number(no.dataset.largura), pequeno.matches ? 270 : 360);
      for (const [k, v] of Object.entries(m)) no.style.setProperty(`--${k}`, `${v}px`);
      const icone = no.querySelector<HTMLElement>("[data-icone-de]");
      if (icone) icone.innerHTML = estante!.querySelector(`[data-livro="${id}"] :is(.icone-lombada, .emblema-lombada)`)?.innerHTML ?? "";
      gaveta!.replaceChildren(no);
      gaveta!.hidden = false;
      // Na troca de livro, a gaveta ficou presa na altura do anterior: solta, para medir a do novo.
      for (const p of ["height", "margin-top", "padding-top", "padding-bottom"]) gaveta!.style.removeProperty(p);
      trazerDesenho(no);
      return no;
    }

    const partes = (no: HTMLElement) => ({
      voo: no.querySelector<HTMLElement>(".livro-na-gaveta")!,
      livro: no.querySelector<HTMLElement>(".livro-3d")!,
      caixa: no.querySelector<HTMLElement>(".livro-3d-caixa")!,
      sumario: no.querySelector<HTMLElement>(".sumario-livro")!,
      lupa: no.querySelector<HTMLElement>(".lupa")!,
    });

    /**
     * Onde pôr o livro da gaveta (girado 90°, de lombada para a frente) para ele cobrir a lombada da
     * estante: o deslocamento até o centro dela e a escala que iguala as alturas. A lombada do livro 3D
     * fica meia capa mais perto do olho e aparece um pouco maior (a perspectiva da caixa, livro.css). Ela
     * também é mais fina que a da estante (a altura do livro 3D é sempre a de 720, D30): a largura
     * acompanha a da estante no começo do voo e volta à do livro enquanto ele gira.
     */
    function sobreALombada(caixa: HTMLElement, lombada: HTMLElement) {
      const l = lombada.getBoundingClientRect();
      const c = caixa.getBoundingClientRect();
      const p = parseFloat(getComputedStyle(caixa).perspective) || c.height * 4.7;
      const scale = l.height / ((c.height * p) / (p - c.width / 2));
      const espessura = parseFloat(getComputedStyle(caixa).getPropertyValue("--sw")) || lombada.offsetWidth;
      const largura = lombada.offsetWidth / lombada.offsetHeight / (espessura / caixa.offsetHeight);
      return {
        x: l.left + l.width / 2 - (c.left + c.width / 2),
        y: l.top + l.height / 2 - (c.top + c.height / 2),
        scaleX: scale * largura,
        scaleY: scale,
      };
    }

    /** A gaveta à vista: rola até o livro, se ele ficar fora da tela (`ate` em coordenadas da página). */
    function rolarAte(ate: number, direto: boolean) {
      const falta = ate - scrollY - innerHeight;
      if (falta > 0) scrollBy({ top: falta + 24, behavior: direto || movimentoReduzido.matches ? "auto" : "smooth" });
    }

    type Aberto = { id: string; lombada: HTMLElement; no: HTMLElement; vizinho: Tombado | null; tl: gsap.core.Timeline };
    let aberto: Aberto | null = null;
    // A gaveta que cresce e recolhe (D47): altura, margem e respiros vão de zero ao natural.
    const FECHADA = { height: 0, marginTop: 0, paddingTop: 0, paddingBottom: 0 };
    const MEDIDAS = "height,marginTop,paddingTop,paddingBottom";
    const cheia = () => {
      const cs = getComputedStyle(gaveta!);
      return {
        height: gaveta!.offsetHeight,
        marginTop: parseFloat(cs.marginTop),
        paddingTop: parseFloat(cs.paddingTop),
        paddingBottom: parseFloat(cs.paddingBottom),
      };
    };
    // Na troca de livro, a altura do que estava aberto: a gaveta vai dela para a do novo.
    let alturaDaTroca = 0;
    let ocupado = false;
    /** O livro que já veio para a frente, na mão (arrastado pela cabeça), com o vizinho que tombou. */
    type NaMao = { vizinho: Tombado | null };
    /** Um pedido feito durante um movimento: abrir um livro (`id`) ou fechar o aberto (sem `id`). */
    type Pedido = { id?: string; foco: boolean; naMao?: NaMao };
    let pendente: Pedido | null = null;
    let gsapNoAr: GSAP | null = null;

    /**
     * Tira o livro da estante e leva para a gaveta. O gesto (D49): o livro tomba pela cabeça dentro do
     * próprio vão e só então vem para a frente, quando o vizinho perde o apoio e tomba; na frente dos
     * outros, o livro 3D da gaveta toma o lugar da lombada e anda até a gaveta, girando da lombada até
     * os 38°. A gaveta cresce enquanto isso (do zero, ou da altura do livro anterior). `naMao`: o livro
     * já veio para a frente, arrastado, e parte de onde foi solto. `direto`: tudo no estado final.
     */
    function abrir(gsap: GSAP, id: string, foco: boolean, { naMao, direto = false }: { naMao?: NaMao; direto?: boolean } = {}) {
      const lombada = lombadas.find((l) => l.dataset.livro === id)!;
      prepararPrateleira(gsap, prateleira!);
      lombada.setAttribute("aria-expanded", "true");
      const no = montar(id);
      const { voo, livro, caixa, sumario, lupa } = partes(no);
      const dur = DUR();
      // Onde a gaveta termina, para rolar até ela: medido agora, com ela já no tamanho final.
      const r = no.getBoundingClientRect();
      const ate = r.top + scrollY + Math.min(r.height, caixa.offsetHeight + 120);
      const troca = alturaDaTroca;
      alturaDaTroca = 0;
      const animar = !direto && !movimentoReduzido.matches;
      if (animar) {
        // A gaveta cresce (do zero, ou da altura do livro anterior) enquanto o livro sai da estante. Vem
        // antes da linha do tempo do livro, para, a cada quadro, o livro medir a gaveta já no lugar.
        const fim = cheia();
        gsap.fromTo(
          gaveta!,
          troca ? { ...fim, height: troca } : FECHADA,
          { ...fim, duration: troca ? 0.55 : 0.8, ease: "power3.inOut", overwrite: true, clearProps: MEDIDAS },
        );
      }
      const tl = gsap.timeline({ onComplete: () => foco && no.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true }) });
      const registro: Aberto = { id, lombada, no, vizinho: naMao?.vizinho ?? null, tl };
      aberto = registro;

      if (!animar) {
        // O livro aparece na gaveta, o lugar dele fica vazio e o vizinho já aparece tombado.
        if (!naMao) registro.vizinho = quemTomba(lombada);
        gsap.killTweensOf(lombada);
        lombada.classList.add("retirado");
        lombada.classList.remove("segurando");
        gsap.set(lombada, { x: 0, y: 0, z: 0, rotationX: 0, ...descanso(lombada) });
        tombar(gsap, registro.vizinho, dur, true);
        tl.set(livro, { rotationY: GIRO });
        rolarAte(ate, true);
        return tl;
      }

      lombada.classList.add("segurando");
      gsap.killTweensOf(lombada);
      gsap.set(voo, { autoAlpha: 0 });
      gsap.set([sumario, lupa], { opacity: 0 });
      gsap.set(livro, { rotationY: 90 });
      if (!naMao) {
        const prof = profundidade(lombada);
        // Tomba pela cabeça dentro do próprio vão (a inclinada se endireita junto); só depois vem para
        // a frente, e aí o vizinho perde o apoio.
        tl.to(lombada, { rotation: 0, rotationX: -24, duration: 0.28 * dur, ease: "power2.out" })
          .add(() => {
            registro.vizinho = quemTomba(lombada);
            tombar(gsap, registro.vizinho, dur);
          })
          .to(lombada, { rotationX: -6, z: prof, y: levantar(prateleira!, prof), duration: 0.32 * dur, ease: "power2.inOut" });
      }
      // Na frente dos outros, o livro da gaveta toma o lugar da lombada e anda até a gaveta.
      tl.add(() => {
        gsap.set(voo, { ...sobreALombada(caixa, lombada), autoAlpha: 1, transformOrigin: "50% 50%", zIndex: 6 });
        lombada.classList.add("retirado");
        rolarAte(ate, false);
      })
        .to(voo, { x: 0, y: 0, scaleX: 1, scaleY: 1, duration: 0.9 * dur, ease: "power3.inOut" })
        .to(livro, { rotationY: GIRO, duration: 0.9 * dur, ease: "power3.inOut" }, "<")
        .set(voo, { zIndex: "auto" })
        .add(() => {
          // O lugar vazio fica pronto: a lombada, escondida, volta a ficar em pé no lugar dela.
          lombada.classList.remove("segurando");
          gsap.set(lombada, { x: 0, y: 0, z: 0, rotationX: 0, ...descanso(lombada) });
        })
        .fromTo(sumario, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, "-=0.3")
        .to(lupa, { opacity: 1, duration: 0.25, ease: "none" }, "<");
      return tl;
    }

    /**
     * Guarda o livro (D49): o livro 3D volta até a frente do lugar dele, girando de volta para a lombada;
     * ela entra na prateleira, empurrando o vizinho de volta, e assenta (a inclinada volta a se apoiar no
     * aparador). Fechando de vez, a gaveta recolhe enquanto o livro entra; trocando de livro (`depois`),
     * fica na altura de agora, e o outro livro só sai da estante depois que este estiver guardado.
     */
    function fechar(depois?: () => void, devolverFoco = false) {
      if (!aberto) return depois?.();
      const { lombada, no, vizinho, tl: abertura } = aberto;
      aberto = null;
      ocupado = true;
      abertura.kill();
      const gsap = gsapNoAr!;
      const dur = DUR();
      const terminar = () => {
        gaveta!.replaceChildren();
        gaveta!.hidden = true;
        if (!depois) gsap.set(gaveta!, { clearProps: MEDIDAS });
        lombada.classList.remove("segurando");
        lombada.setAttribute("aria-expanded", "false");
        ocupado = false;
        if (devolverFoco) lombada.focus();
        if (depois) return depois();
        seguirPendente();
      };
      if (movimentoReduzido.matches) {
        lombada.classList.remove("retirado");
        gsap.set(lombada, { x: 0, y: 0, z: 0, rotationX: 0, ...descanso(lombada) });
        endireitar(gsap, vizinho, dur, true);
        return terminar();
      }
      if (depois) {
        alturaDaTroca = gaveta!.offsetHeight;
        gsap.set(gaveta!, { height: alturaDaTroca });
      }
      const { voo, livro, caixa, sumario, lupa } = partes(no);
      const { rotation, transformOrigin } = descanso(lombada);
      // A lombada espera fora da estante, na frente do lugar dela, para o livro 3D mirar nela.
      const prof = profundidade(lombada);
      lombada.classList.add("segurando");
      gsap.killTweensOf(lombada);
      gsap.set(lombada, { x: 0, rotation: 0, rotationX: -6, z: prof, y: levantar(prateleira!, prof) });
      const volta = gsap
        .timeline({ onComplete: terminar })
        .to([sumario, lupa], { opacity: 0, duration: 0.18 }, 0)
        .set(voo, { zIndex: 6 }, 0)
        .to(livro, { rotationY: 90, duration: 0.6 * dur, ease: "power3.inOut" }, 0)
        .to(voo, { ...sobreALombada(caixa, lombada), duration: 0.6 * dur, ease: "power3.inOut" }, 0)
        .add(() => {
          gsap.set(voo, { autoAlpha: 0 });
          lombada.classList.remove("retirado");
        })
        .addLabel("pouso")
        // Entra na prateleira: volta para o plano dos outros, e o vizinho é empurrado de volta.
        .to(lombada, { z: 0, y: 0, rotationX: 0, duration: 0.4 * dur, ease: "power2.inOut" })
        .add(() => endireitar(gsap, vizinho, dur), "<")
        .set(lombada, { transformOrigin })
        .to(lombada, { rotation, duration: rotation ? 0.2 : 0.01, ease: "power2.in" })
        .to(lombada, { y: 1, duration: 0.05, ease: "power1.out" })
        .to(lombada, { y: 0, duration: 0.1, ease: "power1.in" });
      if (!depois) volta.to(gaveta!, { ...FECHADA, duration: 0.5, ease: "power3.inOut", overwrite: true }, "pouso");
    }

    /** O pedido feito durante o último movimento, se houver. */
    function seguirPendente() {
      if (!pendente) return;
      const p = pendente;
      pendente = null;
      if (!p.id) return fechar(undefined, p.foco);
      if (p.naMao || p.id !== aberto?.id) escolher(p.id, p.foco, p.naMao);
    }

    /** Pede um movimento; durante outro, fica para depois (o último pedido vale, e o livro na mão espera). */
    function pedir(p: Pedido) {
      if (pendente?.naMao) return;
      if (ocupado) return void (pendente = p);
      if (!p.id) return fechar(undefined, p.foco);
      escolher(p.id, p.foco, p.naMao);
    }

    async function escolher(id: string, foco: boolean, naMao?: NaMao) {
      if (ocupado) return void (pendente = { id, foco, naMao });
      if (aberto?.id === id) return fechar(undefined, foco);
      const gsap = (gsapNoAr = await carregarGsap());
      fechar(() => {
        ocupado = true;
        abrir(gsap, id, foco, { naMao }).then(() => {
          ocupado = false;
          seguirPendente();
        });
      });
    }

    const clique = (e: MouseEvent) => e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
    for (const l of lombadas) {
      l.setAttribute("aria-controls", "gaveta");
      l.setAttribute("aria-expanded", "false");
      l.addEventListener("click", (e) => {
        if (!clique(e)) return;
        e.preventDefault();
        // O livro que o arrasto está devolvendo para a prateleira termina de entrar antes.
        if (l.classList.contains("segurando") && !ocupado) return;
        pedir({ id: l.dataset.livro!, foco: e.detail === 0 });
      });
    }
    gaveta.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-fechar-livro]")) pedir({ foco: e.detail === 0 });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && (aberto || ocupado) && !document.querySelector("dialog[open]")) pedir({ foco: true });
    });
    // Passou do celular para a tela larga (ou o contrário) com o livro aberto: remonta no tamanho novo,
    // no estado final.
    pequeno.addEventListener("change", () => {
      if (!aberto || ocupado) return;
      const { id, vizinho, tl } = aberto;
      tl.kill();
      aberto = null;
      carregarGsap().then((gsap) => abrir(gsap, id, false, { direto: true, naMao: { vizinho } }));
    });

    /*
     * ---------- arrastar pela cabeça (só com mouse, D49) ----------
     * Puxar a cabeça do livro para baixo tomba o livro para a frente, pela borda de baixo (até 30°). A
     * partir de 22°, ele se solta da prateleira: vem para a frente, o vizinho tomba, e o livro segue o
     * mouse. Solto abaixo da prateleira (a velocidade do arremesso conta), vai para a gaveta; solto no
     * ar, volta para o lugar dele. Sem chegar a soltar, cai de volta em pé. Só clicar faz o gesto
     * inteiro sozinho. No toque não há arrasto: o dedo precisa rolar a página.
     */
    let arrasto = false;
    function ligarArrasto() {
      if (arrasto || !temMouse.matches || movimentoReduzido.matches) return;
      arrasto = true;
      carregarArrastar().then(({ gsap, Draggable, InertiaPlugin }) => {
        gsapNoAr ??= gsap;
        prepararPrateleira(gsap, prateleira!);
        prateleira!.classList.add("arrasta");
        const tabua = estante!.querySelector<HTMLElement>(".tabua")!;
        for (const lombada of lombadas) {
          lombada.draggable = false;
          const proxy = document.createElement("div");
          let fase: "parado" | "tombando" | "saindo" | "na-mao" = "parado";
          let arrastou = false;
          let inicio = 0;
          let pega = { x: 0, y: 0 };
          let prof = 0;
          let vizinho: Tombado | null = null;
          let segue: { x: (v: number) => void; y: (v: number) => void } | null = null;
          let soltou: { y: number; vy: number } | null = null;

          /** Solto no ar: não fica flutuando, volta para o lugar dele, e o vizinho é empurrado de volta. */
          const devolver = () => {
            const { rotation, transformOrigin } = descanso(lombada);
            const v = vizinho;
            vizinho = null;
            gsap.killTweensOf(lombada);
            gsap
              .timeline({ onComplete: () => lombada.classList.remove("segurando") })
              .to(lombada, { x: 0, y: levantar(prateleira!, prof), duration: 0.35, ease: "power2.inOut" })
              .to(lombada, { z: 0, y: 0, rotationX: 0, duration: 0.36, ease: "power2.inOut" })
              .add(() => endireitar(gsap, v, DUR()), "<")
              .set(lombada, { transformOrigin })
              .to(lombada, { rotation, duration: rotation ? 0.18 : 0.01, ease: "power2.in" })
              .to(lombada, { y: 1, duration: 0.05, ease: "power1.out" })
              .to(lombada, { y: 0, duration: 0.1, ease: "power1.in" });
          };

          /** Onde o livro solto iria parar, pela velocidade no fim do arrasto: abaixo da tábua, na gaveta. */
          const decidir = (y: number, vy: number) => {
            fase = "parado";
            if (y + vy * 0.25 > tabua.getBoundingClientRect().bottom + 8) {
              const v = vizinho;
              vizinho = null;
              gsap.killTweensOf(lombada, "x,y");
              escolher(lombada.dataset.livro!, false, { vizinho: v });
            } else devolver();
          };

          Draggable.create(proxy, {
            trigger: lombada,
            type: "x,y",
            minimumMovement: 4,
            cursor: "pointer",
            activeCursor: "grabbing",
            onPress() {
              arrastou = false;
              soltou = null;
              inicio = this.y;
              const livre = !ocupado && !pendente && aberto?.id !== lombada.dataset.livro && !lombada.classList.contains("segurando");
              fase = livre && !movimentoReduzido.matches ? "tombando" : "parado";
            },
            onDragStart() {
              if (fase !== "tombando") return;
              arrastou = true;
              // O livro aberto volta para a estante enquanto este sai.
              if (aberto) fechar();
              lombada.classList.add("segurando");
              prof = profundidade(lombada);
              gsap.killTweensOf(lombada);
              gsap.to(lombada, { rotation: 0, duration: 0.15, ease: "power2.out" });
            },
            onDrag() {
              if (fase === "tombando") {
                // Puxar a cabeça para baixo tomba o livro para a frente, pela borda de baixo.
                const dy = Math.max(0, this.y - inicio);
                const graus = Math.min(30, (dy / (lombada.offsetHeight * 0.45)) * 30);
                gsap.set(lombada, { rotationX: -graus });
                if (graus < 22) return;
                // Solto da prateleira: sai para a frente (a profundidade inteira do livro) e só então anda.
                fase = "saindo";
                vizinho = quemTomba(lombada);
                tombar(gsap, vizinho, DUR());
                gsap.to(lombada, {
                  rotationX: -6,
                  z: prof,
                  y: levantar(prateleira!, prof),
                  duration: 0.24,
                  ease: "power2.out",
                  onComplete: () => {
                    if (soltou) return decidir(soltou.y, soltou.vy);
                    fase = "na-mao";
                    pega = { x: this.x, y: this.y };
                    segue = {
                      x: gsap.quickTo(lombada, "x", { duration: 0.18, ease: "power3.out" }),
                      y: gsap.quickTo(lombada, "y", { duration: 0.18, ease: "power3.out" }),
                    };
                  },
                });
              } else if (fase === "na-mao") {
                segue!.x(this.x - pega.x);
                segue!.y(this.y - pega.y + levantar(prateleira!, prof));
              }
            },
            onRelease() {
              if (!arrastou) return;
              arrastou = false;
              const vy = InertiaPlugin.getVelocity(proxy, "y") || 0;
              if (fase === "tombando") {
                // Não chegou a soltar: cai de volta em pé, acelerando, e assenta.
                fase = "parado";
                const { rotation } = descanso(lombada);
                gsap
                  .timeline({ onComplete: () => lombada.classList.remove("segurando") })
                  .to(lombada, { rotationX: 0, duration: 0.22, ease: "power2.in" })
                  .to(lombada, { rotation, duration: rotation ? 0.18 : 0.01, ease: "power2.in" });
              } else if (fase === "saindo") soltou = { y: this.pointerY, vy };
              else if (fase === "na-mao") decidir(this.pointerY, vy);
            },
          });
        }
      });
    }
    prateleira.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && ligarArrasto());
  }
</script>
