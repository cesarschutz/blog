---
/**
 * A gaveta da estante (briefing §5.1, D40, ideia 3): tirar o livro da estante e abrir. No clique ou
 * toque numa lombada, o livro sobe e o lugar dele fica escurecido; um livro 3D sai da posição exata da
 * lombada, com a lombada de frente, e vem para a gaveta girando até 18°; a capa abre (-165°) enquanto
 * o livro desliza para centralizar as duas páginas e gira até 4°; na página da direita aparecem os
 * artigos mais recentes (até 6), com "Ver todos os N artigos" e "Ver o livro". O verso da capa leva a
 * assinatura do blog. "Guardar o livro", Esc ou um clique no lugar escurecido fazem o caminho de
 * volta, 1,5× mais rápido; outro livro fecha o atual e abre o novo. No celular, o livro aberto cabe na
 * largura da tela. Com movimento reduzido, tudo direto no estado final.
 *
 * Cada livro vem pronto num <template>; o script só monta. O desenho da capa só é buscado quando o
 * livro abre (/livros/<slug>.svg) e entra inline. Sem JS, a lombada leva à página do livro.
 */
import Livro3D from "./Livro3D.astro";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import { diaEMes } from "../lib/formato";
import { url } from "../lib/url";
import "../styles/estante.css";

interface Props {
  livros: Livro[];
}

const { livros } = Astro.props;
/** Quantos artigos cabem na página da direita. */
const NA_PAGINA = 6;
const recentes = (l: Livro) => [...l.posts].sort((a, b) => b.publicado.getTime() - a.publicado.getTime()).slice(0, NA_PAGINA);
const quantos = (l: Livro) => {
  const n = l.posts.length;
  if (l.serie) return `${n} ${n === 1 ? "edição" : "edições"}`;
  return `${n} ${n === 1 ? "artigo" : "artigos"}`;
};
---

<div class="gaveta" id="gaveta" data-gaveta hidden>
  <h2 class="sr" tabindex="-1" data-titulo-gaveta></h2>
  <button type="button" class="botao guardar" data-guardar>Guardar o livro</button>
</div>

{
  livros.map((l) => (
    <template data-modelo={l.id}>
      <div class="livro-voando" data-largura={l.emPe.largura} style={`${coresDoLivroCss(l)};--h:${l.emPe.altura}`}>
        <Livro3D livro={l} desenho="adiado">
          <div slot="pagina" class="pagina-aberta">
            <p class="titulo-pagina">{l.serie ? "Nesta série" : "Neste livro"}</p>
            <p class="sub-pagina">{l.posts.length > 0 ? `${l.nome} · ${quantos(l)}` : l.nome}</p>
            {l.posts.length > 0 ? (
              <ol class="itens-pagina">
                {recentes(l).map((p) => (
                  <li>
                    <a href={p.url}>{p.titulo}</a>
                    <small>{diaEMes(p.publicado)}</small>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="vazio-pagina">Este livro ainda não tem artigos. O primeiro está a caminho.</p>
            )}
            <p class="links-pagina">
              {l.posts.length > 0 && <a href={url(`/archive/?livro=${l.id}`)}>{l.serie ? "Ver todas as" : "Ver todos os"} {quantos(l)}</a>}
              <a href={l.href}>{l.serie ? "Ver a série" : "Ver o livro"}</a>
            </p>
          </div>
        </Livro3D>
      </div>
    </template>
  ))
}

<script>
  import { carregarGsap, movimentoReduzido, type GSAP } from "../scripts/gsap";
  import { medidasDoLivro3D } from "../lib/livro-3d";

  const gaveta = document.querySelector<HTMLElement>("[data-gaveta]");
  const estante = document.querySelector<HTMLElement>("[data-estante]");
  const palco = gaveta?.closest<HTMLElement>(".folha");
  if (gaveta && estante && palco) {
    const lombadas = [...estante.querySelectorAll<HTMLElement>("[data-livro]")];
    const titulo = gaveta.querySelector<HTMLElement>("[data-titulo-gaveta]")!;
    const guardar = gaveta.querySelector<HTMLButtonElement>("[data-guardar]")!;
    palco.classList.add("palco-gaveta");

    // O desenho da capa (ou o emblema da revista) só vem quando o livro abre (D30, D32).
    const desenhos = new Map<string, Promise<string>>();
    function trazerDesenho(no: HTMLElement) {
      for (const alvo of no.querySelectorAll<HTMLElement>("[data-desenho]")) {
        const endereco = alvo.dataset.desenho!;
        if (!desenhos.has(endereco)) {
          desenhos.set(endereco, fetch(endereco).then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status))))));
        }
        desenhos
          .get(endereco)!
          .then((svg) => (alvo.innerHTML = svg))
          .catch(() => desenhos.delete(endereco));
      }
    }

    // Altura do livro: 360px, ou o que couber com as duas páginas abertas na largura do palco.
    const alturaDoLivro = () => {
      const largura = palco.clientWidth - 40;
      return Math.round(Math.min(360, (largura / 2) * 1.5));
    };

    type Aberto = { id: string; lombada: HTMLElement; clone: HTMLElement; tl: gsap.core.Timeline };
    let aberto: Aberto | null = null;
    let ocupado = false;
    let pendente: string | null = null;

    function montar(id: string) {
      const modelo = document.querySelector<HTMLTemplateElement>(`template[data-modelo="${id}"]`)!;
      const clone = modelo.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const altura = alturaDoLivro();
      const m = medidasDoLivro3D(Number(clone.dataset.largura), altura);
      for (const [k, v] of Object.entries(m)) clone.style.setProperty(`--${k}`, `${v}px`);
      const icone = clone.querySelector<HTMLElement>("[data-icone-de]");
      if (icone) icone.innerHTML = estante!.querySelector(`[data-livro="${id}"] :is(.icone-lombada, .emblema-lombada)`)?.innerHTML ?? "";
      palco!.append(clone);
      trazerDesenho(clone);
      return { clone, m };
    }

    function abrir(gsap: GSAP, id: string, foco: boolean) {
      const lombada = lombadas.find((l) => l.dataset.livro === id)!;
      gaveta!.hidden = false;
      const { clone, m } = montar(id);
      gaveta!.style.setProperty("--altura-livro", `${m.bh}px`);
      titulo.textContent = `${lombada.dataset.titulo}, aberto na gaveta`;
      lombada.setAttribute("aria-expanded", "true");

      const livro = clone.querySelector<HTMLElement>(".livro-3d")!;
      const capa = clone.querySelector<HTMLElement>(".face-capa")!;
      const itens = clone.querySelectorAll(".pagina-aberta > *, .itens-pagina li");
      const p = palco!.getBoundingClientRect();
      const l = lombada.getBoundingClientRect();
      const g = gaveta!.getBoundingClientRect();
      // De onde sai: a lombada, com a mesma altura. Para onde vai: o meio da gaveta.
      const s0 = l.height / m.bh;
      const x0 = l.left - p.left + l.width / 2 - m.cw / 2;
      const y0 = l.top - p.top + l.height / 2 - m.bh / 2;
      const meio = p.width / 2 - m.cw * 0.02;
      const ym = g.top - p.top + 18;

      gsap.set(clone, { x: x0, y: y0, scale: s0, transformOrigin: "50% 50%" });
      gsap.set(livro, { rotationY: 90 });
      gsap.set(capa, { rotationY: 0 });
      const tl = gsap.timeline({ defaults: { ease: "power3.inOut" }, onComplete: () => foco && clone.querySelector<HTMLElement>(".pagina-aberta a")?.focus() });
      if (movimentoReduzido.matches) {
        lombada.classList.add("retirado");
        tl.set(clone, { x: meio, y: ym, scale: 1 }).set(livro, { rotationY: 4 }).set(capa, { rotationY: -165 });
      } else {
        tl.to(clone, { y: y0 - 40, duration: 0.45, ease: "power2.out" }, 0)
          .add(() => lombada.classList.add("retirado"), 0.3)
          .to(clone, { x: meio - m.cw * 0.45, y: ym, scale: 1, duration: 1.05 }, 0.38)
          .to(livro, { rotationY: 18, duration: 1.05 }, 0.38)
          .to(capa, { rotationY: -165, duration: 1.05 }, "+=0.12")
          .to(clone, { x: meio, duration: 1.05 }, "<")
          .to(livro, { rotationY: 4, duration: 1.05 }, "<")
          .from(itens, { opacity: 0, y: 6, stagger: 0.05, duration: 0.35, ease: "power2.out" }, "-=0.4");
      }
      aberto = { id, lombada, clone, tl };

      // A gaveta à vista: rola até ela, se o livro aberto ficar fora da tela.
      const fim = g.top + m.bh + 80;
      if (fim > innerHeight) scrollBy({ top: fim - innerHeight + 24, behavior: movimentoReduzido.matches ? "auto" : "smooth" });
      return tl;
    }

    function fechar(depois?: () => void, devolverFoco = false) {
      if (!aberto) return depois?.();
      const { lombada, clone, tl } = aberto;
      aberto = null;
      ocupado = true;
      tl.eventCallback("onComplete", null);
      tl.eventCallback("onReverseComplete", () => {
        clone.remove();
        lombada.classList.remove("retirado");
        lombada.setAttribute("aria-expanded", "false");
        gaveta!.hidden = true;
        ocupado = false;
        if (devolverFoco) lombada.focus();
        depois?.();
      });
      // Sem movimento, fecha na hora; com, faz o caminho de volta 1,5× mais rápido.
      if (movimentoReduzido.matches) tl.progress(0).eventCallback("onReverseComplete")?.();
      else tl.timeScale(1.5).reverse();
    }

    async function escolher(id: string, foco: boolean) {
      if (ocupado) return void (pendente = id);
      if (aberto?.id === id) return fechar(undefined, foco);
      const gsap = await carregarGsap();
      fechar(() => {
        ocupado = true;
        const tl = abrir(gsap, id, foco);
        tl.then(() => {
          ocupado = false;
          if (pendente) {
            const p = pendente;
            pendente = null;
            if (p !== aberto?.id) escolher(p, false);
          }
        });
      });
    }

    const clique = (e: MouseEvent) => e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
    for (const l of lombadas) {
      l.setAttribute("aria-controls", "gaveta");
      l.setAttribute("aria-expanded", "false");
      l.addEventListener("click", (e) => {
        if (!clique(e)) return;
        e.preventDefault();
        escolher(l.dataset.livro!, e.detail === 0);
      });
    }
    guardar.addEventListener("click", (e) => fechar(undefined, e.detail === 0));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && aberto && !document.querySelector("dialog[open]")) fechar(undefined, true);
    });
    // Mudou a largura com o livro aberto: remonta no estado final, no tamanho novo.
    let largura = palco.clientWidth;
    new ResizeObserver(() => {
      if (palco.clientWidth === largura) return;
      largura = palco.clientWidth;
      if (!aberto || ocupado) return;
      const { id, clone, tl } = aberto;
      tl.kill();
      clone.remove();
      aberto.lombada.classList.remove("retirado");
      aberto = null;
      carregarGsap().then((gsap) => abrir(gsap, id, false).progress(1));
    }).observe(palco);
  }
</script>
