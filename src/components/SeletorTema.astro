---
/**
 * Alternância de tema no rodapé: claro, escuro ou sistema, guardada no navegador (`cs-theme`, a
 * mesma chave do blog atual, para quem já escolheu não perder a escolha). Fica em sincronia com o
 * botão do cabeçalho (src/scripts/tema.ts). Sem JS, o seletor fica escondido e o tema segue o
 * sistema. O script anti-piscada fica no layout.
 */
---

<div class="tema" data-tema hidden>
  <span id="tema-rotulo">Tema</span>
  <div role="group" aria-labelledby="tema-rotulo">
    <button type="button" data-valor="light">Claro</button>
    <button type="button" data-valor="dark">Escuro</button>
    <button type="button" data-valor="">Sistema</button>
  </div>
</div>

<script>
  import { aoMudarTema, aplicarTema, lerEscolha, type Escolha } from "../scripts/tema";

  const caixa = document.querySelector<HTMLElement>("[data-tema]");
  if (caixa) {
    const botoes = [...caixa.querySelectorAll<HTMLButtonElement>("button")];
    botoes.forEach((b) => b.addEventListener("click", () => aplicarTema((b.dataset.valor ?? "") as Escolha)));
    aoMudarTema(() => {
      const escolha = lerEscolha();
      botoes.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.valor === escolha)));
    });
    caixa.hidden = false;
  }
</script>

<style>
  .tema {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .tema div {
    display: inline-flex;
    gap: 4px;
  }

  .tema button {
    padding: 6px 4px;
    border: 0;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  .tema button:hover {
    color: var(--acento);
  }

  .tema button[aria-pressed="true"] {
    color: var(--acento);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
</style>
