---
/**
 * O ícone de uma tag (D52, B11): o desenho de src/livros/tags/<slug>.svg, inline, na caixa de
 * 120 × 120 (src/lib/tags-svg.ts), no traço dos ícones das lombadas: currentColor, pontas redondas e
 * o traço sem escala (vector-effect), com a espessura principal em `--traco-tag` (1,3px por padrão;
 * as outras duas, na proporção do arquivo). O papel que tapa o que fica atrás vem de `--papel-da-tag`
 * (a folha, por padrão). Decorativo: o nome da tag está sempre escrito ao lado.
 */
import { mioloDaTag } from "../lib/tags-svg";

interface Props {
  nome: string;
  class?: string;
}

const { nome, class: classe } = Astro.props;
---

<svg class:list={["icone-tag", classe]} viewBox="0 0 120 120" aria-hidden="true" focusable="false" set:html={mioloDaTag(nome)} />

<style>
  .icone-tag {
    --traco: var(--traco-tag, 1.3px);
    --tag-papel: var(--papel-da-tag, var(--paper-hi));
    display: block;
    overflow: visible;
  }

  .icone-tag :global(path) {
    vector-effect: non-scaling-stroke;
  }

  .icone-tag :global(:is(.cz-ln, .cz-gh)) {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icone-tag :global(.cz-w1) {
    stroke-width: var(--traco);
  }

  .icone-tag :global(.cz-w2) {
    stroke-width: calc(var(--traco) * 0.67);
  }

  .icone-tag :global(.cz-w3) {
    stroke-width: calc(var(--traco) * 0.5);
  }

  /* O único traço fantasma do desenho (a célula por fazer, o picote do ingresso). */
  .icone-tag :global(.cz-gh) {
    stroke-width: calc(var(--traco) * 0.9);
    stroke-dasharray: calc(var(--traco) * 2) calc(var(--traco) * 3.2);
    opacity: 0.8;
  }
</style>
