---
/**
 * Sumário do artigo (briefing §5.3), só com 3 seções ou mais.
 *
 * "lateral" (D26, D33, D49; C05, D52): em telas ≥ 1300px, à esquerda do texto, fixa. O sumário é um
 * post-it (o lembrete colado ao lado do texto, escrito à caneta azul) e o livro, embaixo, a ficha do
 * volume (uma ficha de fichário, à caneta preta, com a foto do livro deitado na mesa, D57). As
 * seções ficam num trilho, com um ponto em cada uma e sem número (D36): o "3. " de um título
 * numerado sai também do nome, nas três variantes. O sumário acompanha a leitura como o índice de um
 * caderno (C2, D49), escrito com a mesma caneta azul do fio do cabeçalho (B05, D52; `--caneta`, e não
 * mais a cor do livro): o fio desce conforme a leitura anda dentro da seção; a seção atual é
 * sublinhada à mão, como a do menu (traco.ts); a seção em que o leitor ficou ganha um visto quando
 * fica para trás (B04). O script (src/scripts/artigo.ts) desenha o fio e o sublinhado, abre as
 * subseções da atual e mantém a atual à vista quando a lista rola. Embaixo, "NN% lido" e o tempo que
 * falta (sem barra: o fio do cabeçalho já mostra o quanto foi lido); só com JS. Embaixo, na ficha, a
 * foto do livro do artigo (D57, prancha 04: deitado, com a fita e uma etiqueta por artigo, a deste
 * amarela; FotoDoLivro) e o link para a página dele. Sem seções (menos de 3), a coluna tem só a ficha. Os vistos são desenhados à mão, um por seção (vistoDeCaneta, traco.ts), aqui e na "folha".
 *
 * "recolhivel": no início do texto, nas telas menores.
 *
 * "folha" (C2, D49): nas telas sem a lateral, o nome da seção atual toma o lugar da marca no
 * cabeçalho (Cabecalho.astro) e, tocado, abre esta folha, que desce do cabeçalho como o menu (D46),
 * com os mesmos vistos; a caneta sublinha a seção atual quando a folha termina de descer.
 */
import FotoDoLivro from "./FotoDoLivro.astro";
import { ICONES } from "../lib/icones";
import { dadosDoLivro, type Livro } from "../lib/estante";
import { posicaoNoLivro } from "../lib/fotos";
import type { Resumo, SecaoDoSumario } from "../lib/posts";
import { tituloComQuebras } from "../lib/formato";
import { vistoDeCaneta } from "../lib/traco";
import type { TituloAMao } from "../lib/mao";

interface Props {
  secoes: SecaoDoSumario[];
  variante: "lateral" | "recolhivel" | "folha";
  /** Tempo de leitura do artigo, para o "faltam N min". */
  minutos?: number;
  /** O livro do artigo, na ficha embaixo do sumário lateral (D46, D57). */
  livro?: Livro;
  /** O artigo aberto: a etiqueta dele sai amarela na foto do livro (D57). */
  atual?: Resumo;
}

const { secoes, variante, minutos = 0, livro, atual } = Astro.props;
const posicao = livro && atual ? posicaoNoLivro(livro, atual.url) : undefined;
// "3. Bloqueio pessimista" → "Bloqueio pessimista": o sumário não mostra número (D36).
const semNumero = (texto: string) => texto.replace(/^\d{1,2}[.)]\s+/, "");
// Os títulos à mão da papelaria (C05, D52): só os da lista de src/data/mao.ts (o subconjunto da Caveat).
const NESTE_ARTIGO: TituloAMao = "Neste artigo";
const DO_LIVRO: TituloAMao = livro?.serie ? "Da série" : "Do livro";
---

{
  variante === "lateral" ? (
    <aside class="lateral" data-pagefind-ignore>
      {secoes.length > 0 && (
      <div class="folha folha-sumario post-it">
        <nav aria-label="Neste artigo" data-trilho>
          <p class="titulo">{NESTE_ARTIGO}</p>
          <div class="lista-trilho" data-lista-trilho>
          <svg class="fio" aria-hidden="true" focusable="false"><path class="fio-base" /><path class="fio-tinta" /></svg>
          <ol class="trilho">
            {secoes.map((s) => {
              return (
                <li class="secao">
                  <a href={`#${s.slug}`} data-secao={s.slug}>
                    <svg class="marco" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle class="bolinha" cx="7" cy="7" r="3.4" /><path class="visto" pathLength="1" d={vistoDeCaneta(s.text)} /></svg>
                    <span class="nome"><span class="rotulo" set:html={tituloComQuebras(semNumero(s.text))} /></span>
                  </a>
                  {s.sub.length > 0 && (
                    <div class="subsecoes">
                      <ol>
                        {s.sub.map((sub) => (
                          <li>
                            <a href={`#${sub.slug}`} data-subsecao={sub.slug} set:html={tituloComQuebras(sub.text)} />
                          </li>
                        ))}
                      </ol>
                    </div>
                  )}
                </li>
              );
            })}
          </ol>
          </div>
        </nav>
        <div class="progresso" aria-hidden="true" hidden data-progresso-sumario data-minutos={minutos}>
          <p class="numeros">
            <span class="lido">0% lido</span>
            <span class="falta" data-falta>
              <span class="faltam">faltam <span data-minutos-falta>{minutos}</span> min</span>
              <span class="chegou">chegou ao fim</span>
            </span>
          </p>
        </div>
        {/* Os atalhos do teclado (D50, Atalhos.astro): só com mouse e teclado, e com JS; a ficha sai daqui (B06). */}
        <button type="button" class="dica-atalhos" popovertarget="atalhos">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.teclado} />
          Atalhos
          <kbd aria-hidden="true">?</kbd>
        </button>
      </div>
      )}
      {
        livro && (
          <div class="folha do-livro ficha">
            <p class="cabeca-ficha">{DO_LIVRO}</p>
            <div class="foto">
              <FotoDoLivro livro={livro} atual={atual} prefixo="ficha-lateral" largura={220} />
            </div>
            <a class="sobre" href={livro.href}>
              <span class="dados">{dadosDoLivro(livro)}{posicao && <span class="sr">, {posicao}</span>}</span>
              <span class="nome-livro">{livro.nome}</span>
              <span class="ver">
                {livro.serie ? "Ver a série" : "Ver o livro"}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
              </span>
            </a>
          </div>
        )
      }
    </aside>
  ) : variante === "folha" ? (
    <div class="veu-sumario" data-veu-sumario aria-hidden="true" />
    <div
      class="folha folha-celular"
      id="folha-sumario"
      role="dialog"
      aria-label="Neste artigo"
      data-folha-sumario
      data-pagefind-ignore
    >
      <p class="titulo">Neste artigo</p>
      <ol class="trilho">
        {secoes.map((s, i) => (
          <li class="secao" style={`--i:${i}`}>
            <a href={`#${s.slug}`} data-secao-folha={s.slug}>
              <svg class="marco" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle class="bolinha" cx="7" cy="7" r="3.4" /><path class="visto" pathLength="1" d={vistoDeCaneta(s.text)} /></svg>
              <span class="nome"><span class="rotulo" set:html={tituloComQuebras(semNumero(s.text))} /></span>
            </a>
          </li>
        ))}
      </ol>
      {/* Sem a lateral, a ficha dos atalhos (Atalhos.astro, B06 da D52) também abre daqui: só com mouse. */}
      <button type="button" class="dica-atalhos" popovertarget="atalhos">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.teclado} />
        Atalhos do teclado
        <kbd aria-hidden="true">?</kbd>
      </button>
    </div>
  ) : (
    <details class="recolhivel" data-pagefind-ignore>
      <summary>Neste artigo</summary>
      <nav aria-label="Neste artigo">
        <ol>
          {secoes.map((s) => (
            <li>
              <a href={`#${s.slug}`} set:html={tituloComQuebras(semNumero(s.text))} />
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  /*
   * A leitura é escrita com a caneta azul (B05, D52): o fio do trilho, o ponto atual, os vistos e o
   * sublinhado da seção atual usam `--caneta`, a mesma do fio do cabeçalho (BarraLeitura) e das
   * marcações do caderno (D48). A cor do livro fica só no livro, embaixo (D39 item 7, revisto).
   */
  .lateral {
    display: none;
  }

  .titulo {
    margin: 0 0 12px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- trilho das seções ---------- */

  .trilho,
  .subsecoes ol {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  /*
   * O fio do trilho (C2, D49): um traço à mão que passa pelos pontos, com a tinta da caneta
   * escrita até onde a leitura chegou dentro da seção (artigo.ts desenha o caminho e move a tinta; a
   * transição do stroke-dashoffset faz a caneta seguir a rolagem com um leve atraso).
   */
  .lista-trilho {
    --marco: 22px;
    position: relative;
  }

  .fio {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--marco);
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .fio path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fio-base {
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .fio-tinta {
    stroke: var(--caneta);
    stroke-width: 2;
    transition: stroke-dashoffset 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .secao {
    position: relative;
    padding-left: calc(var(--marco) + 11px);
  }

  /* Nomes longos quebram nos pontos (tituloComQuebras) e, em último caso, onde der: nunca rolam. */
  .secao a {
    display: block;
    overflow-wrap: break-word;
    padding: 5px 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.38;
    text-decoration: none;
  }

  .secao > a:hover .nome {
    color: var(--ink);
  }

  /*
   * O ponto de cada seção, sem número (D36). Na seção atual, cheio de tinta; na que ficou para trás,
   * uma clareira no fio com o visto escrito dentro (C2, D49): fica, mesmo voltando a rolagem, como as
   * marcações do caderno.
   */
  .marco {
    position: absolute;
    z-index: 1;
    top: 8px;
    left: calc(var(--marco) / 2 - 7px);
    width: 14px;
    height: 14px;
    overflow: visible;
  }

  .bolinha {
    r: 3.4px;
    fill: var(--paper-hi);
    stroke: var(--ink-3);
    stroke-width: 1.2;
    transition:
      r 0.2s,
      fill 0.2s,
      stroke 0.2s;
  }

  .visto {
    fill: none;
    stroke: var(--caneta);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* O vão maior que o traço: com a ponta redonda, "1" deixava um pingo no começo do visto apagado. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 0.42s ease-in-out 0.15s,
      opacity 0.2s;
  }

  .secao > a[aria-current="true"] .bolinha {
    fill: var(--caneta);
    stroke: var(--caneta);
  }

  .secao.lida > a:not([aria-current]) .bolinha {
    r: 6.4px;
    fill: var(--paper-hi);
    stroke: transparent;
  }

  .secao.lida .visto {
    stroke-dashoffset: 0;
  }

  .secao > a[aria-current="true"] .visto {
    opacity: 0;
  }

  /*
   * A seção atual fica na tinta cheia e um nada mais encorpada, sem mudar a largura do texto (revisão
   * 4, D52): com o peso 600, o nome quebrava noutra linha, a lista inteira saltava e o sublinhado que
   * saía, medido nas linhas de antes, ficava por um instante como um risco sobre a seção seguinte. O
   * contorno fino na cor do texto engrossa a letra sem mexer na métrica; quem marca é o sublinhado.
   */
  .secao > a {
    transition: color 0.2s;
  }

  .secao > a[aria-current="true"] {
    color: var(--ink);
  }

  .secao > a[aria-current="true"] .rotulo {
    -webkit-text-stroke: 0.35px currentColor;
  }

  /*
   * A seção atual, sublinhada à caneta (B05, D52; no lugar do marca-texto na cor do livro): o mesmo
   * traço do menu do cabeçalho (traco.ts), um por linha do nome, que a caneta escreve da esquerda para
   * a direita, linha a linha; quando a leitura segue, ele termina de passar e some pela direita. Com o
   * mouse (ou o foco) numa seção, um traço leve, como no menu. Quem desenha é o artigo.ts: as linhas
   * de um nome que quebra só existem na tela. Com movimento reduzido, o traço aparece pronto.
   */
  .secao :global(.sublinhado) {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .secao :global(.sublinhado svg) {
    position: absolute;
    height: 8px;
    overflow: visible;
  }

  .secao :global(.sublinhado path) {
    fill: none;
    stroke: var(--caneta);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .secao :global(.sublinhado.leve) {
    opacity: 0.5;
  }

  .secao :global(.sublinhado.leve path) {
    stroke-width: 1.4;
  }

  /*
   * Subseções: só as da seção atual, em corpo menor, com a atual em azul-tinta. Elas se desdobram
   * embaixo do nome (e se dobram na que fica para trás) em vez de surgir de uma vez: antes, a lista
   * inteira saltava ~47px a cada seção com subseções (revisão 4, D52). O fio acompanha os pontos quadro
   * a quadro (artigo.ts). Fechadas, ficam escondidas também do teclado e do leitor de tela.
   */
  .subsecoes {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.26s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.26s;
  }

  .subsecoes > ol {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.14s;
  }

  /* O fio e o respiro ficam nos itens: no <ol>, eles ocupariam lugar mesmo com a lista fechada. */
  .subsecoes li {
    padding-left: 10px;
    border-left: 1px solid var(--rule);
  }

  .subsecoes li:last-child {
    margin-bottom: 6px;
  }

  .secao:has(> a[aria-current="true"]) > .subsecoes {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 0.34s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .secao:has(> a[aria-current="true"]) > .subsecoes > ol {
    opacity: 1;
    transition: opacity 0.24s 0.08s;
  }

  /* Ao chegar (e voltando pela memória do navegador), a lista já vem aberta onde o leitor está. */
  .de-uma-vez .subsecoes,
  .de-uma-vez .subsecoes > ol {
    transition: none !important;
  }

  .subsecoes a {
    padding: 3px 0;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 400;
  }

  .subsecoes a:hover {
    color: var(--ink);
  }

  .subsecoes a[aria-current="true"] {
    color: var(--acento);
  }

  /* ---------- progresso ---------- */

  .progresso {
    flex: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .progresso[hidden] {
    display: none;
  }

  /* "Atalhos ?" (D50): discreto, embaixo do progresso; some no toque e sem JS. */
  .dica-atalhos {
    display: none;
    align-items: center;
    gap: 7px;
    margin: 12px 0 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: 12px;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:root[data-js]) .dica-atalhos {
      display: inline-flex;
    }
  }

  /* Com a ficha aberta, o botão fica na tinta, como quem está com ela na mão. */
  .dica-atalhos:hover,
  .dica-atalhos:focus-visible,
  :global(:root:has(#atalhos:popover-open)) .dica-atalhos {
    color: var(--acento);
  }

  .dica-atalhos svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dica-atalhos kbd {
    font-size: 10.5px;
    padding: 0 4px;
  }

  .numeros {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-3);
  }

  /*
   * Os minutos que faltam (D49, protótipo E4): o número roda como contador quando muda (0,4s,
   * contador.ts); no fim, "faltam 1 min" sobe e some e "chegou ao fim" sobe de baixo (0,3s), e o
   * contrário ao voltar. A porcentagem acompanha a rolagem a cada quadro, parada (rodar seria ruído).
   */
  .falta {
    display: inline-grid;
    justify-items: end;
    overflow: hidden;
  }

  .falta > span {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .falta :global([data-minutos-falta]) {
    --rola: 0.4s;
  }

  /* Antes do fim: "faltam" à vista (e, ao voltar, chegando de cima); "chegou" embaixo, escondido. */
  .falta > .faltam {
    transition:
      transform 0.3s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      opacity 0.3s 0.08s;
  }

  .falta > .chegou {
    opacity: 0;
    transform: translateY(110%);
    transition:
      transform 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      opacity 0.2s;
  }

  /* No fim: "faltam" sobe e some, e "chegou ao fim" sobe de baixo. */
  .falta:global(.no-fim) > .faltam {
    opacity: 0;
    transform: translateY(-110%);
    transition:
      transform 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      opacity 0.2s;
  }

  .falta:global(.no-fim) > .chegou {
    opacity: 1;
    transform: none;
    transition:
      transform 0.3s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      opacity 0.3s 0.08s;
  }

  @media (prefers-reduced-motion: reduce) {
    .falta > span,
    .falta:global(.no-fim) > span {
      transition: none !important;
    }
  }

  /*
   * ---------- o livro do artigo: a ficha do volume (D46; C05, D52; D57) ----------
   * Uma ficha pautada de fichário, escrita à caneta preta: no cabeçalho, "Do livro" à mão sobre a linha
   * vermelha; embaixo, a foto do livro deitado na mesa, com a fita e uma etiqueta por artigo (a deste,
   * amarela; FotoDoLivro), direto na ficha, sem painel; e os dados do volume datilografados (JetBrains
   * Mono) nas linhas azuis da pauta, com o nome e o link. Reta, como toda folha: só o post-it gira. A
   * pauta segue as linhas do texto (--linha).
   */
  .do-livro {
    --linha: 24px;
    flex: none;
    overflow: hidden;
    border-radius: 3px;
  }

  .cabeca-ficha {
    margin: 0;
    padding: 9px 14px 3px;
    border-bottom: 1.5px solid var(--pauta-cabeca);
    color: var(--ink);
    font-family: var(--font-mao);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.05;
  }

  /* A foto, centrada; a sombra da mesa e as pontas das etiquetas já têm a folga delas na imagem. */
  .foto {
    display: grid;
    justify-items: center;
    margin: 6px 8px -6px;
  }

  /* Tela baixa: o livro encolhe para o sumário continuar à vista; bem baixa, fica só o sumário. */
  @media (max-height: 820px) {
    .foto {
      zoom: 0.8;
    }
  }

  @media (max-height: 760px) {
    .foto {
      zoom: 0.7;
    }
  }

  @media (max-height: 660px) {
    .do-livro {
      display: none;
    }
  }

  /*
   * Os dados na pauta: cada linha do texto numa linha da ficha, com o fio azul logo abaixo das letras
   * (a mesma altura de linha nos três, para o nome que quebra em duas continuar na pauta).
   */
  .sobre {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
    padding: 0 14px 6px;
    background: repeating-linear-gradient(to bottom, transparent 0 calc(var(--linha) - 1px), var(--pauta) calc(var(--linha) - 1px) var(--linha));
    background-position: 0 -4px;
    color: var(--ink);
    font-family: var(--font-ui);
    line-height: var(--linha);
    text-decoration: none;
  }

  .dados {
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }

  .nome-livro {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
  }

  .ver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13.5px;
    color: var(--acento);
  }

  .ver svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.2s;
