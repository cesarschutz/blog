---
/**
 * Sumário do artigo (briefing §5.3), só com 3 seções ou mais.
 *
 * "lateral" (D26, D33): em telas ≥ 1300px, à esquerda do texto, numa folha própria e fixa. As seções
 * ficam num trilho, com um ponto em cada uma e sem número (D36): o "3. " de um título numerado sai
 * também do nome, nas duas variantes. O script (src/scripts/artigo.ts) pinta o trilho até a
 * seção atual, marca as já lidas e a atual (em azul-tinta), abre as subseções da atual e mantém a
 * atual à vista quando a lista rola. Embaixo, a barra de quanto já foi lido, com "NN% lido" e o tempo
 * que falta; só com JS. O post-it das frases saiu daqui para o fim do artigo (D38).
 *
 * "recolhivel": no início do texto, nas telas menores.
 */
import type { SecaoDoSumario } from "../lib/posts";

interface Props {
  secoes: SecaoDoSumario[];
  variante: "lateral" | "recolhivel";
  /** Tempo de leitura do artigo, para o "faltam N min". */
  minutos?: number;
}

const { secoes, variante, minutos = 0 } = Astro.props;
// "3. Bloqueio pessimista" → "Bloqueio pessimista": o sumário não mostra número (D36).
const semNumero = (texto: string) => texto.replace(/^\d{1,2}[.)]\s+/, "");
---

{
  variante === "lateral" ? (
    <aside class="lateral" data-pagefind-ignore>
      <div class="folha folha-sumario">
        <nav aria-label="Neste artigo" data-trilho>
          <p class="titulo">Neste artigo</p>
          <ol class="trilho">
            {secoes.map((s) => {
              return (
                <li class="secao">
                  <a href={`#${s.slug}`} data-secao={s.slug}>
                    <span class="marco" aria-hidden="true" />
                    <span class="nome">{semNumero(s.text)}</span>
                  </a>
                  {s.sub.length > 0 && (
                    <ol class="subsecoes">
                      {s.sub.map((sub) => (
                        <li>
                          <a href={`#${sub.slug}`} data-subsecao={sub.slug}>
                            {sub.text}
                          </a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              );
            })}
          </ol>
        </nav>
        <div class="progresso" aria-hidden="true" hidden data-progresso-sumario data-minutos={minutos}>
          <span class="barra"><span class="feito"></span></span>
          <p class="numeros">
            <span class="lido">0% lido</span>
            <span class="falta">faltam {minutos} min</span>
          </p>
        </div>
      </div>
    </aside>
  ) : (
    <details class="recolhivel" data-pagefind-ignore>
      <summary>Neste artigo</summary>
      <nav aria-label="Neste artigo">
        <ol>
          {secoes.map((s) => (
            <li>
              <a href={`#${s.slug}`}>{semNumero(s.text)}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .lateral {
    display: none;
  }

  .titulo {
    margin: 0 0 12px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- trilho das seções ---------- */

  .trilho,
  .subsecoes {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  .secao {
    --marco: 22px;
    position: relative;
    padding-left: calc(var(--marco) + 11px);
  }

  /* O fio do trilho, de um marco ao outro; já lido, em azul-tinta. */
  .secao::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--marco) / 2 - 0.75px);
    width: 1.5px;
    background: var(--rule);
  }

  .secao:first-child::before {
    top: 14px;
  }

  .secao:last-child::before {
    bottom: calc(100% - 14px);
  }

  .secao.lida::before {
    background: color-mix(in oklab, var(--acento) 55%, var(--rule));
  }

  .secao a {
    display: block;
    padding: 5px 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.38;
    text-decoration: none;
  }

  .secao > a:hover .nome {
    color: var(--ink);
  }

  /* Um ponto no trilho em cada seção, sem número (D36). */
  .marco {
    position: absolute;
    z-index: 1;
    top: 10px;
    left: calc(var(--marco) / 2 - 4.5px);
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-hi);
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .secao.lida .marco {
    border-color: color-mix(in oklab, var(--acento) 55%, var(--rule));
    background: color-mix(in oklab, var(--acento) 12%, var(--paper-hi));
  }

  .secao > a[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
  }

  .secao > a[aria-current="true"] .marco {
    border-color: var(--acento);
    background: var(--acento);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--acento) 16%, transparent);
  }

  /* Subseções: só as da seção atual, em corpo menor, com a atual em azul-tinta. */
  .subsecoes {
    display: none;
    margin: 0 0 6px;
    padding-left: 10px;
    border-left: 1px solid var(--rule);
  }

  .secao:has(> a[aria-current="true"]) > .subsecoes {
    display: block;
  }

  .subsecoes a {
    padding: 3px 0;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 400;
  }

  .subsecoes a:hover {
    color: var(--ink);
  }

  .subsecoes a[aria-current="true"] {
    color: var(--acento);
  }

  /* ---------- progresso ---------- */

  .progresso {
    flex: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .progresso[hidden] {
    display: none;
  }

  .barra {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }

  .feito {
    display: block;
    height: 100%;
    background: var(--acento);
    transform: scaleX(0);
    transform-origin: left;
  }

  .numeros {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 8px 0 0;
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-3);
  }

  /* ---------- recolhível ---------- */

  .recolhivel ol {
    margin: 0;
    padding: 0 16px 12px 36px;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.5;
  }

  .recolhivel a {
    color: var(--ink);
  }

  .recolhivel a:hover {
    color: var(--acento);
  }

  @media (min-width: 1300px) {
    /*
     * Na coluna da esquerda da grade do artigo (artigo.css), fixa enquanto o texto rola. Só a lista
     * rola, se for longa; a barra fica sempre à vista, e o post-it vem embaixo quando a tela é alta.
     */
    .lateral {
      display: flex;
      flex-direction: column;
      gap: 26px;
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--altura-topo) + 20px);
      max-height: calc(100vh - var(--altura-topo) - 40px);
    }

    .folha-sumario {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 20px 18px 16px;
    }

    .folha-sumario nav {
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
      margin-right: -8px;
      padding-right: 8px;
    }

    .recolhivel {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco {
      transition: none;
    }
  }
</style>
