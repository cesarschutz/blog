---
/**
 * Sumário do artigo (briefing §5.3), só com 3 seções ou mais.
 *
 * "lateral" (D26, D33, D49): em telas ≥ 1300px, à esquerda do texto, numa folha própria e fixa. As
 * seções ficam num trilho, com um ponto em cada uma e sem número (D36): o "3. " de um título
 * numerado sai também do nome, nas três variantes. O sumário acompanha a leitura como o índice de um
 * caderno (C2, D49): o fio é escrito à caneta, na cor do livro, conforme a leitura anda dentro da
 * seção; a seção atual ganha o marca-texto na cor do livro; a que ficou para trás ganha um visto. O
 * script (src/scripts/artigo.ts) desenha o fio, abre as subseções da atual e mantém a atual à vista
 * quando a lista rola. Embaixo, a barra de quanto já foi lido, com "NN% lido" e o tempo que falta; só
 * com JS. Embaixo, o livro do artigo, grande e de lado, como o da gaveta da home (D46): gira um pouco
 * ao passar o mouse, a lupa abre o livro ampliado e o link leva à página dele. Sem seções (menos de
 * 3), a coluna tem só o livro.
 *
 * "recolhivel": no início do texto, nas telas menores.
 *
 * "folha" (C2, D49): nas telas sem a lateral, o nome da seção atual toma o lugar da marca no
 * cabeçalho (Cabecalho.astro) e, tocado, abre esta folha, que desce do cabeçalho como o menu (D46),
 * com os mesmos vistos.
 */
import LivroAmpliado from "./LivroAmpliado.astro";
import LivroEmPe from "./LivroEmPe.astro";
import { ICONES } from "../lib/icones";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import type { SecaoDoSumario } from "../lib/posts";
import "../styles/livro.css";
import { tituloComQuebras } from "../lib/formato";

interface Props {
  secoes: SecaoDoSumario[];
  variante: "lateral" | "recolhivel" | "folha";
  /** Tempo de leitura do artigo, para o "faltam N min". */
  minutos?: number;
  /** O livro do artigo, grande, embaixo do sumário lateral (D46); na folha, dá a cor dela. */
  livro?: Livro;
  /** A cor do artigo (a da categoria ou da série), para a folha, que fica fora do artigo. */
  cor?: string;
}

const { secoes, variante, minutos = 0, livro, cor } = Astro.props;
// "3. Bloqueio pessimista" → "Bloqueio pessimista": o sumário não mostra número (D36).
const semNumero = (texto: string) => texto.replace(/^\d{1,2}[.)]\s+/, "");
---

{
  variante === "lateral" ? (
    <aside class="lateral" data-pagefind-ignore style={livro ? coresDoLivroCss(livro) : undefined}>
      {secoes.length > 0 && (
      <div class="folha folha-sumario">
        <nav aria-label="Neste artigo" data-trilho>
          <p class="titulo">Neste artigo</p>
          <div class="lista-trilho" data-lista-trilho>
          <svg class="fio" aria-hidden="true" focusable="false"><path class="fio-base" /><path class="fio-tinta" /></svg>
          <ol class="trilho">
            {secoes.map((s) => {
              return (
                <li class="secao">
                  <a href={`#${s.slug}`} data-secao={s.slug}>
                    <svg class="marco" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle class="bolinha" cx="7" cy="7" r="3.4" /><path class="visto" pathLength="1" d="M2.6 7.6 5.7 10.5 11.6 3.3" /></svg>
                    <span class="nome"><span class="rotulo" set:html={tituloComQuebras(semNumero(s.text))} /></span>
                  </a>
                  {s.sub.length > 0 && (
                    <ol class="subsecoes">
                      {s.sub.map((sub) => (
                        <li>
                          <a href={`#${sub.slug}`} data-subsecao={sub.slug} set:html={tituloComQuebras(sub.text)} />
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              );
            })}
          </ol>
          </div>
        </nav>
        <div class="progresso" aria-hidden="true" hidden data-progresso-sumario data-minutos={minutos}>
          <span class="barra"><span class="feito"></span></span>
          <p class="numeros">
            <span class="lido">0% lido</span>
            <span class="falta" data-falta>
              <span class="faltam">faltam <span data-minutos-falta>{minutos}</span> min</span>
              <span class="chegou">chegou ao fim</span>
            </span>
          </p>
        </div>
        {/* Os atalhos do teclado (D50, Atalhos.astro): só com mouse e teclado, e com JS. */}
        <button type="button" class="dica-atalhos" popovertarget="atalhos">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.teclado} />
          Atalhos
          <kbd aria-hidden="true">?</kbd>
        </button>
      </div>
      )}
      {
        livro && (
          <div class="folha do-livro">
            <div class="palco-livro painel" style={`--cor:${livro.cores.cor}`} data-livro-gira>
              <LivroEmPe livro={livro} altura={204} ampliavel />
            </div>
            <a class="sobre" href={livro.href}>
              <span class="rotulo">{livro.serie ? "Da série" : "Do livro"}</span>
              <span class="nome-livro">{livro.nome}</span>
              <span class="ver">
                {livro.serie ? "Ver a série" : "Ver o livro"}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
              </span>
            </a>
          </div>
        )
      }
    </aside>
  ) : variante === "folha" ? (
    <div class="veu-sumario" data-veu-sumario aria-hidden="true" />
    <div
      class="folha folha-celular"
      id="folha-sumario"
      role="dialog"
      aria-label="Neste artigo"
      style={`${cor ? `--cor:${cor};` : ""}${livro ? coresDoLivroCss(livro) : ""}`}
      data-folha-sumario
      data-pagefind-ignore
    >
      <p class="titulo">Neste artigo</p>
      <ol class="trilho">
        {secoes.map((s, i) => (
          <li class="secao" style={`--i:${i}`}>
            <a href={`#${s.slug}`} data-secao-folha={s.slug}>
              <svg class="marco" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle class="bolinha" cx="7" cy="7" r="3.4" /><path class="visto" pathLength="1" d="M2.6 7.6 5.7 10.5 11.6 3.3" /></svg>
              <span class="nome"><span class="rotulo" set:html={tituloComQuebras(semNumero(s.text))} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <details class="recolhivel" data-pagefind-ignore>
      <summary>Neste artigo</summary>
      <nav aria-label="Neste artigo">
        <ol>
          {secoes.map((s) => (
            <li>
              <a href={`#${s.slug}`} set:html={tituloComQuebras(semNumero(s.text))} />
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
{variante === "lateral" && livro && <LivroAmpliado />}

<style>
  /*
   * A cor do livro do post (D39) no trilho, no ponto atual e na barra de porcentagem: o destaque do
   * livro (a cor escurecida até ter contraste sobre o papel) e, no escuro, com o branco dos desenhos
   * (--branco-no-escuro). Passa de 3:1 sobre a folha nos dois temas (npm run contraste).
   */
  .lateral,
  .folha-celular {
    --cor-ui: color-mix(in oklab, var(--livro-destaque, var(--cor, var(--acento))), #fff var(--branco-no-escuro, 0%));
    --marca-sumario: color-mix(in oklab, color-mix(in oklab, var(--cor, var(--acento)), #fff var(--sumario-marca-branco)) var(--sumario-marca-forca), transparent);
  }

  .lateral {
    display: none;
  }

  .titulo {
    margin: 0 0 12px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- trilho das seções ---------- */

  .trilho,
  .subsecoes {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  /*
   * O fio do trilho (C2, D49): um traço à mão que passa pelos pontos, com a tinta na cor do livro
   * escrita até onde a leitura chegou dentro da seção (artigo.ts desenha o caminho e move a tinta; a
   * transição do stroke-dashoffset faz a caneta seguir a rolagem com um leve atraso).
   */
  .lista-trilho {
    --marco: 22px;
    position: relative;
  }

  .fio {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--marco);
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .fio path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fio-base {
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .fio-tinta {
    stroke: var(--cor-ui);
    stroke-width: 2;
    transition: stroke-dashoffset 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .secao {
    position: relative;
    padding-left: calc(var(--marco) + 11px);
  }

  /* Nomes longos quebram nos pontos (tituloComQuebras) e, em último caso, onde der: nunca rolam. */
  .secao a {
    display: block;
    overflow-wrap: break-word;
    padding: 5px 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.38;
    text-decoration: none;
  }

  .secao > a:hover .nome {
    color: var(--ink);
  }

  /*
   * O ponto de cada seção, sem número (D36). Na seção atual, cheio na cor do livro; na que ficou para
   * trás, uma clareira no fio com o visto escrito dentro (C2, D49): fica, mesmo voltando a rolagem,
   * como as marcações do caderno.
   */
  .marco {
    position: absolute;
    z-index: 1;
    top: 8px;
    left: calc(var(--marco) / 2 - 7px);
    width: 14px;
    height: 14px;
    overflow: visible;
  }

  .bolinha {
    r: 3.4px;
    fill: var(--paper-hi);
    stroke: var(--ink-3);
    stroke-width: 1.2;
    transition:
      r 0.2s,
      fill 0.2s,
      stroke 0.2s;
  }

  .visto {
    fill: none;
    stroke: var(--cor-ui);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 0.42s ease-in-out 0.15s,
      opacity 0.2s;
  }

  .secao > a[aria-current="true"] .bolinha {
    fill: var(--cor-ui);
    stroke: var(--cor-ui);
  }

  .secao.lida > a:not([aria-current]) .bolinha {
    r: 6.4px;
    fill: var(--paper-hi);
    stroke: transparent;
  }

  .secao.lida .visto {
    stroke-dashoffset: 0;
  }

  .secao > a[aria-current="true"] .visto {
    opacity: 0;
  }

  .secao > a[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
  }

  /*
   * A seção atual ganha o marca-texto na cor do livro (C2, D49; os tons de SUMARIO_MARCA em tokens.ts,
   * conferidos pelo npm run contraste): a pintura estica da esquerda para a direita e, ao sair, recolhe.
   */
  .rotulo {
    padding: 0 2px;
    background-image: linear-gradient(transparent 16%, var(--marca-sumario) 16%, var(--marca-sumario) 92%, transparent 92%);
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 0% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.2s ease-in;
  }

  [aria-current="true"] > .nome > .rotulo {
    background-size: 100% 100%;
    transition: background-size 0.55s cubic-bezier(0.45, 0, 0.55, 1);
  }

  /* Subseções: só as da seção atual, em corpo menor, com a atual em azul-tinta. */
  .subsecoes {
    display: none;
    margin: 0 0 6px;
    padding-left: 10px;
    border-left: 1px solid var(--rule);
  }

  .secao:has(> a[aria-current="true"]) > .subsecoes {
    display: block;
  }

  .subsecoes a {
    padding: 3px 0;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 400;
  }

  .subsecoes a:hover {
    color: var(--ink);
  }

  .subsecoes a[aria-current="true"] {
    color: var(--acento);
  }

  /* ---------- progresso ---------- */

  .progresso {
    flex: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .progresso[hidden] {
    display: none;
  }

  .barra {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }

  .feito {
    display: block;
    height: 100%;
    background: var(--cor-ui);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* "Atalhos ?" (D50): discreto, embaixo do progresso; some no toque e sem JS. */
  .dica-atalhos {
    display: none;
    align-items: center;
    gap: 7px;
    margin: 12px 0 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: 12px;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:root[data-js]) .dica-atalhos {
      display: inline-flex;
    }
  }

  .dica-atalhos:hover,
  .dica-atalhos:focus-visible {
    color: var(--acento);
  }

  .dica-atalhos svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dica-atalhos kbd {
    font-size: 10.5px;
    padding: 0 4px;
  }

  .numeros {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 8px 0 0;
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-3);
  }

  /*
   * Os minutos que faltam (D49, protótipo E4): o número roda como contador quando muda (0,4s,
   * contador.ts); no fim, "faltam 1 min" sobe e some e "chegou ao fim" sobe de baixo (0,3s), e o
   * contrário ao voltar. A porcentagem acompanha a rolagem a cada quadro, parada (rodar seria ruído).
   */
  .falta {
    display: inline-grid;
    justify-items: end;
    overflow: hidden;
  }

  .falta > span {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .falta :global([data-minutos-falta]) {
    --rola: 0.4s;
  }

  /* Antes do fim: "faltam" à vista (e, ao voltar, chegando de cima); "chegou" embaixo, escondido. */
  .falta > .faltam {
    transition:
      transform 0.3s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      opacity 0.3s 0.08s;
  }

  .falta > .chegou {
    opacity: 0;
    transform: translateY(110%);
    transition:
      transform 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      opacity 0.2s;
  }

  /* No fim: "faltam" sobe e some, e "chegou ao fim" sobe de baixo. */
  .falta:global(.no-fim) > .faltam {
    opacity: 0;
    transform: translateY(-110%);
    transition:
      transform 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53),
      opacity 0.2s;
  }

  .falta:global(.no-fim) > .chegou {
    opacity: 1;
    transform: none;
    transition:
      transform 0.3s cubic-bezier(0.215, 0.61, 0.355, 1) 0.08s,
      opacity 0.3s 0.08s;
  }

  @media (prefers-reduced-motion: reduce) {
    .falta > span,
    .falta:global(.no-fim) > span {
      transition: none !important;
    }
  }

  /*
   * ---------- o livro do artigo (D46) ----------
   * Grande e de lado (38°, como na gaveta da home), num painel tingido pela cor dele; embaixo, o nome e
   * o link. A lupa (LivroEmPe) abre o livro ampliado.
   */
  .do-livro {
    flex: none;
    overflow: hidden;
    padding: 10px;
  }

  .palco-livro {
    display: grid;
    place-items: center;
    padding: 22px 10px 26px;
  }

  /* Tela baixa: o livro encolhe para o sumário continuar à vista; bem baixa, fica só o sumário. */
  @media (max-height: 820px) {
    .palco-livro {
      zoom: 0.8;
    }
  }

  @media (max-height: 660px) {
    .do-livro {
      display: none;
    }
  }

  .sobre {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 6px 4px;
    color: var(--ink);
    font-family: var(--font-ui);
    text-decoration: none;
  }

  .rotulo {
    font-size: 12.5px;
    color: var(--ink-2);
  }

  .nome-livro {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
  }

  .ver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--acento);
  }

  .ver svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.2s;
  }

  .sobre:hover .nome-livro {
    color: var(--acento);
  }

  .sobre:hover .ver {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .sobre:hover .ver svg {
    translate: 3px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ver svg {
      transition: none;
    }
  }

  /* ---------- recolhível ---------- */

  .recolhivel ol {
    margin: 0;
    padding: 0 16px 12px 36px;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.5;
  }

  .recolhivel a {
    color: var(--ink);
  }

  .recolhivel a:hover {
    color: var(--acento);
  }

  @media (min-width: 1300px) {
    /*
     * Na coluna da esquerda da grade do artigo (artigo.css), fixa enquanto o texto rola. Só a lista
     * rola, se for longa; a barra fica sempre à vista, e o "Do livro" vem embaixo.
     */
    .lateral {
      display: flex;
      flex-direction: column;
      gap: 26px;
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--altura-topo) + 20px);
      max-height: calc(100vh - var(--altura-topo) - 40px);
    }

    .folha-sumario {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 20px 18px 16px;
    }

    .folha-sumario nav {
      min-height: 0;
      overflow: hidden auto;
      margin-right: -8px;
      padding-right: 8px;
    }

    .recolhivel {
      display: none;
    }
  }

  /*
   * ---------- a folha do sumário (C2, D49) ----------
   * Nas telas sem a lateral: desce do cabeçalho como o menu do celular (D46), recortada de cima para
   * baixo, com os itens chegando em sequência; um véu escurece a página por baixo (Cabecalho.astro).
   */
  .folha-celular {
    position: fixed;
    z-index: 29;
    top: calc(env(safe-area-inset-top, 0px) + var(--altura-cabecalho) + 8px);
    right: clamp(12px, 3vw, 24px);
    left: clamp(12px, 3vw, 24px);
    max-width: 520px;
    max-height: calc(100dvh - var(--altura-cabecalho) - 32px);
    padding: 18px 18px 14px;
    overflow: auto;
    scrollbar-width: thin;
    clip-path: inset(0 0 100% 0 round 14px);
    visibility: hidden;
    transition:
      clip-path 0.34s cubic-bezier(0.6, 0, 0.8, 0.4),
      visibility 0s linear 0.34s;
  }

  .veu-sumario {
    position: fixed;
    inset: 0;
    z-index: 28;
    background: rgb(20 22 24 / 0.32);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0s linear 0.3s;
  }

  :global(:root[data-sumario-aberto]) .veu-sumario {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s;
  }

  :global(:root[data-sumario-aberto]) .folha-celular {
    clip-path: inset(0 0 0 0 round 14px);
    visibility: visible;
    transition: clip-path 0.46s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .folha-celular .trilho > li {
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.2s,
      translate 0.2s;
  }

  :global(:root[data-sumario-aberto]) .folha-celular .trilho > li {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.3s calc(0.12s + var(--i, 0) * 0.05s),
      translate 0.3s cubic-bezier(0.2, 0.75, 0.2, 1) calc(0.12s + var(--i, 0) * 0.05s);
  }

  .folha-celular .secao {
    --marco: 22px;
  }

  .folha-celular .secao a {
    padding: 7px 0;
    font-size: 15.5px;
  }

  .folha-celular .marco {
    top: 11px;
  }

  @media (min-width: 1300px) {
    .folha-celular,
    .veu-sumario {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bolinha,
    .visto,
    .rotulo,
    [aria-current="true"] > .nome > .rotulo,
    .fio-tinta,
    .folha-celular,
    .veu-sumario,
    :global(:root[data-sumario-aberto]) .folha-celular,
    :global(:root[data-sumario-aberto]) .veu-sumario,
    .folha-celular .trilho > li,
