---
/**
 * Sumário do artigo (briefing §5.3), só com 3 seções ou mais.
 *
 * "lateral" (D26, D33): em telas ≥ 1300px, à esquerda do texto, numa folha própria e fixa. As seções
 * ficam num trilho, com um ponto em cada uma e sem número (D36): o "3. " de um título numerado sai
 * também do nome, nas duas variantes. O script (src/scripts/artigo.ts) pinta o trilho até a
 * seção atual, marca as já lidas e a atual (em azul-tinta), abre as subseções da atual e mantém a
 * atual à vista quando a lista rola. Embaixo, a barra de quanto já foi lido, com "NN% lido" e o tempo
 * que falta; só com JS. Embaixo, o "Do livro" compacto (D39).
 *
 * "recolhivel": no início do texto, nas telas menores.
 */
import Capa from "./Capa.astro";
import { ICONES } from "../lib/icones";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import type { SecaoDoSumario } from "../lib/posts";
import "../styles/livro.css";
import { tituloComQuebras } from "../lib/formato";

interface Props {
  secoes: SecaoDoSumario[];
  variante: "lateral" | "recolhivel";
  /** Tempo de leitura do artigo, para o "faltam N min". */
  minutos?: number;
  /** O livro do artigo: o "Do livro" compacto embaixo do sumário lateral (D39). */
  livro?: Livro;
}

const { secoes, variante, minutos = 0, livro } = Astro.props;
// "3. Bloqueio pessimista" → "Bloqueio pessimista": o sumário não mostra número (D36).
const semNumero = (texto: string) => texto.replace(/^\d{1,2}[.)]\s+/, "");
---

{
  variante === "lateral" ? (
    <aside class="lateral" data-pagefind-ignore style={livro ? coresDoLivroCss(livro) : undefined}>
      <div class="folha folha-sumario">
        <nav aria-label="Neste artigo" data-trilho>
          <p class="titulo">Neste artigo</p>
          <ol class="trilho">
            {secoes.map((s) => {
              return (
                <li class="secao">
                  <a href={`#${s.slug}`} data-secao={s.slug}>
                    <span class="marco" aria-hidden="true" />
                    <span class="nome" set:html={tituloComQuebras(semNumero(s.text))} />
                  </a>
                  {s.sub.length > 0 && (
                    <ol class="subsecoes">
                      {s.sub.map((sub) => (
                        <li>
                          <a href={`#${sub.slug}`} data-subsecao={sub.slug} set:html={tituloComQuebras(sub.text)} />
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              );
            })}
          </ol>
        </nav>
        <div class="progresso" aria-hidden="true" hidden data-progresso-sumario data-minutos={minutos}>
          <span class="barra"><span class="feito"></span></span>
          <p class="numeros">
            <span class="lido">0% lido</span>
            <span class="falta">faltam {minutos} min</span>
          </p>
        </div>
      </div>
      {
        livro && (
          <a class="folha do-livro" href={livro.href}>
            <span class="capa-mini" style={coresDoLivroCss(livro)}>
              <Capa livro={livro} desenho="adiado" />
            </span>
            <span class="sobre">
              <span class="rotulo">{livro.serie ? "Da série" : "Do livro"}</span>
              <span class="nome-livro">{livro.nome}</span>
              <span class="ver">
                {livro.serie ? "Ver a série" : "Ver o livro"}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} />
              </span>
            </span>
          </a>
        )
      }
    </aside>
  ) : (
    <details class="recolhivel" data-pagefind-ignore>
      <summary>Neste artigo</summary>
      <nav aria-label="Neste artigo">
        <ol>
          {secoes.map((s) => (
            <li>
              <a href={`#${s.slug}`} set:html={tituloComQuebras(semNumero(s.text))} />
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  /*
   * A cor do livro do post (D39) no trilho, no ponto atual e na barra de porcentagem: o destaque do
   * livro (a cor escurecida até ter contraste sobre o papel) e, no escuro, com o branco dos desenhos
   * (--branco-no-escuro). Passa de 3:1 sobre a folha nos dois temas (npm run contraste).
   */
  .lateral {
    --cor-ui: color-mix(in oklab, var(--livro-destaque, var(--acento)), #fff var(--branco-no-escuro, 0%));
    --cor-trilho: color-mix(in oklab, var(--cor-ui) 60%, var(--rule));
    display: none;
  }

  .titulo {
    margin: 0 0 12px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- trilho das seções ---------- */

  .trilho,
  .subsecoes {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
  }

  .secao {
    --marco: 22px;
    position: relative;
    padding-left: calc(var(--marco) + 11px);
  }

  /* O fio do trilho, de um marco ao outro; já lido, em azul-tinta. */
  .secao::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--marco) / 2 - 0.75px);
    width: 1.5px;
    background: var(--rule);
  }

  .secao:first-child::before {
    top: 14px;
  }

  .secao:last-child::before {
    bottom: calc(100% - 14px);
  }

  .secao.lida::before {
    background: var(--cor-trilho);
  }

  /* Nomes longos quebram nos pontos (tituloComQuebras) e, em último caso, onde der: nunca rolam. */
  .secao a {
    display: block;
    overflow-wrap: break-word;
    padding: 5px 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.38;
    text-decoration: none;
  }

  .secao > a:hover .nome {
    color: var(--ink);
  }

  /* Um ponto no trilho em cada seção, sem número (D36). */
  .marco {
    position: absolute;
    z-index: 1;
    top: 10px;
    left: calc(var(--marco) / 2 - 4.5px);
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-hi);
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .secao.lida .marco {
    border-color: var(--cor-trilho);
    background: color-mix(in oklab, var(--cor-ui) 12%, var(--paper-hi));
  }

  .secao > a[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
  }

  .secao > a[aria-current="true"] .marco {
    border-color: var(--cor-ui);
    background: var(--cor-ui);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--cor-ui) 16%, transparent);
  }

  /* Subseções: só as da seção atual, em corpo menor, com a atual em azul-tinta. */
  .subsecoes {
    display: none;
    margin: 0 0 6px;
    padding-left: 10px;
    border-left: 1px solid var(--rule);
  }

  .secao:has(> a[aria-current="true"]) > .subsecoes {
    display: block;
  }

  .subsecoes a {
    padding: 3px 0;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 400;
  }

  .subsecoes a:hover {
    color: var(--ink);
  }

  .subsecoes a[aria-current="true"] {
    color: var(--acento);
  }

  /* ---------- progresso ---------- */

  .progresso {
    flex: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .progresso[hidden] {
    display: none;
  }

  .barra {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }

  .feito {
    display: block;
    height: 100%;
    background: var(--cor-ui);
    transform: scaleX(0);
    transform-origin: left;
  }

  .numeros {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 8px 0 0;
    font-family: var(--font-codigo);
    font-size: 12px;
    color: var(--ink-3);
  }

  /* ---------- "Do livro" compacto (D39) ---------- */

  .do-livro {
    display: flex;
    flex: none;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    color: var(--ink);
    text-decoration: none;
    transition: box-shadow 0.2s;
  }

  .capa-mini {
    flex: none;
    width: 46px;
  }

  .sobre {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-family: var(--font-ui);
  }

  .rotulo {
    font-size: 12.5px;
    color: var(--ink-2);
  }

  .nome-livro {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
  }

  .ver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--acento);
  }

  .ver svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .do-livro:hover {
      box-shadow: var(--sombra-folha-alta);
    }

    .do-livro:hover .ver {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
  }

  /* ---------- recolhível ---------- */

  .recolhivel ol {
    margin: 0;
    padding: 0 16px 12px 36px;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.5;
  }

  .recolhivel a {
    color: var(--ink);
  }

  .recolhivel a:hover {
    color: var(--acento);
  }

  @media (min-width: 1300px) {
    /*
     * Na coluna da esquerda da grade do artigo (artigo.css), fixa enquanto o texto rola. Só a lista
     * rola, se for longa; a barra fica sempre à vista, e o "Do livro" vem embaixo.
     */
    .lateral {
      display: flex;
      flex-direction: column;
      gap: 26px;
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--altura-topo) + 20px);
      max-height: calc(100vh - var(--altura-topo) - 40px);
    }

    .folha-sumario {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 20px 18px 16px;
    }

    .folha-sumario nav {
      min-height: 0;
      overflow: hidden auto;
      margin-right: -8px;
      padding-right: 8px;
    }

    .recolhivel {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco {
      transition: none;
    }
  }
</style>
