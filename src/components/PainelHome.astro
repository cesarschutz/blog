---
/**
 * Painel ao lado da página de um livro (D28, D46): a pilha dos livros do mesmo tipo (na página de uma
 * categoria, só as categorias; na de uma série, só as séries) e o RSS. Os livros são a lombada da
 * estante (MioloLombada) deitada, mais fina que a lombada em pé (D46), e o volume 1 fica embaixo.
 *
 * O livro aberto no topo da página não está na pilha (D46): ele fica no HTML, escondido, e o script
 * da ordem, logo depois da lista, monta a pilha da visita: a ordem guardada na sessão
 * (`cs-pilha-<tipo>`), com o livro da página anterior (o que estava aberto) em cima. Assim, ao trocar
 * de livro, o que estava aberto volta para o topo da pilha.
 *
 * Trocar de livro pela pilha (D46, D49, D52): primeiro o livro aberto no topo da página é guardado em
 * cima da pilha (a pilha guarda, em cima, o espaço dele: --folga), depois o escolhido é puxado para
 * fora, com o peso dos de cima (o bloco tomba e cai no lugar), voa até o topo da página, se põe em pé
 * e gira até ficar de lado (o livro da página nova, tirado do HTML dela). A página nova abre quando ele
 * começa a girar e continua o giro (o script da ordem, abaixo, lê `cs-pilha-chegada`). Com movimento
 * reduzido, a página só abre.
 * Uma série só: a pilha fica vazia, com um texto curto.
 */
import { ICONES } from "../lib/icones";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import MioloLombada from "./MioloLombada.astro";
import { url } from "../lib/url";
import "../styles/livro.css";

interface Props {
  livros: Livro[];
  tipo: "categorias" | "series";
  /** Id do livro que está aberto na página. */
  atual?: string;
}

const { livros, tipo, atual } = Astro.props;
const titulo = tipo === "series" ? "Séries" : "Categorias";
// De cima para baixo: o último volume em cima e o volume 1 embaixo.
const pilha = livros
  .filter((l) => (tipo === "series" ? l.serie : !l.serie))
  .sort((a, b) => (b.volume ?? 0) - (a.volume ?? 0));
const outros = pilha.filter((l) => l.id !== atual).length;
// O espaço em cima da pilha para o livro aberto voltar para ela (D49): a espessura dele, deitado.
const aberto = pilha.find((l) => l.id === atual);
// O deslocamento de cada livro na pilha (livros.json), em unidades da lombada em pé.
const estilo = (l: Livro) =>
  [coresDoLivroCss(l), `--w:${l.emPe.largura}`, `--h:${l.emPe.altura}`, `--recuo:${10 + l.deitada.deslocamento}`].join(";");
const rotulo = (l: Livro) => {
  const n = l.posts.length;
  if (l.serie) return `${l.nome}, ${n} ${n === 1 ? "parte" : "partes"}`;
  return n === 0 ? `${l.nome}, ainda sem artigos` : `${l.nome}, ${n} ${n === 1 ? "artigo" : "artigos"}`;
};
---

<aside class="painel-home folha" aria-label={titulo}>
  <section class="bloco">
    <h2 class="titulo-bloco">{titulo}</h2>
    <div class="pilha" data-pilha={tipo}>
      <ol style={aberto && outros > 0 ? `--folga:${aberto.emPe.largura}` : undefined}>
        {
          pilha.map((l) => (
            <li data-id={l.id} hidden={l.id === atual}>
              <a class="deitado" href={l.href} aria-label={rotulo(l)} data-vt={l.id} style={estilo(l)}>
                <span class:list={["lombada-visual", { "de-serie": l.serie }]}>
                  <MioloLombada livro={l} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      {/* A ordem da visita, antes da primeira pintura (ver o comentário do topo). */}
      <script is:inline>
        (function () {
          var pilha = document.currentScript.parentElement;
          var ol = pilha.querySelector("ol");
          var chave = "cs-pilha-" + pilha.dataset.pilha;
          var itens = {};
          var padrao = [];
          [].forEach.call(ol.children, function (li) {
            itens[li.dataset.id] = li;
            padrao.push(li.dataset.id);
          });
          var ordem = padrao;
          try {
            var guardada = JSON.parse(sessionStorage.getItem(chave) || "null");
            if (Array.isArray(guardada)) {
              ordem = guardada.filter(function (id) { return itens[id]; });
              padrao.forEach(function (id) { if (ordem.indexOf(id) < 0) ordem.push(id); });
            }
          } catch (e) {}
          // O livro da página anterior (o que estava aberto) vai para o topo da pilha.
          try {
            var de = document.referrer && new URL(document.referrer);
            if (de && de.origin === location.origin && de.pathname !== location.pathname) {
              for (var id in itens) {
                var link = itens[id].querySelector("a");
                if (new URL(link.href).pathname === de.pathname) {
                  ordem.splice(ordem.indexOf(id), 1);
                  ordem.unshift(id);
                }
              }
            }
          } catch (e) {}
          ordem.forEach(function (id) { ol.appendChild(itens[id]); });
          try { sessionStorage.setItem(chave, JSON.stringify(ordem)); } catch (e) {}

          // Chegando pela troca da pilha (D52): a página anterior deixou o livro do topo girando e a
          // página já montada em cima (o texto e a cor do livro novo). Aqui, a troca de página (tipo
          // "pilha", abaixo) continua o giro de onde ele parou, e os artigos chegam esmaecendo. O
          // livro que está sob o mouse fica quieto até o mouse andar (senão, ele saía 8px sozinho).
          try {
            var chegada = JSON.parse(sessionStorage.getItem("cs-pilha-chegada") || "null");
            sessionStorage.removeItem("cs-pilha-chegada");
            if (!chegada || chegada.para !== location.pathname || Date.now() - chegada.t > 5000) return;
            if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            pilha.classList.add("quieta");
            var mouse = null;
            addEventListener("pointermove", function andou(e) {
              if (!mouse) return void (mouse = [e.clientX, e.clientY]);
              if (Math.abs(e.clientX - mouse[0]) + Math.abs(e.clientY - mouse[1]) < 4) return;
              pilha.classList.remove("quieta");
              removeEventListener("pointermove", andou);
            });
            // As fontes do topo e da pilha já começam a vir (no primeiro quadro, nenhuma está pronta).
            ["800 40px 'Besley Variable'", "400 18px 'Literata Variable'", "400 14px 'IBM Plex Sans Variable'", "700 12px 'Bitter Variable'", "italic 400 12px 'Newsreader Variable'"].forEach(function (f) {
              try { document.fonts.load(f, "Aaçã").catch(function () {}); } catch (x) {}
            });
            addEventListener("pagereveal", function (e) {
              var vt = e.viewTransition;
              if (!vt) return;
              try { vt.types.add("pilha"); } catch (x) {}
              var raiz = document.documentElement;
              var livro = document.querySelector(".topo-livro .livro-3d");
              var lupa = document.querySelector(".topo-livro .lupa");
              var resta = chegada.giro == null ? 0 : Math.max(0, chegada.resta);
              // A imagem da página antiga fica até as fontes da nova ficarem prontas (no máximo 0,5s):
              // nos primeiros quadros, a capa, a pilha e o título apareciam na fonte de reserva. Aí a
              // página troca, e o livro continua o giro de onde parou.
              var comecou = false;
              function comecar() {
                if (comecou) return;
                comecou = true;
                raiz.dataset.pilhaPronta = "";
                if (livro && resta > 16) {
                  var giro = getComputedStyle(livro).getPropertyValue("--giro").trim() || "38deg";
                  // O resto de um power2.out (cúbico) é outro: a curva segue sem emenda.
                  livro.animate([{ transform: "rotateY(" + chegada.giro + "deg)" }, { transform: "rotateY(" + giro + ")" }], {
                    duration: resta,
                    easing: "cubic-bezier(0.33, 1, 0.68, 1)",
                  });
                }
                if (lupa && chegada.lupa < 1) {
                  lupa.animate([{ opacity: chegada.lupa }, { opacity: 1 }], { duration: 220, delay: resta, easing: "linear", fill: "backwards" });
                }
              }
              vt.ready.then(function () {
                document.fonts.ready.then(comecar);
                setTimeout(comecar, 500);
              }, comecar);
              vt.finished.finally(function () { delete raiz.dataset.pilhaPronta; });
            }, { once: true });
          } catch (e) {}
        })();
      </script>
      {outros === 0 && <p class="pilha-vazia">Outras séries aparecem aqui.</p>}
      <div class="tampo" aria-hidden="true"></div>
    </div>
  </section>
  <a class="rss" href={url("/rss.xml")}
    ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.rss} />Assinar via RSS</a
  >
</aside>

<script>
  /*
   * A pilha com peso (D46, D49, protótipo D3; revista na D52), com GSAP sob demanda:
   *
   * - O mouse em cima (ou o foco do teclado): o livro sai 8px, e o bloco de cima vai junto 1,5px, pelo
   *   atrito; volta sem mola. Parado um instante em cima, o livro já busca a página dele.
   * - Trocar de livro (clique, toque ou Enter), numa sequência só, sem paradas:
   *   1. os artigos esmaecem (a página vai mudar; o título do topo fica, D52) e, se a página estiver
   *      rolada, ela volta ao topo (a pilha fica parada ao lado);
   *   2. o livro aberto gira até mostrar a lombada, sai do palco subindo e voa num arco até a pilha,
   *      deitando-se no caminho, e é pousado em cima dela (a mão desce devagar no fim), no espaço que
   *      a pilha guarda para ele; a sombra cresce enquanto ele está no ar e some no pouso;
   *   3. o escolhido é puxado (logo antes do pouso, ANTECIPA): os de cima vão junto nos primeiros
   *      milímetros, pelo atrito; quando a ponta dele passa do centro de massa deles, o bloco tomba
   *      sobre a quina, com a ponta apoiada no livro de baixo; quando ele sai inteiro, o bloco cai
   *      deitado no lugar, com um baque;
   *   4. sem parar (com o embalo do puxão), ele segue até o palco do topo, se pondo em pé no caminho;
   *      o palco já toma a cor dele, e o título velho dá lugar ao da página nova (tirado do HTML dela);
   *   5. ele gira até ficar de lado, e a página nova abre nesse giro: ela o continua de onde parou
   *      (`cs-pilha-chegada`, lido pelo script da ordem), e só os artigos chegam, esmaecendo.
   *   Os livros voam numa camada própria (`.voo-da-pilha`), por cima da página e da pilha e por baixo
   *   do cabeçalho, como o livro 3D inteiro (a lombada da pilha só aparece quando ele está deitado, do
   *   tamanho dela). Nada se cruza no ar: o aberto está na pilha antes de o outro sair.
   * - Com mouse, dá para puxar o livro devagar e ver o bloco de cima reagir. Solto depois da metade (a
   *   velocidade conta), o livro sai, espera ao lado da pilha enquanto o aberto é guardado, e segue.
   *   Antes disso, volta para o lugar, perdendo velocidade, e o bloco se endireita sobre ele.
   * - Se o topo não estiver à vista (no celular e no tablet, a pilha fica embaixo do conteúdo), o aberto
   *   só chega por cima da pilha, e a troca de página leva a lombada até o livro do topo (a de antes).
   * - Com movimento reduzido, fica tudo parado e o clique só abre a página.
   *
   * As medidas vêm da pilha (comprimento, espessura e recuo de cada livro, livros.json), em px da tela.
   */
  import { adiantar, carregarArrastar, carregarGsap, movimentoReduzido, temMouse, type GSAP } from "../scripts/gsap";

  const raiz = document.documentElement;
  /** O que a página nova precisa para continuar o giro (lido pelo script inline da pilha). */
  const CHEGADA = "cs-pilha-chegada";

  // ---------- a página nova, buscada antes ----------
  type Pagina = { livro: HTMLElement; texto: HTMLElement | null; marca: HTMLElement | null; cor: string };
  const paginas = new Map<string, Promise<Pagina | null>>();

  /** O topo da página de um livro, tirado do HTML dela: o livro em pé, o texto, a marca d'água e a cor. */
  function paginaNova(href: string) {
    const chave = new URL(href, location.href).pathname;
    let p = paginas.get(chave);
    if (!p) {
      p = buscar(href);
      paginas.set(chave, p);
      p.then((r) => void (r || paginas.delete(chave)));
    }
    return p;
  }

  async function buscar(href: string): Promise<Pagina | null> {
    try {
      const resposta = await fetch(href);
      if (!resposta.ok) return null;
      // Só o topo da página (o <header class="topo-livro">): montar o documento inteiro (uns 250 kB, com
      // a pilha e os artigos) travava a tela no começo da troca quando o clique vinha sem o mouse parar
      // antes no livro.
      const html = await resposta.text();
      const ini = html.search(/<header[^>]*class="topo-livro/);
      const fim = ini < 0 ? -1 : html.indexOf("</header>", ini);
      if (fim < 0) return null;
      const doc = new DOMParser().parseFromString(html.slice(ini, fim + 9), "text/html");
      const topo = doc.querySelector<HTMLElement>(".topo-livro");
      const livro = topo?.querySelector<HTMLElement>(".livro-em-pe");
      if (!topo || !livro) return null;
      const texto = topo.querySelector<HTMLElement>(":scope > .texto");
      const marca = topo.querySelector<HTMLElement>(":scope > .marca-dagua");
      // A máscara da marca d'água já fica no cache (senão ela pisca ao entrar).
      const mascara = marca?.style.getPropertyValue("--mascara").match(/url\(["']?([^"')]+)/)?.[1];
      if (mascara) fetch(mascara).catch(() => {});
      return {
        livro: document.importNode(livro, true),
        texto: texto && comEstilo(texto) ? document.importNode(texto, true) : null,
        marca: marca ? document.importNode(marca, true) : null,
        cor: topo.style.getPropertyValue("--cor"),
      };
    } catch {
      return null;
    }
  }

  /** O texto só entra antes da página se o CSS de todas as peças dele já estiver aqui. */
  function comEstilo(el: Element) {
    const cids = new Set<string>();
    for (const e of [el, ...el.querySelectorAll("*")]) for (const a of e.getAttributeNames()) if (a.startsWith("data-astro-cid-")) cids.add(a);
    return [...cids].every((a) => document.querySelector(`[${a}]`));
  }

  /** O que não chegar a tempo fica de fora (a página abre do mesmo jeito). */
  const ate = <T,>(p: Promise<T>, ms: number) => Promise.race([p, new Promise<null>((r) => setTimeout(() => r(null), ms))]);

  // ---------- o voo: estado, trajeto e a camada ----------
  /** Um livro no ar: centro, ângulo (0 = deitado, com a cabeça à esquerda; 90 = em pé), comprimento e espessura, em px da tela. */
  type Pose = { cx: number; cy: number; ang: number; len: number; esp: number };
  /** O centro de uma peça parada e as medidas dela na pose de partida (a lombada, no livro 3D). */
  type Base = { x: number; y: number; w: number; h: number };

  const limitar = (v: number) => Math.min(1, Math.max(0, v));
  const bezier = (a: number, b: number, c: number, d: number, u: number) => {
    const v = 1 - u;
    return v * v * v * a + 3 * v * v * u * b + 3 * v * u * u * c + u * u * u * d;
  };

  /**
   * O caminho de um voo: um arco (Bézier) de `de` a `para`, que sai na direção `saida` e chega pela
   * direção `chegada` (px, relativos às pontas); o livro gira e muda de tamanho entre `giro[0]` e
   * `giro[1]` do caminho, suave nas duas pontas.
   */
  function trajeto(g: GSAP, de: Pose, para: Pose, saida: [number, number], chegada: [number, number], giro: [number, number]) {
    const suave = g.parseEase("power2.inOut");
    return (u: number): Pose => {
      const q = suave(limitar((u - giro[0]) / (giro[1] - giro[0])));
      return {
        cx: bezier(de.cx, de.cx + saida[0], para.cx + chegada[0], para.cx, u),
        cy: bezier(de.cy, de.cy + saida[1], para.cy + chegada[1], para.cy, u),
        ang: de.ang + (para.ang - de.ang) * q,
        len: de.len + (para.len - de.len) * q,
        esp: de.esp + (para.esp - de.esp) * q,
      };
    };
  }

  /** A lombada da pilha (deitada) na pose: o comprimento dela é a largura, e a espessura, a altura. */
  function poseDeitado(g: GSAP, el: HTMLElement, b: Base, p: Pose) {
    g.set(el, { x: p.cx - b.x, y: p.cy - b.y, rotation: p.ang, scaleX: p.len / b.w, scaleY: p.esp / b.h, transformOrigin: "50% 50%" });
  }

  /** O livro 3D (em pé, de lombada para o leitor) na pose: b.w e b.h são a espessura e a altura da lombada. */
  function poseEmPe(g: GSAP, el: HTMLElement, b: Base, p: Pose) {
    g.set(el, { x: p.cx - b.x, y: p.cy - b.y, rotation: p.ang - 90, scaleX: p.esp / b.w, scaleY: p.len / b.h, transformOrigin: "50% 50%" });
  }

  /** A camada dos voos: por cima da página e da pilha, por baixo do cabeçalho. */
  function camada() {
    let c = document.querySelector<HTMLElement>(".voo-da-pilha");
    if (!c) {
      c = document.createElement("div");
      c.className = "voo-da-pilha";
      c.setAttribute("aria-hidden", "true");
      document.body.append(c);
    }
    return c;
  }

  /**
   * A sombra do livro no ar: uma mancha suave do tamanho dele, embaixo dele, que se afasta e fica mais
   * forte com a altura (h, de 0 a 1) e some no pouso. Só transform e opacity (um filtro de sombra na
   * camada travava a placa de vídeo no começo do voo).
   */
  function sombra(p: Pose | null, h = 0) {
    const c = camada();
    let s = c.querySelector<HTMLElement>(":scope > .sombra-do-voo");
    if (!s) {
      s = document.createElement("span");
      s.className = "sombra-do-voo";
      c.prepend(s);
    }
    if (!p || h < 0.02) return void (s.style.opacity = "0");
    const largura = p.len * 1.12 + 10 * h;
    const altura = Math.max(p.esp, 10) * 1.8 + 8 * h;
    s.style.opacity = (0.9 * h).toFixed(3);
    s.style.transform = `translate(${p.cx - 50}px, ${p.cy - 50 + 4 + 12 * h}px) rotate(${p.ang}deg) scale(${largura / 100}, ${altura / 100})`;
  }

  /**
   * Uma cópia do livro 3D na camada dos voos, no lugar dele. Devolve a cópia, o livro dela e a Base: o
   * centro da caixa e a lombada medida a 90° (a pose em pé de partida).
   */
  function copiaQueVoa(g: GSAP, el: HTMLElement) {
    const r = el.getBoundingClientRect();
    const c = el.cloneNode(true) as HTMLElement;
    c.style.viewTransitionName = "none";
    c.style.removeProperty("visibility");
    Object.assign(c.style, { position: "absolute", left: `${r.left}px`, top: `${r.top}px`, margin: "0" });
    camada().append(c);
    const livro = c.querySelector<HTMLElement>(".livro-3d")!;
    const antes = Number(g.getProperty(livro, "rotationY"));
    g.set(livro, { rotationY: 90 });
    const rl = c.querySelector(".face-lombada")!.getBoundingClientRect();
    g.set(livro, { rotationY: antes });
    const base: Base = { x: r.left + r.width / 2, y: r.top + r.height / 2, w: rl.width, h: rl.height };
    return { copia: c, livro, base, giro: antes };
  }

  for (const pilha of document.querySelectorAll<HTMLElement>(".pilha")) {
    if (movimentoReduzido.matches) continue;
    const ol = pilha.querySelector("ol")!;
    const painel = pilha.closest<HTMLElement>(".painel-home");
    const celular = matchMedia("(max-width: 760px)");
    // No celular, tudo um pouco mais rápido.
    const DUR = () => (celular.matches ? 0.8 : 1);
    /** Quanto o puxão começa antes de o livro guardado pousar (s, na escala de DUR). */
    const ANTECIPA = 0.15;
    let gsap: GSAP | null = null;
    let ocupado = false;
    let pressionado: HTMLElement | null = null;
    // A pilha e o topo como a página abriu (para voltar a eles pelo histórico).
    const ordemInicial = [...ol.children] as HTMLElement[];
    const escondido = ol.querySelector<HTMLElement>(":scope > li[hidden]");
    const topoInicial = document.querySelector<HTMLElement>(".topo-livro .livro-em-pe");
    const nomeDoTopo = topoInicial?.style.viewTransitionName ?? "";
    const estiloDaPilha = ol.getAttribute("style");

    const visiveis = () => [...ol.querySelectorAll<HTMLElement>(":scope > li:not([hidden]) > .deitado")];
    /** O bloco em cima de um livro, de baixo para cima: o primeiro é o que está logo acima dele. */
    const blocoDe = (el: HTMLElement) => {
      const livros = visiveis();
      return livros.slice(0, livros.indexOf(el)).reverse();
    };
    const naTela = (r: DOMRect) => r.bottom > 0 && r.top < innerHeight && r.width > 0;
    /** Na tela grande, a pilha fica parada ao lado do conteúdo enquanto ele rola. */
    const aoLado = () => !!painel && getComputedStyle(painel).position === "sticky";

    // ---------- a física do bloco de cima ----------
    type Geo = { L: number; R: number; topo: number; t: number; m: number };
    let geo = new Map<HTMLElement, Geo>();
    /** Onde está cada livro parado (sem o deslocamento do GSAP), em px da tela: pontas, topo, espessura e massa. */
    function medir() {
      geo = new Map();
      for (const el of visiveis()) {
        const r = el.getBoundingClientRect();
        const x = Number(gsap?.getProperty(el, "x")) || 0;
        const y = Number(gsap?.getProperty(el, "y")) || 0;
        geo.set(el, { L: r.left - x, R: r.right - x, topo: r.top - y, t: r.height, m: r.width * r.height });
      }
    }

    type Estado = { arrasto: number; graus: number; cai: number; pivo: { x: number; y: number } | null };
    /**
     * Puxando o livro k `dx` px para a direita:
     * - atrito: nos primeiros 6px, o bloco de cima vai junto pela metade (no máximo 3px) e depois fica;
     * - enquanto a ponta esquerda do livro puxado não passa do centro de massa do bloco, ele fica apoiado;
     * - passou: o bloco gira em volta da quina de cima do livro puxado, até a ponta esquerda dele
     *   encostar no livro de baixo (sen θ = espessura do puxado / distância da quina até a ponta);
     * - o livro saiu inteiro: o bloco cai deitado, a espessura do puxado abaixo.
     */
    function estadoDoBloco(k: HTMLElement, dx: number): Estado | null {
      const cima = blocoDe(k);
      const g = geo.get(k);
      if (!cima.length || !g) return null;
      const arrasto = Math.min(dx, 6) * 0.5;
      const massa = cima.reduce((s, c) => s + geo.get(c)!.m, 0);
      const cm = cima.reduce((s, c) => s + geo.get(c)!.m * ((geo.get(c)!.L + geo.get(c)!.R) / 2), 0) / massa + arrasto;
      const baixo = geo.get(cima[0])!;
      const quina = g.L + dx;
      // Saiu: o bloco cai e assenta reto sobre o de baixo (sem o arrasto do atrito, como na página nova).
      if (quina >= baixo.R + arrasto) return { arrasto: 0, graus: 0, cai: g.t, pivo: null };
      if (quina <= cm) return { arrasto, graus: 0, cai: 0, pivo: null };
      const dist = Math.max(g.t * 1.2, quina - (baixo.L + arrasto));
      const graus = Math.min(25, (Math.asin(Math.min(1, g.t / dist)) * 180) / Math.PI);
      return { arrasto, graus, cai: 0, pivo: { x: quina, y: g.topo } };
    }

    /** O bloco inteiro gira em volta do mesmo ponto (corpo rígido): a origem de cada livro, em px dele. */
    function aplicarBloco(k: HTMLElement, e: Estado | null) {
      if (!e || !gsap) return;
      for (const c of blocoDe(k)) {
        const gc = geo.get(c)!;
        const vars: gsap.TweenVars = { x: e.arrasto, y: e.cai, rotation: -e.graus };
        if (e.pivo) vars.transformOrigin = `${e.pivo.x - e.arrasto - gc.L}px ${e.pivo.y - gc.topo}px`;
        gsap.to(c, { ...vars, duration: e.cai ? 0.16 : 0.14, ease: "power2.in", overwrite: "auto" });
      }
    }

    function puxar(k: HTMLElement, dx: number) {
      gsap!.set(k, { x: dx });
      aplicarBloco(k, estadoDoBloco(k, dx));
    }

    /**
     * Termina de puxar, na velocidade de quem puxa, sem mola; o bloco tomba e cai no caminho e, logo
     * depois, dá o baque (sem esperar por ele: o livro já segue). Devolve quanto o bloco caiu e a
     * velocidade do livro na saída (px/s), para o voo seguir com o mesmo embalo.
     */
    async function puxarAteSair(k: HTMLElement, dx0: number) {
      const g = gsap!;
      const gk = geo.get(k)!;
      const saida = gk.R - gk.L + 12;
      const obj = { dx: dx0 };
      const dur = 0.34 * DUR() * (1 - dx0 / saida) + 0.1;
      k.parentElement!.classList.add("no-ar");
      // Acelera desde o começo (quadrática): o atrito segura só nos primeiros milímetros.
      await g.to(obj, { dx: saida, duration: dur, ease: "power1.in", onUpdate: () => puxar(k, obj.dx) }).then();
      const e = estadoDoBloco(k, saida);
      const velocidade = (2 * (saida - dx0)) / dur;
      if (!e) return { cai: 0, velocidade };
      // O baque; no fim dele, se o puxado já virou o livro que voa, a pilha assenta (ainda no movimento,
      // e não depois, parada, quando até meio pixel se nota).
      g.timeline({ onComplete: () => void (k.style.visibility === "hidden" && assentar(k)) })
        .to(blocoDe(k), { y: e.cai + 1, duration: 0.05, ease: "power1.out", delay: 0.16 })
        .to(blocoDe(k), { y: e.cai, duration: 0.1, ease: "power1.in" });
      return { cai: e.cai, velocidade };
    }

    // ---------- a página que sai (o texto e os artigos) ----------
    type Palco = {
      topo: HTMLElement;
      cor: string;
      apagados: HTMLElement[];
      texto: HTMLElement | null;
      marca: HTMLElement | null;
      novoTexto?: HTMLElement | null;
      novaMarca?: HTMLElement | null;
    };
    let palco: Palco | null = null;

    /**
     * Os artigos esmaecem: a página vai mudar. O título e a marca d'água do topo ficam até o livro novo
     * sair da pilha (montarOTopo): antes, eles sumiam no clique, e o topo ficava um bloco colorido vazio
     * por mais de um segundo, com a ação toda na pilha pequena (D52).
     */
    function apagarAPagina() {
      const topo = document.querySelector<HTMLElement>(".topo-livro");
      if (!topo) return;
      const texto = topo.querySelector<HTMLElement>(":scope > .texto");
      const marca = topo.querySelector<HTMLElement>(":scope > .marca-dagua");
      const resto = [...(topo.parentElement?.children ?? [])].filter((el) => el !== topo && el instanceof HTMLElement) as HTMLElement[];
      palco = { topo, cor: topo.style.getPropertyValue("--cor"), apagados: resto, texto, marca };
      gsap!.to(resto, { opacity: 0, duration: 0.28, ease: "power1.out", overwrite: "auto" });
    }

    /** O título velho, fora do fluxo, no lugar exato onde está: o topo passa a ter o tamanho do novo. */
    const TEXTO_SOLTO = ["position", "left", "top", "width", "margin", "pointer-events", "--cor"];
    function soltar(el: HTMLElement, topo: HTMLElement, cor: string) {
      const rt = topo.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      // A cor do livro velho fica nele (o quadradinho da contagem não troca de cor antes de sair).
      if (cor) el.style.setProperty("--cor", cor);
      Object.assign(el.style, {
        position: "absolute",
        left: `${r.left - rt.left - topo.clientLeft}px`,
        top: `${r.top - rt.top - topo.clientTop}px`,
        width: `${r.width}px`,
        margin: "0",
        pointerEvents: "none",
      });
    }

    /**
     * O livro novo saiu da pilha: o topo toma o livro novo antes de a página abrir. A cor do palco muda
     * devagar, e o texto e a marca d'água da página nova entram (ainda transparentes) ao lado dos
     * antigos, que saem em mostrarOTopo (o título velho fica no mesmo lugar, fora do fluxo). Se o topo
     * mudar de altura, ele cresce ou encolhe até ela (devolve essa animação, para começar depois de
     * medido o voo).
     */
    function montarOTopo(p: Pagina) {
      if (!palco) return () => {};
      const { topo } = palco;
      const antes = topo.offsetHeight;
      const quadro = topo.querySelector<HTMLElement>(":scope > .palco");
      if (quadro) quadro.style.transition = "background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
      if (p.cor) topo.style.setProperty("--cor", p.cor);
      if (palco.texto && p.texto) {
        palco.novoTexto = p.texto.cloneNode(true) as HTMLElement;
        palco.novoTexto.style.opacity = "0";
        soltar(palco.texto, topo, palco.cor);
        palco.texto.after(palco.novoTexto);
      }
      if (palco.marca && p.marca) {
        palco.novaMarca = p.marca.cloneNode(true) as HTMLElement;
        palco.novaMarca.style.opacity = "0";
        palco.marca.after(palco.novaMarca);
      }
      const depois = topo.offsetHeight;
      return () => {
        if (Math.abs(depois - antes) > 0.5) gsap!.fromTo(topo, { height: antes }, { height: depois, duration: 0.4, ease: "power2.inOut", clearProps: "height" });
      };
    }

    /**
     * O título velho sai depressa (e a marca d'água dele, junto com a cor do palco) e o novo aparece
     * logo depois, no mesmo lugar, quase sem se cruzarem (e a marca d'água, até a transparência dela).
     * Sem o texto novo (a página de origem não tem o CSS de alguma peça dele), o velho sai do mesmo
     * jeito, e o novo entra com a troca de página.
     */
    function mostrarOTopo(atraso: number) {
      if (!palco) return;
      const g = gsap!;
      const { texto, marca, novoTexto, novaMarca } = palco;
      if (texto) g.to(texto, { opacity: 0, duration: 0.18, ease: "power1.out", onComplete: () => void (novoTexto && texto.remove()) });
      if (novoTexto) g.to(novoTexto, { opacity: 1, duration: 0.42, delay: atraso, ease: "power1.inOut", clearProps: "opacity" });
      if (marca) {
        const alvo = Number(getComputedStyle(marca).opacity) || 0.1;
        g.to(marca, { opacity: 0, duration: 0.3, ease: "power1.inOut", onComplete: () => void (novaMarca && marca.remove()) });
        if (novaMarca) g.to(novaMarca, { opacity: alvo, duration: 0.5, delay: atraso, ease: "power1.inOut", clearProps: "opacity" });
      }
    }

    /** Página rolada e pilha ao lado: volta ao topo antes (a pilha fica parada), para o livro ir ao lugar dele. */
    async function subirAoTopo() {
      if (scrollY < 1 || !aoLado()) return;
      const obj = { y: scrollY };
      await gsap!
        .to(obj, { y: 0, duration: Math.min(0.55, 0.28 + scrollY / 4000), ease: "power2.inOut", onUpdate: () => scrollTo({ top: obj.y, behavior: "instant" }) })
        .then();
    }

    // ---------- guardar o livro aberto ----------
    /** O livro aberto: o 3D do topo da página e, escondida na pilha, a lombada dele. */
    function aberto() {
      const li = ol.querySelector<HTMLElement>(":scope > li[hidden]");
      const topo = document.querySelector<HTMLElement>(".topo-livro .livro-em-pe");
      return li && topo ? { li, deitado: li.querySelector<HTMLElement>(".deitado")!, topo } : null;
    }

    /** O topo da página está (ou vai estar, depois de subir) à vista: os livros voam de e até ele. */
    function topoAVista() {
      const topo = document.querySelector<HTMLElement>(".topo-livro .livro-em-pe");
      return !!topo && (aoLado() || naTela(topo.getBoundingClientRect()));
    }

    /**
     * O livro aberto volta para a pilha: gira até mostrar a lombada, sai do palco subindo e voa num arco
     * até em cima da pilha, deitando-se no caminho, e é pousado (a mão desce devagar no fim) no espaço
     * que a pilha guarda para ele; lá, a lombada da pilha toma o lugar dele. `queda`: o quanto a pilha
     * já desceu (o bloco que caiu quando o livro puxado saiu). Longe da tela, ele só chega por cima da
     * pilha e assenta.
     */
    async function guardarOAberto(queda = 0) {
      const g = gsap!;
      const a = aberto();
      if (!a) return;
      const voa = !!a.topo.querySelector(".livro-3d") && naTela(a.topo.getBoundingClientRect());
      // O livro entra no espaço que a pilha guardava em cima (--folga), e o espaço sai: a pilha não muda
      // de altura, e nenhum livro dela se mexe (nem meio pixel).
      ol.prepend(a.li);
      a.li.hidden = false;
      ol.style.paddingTop = "0px";
      a.li.classList.add("no-ar");
      a.deitado.style.viewTransitionName = a.deitado.dataset.vt ?? "";
      const rd = a.deitado.getBoundingClientRect();
      if (!voa) {
        a.topo.style.visibility = "hidden";
        a.topo.style.viewTransitionName = "none";
        g.set(a.deitado, { y: queda - Math.max(24, rd.height * 2), opacity: 0 });
        await g
          .timeline()
          .to(a.deitado, { opacity: 1, duration: 0.15, ease: "none" })
          .to(a.deitado, { y: queda, duration: 0.22, ease: "power2.in" }, ">-0.02")
          .to(a.deitado, { y: queda + 1, duration: 0.04, ease: "power1.out" })
          .to(a.deitado, { y: queda, duration: 0.09, ease: "power1.in" })
          .then();
        a.li.classList.remove("no-ar");
        return;
      }
      // O livro sai do palco numa cópia (idêntica, no mesmo lugar); o de verdade some junto.
      const v = copiaQueVoa(g, a.topo);
      a.topo.style.visibility = "hidden";
      a.topo.style.viewTransitionName = "none";
      g.set(a.deitado, { opacity: 0 });
      const de: Pose = { cx: v.base.x, cy: v.base.y, ang: 90, len: v.base.h, esp: v.base.w };
      const para: Pose = { cx: rd.left + rd.width / 2, cy: rd.top + rd.height / 2 + queda, ang: 0, len: rd.width, esp: rd.height };
      const dx = Math.abs(para.cx - de.cx);
      // Sai subindo; chega por cima e um pouco da direita, já quase deitado, e desce até a pilha.
      const ir = trajeto(g, de, para, [0, -34], [Math.min(110, dx * 0.35), -Math.max(16, para.esp * 1.4)], [0.04, 0.8]);
      const obj = { u: 0 };
      const tl = g.timeline();
      const lupa = v.copia.querySelector(".lupa");
      if (lupa) tl.to(lupa, { opacity: 0, duration: 0.14, ease: "none" }, 0);
      tl.to(v.livro, { rotationY: 90, duration: 0.26 * DUR(), ease: "power2.in" }, 0);
      tl.to(
        obj,
        {
          u: 1,
          duration: 0.58 * DUR(),
          ease: "power1.inOut",
          onUpdate: () => {
            const pose = ir(obj.u);
            // O puxão pode começar antes do pouso (abaixo): o atrito leva o bloco de cima, e este livro
            // com ele, um ou dois px para o lado; a cópia vai junto e pousa onde a lombada está.
            pose.cx += Number(g.getProperty(a.deitado, "x")) || 0;
            poseEmPe(g, v.copia, v.base, pose);
            sombra(pose, Math.sin(Math.PI * obj.u));
          },
        },
        0.1 * DUR(),
      );
      // Pousou: a lombada da pilha (do tamanho dele, no mesmo lugar) toma o lugar da cópia.
      tl.eventCallback("onComplete", () => {
        sombra(null);
        g.set(a.deitado, { y: queda, opacity: 1 });
        g.to(v.copia, { opacity: 0, duration: 0.08, ease: "none", onComplete: () => v.copia.remove() });
        // O baque do pouso (afunda 1px e volta) corre junto com o começo do puxão.
        g.timeline({ onComplete: () => a.li.classList.remove("no-ar") })
          .to(a.deitado, { y: queda + 1, duration: 0.05, ease: "power1.out" })
          .to(a.deitado, { y: queda, duration: 0.1, ease: "power1.in" });
      });
      // O passo seguinte começa um pouco antes do pouso, enquanto o livro desce os últimos milímetros
      // (a outra mão já vai ao escolhido): antes, entre pousar e puxar, a pilha ficava ~0,3s parada.
      await new Promise<void>((r) => void tl.call(r, undefined, Math.max(0, tl.duration() - ANTECIPA * DUR())));
    }

    // ---------- levar o escolhido ao topo ----------
    let posto: { novo: HTMLElement; velho: HTMLElement } | null = null;
    /** O giro final, que a página nova continua (pageswap). */
    let giroFinal: { tween: gsap.core.Tween; livro: HTMLElement; lupa: HTMLElement | null; para: string } | null = null;

    /**
     * O escolhido vai até o lugar dele (D49, D52): da saída da pilha, com o embalo do puxão, voa num
     * arco até o palco do topo, se pondo em pé no caminho (a lombada deitada vira o livro 3D logo no
     * começo, ainda pequeno, e ele cresce até o tamanho do topo), e desce no lugar. Lá, o livro da
     * página nova (o mesmo elemento dela) toma o lugar da cópia e gira até ficar de lado. `embalo`: a
     * velocidade com que ele saiu da pilha (0, se estava parado ao lado).
     */
    async function levarAoTopo(k: HTMLAnchorElement, p: Pagina | null, embalo: number) {
      const g = gsap!;
      const velho = document.querySelector<HTMLElement>(".topo-livro .livro-em-pe");
      if (!p || !velho || !naTela(velho.getBoundingClientRect())) return false;
      const novo = p.livro.cloneNode(true) as HTMLElement;
      novo.style.visibility = "hidden";
      const lupa = novo.querySelector<HTMLElement>(".lupa");
      if (lupa) lupa.style.opacity = "0";
      velho.replaceWith(novo);
      posto = { novo, velho };
      const crescer = montarOTopo(p);
      const livro = novo.querySelector<HTMLElement>(".livro-3d")!;
      // O palco gira o livro por CSS (data-livro-gira): aqui, quem gira é o GSAP.
      livro.style.transition = "none";
      g.set(livro, { rotationY: 90 });
      const v = copiaQueVoa(g, novo);
      v.copia.querySelector(".lupa")?.remove();
      crescer();

      // Um livro só com esse nome na troca: o que está no topo (o script do <head> nomearia o da pilha).
      k.removeAttribute("data-vt");
      k.style.viewTransitionName = "none";
      const rk = k.getBoundingClientRect();
      const bk: Base = {
        x: rk.left + rk.width / 2 - (Number(g.getProperty(k, "x")) || 0),
        y: rk.top + rk.height / 2 - (Number(g.getProperty(k, "y")) || 0),
        w: k.offsetWidth,
        h: k.offsetHeight,
      };
      const de: Pose = { cx: rk.left + rk.width / 2, cy: rk.top + rk.height / 2, ang: 0, len: rk.width, esp: rk.height };
      const para: Pose = { cx: v.base.x, cy: v.base.y, ang: 90, len: v.base.h, esp: v.base.w };
      const T = 0.54 * DUR();
      // Com embalo, a saída segue na direção do puxão, na mesma velocidade (power1.out começa a 2/T).
      const saida: [number, number] = embalo > 0 ? [Math.min(140, (embalo * T) / 6), -14] : [40, -26];
      const ir = trajeto(g, de, para, saida, [0, -Math.max(36, (para.len - de.len) * 0.25)], [0.06, 0.86]);
      g.set(v.copia, { opacity: 0 });
      poseEmPe(g, v.copia, v.base, de);
      const obj = { u: 0 };
      mostrarOTopo(T * 0.25);
      const giro = parseFloat(getComputedStyle(livro).getPropertyValue("--giro")) || 38;
      const D = 0.52 * DUR();
      // O giro começa ainda na descida (na cópia): pousar e virar são um gesto só.
      const giroDaCopia = g.to(v.livro, { rotationY: giro, duration: D, ease: "power2.out", paused: true });
      await g
        .timeline()
        .to(obj, {
          u: 1,
          duration: T,
          ease: embalo > 0 ? "power1.out" : "power2.inOut",
          onUpdate: () => {
            const pose = ir(obj.u);
            poseEmPe(g, v.copia, v.base, pose);
            // A lombada deitada vira o livro 3D no começo do voo, ainda do tamanho dela: o 3D aparece
            // por cima dela (que fica inteira por baixo até ele cobrir, sem clarear no meio).
            const troca = limitar(obj.u / 0.12);
            g.set(v.copia, { opacity: troca });
            if (troca < 1) poseDeitado(g, k, bk, pose);
            else k.style.visibility = "hidden";
            sombra(pose, Math.sin(Math.PI * obj.u) * 0.9);
          },
        })
        .add(() => void giroDaCopia.play(), T * 0.62)
        .then();
      // No lugar: o livro da página nova (idêntico à cópia, no mesmo ângulo) fica e termina o giro. O resto
      // de um power2.out é outro power2.out, no tempo que falta: a curva segue sem emenda.
      sombra(null);
      const feito = giroDaCopia.progress();
      g.set(livro, { rotationY: Number(g.getProperty(v.livro, "rotationY")) });
      giroDaCopia.kill();
      novo.style.removeProperty("visibility");
      v.copia.remove();
      k.style.visibility = "hidden";
      const resta = (1 - feito) * D;
      const tween = g.to(livro, { rotationY: giro, duration: resta, ease: "power2.out" });
      if (lupa) g.to(lupa, { opacity: 1, duration: 0.22, delay: resta, ease: "none" });
      giroFinal = { tween, livro, lupa, para: new URL(k.href).pathname };
      // A página nova abre perto do fim do giro: entre a página antiga parar (pageswap) e a nova pintar,
      // a tela fica parada um instante, e isso não se nota com o livro já quase parado (a 70% do tempo,
      // o power2.out já fez 97% do giro). A página nova faz o resto.
      await new Promise((r) => g.delayedCall(Math.max(0, (0.7 - feito) * D), r));
      return true;
    }

    // A página nova abre no meio do giro: ele para aqui e a página nova o continua de onde parou.
    addEventListener("pageswap", () => {
      if (!giroFinal || !gsap) return;
      const { tween, livro, lupa, para } = giroFinal;
      const resta = tween.progress() < 1 ? (1 - tween.progress()) * tween.duration() * 1000 : 0;
      tween.pause();
      const dados = {
        t: Date.now(),
        para,
        giro: resta > 0 ? Number(gsap.getProperty(livro, "rotationY")) : null,
        resta: Math.round(resta),
        lupa: lupa ? Number(getComputedStyle(lupa).opacity) : 1,
      };
      try {
        sessionStorage.setItem(CHEGADA, JSON.stringify(dados));
      } catch {}
    });

    // ---------- trocar de livro ----------

    /**
     * Tudo parado, a pilha passa a ser a da página nova de verdade: o lugar do puxado sai do layout e os
     * livros perdem as transformações (o bloco que caiu fica onde estava). Assim, a pilha da página
     * antiga e a da nova são iguais até no meio pixel, e a troca de página não a mexe.
     */
    function assentar(k: HTMLElement) {
      const li = k.parentElement!;
      li.hidden = true;
      li.classList.remove("no-ar");
      gsap?.set(visiveis(), { clearProps: "transform,opacity" });
      // O espaço de cima passa a ser o do livro que abriu (a pilha fica com a altura de antes).
      const largura = k.style.getPropertyValue("--w");
      if (largura) ol.style.setProperty("--folga", largura);
      ol.style.removeProperty("padding-top");
    }

    function abrir(k: HTMLAnchorElement, voou = false) {
      if (voou) assentar(k);
      // A troca é esta (troca.js não derruba as folhas: o livro já está no lugar dele).
      raiz.dataset.trocaPropria = "";
      location.assign(k.href);
    }

    /** Clique, toque ou Enter: guarda o aberto, puxa o escolhido, leva-o ao topo e abre a página dele. */
    async function trocar(k: HTMLAnchorElement) {
      if (ocupado || !gsap) return;
      ocupado = true;
      // Durante a troca, o livro sob o mouse não sai (o :hover do CSS voltava quando a pilha assentava).
      pilha.classList.add("quieta");
      const pagina = paginaNova(k.href);
      const voa = topoAVista();
      if (voa) apagarAPagina();
      await subirAoTopo();
      const dx = Number(gsap.getProperty(k, "x")) || 0;
      await guardarOAberto();
      // Com o livro guardado em cima, o bloco sobre o escolhido mudou: mede de novo.
      medir();
      const { velocidade } = await puxarAteSair(k, dx);
      const voou = voa && (await levarAoTopo(k, await ate(pagina, 1200), velocidade));
      abrir(k, voou);
    }

    /** Arrastado e solto depois da metade: sai inteiro, espera ao lado da pilha, o aberto é guardado, e ele vai ao topo. */
    async function tirarArrastado(k: HTMLAnchorElement, dx: number) {
      ocupado = true;
      pilha.classList.add("quieta");
      const pagina = paginaNova(k.href);
      const voa = topoAVista();
      if (voa) apagarAPagina();
      const { cai } = await puxarAteSair(k, dx);
      await subirAoTopo();
      await guardarOAberto(cai);
      const voou = voa && (await levarAoTopo(k, await ate(pagina, 1200), 0));
      abrir(k, voou);
    }

    // ---------- mouse, arrasto, toque e teclado ----------
    // Parado um instante sobre um livro (ou com o foco nele, ou ao tocar), a página dele já vem.
    for (const k of visiveis() as HTMLAnchorElement[]) {
      let espera = 0;
      k.addEventListener("pointerenter", () => (espera = window.setTimeout(() => paginaNova(k.href), 90)));
      k.addEventListener("pointerleave", () => clearTimeout(espera));
      k.addEventListener("pointerdown", () => paginaNova(k.href));
      k.addEventListener("focus", () => paginaNova(k.href));
    }

    const ligar = (g: GSAP) => {
      if (gsap) return;
      gsap = g;
      pilha.classList.add("viva");
      for (const k of visiveis()) {
        const sair = () => {
          if (ocupado || pressionado) return;
          g.to(k, { x: 8, duration: 0.3, ease: "power2.out", overwrite: "auto" });
          g.to(blocoDe(k), { x: 1.5, duration: 0.4, ease: "power2.out", overwrite: "auto" });
        };
        const voltar = () => {
          if (ocupado || pressionado) return;
          g.to(k, { x: 0, duration: 0.32, ease: "power3.out", overwrite: "auto" });
          g.to(blocoDe(k), { x: 0, duration: 0.4, ease: "power3.out", overwrite: "auto" });
        };
        k.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && sair());
        k.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && voltar());
        k.addEventListener("focus", () => k.matches(":focus-visible") && sair());
        k.addEventListener("blur", voltar);
      }
      if (temMouse.matches) ligarArrasto();
    };

    /** Puxar com o mouse (Draggable + InertiaPlugin), só na horizontal: o toque precisa rolar a página. */
    async function ligarArrasto() {
      const { Draggable, InertiaPlugin } = await carregarArrastar();
      const g = gsap!;
      for (const k of visiveis() as HTMLAnchorElement[]) {
        k.draggable = false;
        const proxy = document.createElement("div");
        let x0 = 0;
        let arrastou = false;
        Draggable.create(proxy, {
          trigger: k,
          type: "x",
          minimumMovement: 3,
          cursor: "pointer",
          activeCursor: "grabbing",
          onPress() {
            arrastou = false;
            if (ocupado) return;
            pressionado = k;
            x0 = this.x - (Number(g.getProperty(k, "x")) || 0);
            // A pilha medida parada (o livro sob o mouse pode estar 8px para fora).
            medir();
          },
          onDrag() {
            if (ocupado) return;
            arrastou = true;
            puxar(k, Math.max(0, this.x - x0));
          },
          onRelease() {
            pressionado = null;
            if (ocupado || !arrastou) return;
            const dx = Number(g.getProperty(k, "x")) || 0;
            const gk = geo.get(k)!;
            const vx = InertiaPlugin.getVelocity(proxy, "x") || 0;
            if (dx + vx * 0.2 > (gk.R - gk.L) * 0.5) return void tirarArrastado(k, dx);
            // Não saiu: volta empurrado, perdendo velocidade (atrito), e o bloco se endireita sobre ele.
            const obj = { dx };
            g.to(obj, {
              dx: 0,
              duration: 0.3 + dx / 900,
              ease: "power2.out",
              onUpdate: () => puxar(k, obj.dx),
              onComplete: () => void g.to(blocoDe(k), { x: 0, duration: 0.3, ease: "power2.out" }),
            });
          },
        });
      }
    }
    adiantar(pilha, () => carregarGsap().then(ligar));

    ol.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("a.deitado");
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      // O GSAP chega sozinho logo depois de a página abrir; um clique antes disso (ou o do livro
      // ampliado, que abre o próximo livro pela pilha) espera por ele.
      if (gsap) trocar(link);
      else carregarGsap().then((g) => (ligar(g), trocar(link)));
    });

    // Voltar pelo histórico (bfcache) traz a página como ficou: a pilha, o topo e o texto voltam ao lugar.
    addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      delete raiz.dataset.trocaPropria;
      pilha.classList.remove("quieta");
      if (!gsap) return;
      ocupado = false;
      pressionado = null;
      giroFinal?.tween.kill();
      giroFinal = null;
      document.querySelector(".voo-da-pilha")?.replaceChildren();
      sombra(null);
      if (posto) {
        posto.novo.replaceWith(posto.velho);
        posto = null;
      }
      if (palco) {
        const { topo, cor, apagados, texto, marca, novoTexto, novaMarca } = palco;
        const velhos = [texto, marca].filter((el): el is HTMLElement => !!el);
        gsap.killTweensOf(velhos);
        if (novoTexto && texto) novoTexto.replaceWith(texto);
        if (novaMarca && marca) novaMarca.replaceWith(marca);
        for (const prop of TEXTO_SOLTO) texto?.style.removeProperty(prop);
        topo.style.setProperty("--cor", cor);
        topo.querySelector<HTMLElement>(":scope > .palco")?.style.removeProperty("transition");
        gsap.set([topo, ...apagados, ...velhos], { clearProps: "opacity,height" });
        palco = null;
      }
      for (const li of ordemInicial) {
        ol.append(li);
        li.hidden = li === escondido;
        li.classList.remove("no-ar");
        const d = li.querySelector<HTMLElement>(".deitado");
        if (!d) continue;
        d.style.removeProperty("view-transition-name");
        d.style.removeProperty("visibility");
        d.dataset.vt = li.dataset.id;
      }
      if (topoInicial) {
        topoInicial.style.removeProperty("visibility");
        topoInicial.style.viewTransitionName = nomeDoTopo;
      }
      const livroDoTopo = topoInicial?.querySelector(".livro-3d");
      // Só o que o GSAP pôs (clearProps "all" apagava o style inteiro: as cores e as medidas de cada
      // livro iam junto, e a pilha voltava vazia).
      gsap.set([...ol.querySelectorAll(".deitado"), ...(livroDoTopo ? [livroDoTopo] : [])], { clearProps: "transform,transformOrigin,opacity" });
      if (estiloDaPilha) ol.setAttribute("style", estiloDaPilha);
      else ol.removeAttribute("style");
    });
  }
</script>

<style>
  .painel-home {
    padding: 22px 18px 18px;
  }

  /*
   * Com o painel embaixo do conteúdo (abaixo de 1100px, ComPainel), a lombada puxada some na borda da
   * folha (D52). Sem isso, no celular ela passava da borda da tela, o documento ficava mais largo que
   * ela (390 → 568px) e o navegador abortava a troca de página ("Viewport size changed"): a página nova
   * entrava num corte seco. O clip só vale para o lado (a pilha que tomba e a sombra da folha ficam
   * inteiras) e não cria rolagem. Na tela grande, a lombada passa da borda do painel de propósito.
   */
  @media (max-width: 1099.98px) {
    .painel-home {
      overflow-x: clip;
    }
  }

  .titulo-bloco {
    margin: 0 0 14px;
    font-family: var(--font-livro);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.005em;
  }

  /* ---------- pilha de livros deitados ---------- */

  /*
   * A lombada em pé da estante (livro.css), girada 90° para a esquerda: o ícone fica na ponta
   * esquerda e o título e o número passam a correr na horizontal. --u-comprimento faz o livro mais
   * longo com o recuo caber na largura da pilha, com o teto da estante da home (0,42px). Deitado, o
   * livro é mais fino que a lombada em pé (D46): a espessura (--u) é 62% do comprimento, e o título e
   * o número têm corpo próprio, de uns 10px, para continuar legíveis.
   */
  .pilha {
    container-type: inline-size;
  }

  .pilha ol {
    --u-comprimento: min(0.42px, 100cqw / 680);
    --u: calc(var(--u-comprimento) * 0.62);
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* O espaço em cima da pilha, do tamanho do livro aberto: é para lá que ele volta (D49). */
  .pilha ol[style*="--folga"] {
    padding-top: max(18px, calc(var(--folga) * var(--u)));
  }

  .deitado {
    position: relative;
    display: block;
    width: calc(var(--h) * var(--u-comprimento));
    height: max(18px, calc(var(--w) * var(--u)));
    margin-left: calc(var(--recuo) * var(--u-comprimento));
    border-radius: max(1.5px, calc(3 * var(--u)));
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
    view-transition-class: livro;
  }

  /* O puxado passa por cima do conteúdo ao lado; o que está no ar, por cima dos outros livros. */
  .pilha li {
    position: relative;
  }

  .pilha li.no-ar {
    z-index: 2;
  }

  .deitado > .lombada-visual {
    position: absolute;
    top: 100%;
    left: 0;
    width: max(18px, calc(var(--w) * var(--u)));
    height: calc(var(--h) * var(--u-comprimento));
    transform-origin: 0 0;
    rotate: -90deg;
    /* Girada, a sombra da lombada cai para baixo, como a de um livro deitado. */
    box-shadow: -1px 0 0 rgb(0 0 0 / 0.18);
  }

  /* O título e o número, com corpo próprio (a espessura encolheu, eles não). */
  .deitado > .lombada-visual :global(.titulo-lombada) {
    top: calc(100% - var(--papel-h) + 14 * var(--u-comprimento));
    font-size: calc(28 * var(--u-comprimento));
    line-height: calc(29 * var(--u-comprimento));
  }

  .deitado > .lombada-visual :global(.numero-lombada) {
    bottom: calc(18 * var(--u-comprimento));
    font-size: calc(26 * var(--u-comprimento));
  }

  /* Foco só para quem navega pelo teclado, discreto (D39). */
  .deitado:focus-visible {
    outline: 1.5px solid color-mix(in oklab, var(--acento), transparent 35%);
    outline-offset: 3px;
  }

  /* A divisão do papel acompanha o comprimento (a revista, toda de papel, tem a regra dela). */
  .deitado > .lombada-visual:not(.de-serie) {
    --papel-h: calc(400 * var(--u-comprimento));
  }

  /* A revista: o emblema cabe na espessura, e o título fica mais perto dele. */
  .deitado > .lombada-visual.de-serie :global(.titulo-lombada) {
    top: calc(110 * var(--u-comprimento));
    font-size: calc(27 * var(--u-comprimento));
  }

  .deitado > .lombada-visual.de-serie :global(.emblema-lombada) {
    top: calc(22 * var(--u-comprimento));
    height: calc(70 * var(--u-comprimento));
  }

  /* Com o GSAP no ar (D40), é ele que move os livros da pilha. */
  .pilha.viva .deitado {
    transition: none;
  }

  /* Uma série só: o lugar vazio da prateleira, com um texto curto. */
  .pilha-vazia {
    margin: 0 0 6px;
    padding: 22px 4px 8px;
    font-family: var(--font-livro-italico);
    font-style: italic;
    font-size: 16px;
    font-variation-settings: "opsz" 16;
    color: var(--ink-2);
  }

  /* A prateleira sob a pilha: 5 na cor da estante e 2 de borda. */
  .tampo {
    height: max(4px, calc(12 * var(--u, 0.4px)));
    border-bottom: 2px solid var(--tabua-borda);
    background: var(--tabua);
    --u: min(0.42px, 100cqw / 680);
  }

  @media (hover: hover) {
    .deitado:hover {
      transform: translateX(8px);
    }
  }

  /* Na troca pela pilha e chegando por ela (D52): o livro sob o mouse só sai quando o mouse andar. */
  .pilha.quieta .deitado:hover {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .deitado {
      transition: none;
    }

    .deitado:hover {
      transform: none;
    }
  }

  /* ---------- RSS ---------- */

  .rss {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .rss:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .rss svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<style is:global>
  /*
   * A camada dos voos da troca pela pilha (D52): por cima da página e da pilha, por baixo do cabeçalho
   * (z-index 30). O livro 3D voa aqui, fora do palco (que o cortaria) e por cima do painel.
   */
  .voo-da-pilha {
    position: fixed;
    inset: 0;
    z-index: 25;
    pointer-events: none;
  }

  /* A sombra do livro no ar (sombra(), no script): uma mancha de 100px, movida e esticada por transform. */
  .voo-da-pilha > .sombra-do-voo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.08) 60%, transparent);
    opacity: 0;
    will-change: transform, opacity;
  }

  /*
   * A chegada pela troca da pilha (tipo "pilha", posto pelo script da ordem da pilha): a página antiga
   * já estava montada como a nova no topo (o livro no lugar, a cor e o texto dele) e sem os artigos.
   * Nada se move. Primeiro, as imagens da página antiga ficam à vista, e as da nova escondidas, até as
   * fontes da nova ficarem prontas (data-pilha-pronta, posto pelo script; no primeiro quadro, nenhuma
   * está). Aí a página esmaece de uma na outra (o que é igual fica igual, e os artigos chegam), e os
   * que têm nome próprio (o cabeçalho, o traço do menu, o livro do topo, que continua o giro, e o
   * guardado na pilha) trocam de uma vez, sem esmaecer. Antes (D51), a página nova subia 18px e a
   * antiga 6px: a tela inteira tremia no fim da troca (B01, B09).
   */
  :root:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-group(*) {
    animation: none;
  }

  :root:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-old(*) {
    animation: pilha-segura 2s both;
  }

  :root:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-new(*) {
    animation: pilha-espera 2s both;
  }

  :root[data-pilha-pronta]:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-old(*) {
    animation: pilha-sai 1ms both;
  }

  :root[data-pilha-pronta]:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-new(*) {
    animation: none;
  }

  :root[data-pilha-pronta]:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-old(root) {
    animation: pilha-sai 0.34s cubic-bezier(0.33, 0, 0.2, 1) both;
  }

  :root[data-pilha-pronta]:not(.trocando-tema):active-view-transition-type(pilha)::view-transition-new(root) {
    animation: pilha-surge 0.34s cubic-bezier(0.33, 0, 0.2, 1) both;
  }

  /*
   * As duas imagens da página somam (plus-lighter), num grupo isolado: onde são iguais, a página fica
   * como está. Quem punha isso era a animação padrão do navegador, que as regras acima trocam; sem
   * isso, a página inteira clareava no meio da troca (as duas a meia opacidade sobre o fundo).
   */
  :root:active-view-transition-type(pilha)::view-transition-image-pair(root) {
    isolation: isolate;
  }

  :root:active-view-transition-type(pilha)::view-transition-old(root),
  :root:active-view-transition-type(pilha)::view-transition-new(root) {
    mix-blend-mode: plus-lighter;
  }

  @keyframes pilha-segura {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes pilha-espera {
    from,
    to {
      opacity: 0;
    }
  }

  @keyframes pilha-sai {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @keyframes pilha-surge {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
