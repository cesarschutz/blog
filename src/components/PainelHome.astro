---
/**
 * Painel ao lado dos artigos (D28), inspirado na barra lateral do blog atual: séries, categorias,
 * tags e RSS. Séries e categorias são os livros deitados e empilhados: a mesma lombada da estante
 * (MioloLombada, com as mesmas proporções, ícone, tipografia e contagem), só que deitada (D39). A
 * pilha escala com a largura (container query), e o volume 1 fica embaixo. O número é o total de
 * artigos e some quando não há nenhum. Ao passar o mouse, o livro sai um pouco da pilha. Na tela
 * larga, o painel fica parado enquanto a lista rola (o `sticky` está em ComPainel.astro).
 *
 * Transição (D29): o livro em pé do topo da página do livro tem `view-transition-name` igual ao id
 * do livro; o script do <head> (Base.astro) dá o mesmo nome, em `data-vt`, só ao livro da pilha que
 * leva à página nova ou que veio da anterior, e o navegador leva um ao outro. Na página do próprio
 * livro (`atual`), ele continua na pilha, escurecido, sem nome (D39).
 */
import { ICONES } from "../lib/icones";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import MioloLombada from "./MioloLombada.astro";
import { urlTag, type Grupo } from "../lib/posts";
import { url } from "../lib/url";
import "../styles/livro.css";

interface Props {
  livros: Livro[];
  tags: Grupo[];
  /** Id do livro que está aberto na página (o da categoria atual). */
  atual?: string;
}

const { livros, tags, atual } = Astro.props;
// De cima para baixo: o último volume em cima e o volume 1 embaixo.
const pilhas = [
  { titulo: "Séries", livros: livros.filter((l) => l.serie) },
  { titulo: "Categorias", livros: livros.filter((l) => !l.serie).sort((a, b) => (b.volume ?? 0) - (a.volume ?? 0)) },
].filter((p) => p.livros.length > 0);
// O deslocamento de cada livro na pilha (livros.json), em unidades da lombada em pé.
const estilo = (l: Livro) =>
  [coresDoLivroCss(l), `--w:${l.emPe.largura}`, `--h:${l.emPe.altura}`, `--recuo:${10 + l.deitada.deslocamento}`].join(";");
const rotulo = (l: Livro) => {
  const n = l.posts.length;
  if (l.serie) return `${l.nome}, ${n} ${n === 1 ? "parte" : "partes"}`;
  return n === 0 ? `${l.nome}, ainda sem artigos` : `${l.nome}, ${n} ${n === 1 ? "artigo" : "artigos"}`;
};
const TAGS_NO_PAINEL = 10;
---

<aside class="painel-home folha" aria-label="Séries, categorias e tags">
  {
    pilhas.map((p) => (
      <section class="bloco">
        <h2 class="titulo-bloco">{p.titulo}</h2>
        <div class="pilha">
          <ol>
            {p.livros.map((l) => (
              <li>
                <a
                  class:list={["deitado", { retirado: l.id === atual }]}
                  href={l.href}
                  aria-label={rotulo(l)}
                  aria-current={l.id === atual ? "page" : undefined}
                  data-vt={l.id === atual ? undefined : l.id}
                  style={estilo(l)}
                >
                  <span class:list={["lombada-visual", { "de-serie": l.serie }]}>
                    <MioloLombada livro={l} />
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <div class="tampo" aria-hidden="true" />
        </div>
      </section>
    ))
  }
  <section class="bloco">
    <h2 class="titulo-bloco">Tags</h2>
    <ul class="tags">
      {
        tags.slice(0, TAGS_NO_PAINEL).map((t) => (
          <li>
            <a class="pilula" href={urlTag(t.nome)}>
              {t.nome}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="mais" href={url("/tags/")}
      >Todas as tags <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} /></a
    >
  </section>
  <a class="rss" href={url("/rss.xml")}
    ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.rss} />Assinar via RSS</a
  >
</aside>

<style>
  .painel-home {
    padding: 22px 18px 18px;
  }

  .bloco + .bloco {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .titulo-bloco {
    margin: 0 0 14px;
    font-family: var(--font-livro);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.005em;
  }

  /* ---------- pilha de livros deitados ---------- */

  /*
   * A lombada em pé da estante (livro.css), girada 90° para a esquerda: o ícone fica na ponta
   * esquerda e o título e o número passam a correr na horizontal. --u (px por unidade) faz o livro
   * mais longo com o recuo caber na largura da pilha, com o teto da estante da home (0,42px).
   */
  .pilha {
    container-type: inline-size;
  }

  .pilha ol {
    --u: min(0.42px, 100cqw / 680);
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deitado {
    position: relative;
    display: block;
    width: calc(var(--h) * var(--u));
    height: calc(var(--w) * var(--u));
    margin-left: calc(var(--recuo) * var(--u));
    border-radius: max(1.5px, calc(3 * var(--u)));
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.75, 0.2, 1),
      opacity 0.25s,
      filter 0.25s;
    view-transition-class: livro;
  }

  .deitado > .lombada-visual {
    position: absolute;
    top: 100%;
    left: 0;
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    transform-origin: 0 0;
    rotate: -90deg;
    /* Girada, a sombra da lombada cai para baixo, como a de um livro deitado. */
    box-shadow: -1px 0 0 rgb(0 0 0 / 0.18);
  }

  /* Foco só para quem navega pelo teclado, discreto (D39). */
  .deitado:focus-visible {
    outline: 1.5px solid color-mix(in oklab, var(--acento), transparent 35%);
    outline-offset: 3px;
  }

  /* O livro da página atual continua na pilha, escurecido, como os não escolhidos do filtro (D39). */
  .retirado {
    opacity: 0.4;
    filter: saturate(0.5);
  }

  /* A prateleira sob a pilha: 5 na cor da estante e 2 de borda. */
  .tampo {
    height: max(4px, calc(12 * var(--u, 0.4px)));
    border-bottom: 2px solid var(--tabua-borda);
    background: var(--tabua);
    --u: min(0.42px, 100cqw / 680);
  }

  @media (hover: hover) {
    .deitado:hover {
      transform: translateX(8px);
    }

    .retirado:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deitado {
      transition: none;
    }

    .deitado:hover {
      transform: none;
    }
  }

  /* ---------- tags e RSS ---------- */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags .pilula {
    min-height: 30px;
    padding: 3px 11px;
    font-size: 13.5px;
  }

  .mais,
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 14px;
    text-decoration: none;
  }

  .mais {
    margin-top: 14px;
    color: var(--acento);
  }

  .mais:hover,
  .rss:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .rss {
    display: flex;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  /* Abaixo de 1100px o painel vem depois da lista, logo antes do rodapé, que já tem o RSS (D37). */
  @media (max-width: 1099.98px) {
    .rss {
      display: none;
    }
  }

  .mais svg,
  .rss svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
