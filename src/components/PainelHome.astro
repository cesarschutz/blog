---
/**
 * Painel ao lado dos artigos recentes (pedido do Cesar em 24/09/2026, D28), inspirado na barra
 * lateral do blog atual: séries, categorias, tags e RSS. Séries e categorias são os mesmos livros da
 * estante, agora deitados e empilhados: o comprimento é a altura da lombada na estante, a espessura
 * acompanha o número de posts e o mais comprido fica embaixo. Todos ficam retos (o de cima torto
 * parecia voando); ao passar o mouse, o livro sai um pouco da pilha. Cada livro de categoria leva à
 * página da categoria (D29); o de série, por enquanto, à página que já existia. Na tela larga, o painel
 * fica parado enquanto a lista rola, como no blog atual (o `sticky` está em ComPainel.astro).
 *
 * Transição (D29): o livro em pé do topo da categoria tem `view-transition-name` igual ao id do
 * livro; o script do <head> (Base.astro) dá o mesmo nome, em `data-vt`, só ao livro da pilha que leva
 * à página nova ou que veio da anterior, e o navegador leva um ao outro. Na página da própria
 * categoria (`atual`), o livro saiu da pilha: fica só o contorno do lugar, sem nome.
 */
import { ICONES } from "../lib/icones";
import type { Livro } from "../lib/estante";
import { urlTag, type Grupo } from "../lib/posts";
import { url } from "../lib/url";

interface Props {
  livros: Livro[];
  tags: Grupo[];
  /** Id do livro que está aberto na página (o da categoria atual). */
  atual?: string;
}

const { livros, tags, atual } = Astro.props;
/** De cima para baixo: o mais curto em cima, o mais comprido embaixo, como numa pilha de verdade. */
const empilhar = (lista: Livro[]) => [...lista].sort((a, b) => a.altura - b.altura);
const pilhas = [
  { titulo: "Séries", livros: empilhar(livros.filter((l) => l.serie)) },
  { titulo: "Categorias", livros: empilhar(livros.filter((l) => !l.serie)) },
].filter((p) => p.livros.length > 0);
const MAIOR = Math.max(...livros.map((l) => l.altura));
// Recuo de cada livro, para a pilha não ficar alinhada demais (em px, de cima para baixo).
const RECUOS = [7, 1, 11, 4, 9, 2, 6, 0];
const estilo = (l: Livro, i: number) =>
  [
    `--tecido:${l.tecido}`,
    `--texto:${l.texto}`,
    `--comprimento:${((l.altura / MAIOR) * 88).toFixed(1)}%`,
    `--espessura:${Math.round(l.largura * 0.55)}px`,
    `--recuo:${RECUOS[i % RECUOS.length]}px`,
    l.fita ? `--fita:${l.fita}` : "",
  ]
    .filter(Boolean)
    .join(";");
const rotulo = (l: Livro) =>
  l.serie
    ? `Série ${l.nome}, ${l.posts.length} partes`
    : `${l.nome}, ${l.posts.length} ${l.posts.length === 1 ? "artigo" : "artigos"}`;
const TAGS_NO_PAINEL = 10;
---

<aside class="painel-home folha" aria-label="Séries, categorias e tags">
  {
    pilhas.map((p) => (
      <section class="bloco">
        <h2 class="titulo-bloco">{p.titulo}</h2>
        <ol class="pilha">
          {p.livros.map((l, i) => (
            <li>
              <a
                class:list={["deitado", { "de-serie": l.serie, retirado: l.id === atual }]}
                href={l.href}
                aria-label={rotulo(l)}
                aria-current={l.id === atual ? "page" : undefined}
                data-vt={l.id === atual ? undefined : l.id}
                style={estilo(l, i)}
              >
                <span class="nome" aria-hidden="true">
                  {l.nome}
                </span>
                <span class="conta" aria-hidden="true">
                  {l.posts.length}
                </span>
                {l.fita && <span class="fita" aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ol>
        <div class="tampo" aria-hidden="true" />
      </section>
    ))
  }
  <section class="bloco">
    <h2 class="titulo-bloco">Tags</h2>
    <ul class="tags">
      {
        tags.slice(0, TAGS_NO_PAINEL).map((t) => (
          <li>
            <a class="pilula" href={urlTag(t.nome)} data-busca-tag={t.nome}>
              {t.nome}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="mais" href={url("/tags/")}
      >Todas as tags <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.seta} /></a
    >
  </section>
  <a class="rss" href={url("/rss.xml")}
    ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONES.rss} />Assinar via RSS</a
  >
</aside>

<style>
  .painel-home {
    padding: 22px 22px 18px;
  }

  .bloco + .bloco {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .titulo-bloco {
    margin: 0 0 14px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- pilha de livros ---------- */

  .pilha {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0 0 0 4px;
    list-style: none;
  }

  /* A lombada, deitada: faixas nas duas pontas, o nome na horizontal e a contagem à direita. */
  .deitado {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: var(--comprimento);
    height: var(--espessura);
    margin-left: var(--recuo);
    padding: 0 14px 0 18px;
    border-radius: 2px 3px 3px 2px;
    background-color: var(--tecido);
    background-image:
      linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 40%, rgb(0 0 0 / 0.16)),
      var(--tecido-trama);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.22);
    color: var(--texto);
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
    view-transition-class: livro;
  }

  .deitado::before,
  .deitado::after {
    content: "";
    position: absolute;
    top: 18%;
    bottom: 18%;
    width: 3px;
    border-left: 1px solid currentColor;
    border-right: 1px solid currentColor;
    opacity: 0.55;
  }

  .deitado::before {
    left: 7px;
  }

  .deitado::after {
    right: 5px;
  }

  .nome {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: min(14px, 5.6cqw);
    letter-spacing: 0.02em;
    line-height: 1.35; /* com 1, o overflow cortava o "ç" e o "q" */
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .conta {
    flex: none;
    font-family: var(--font-ui);
    font-size: 12px;
    font-variant-numeric: lining-nums;
    opacity: 0.85;
  }

  /* Série: couro, nervuras mais grossas nas pontas, nome em itálico e a fita saindo pela ponta. */
  .de-serie {
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 45%, rgb(0 0 0 / 0.3));
  }

  .de-serie::before,
  .de-serie::after {
    top: 0;
    bottom: 0;
    width: 5px;
    border: 0;
    opacity: 1;
    background: rgb(0 0 0 / 0.28);
    box-shadow:
      1px 0 0 rgb(255 255 255 / 0.12),
      -1px 0 0 rgb(255 255 255 / 0.08);
  }

  .de-serie .nome {
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .fita {
    position: absolute;
    top: 58%;
    right: -15px;
    width: 18px;
    height: 7px;
    background: var(--fita);
    clip-path: polygon(0 0, 100% 0, 78% 50%, 100% 100%, 0 100%);
  }

  /* Livro retirado da pilha (está aberto no topo da página): fica só o contorno do lugar vazio. */
  .retirado {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--ink-3);
  }

  .retirado::before,
  .retirado::after,
  .retirado .fita {
    opacity: 0;
  }

  .retirado .nome,
  .retirado .conta {
    opacity: 0.8;
  }

  /* O tampo onde a pilha está apoiada: a mesma madeira da estante. */
  .tampo {
    height: 5px;
    margin-top: 1px;
    border-bottom: 2px solid var(--tabua-borda);
    border-radius: 1px 1px 2px 2px;
    background: var(--tabua);
  }

  @media (hover: hover) {
    .deitado:hover {
      transform: translateX(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deitado {
      transition: none;
    }

    .deitado:hover {
      transform: none;
    }
  }

  /* ---------- tags e RSS ---------- */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags .pilula {
    min-height: 30px;
    padding: 3px 11px;
    font-size: 13.5px;
  }

  .mais,
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 14px;
    text-decoration: none;
  }

  .mais {
    margin-top: 14px;
    color: var(--acento);
  }

  .mais:hover,
  .rss:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .rss {
    display: flex;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
