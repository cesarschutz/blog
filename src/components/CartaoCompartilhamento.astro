---
/**
 * Imagem de compartilhamento, 1200×630 (briefing §5.4, protótipo "A + C", D26): sobre a folha, título
 * e subtítulo à esquerda, o recorte "og" da ilustração do post à direita, no painel tingido pela cor
 * da categoria, nome do blog e categoria. Sem ilustração, o texto ocupa a largura toda. A versão
 * padrão (páginas que não são post) mostra a estante.
 */
import Chip from "./Chip.astro";
import Estante from "./Estante.astro";
import Ilustracao from "./Ilustracao.astro";
import { temIlustracao } from "../lib/ilustracoes";
import { claro } from "../styles/tokens";
import { tituloComQuebras } from "../lib/formato";
import type { Livro } from "../lib/estante";

interface Props {
  titulo: string;
  subtitulo?: string;
  rotulo?: string;
  cor?: string;
  /** Post cuja ilustração vai à direita. */
  slug?: string;
  /** Versão padrão: a estante à direita. */
  livros?: Livro[];
}

const { titulo, subtitulo, rotulo, cor = claro["ink-2"], slug, livros } = Astro.props;
const comDesenho = Boolean(slug && temIlustracao(slug));
const comArte = comDesenho || Boolean(livros);
// Ponto de partida pelo tamanho do título; o script abaixo ainda encolhe o que não couber.
const corpoDoTitulo = titulo.length > 60 ? 54 : titulo.length > 42 ? 62 : titulo.length > 28 ? 70 : 77;
---

<div class:list={["cartao-og", { "com-arte": comArte }]} data-cartao-og>
  <div class="texto">
    <span class="blog">Cesar Schutz</span>
    <span class="titulo" style={`font-size:${corpoDoTitulo}px`} set:html={tituloComQuebras(titulo)} />
    {subtitulo && <span class="subtitulo">{subtitulo}</span>}
    {
      rotulo && (
        <span class="rotulo">
          <Chip cor={cor} nome={rotulo} />
        </span>
      )
    }
  </div>
  {
    comDesenho && (
      <div class="arte painel" style={`--cor:${cor}`}>
        <Ilustracao slug={slug!} recorte="og" cor={cor} tamanho="cartao" decorativa />
      </div>
    )
  }
  {
    !comDesenho && livros && (
      <div class="arte estante-og">
        <Estante livros={livros} />
      </div>
    )
  }
</div>

<script is:inline>
  // Com as fontes carregadas, o título encolhe até caber: nenhuma palavra passa para o painel e ele
  // não encosta no nome do blog. scripts/og.mjs espera o data-ajustado para fotografar.
  (function () {
    var cartao = document.querySelector("[data-cartao-og]");
    var texto = cartao.querySelector(".texto");
    var blog = cartao.querySelector(".blog");
    var titulo = cartao.querySelector(".titulo");
    function naoCabe() {
      var folga = titulo.getBoundingClientRect().top - blog.getBoundingClientRect().bottom;
      return titulo.scrollWidth > titulo.clientWidth + 1 || texto.scrollHeight > texto.clientHeight + 1 || folga < 36;
    }
    document.fonts.ready.then(function () {
      var corpo = parseFloat(titulo.style.fontSize);
      while (naoCabe() && corpo > 40) {
        corpo -= 2;
        titulo.style.fontSize = corpo + "px";
      }
      cartao.setAttribute("data-ajustado", "");
    });
  })();
</script>

<style>
  .cartao-og {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 1200px;
    height: 630px;
    background: var(--paper-hi);
  }

  .cartao-og.com-arte {
    grid-template-columns: 56% 44%;
  }

  .texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 72px 36px 60px 72px;
  }

  .blog {
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
  }

  .titulo {
    margin-top: auto;
    font-family: var(--font-titulo);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .subtitulo {
    margin-top: 19px;
    font-size: 31px;
    line-height: 1.3;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .rotulo {
    margin-top: 36px;
    font-family: var(--font-ui);
    font-size: 26px;
  }

  /* O chip da categoria, maior, para a escala da imagem. */
  .rotulo :global(.chip) {
    gap: 14px;
  }

  .rotulo :global(.quadradinho) {
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  .arte {
    position: relative;
    min-width: 0;
  }

  /* O painel com o desenho, afastado das bordas da imagem e com o canto na escala dela. */
  .arte.painel {
    margin: 36px 36px 36px 0;
    border-radius: 22px;
  }

  .arte :global(.ilustracao) {
    position: absolute;
    inset: 0;
  }

  .estante-og {
    display: flex;
    align-items: flex-end;
    padding: 0 48px 96px 0;
  }

  .estante-og :global(.estante) {
    width: 100%;
  }
</style>
