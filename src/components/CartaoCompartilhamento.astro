---
/**
 * Imagem de compartilhamento, 1200×630 (briefing §5.4, protótipo "A + C"): título e subtítulo à
 * esquerda, o recorte "og" da ilustração do post à direita, nome do blog e categoria. Sem
 * ilustração, o texto ocupa a largura toda. A versão padrão (páginas que não são post) mostra a estante.
 */
import Chip from "./Chip.astro";
import Estante from "./Estante.astro";
import Ilustracao from "./Ilustracao.astro";
import { temIlustracao } from "../lib/ilustracoes";
import type { Livro } from "../lib/estante";

interface Props {
  titulo: string;
  subtitulo?: string;
  rotulo?: string;
  cor?: string;
  /** Post cuja ilustração vai à direita. */
  slug?: string;
  /** Versão padrão: a estante à direita. */
  livros?: Livro[];
}

const { titulo, subtitulo, rotulo, cor = "#56605E", slug, livros } = Astro.props;
const comDesenho = Boolean(slug && temIlustracao(slug));
const comArte = comDesenho || Boolean(livros);
// Título longo encolhe para caber na altura sem cortar.
const corpoDoTitulo = titulo.length > 60 ? 54 : titulo.length > 42 ? 62 : titulo.length > 28 ? 70 : 77;
---

<div class:list={["cartao-og", { "com-arte": comArte }]}>
  <div class="texto">
    <span class="blog">Cesar Schutz</span>
    <span class="titulo" style={`font-size:${corpoDoTitulo}px`}>{titulo}</span>
    {subtitulo && <span class="subtitulo">{subtitulo}</span>}
    {
      rotulo && (
        <span class="rotulo">
          <Chip cor={cor} nome={rotulo} />
        </span>
      )
    }
  </div>
  {
    comDesenho && (
      <div class="arte">
        <Ilustracao slug={slug!} recorte="og" cor={cor} tamanho="cartao" decorativa />
      </div>
    )
  }
  {
    !comDesenho && livros && (
      <div class="arte estante-og">
        <Estante livros={livros} />
      </div>
    )
  }
</div>

<style>
  .cartao-og {
    --fig-bg: var(--paper-hi);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 1200px;
    height: 630px;
    background: var(--paper-hi);
  }

  .cartao-og.com-arte {
    grid-template-columns: 56% 44%;
  }

  .texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 72px 36px 60px 72px;
  }

  .blog {
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
  }

  .titulo {
    margin-top: auto;
    font-family: var(--font-titulo);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .subtitulo {
    margin-top: 19px;
    font-size: 31px;
    line-height: 1.3;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .rotulo {
    margin-top: 36px;
    font-size: 26px;
    color: var(--ink-2);
  }

  /* O chip da categoria, maior, para a escala da imagem. */
  .rotulo :global(.chip) {
    gap: 14px;
  }

  .rotulo :global(.lombadinha) {
    width: 11px;
    height: 29px;
  }

  .arte {
    position: relative;
    min-width: 0;
  }

  .arte :global(.ilustracao) {
    position: absolute;
    inset: 0;
  }

  .estante-og {
    display: flex;
    align-items: flex-end;
    padding: 0 48px 96px 0;
  }

  .estante-og :global(.estante) {
    width: 100%;
  }
</style>
