---
/**
 * Lista de artigos com a alternância Lista / Cards. Na home (briefing §5.1): os recentes, com a
 * paginação embaixo, como no blog atual (D27): 12 lugares por página, e na primeira o destaque ocupa
 * dois (D52); nas páginas 2 em diante, o título vira "Artigos — página N". Na categoria (D29):
 * todos os artigos dela, sem paginação, com a contagem abaixo do título. O modo fica guardado no
 * navegador (`cs-post-view`, a mesma chave do blog atual) e é aplicado pelo script do <head>, sem
 * piscar. Sem JS, fica a lista e o seletor some. A lista fica numa folha só; nos cards, cada card é uma folha (D26).
 *
 * Com `destaque` (a primeira página da home, D52, C02), o primeiro artigo é o mais recente em destaque:
 * na lista, um item maior; nos cards, o lugar de dois cards quando a grade tem duas colunas ou mais.
 */
import ItemLista from "./ItemLista.astro";
import Cartao from "./Cartao.astro";
import Paginacao from "./Paginacao.astro";
import SeletorModo from "./SeletorModo.astro";
import type { Resumo } from "../lib/posts";

interface Props {
  posts: Resumo[];
  titulo: string;
  /** h1 nas páginas 2 em diante, que não têm a abertura da home. */
  nivel?: "h1" | "h2";
  /** Linha abaixo do título (na categoria, "7 artigos"). */
  subtitulo?: string;
  /** Paginação (na home); a categoria mostra tudo numa página só. */
  pagina?: { atual: number; ultima: number; anterior?: string; proxima?: string };
  /** O primeiro artigo em destaque (só na primeira página da home). */
  destaque?: boolean;
}

const { posts, titulo, nivel = "h2", subtitulo, pagina, destaque = false } = Astro.props;
const Titulo = nivel;
// Os títulos dos artigos ficam um nível abaixo do título da seção (h1 nas páginas 2 em diante).
const nivelDoItem = nivel === "h1" ? "h2" : "h3";
---

<section class="recentes" aria-labelledby="recentes-titulo">
  <div class="topo-recentes">
    <div>
      <Titulo id="recentes-titulo" class="titulo-secao">{titulo}</Titulo>
      {subtitulo && <p class="subtitulo-secao">{subtitulo}</p>}
    </div>
    <SeletorModo />
  </div>
  <ol class="lista-modo lista-artigos folha">
    {posts.map((p, i) => <ItemLista post={p} nivel={nivelDoItem} destaque={destaque && i === 0} />)}
  </ol>
  <template data-cartoes>
    <ul class="cartoes-modo">
      {posts.map((p, i) => <Cartao post={p} nivel={nivelDoItem} destaque={destaque && i === 0} />)}
    </ul>
  </template>
  <script is:inline>
    // Cards num <template> (D37): só viram DOM se o leitor escolheu Cards (o <head> já marcou).
    document.documentElement.dataset.postView === "cards" && document.currentScript.previousElementSibling.replaceWith(document.currentScript.previousElementSibling.content);
  </script>
  {pagina && <Paginacao {...pagina} />}
</section>


<style>
  .recentes {
    min-width: 0;
  }

  .topo-recentes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 16px;
  }

  .topo-recentes .titulo-secao {
    margin: 0;
  }

  /* O card em destaque mede a grade para saber se cabe no lugar de dois (Cartao.astro). */
  .cartoes-modo {
    container: cartoes / inline-size;
  }

  .subtitulo-secao {
    margin: 4px 0 0;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

</style>
