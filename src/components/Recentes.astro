---
/**
 * Lista de artigos com a alternância Lista / Cards. Na home (briefing §5.1): os recentes, sem repetir
 * o destaque, 12 por página com a paginação embaixo, como no blog atual (D27); nas páginas 2 em
 * diante, o título vira "Artigos — página N". Na categoria (D29): todos os artigos dela, sem
 * paginação, com a contagem abaixo do título. O modo fica guardado no navegador (`cs-post-view`, a
 * mesma chave do blog atual) e é aplicado pelo script do <head>, sem piscar. Sem JS, fica a lista e
 * o seletor some. A lista fica numa folha só; nos cards, cada card é uma folha (D26).
 */
import ItemLista from "./ItemLista.astro";
import Cartao from "./Cartao.astro";
import Paginacao from "./Paginacao.astro";
import type { Resumo } from "../lib/posts";

interface Props {
  posts: Resumo[];
  titulo: string;
  /** h1 nas páginas 2 em diante, que não têm a abertura da home. */
  nivel?: "h1" | "h2";
  /** Linha abaixo do título (na categoria, "7 artigos"). */
  subtitulo?: string;
  /** Paginação (na home); a categoria mostra tudo numa página só. */
  pagina?: { atual: number; ultima: number; anterior?: string; proxima?: string };
}

const { posts, titulo, nivel = "h2", subtitulo, pagina } = Astro.props;
const Titulo = nivel;
---

<section class="recentes" aria-labelledby="recentes-titulo">
  <div class="topo-recentes">
    <div>
      <Titulo id="recentes-titulo" class="titulo-secao">{titulo}</Titulo>
      {subtitulo && <p class="subtitulo-secao">{subtitulo}</p>}
    </div>
    <div class="modo" role="group" aria-label="Modo de exibição" data-modo hidden>
      <button type="button" data-valor="list">Lista</button>
      <button type="button" data-valor="cards">Cards</button>
    </div>
  </div>
  <ol class="lista-recentes lista-artigos folha">
    {posts.map((p) => <ItemLista post={p} />)}
  </ol>
  <ul class="cartoes-recentes">
    {posts.map((p) => <Cartao post={p} />)}
  </ul>
  {pagina && <Paginacao {...pagina} />}
</section>

<script>
  const CHAVE = "cs-post-view";
  const seletor = document.querySelector<HTMLElement>("[data-modo]");
  if (seletor) {
    const raiz = document.documentElement;
    const botoes = [...seletor.querySelectorAll<HTMLButtonElement>("button")];
    const marcar = () => {
      const atual = raiz.dataset.postView === "cards" ? "cards" : "list";
      botoes.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.valor === atual)));
    };
    botoes.forEach((b) =>
      b.addEventListener("click", () => {
        raiz.dataset.postView = b.dataset.valor!;
        try {
          localStorage.setItem(CHAVE, b.dataset.valor!);
        } catch {
          // Sem armazenamento: o modo vale só nesta página.
        }
        marcar();
      }),
    );
    marcar();
    seletor.hidden = false;
  }
</script>

<style>
  .recentes {
    min-width: 0;
  }

  .topo-recentes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 16px;
  }

  .topo-recentes .titulo-secao {
    margin: 0;
  }

  .subtitulo-secao {
    margin: 4px 0 0;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-2);
  }

  .modo {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-hi);
    font-family: var(--font-ui);
  }

  .modo button {
    min-height: 34px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 14px;
    cursor: pointer;
  }

  .modo button:hover {
    color: var(--ink);
  }

  .modo button[aria-pressed="true"] {
    background: var(--acento);
    color: var(--sobre-acento);
  }

  .cartoes-recentes {
    display: none;
    grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr));
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(:root[data-post-view="cards"]) .lista-recentes {
    display: none;
  }

  :global(:root[data-post-view="cards"]) .cartoes-recentes {
    display: grid;
  }
</style>
