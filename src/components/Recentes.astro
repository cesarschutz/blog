---
/**
 * Artigos recentes da home (briefing §5.1), sem repetir o destaque. Alternância Lista / Cards
 * guardada no navegador (`cs-post-view`, a mesma chave do blog atual); o modo é aplicado pelo
 * script do <head>, sem piscar. Sem JS, fica a lista e o seletor some.
 */
import ItemLista from "./ItemLista.astro";
import Cartao from "./Cartao.astro";
import type { Resumo } from "../lib/posts";
import { url } from "../lib/url";

interface Props {
  posts: Resumo[];
  total: number;
}

const { posts, total } = Astro.props;
---

<section class="recentes wrap" aria-labelledby="recentes-titulo">
  <div class="topo-recentes">
    <h2 id="recentes-titulo" class="titulo-secao">Artigos recentes</h2>
    <div class="modo" role="group" aria-label="Modo de exibição" data-modo hidden>
      <button type="button" data-valor="list">Lista</button>
      <button type="button" data-valor="cards">Cards</button>
    </div>
  </div>
  <ol class="lista-recentes">
    {posts.map((p) => <ItemLista post={p} />)}
  </ol>
  <ul class="cartoes-recentes">
    {posts.map((p) => <Cartao post={p} />)}
  </ul>
  <p class="todos"><a href={url("/archive/")}>Todos os {total} artigos</a></p>
</section>

<script>
  const CHAVE = "cs-post-view";
  const seletor = document.querySelector<HTMLElement>("[data-modo]");
  if (seletor) {
    const raiz = document.documentElement;
    const botoes = [...seletor.querySelectorAll<HTMLButtonElement>("button")];
    const marcar = () => {
      const atual = raiz.dataset.postView === "cards" ? "cards" : "list";
      botoes.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.valor === atual)));
    };
    botoes.forEach((b) =>
      b.addEventListener("click", () => {
        raiz.dataset.postView = b.dataset.valor!;
        try {
          localStorage.setItem(CHAVE, b.dataset.valor!);
        } catch {
          // Sem armazenamento: o modo vale só nesta página.
        }
        marcar();
      }),
    );
    marcar();
    seletor.hidden = false;
  }
</script>

<style>
  .recentes {
    padding-top: 64px;
  }

  .topo-recentes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 6px;
  }

  .topo-recentes .titulo-secao {
    margin: 0;
  }

  .modo {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .modo button {
    min-height: 34px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 14.5px;
    cursor: pointer;
  }

  .modo button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .lista-recentes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lista-recentes :global(.item:first-child) {
    border-top: 0;
  }

  .cartoes-recentes {
    display: none;
    grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr));
    gap: 28px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  :global(:root[data-post-view="cards"]) .lista-recentes {
    display: none;
  }

  :global(:root[data-post-view="cards"]) .cartoes-recentes {
    display: grid;
  }

  .todos {
    margin: 18px 0 0;
  }
</style>
