---
/**
 * Estante da home (briefing §5.1, D30): um livro por categoria, na ordem dos volumes da coleção, o
 * aparador e os livros de série, sobre a prateleira (docs/capas/CAPAS.md). Cada lombada é um link
 * para a página da categoria (funciona sem JS); com JS, abre o livro na gaveta (Gaveta.astro). O
 * último livro da coleção fica inclinado, apoiado no alto do aparador.
 */
import MioloLombada from "./MioloLombada.astro";
import { coresDoLivroCss, type Livro } from "../lib/estante";
import "../styles/estante.css";

interface Props {
  livros: Livro[];
}

const { livros } = Astro.props;
const categorias = livros.filter((l) => !l.serie);
const series = livros.filter((l) => l.serie);
const estilo = (l: Livro) => `${coresDoLivroCss(l)};--w:${l.emPe.largura};--h:${l.emPe.altura}`;
// Largura da estante em unidades da referência, pelas medidas de estante.css: 16 de respiro de cada
// lado, 6 entre os livros e o aparador (12 de largura, 43 de margem à esquerda para o livro
// inclinado encostar no alto dele e 25 à direita).
const itens = livros.length + 1;
const natural = Math.ceil(2 * 16 + livros.reduce((soma, l) => soma + l.emPe.largura, 0) + 6 * (itens - 1) + 43 + 12 + 25);
const rotulo = (l: Livro) => {
  const n = l.posts.length;
  if (l.serie) return `Série ${l.nome}, ${n} ${n === 1 ? "parte" : "partes"}`;
  return n === 0 ? `Livro ${l.nome}, ainda sem artigos` : `Livro ${l.nome}, ${n} ${n === 1 ? "artigo" : "artigos"}`;
};
---

<div class="estante" data-estante style={`--natural:${natural}`}>
  <div class="prateleira-livros" role="group" aria-label="Estante: um livro por categoria e um por série">
    {
      categorias.map((l, i) => (
        <a
          class:list={["lombada", "lombada-visual", { inclinada: i === categorias.length - 1 }]}
          href={l.href}
          data-livro={l.id}
          aria-label={rotulo(l)}
          style={estilo(l)}
        >
          <MioloLombada livro={l} />
        </a>
      ))
    }
    <span class="aparador" aria-hidden="true"></span>
    {
      series.map((l) => (
        <a class="lombada lombada-visual de-serie" href={l.href} data-livro={l.id} aria-label={rotulo(l)} style={estilo(l)}>
          <MioloLombada livro={l} />
        </a>
      ))
    }
  </div>
  <div class="tabua" aria-hidden="true"></div>
</div>
