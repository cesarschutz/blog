---
/**
 * Estante (briefing §5.1, D30): um livro por categoria, na ordem dos volumes da coleção, o aparador e
 * os livros de série, sobre a prateleira (docs/capas/CAPAS.md). Cada lombada é um link para a página
 * do livro (funciona sem JS).
 *
 * - "estante" (a home): com JS, a lombada abre o livro na gaveta (Gaveta.astro), com o gesto de tirar
 *   o livro pela cabeça (D49, src/scripts/estante-gesto.ts); o último livro da coleção fica inclinado,
 *   apoiado no alto do aparador.
 * Com mouse, a estante responde a ele (D40, D49, src/scripts/estante-viva.ts): o livro tocado tomba um
 * nada para a frente e mostra mais da cabeça (o alto do livro, .cabeca), com a legenda embaixo.
 *
 * Cada lombada é um livro com volume (D57, prancha 07): a cabeça (as bordas das capas, o miolo e o
 * cabeceado) e os dois lados (as capas, .lado), em 3D, dentro da perspectiva da prateleira, com o olho
 * um pouco acima dos livros; os vizinhos se tapam de verdade.
 *
 * Rodada 3 (área 10): na estante de filtro, o chão é a sombra quente (os tokens --sombra-quente e
 * --halo-quente, como os livros 3D), sem a tábua cinza nem o aparador; a série fica depois de um vão.
 * O chão continua numa peça só (`.tabua.chao-estante`), para as linhas que trocam a prateleira.
 *
 * Linha 18 (estante moderna): uma luz de quadro de latão em cima de cada livro (`.luzes-estante`, uma
 * camada com os mesmos lugares da fileira), que acende ao chegar (estante-moderna.ts) e fica mais forte no
 * livro sob o mouse e no escolhido (nicho.css). Sem o aparador cinza: no lugar dele, só o vão; por isso,
 * nenhum livro fica inclinado.
 *
 * Rodada 4 (a versão final): a prateleira de madeira saiu. O chão é trocável pela prop `chao` (`data-chao` na
 * raiz), como na Colecao: o padrão é a lâmina de vidro curta (E3, vidro.css), com a luz embaixo da lombada sob
 * o mouse, com o foco e escolhida; "nicho" põe o nicho curto (nicho.css), que mora dentro da `.tabua`, preso
 * pelo pé e subindo até o alto da fileira. No filtro, a lombada escolhida (a que "saiu") deixa o abajur dela
 * e a luz embaixo acesos (P18-3).
 *
 * - "filtro" (o arquivo e as tags, D33): menor, sem o livro inclinado, só com os livros que têm
 *   artigos na página; com JS, cada lombada filtra a lista (ListaFiltrada.astro). O número da lombada
 *   é o que a página tem daquele livro. Embaixo da tábua, o pé (D52): a legenda do mouse e, no mesmo
 *   lugar, o que a página puser no slot (o rótulo do filtro e o livro escolhido); a legenda, quando
 *   aparece, cobre o rótulo.
 */
import MioloLombada from "./MioloLombada.astro";
import PontoDeLuz from "./PontoDeLuz.astro";
import { coresDoLivroCss, larguraDaEstante, type Livro } from "../lib/estante";
import "../styles/estante.css";
import "../styles/nicho.css";
import "../styles/vidro.css";

interface Props {
  livros: Livro[];
  modo?: "estante" | "filtro";
  /** O chão (rodada 4): "vidro" (o padrão, E3), "nicho", "nenhum" ou outra forma da amostra dos livros. */
  chao?: string;
}

const { livros, modo = "estante", chao = "vidro" } = Astro.props;
const filtro = modo === "filtro";
const categorias = livros.filter((l) => !l.serie);
const series = livros.filter((l) => l.serie);
const comAparador = !filtro || (categorias.length > 0 && series.length > 0);
const estilo = (l: Livro) => `${coresDoLivroCss(l)};--w:${l.emPe.largura};--h:${l.emPe.altura}`;
const natural = larguraDaEstante(livros, comAparador);
// Linha 18: a altura do livro mais alto (em unidades), para a camada das luzes ir da tábua até acima dele.
const altoMax = Math.max(...livros.map((l) => l.emPe.altura));
// Na estante de filtro, a lombada é um botão (aria-pressed): filtra a lista (D38). Nas outras, um link.
const Lombada = filtro ? "button" : "a";
// O rótulo começa pelo que está escrito na lombada (nome e número), para quem usa comando de voz (WCAG 2.5.3).
const rotulo = (l: Livro) => {
  const n = l.posts.length;
  if (filtro) return `${l.nome}, ${n} ${n === 1 ? "artigo" : "artigos"}`;
  return n === 0 ? `${l.nome}, ainda sem artigos` : `${l.nome}, ${n} ${n === 1 ? "artigo" : "artigos"}`;
};
// A contagem da legenda embaixo da estante (D40).
const conta = (l: Livro) => {
  const n = l.posts.length;
  if (n === 0) return "ainda sem artigos";
  return `${n} ${n === 1 ? "artigo" : "artigos"}`;
};
---

<div
  class:list={["estante", "estante-moderna", { "estante-filtro": filtro }]}
  data-estante={filtro ? undefined : ""}
  data-estante-filtro={filtro ? "" : undefined}
  data-chao={chao}
  data-luzes-ao-chegar
  data-onda-propria
  style={`--natural:${natural}`}
>
  <div
    class="prateleira-livros"
    role="group"
    aria-label={filtro ? undefined : "Estante: um livro por categoria e um por série"}
    aria-labelledby={filtro ? "rotulo-filtro" : undefined}
  >
    {
      categorias.map((l, i) => (
        <Lombada
          class:list={["lombada", "lombada-visual"]}
          href={filtro ? undefined : l.href}
          type={filtro ? "button" : undefined}
          aria-pressed={filtro ? "false" : undefined}
          data-livro={l.id}
          data-filtro={filtro ? l.id : undefined}
          data-nome={filtro ? l.nome : undefined}
          aria-label={rotulo(l)}
          data-titulo={l.nome}
          data-conta={conta(l)}
          style={estilo(l)}
        >
          <span class="cabeca" aria-hidden="true" />
          <span class="lado lado-tras" aria-hidden="true" />
          <span class="lado lado-frente" aria-hidden="true" />
          <MioloLombada livro={l} />
        </Lombada>
      ))
    }
    {comAparador && <span class="aparador" aria-hidden="true" />}
    {
      series.map((l) => (
        <Lombada
          class="lombada lombada-visual de-serie"
          href={filtro ? undefined : l.href}
          type={filtro ? "button" : undefined}
          aria-pressed={filtro ? "false" : undefined}
          data-livro={l.id}
          data-filtro={filtro ? l.id : undefined}
          data-nome={filtro ? l.nome : undefined}
          aria-label={rotulo(l)}
          data-titulo={l.nome}
          data-conta={conta(l)}
          style={estilo(l)}
        >
          <span class="cabeca" aria-hidden="true" />
          <span class="lado lado-tras" aria-hidden="true" />
          <span class="lado lado-frente" aria-hidden="true" />
          <MioloLombada livro={l} />
        </Lombada>
      ))
    }
  </div>
  {/* O chão das lombadas (`.chao-estante`): a altura do chão e do friso do nicho (rodada 4), que mora aqui
      dentro, preso pelo pé. As formas da amostra pintam outro chão aqui. */}
  <div class="tabua chao-estante" aria-hidden="true" style={`--alto-max:${altoMax}`}>
    <span class="nicho">
      <span class="nicho-parede"></span>
      <span class="nicho-teto"></span>
      <span class="nicho-chao"></span>
      <span class="nicho-friso"></span>
    </span>
    {/* Os abajures, um por livro, nos mesmos lugares da fileira (o vão do aparador também), numa camada presa
        ao chão: por cima do nicho e por baixo dos livros. */}
    <div class="luzes-estante">
      {categorias.map((l) => <span class="lugar-luz" style={`--w:${l.emPe.largura}`}><PontoDeLuz /></span>)}
      {comAparador && <span class="lugar-aparador" />}
      {series.map((l) => <span class="lugar-luz" style={`--w:${l.emPe.largura}`}><PontoDeLuz /></span>)}
    </div>
  </div>
  {
    filtro ? (
      <div class="pe-estante">
        <p class="legenda-estante" aria-hidden="true" data-legenda-estante />
        <slot />
      </div>
    ) : (
      <p class="legenda-estante" aria-hidden="true" data-legenda-estante />
    )
  }
</div>

<script>
  import { estanteViva } from "../scripts/estante-viva";
  // Linha 18: as luzes de quadro acendem ao chegar, e depois a onda de luz.
  import "../scripts/estante-moderna";

  for (const prateleira of document.querySelectorAll<HTMLElement>(".estante .prateleira-livros")) {
    // O toque na cabeça (mouse, foco); sem o repouso (H11: nada se mexe sozinho com a página parada).
    estanteViva(prateleira);
  }
</script>
