---
/**
 * Layout das páginas que viram imagem (compartilhamento, D10): só fontes, tokens do tema claro e as
 * definições do desenho, numa tela de 1200×630. scripts/og.mjs fotografa cada página depois do
 * build e apaga o HTML; nada disso fica publicado nem entra no sitemap ou na busca.
 */
import "@fontsource-variable/besley/wght.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "../styles/fontes.css";
import "../styles/base.css";
import "../styles/desenho.css";
import { cssDosTokens } from "../styles/tokens";
import { GRAO_CSS } from "../lib/livros-svg";
import DefinicoesDesenho from "../components/DefinicoesDesenho.astro";

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=1200" />
    <title>{titulo}</title>
    <style is:inline set:html={`${cssDosTokens()}:root{--grao:${GRAO_CSS}}`}></style>
  </head>
  <body class="imagem">
    <DefinicoesDesenho />
    <slot />
  </body>
</html>

<style>
  .imagem {
    width: 1200px;
    height: 630px;
    min-height: 0;
    overflow: hidden;
  }
</style>
