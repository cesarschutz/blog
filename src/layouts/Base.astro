---
/**
 * Layout de todas as páginas: head (SEO mínimo, fontes, tokens, anti-piscada), cabeçalho,
 * conteúdo e rodapé. Open Graph, JSON-LD e RSS entram na Fase 2.
 */
import { GRAO_CSS } from "../lib/livros-svg";
import "@fontsource-variable/besley/wght.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/jetbrains-mono/wght-italic.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "../styles/fontes.css";
import "../styles/base.css";
import "../styles/avisos.css";
import "../styles/desenho.css";
// Só as duas fontes do primeiro quadro são pré-carregadas (D5); itálico e código baixam quando usados.
// A da interface (IBM Plex Sans, D26) não: o CSS vem embutido no HTML, então ela é pedida logo, e a
// reserva ajustada (fontes.css) evita o deslocamento na troca.
import besley from "@fontsource-variable/besley/files/besley-latin-wght-normal.woff2?url";
import literata from "@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url";
import { claro, cssDosTokens, escuro } from "../styles/tokens";
import { url } from "../lib/url";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import Busca from "../components/Busca.astro";
import { ESTATISTICAS, TEXTOS } from "../data/site";
import DefinicoesDesenho from "../components/DefinicoesDesenho.astro";

interface Props {
  /** Título da página, sem o nome do site. A home não passa título. */
  titulo?: string;
  descricao?: string;
  /** Item do menu que fica marcado como atual. */
  atual?: "artigos" | "categorias" | "series" | "tags";
  /** Open Graph: "article" nos posts. */
  tipo?: "website" | "article";
  /** Imagem de compartilhamento (caminho interno, 1200×630, D10); por padrão, a do blog. */
  imagem?: string;
  /** Texto alternativo da imagem de compartilhamento. */
  imagemAlt?: string;
  publicado?: Date;
  modificado?: Date;
  /** Dados estruturados (BlogPosting nos posts, WebSite na home). */
  jsonLd?: Record<string, unknown>;
  /** Fora dos buscadores e sem canonical (a 404, que responde em qualquer endereço). */
  semIndice?: boolean;
}

const NOME = "Cesar Schutz";
const {
  titulo,
  descricao = TEXTOS.descricao,
  atual,
  tipo = "website",
  imagem = "/og/default.png",
  imagemAlt = "Cesar Schutz, blog: a estante com os livros das categorias",
  publicado,
  modificado,
  jsonLd,
  semIndice = false,
} = Astro.props;
const tituloDaAba = titulo ? `${titulo} · ${NOME}` : `${NOME} · Arquitetura e engenharia de software`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(url(imagem), Astro.site).href;
// A pré-visualização não pode concorrer com o blog atual nos buscadores.
const preVisualizacao = process.env.PREVIEW === "true";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Antes da primeira pintura: tema escolhido nesta visita (o site sempre abre no tema do
      // sistema, D33) e modo Lista/Cards da home. A escolha de tema antiga, guardada para sempre
      // (também pelo blog atual, com a mesma chave), é apagada, e as do som e das frases, que saíram (D39), também. O livro inclinado não tomba mais (D35).
      try {
        var raiz = document.documentElement;
        var tema = sessionStorage.getItem("cs-theme");
        if (tema === "light" || tema === "dark") raiz.dataset.theme = tema;
        localStorage.removeItem("cs-theme");
        localStorage.removeItem("cs-som");
        ["cs-frases", "cs-frase-ultima"].forEach(function (k) { localStorage.removeItem(k); });
        if (localStorage.getItem("cs-post-view") === "cards") raiz.dataset.postView = "cards";
      } catch (e) {}
    </script>
    <script is:inline>
      // Transição do livro (D29, D31): um livro da pilha do painel ou da grade de categorias e séries
      // voa até o livro aberto no topo da página dele. Só o livro que leva à página nova (ou que veio
      // da anterior) ganha o nome de transição (data-vt), para os outros não voarem junto; o livro
      // do topo já tem o nome no HTML. O link é o próprio elemento ou o <a> em volta dele.
      (function () {
        function livro(endereco) {
          var caminho = new URL(endereco).pathname;
          var livros = document.querySelectorAll("[data-vt]");
          for (var i = 0; i < livros.length; i++) {
            var link = livros[i].closest("a[href]");
            if (link && new URL(link.href).pathname === caminho) return livros[i];
          }
        }
        function nomear(endereco) {
          var l = endereco && livro(endereco);
          if (l) l.style.viewTransitionName = l.dataset.vt;
        }
        addEventListener("pageswap", function (e) {
          if (e.viewTransition && e.activation && e.activation.entry) nomear(e.activation.entry.url);
        });
        addEventListener("pagereveal", function (e) {
          if (e.viewTransition && window.navigation && navigation.activation && navigation.activation.from) {
            nomear(navigation.activation.from.url);
          }
        });
      })();
    </script>
    <style is:inline set:html={`${cssDosTokens()}:root{--grao:${GRAO_CSS}}`}></style>
    <title>{tituloDaAba}</title>
    <meta name="description" content={descricao} />
    {!semIndice && <link rel="canonical" href={canonico} />}
    {preVisualizacao ? <meta name="robots" content="noindex, nofollow" /> : semIndice && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={claro.paper} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={escuro.paper} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={NOME} href={url("/rss.xml")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <meta name="author" content={NOME} />
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={NOME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo ?? NOME} />
    <meta property="og:description" content={descricao} />
    {!semIndice && <meta property="og:url" content={canonico} />}
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagemAlt} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {modificado && <meta property="article:modified_time" content={modificado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preload" href={besley} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literata} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {
      ESTATISTICAS.goatcounter && (
        <script is:inline async data-goatcounter={`https://${ESTATISTICAS.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <DefinicoesDesenho />
    <Cabecalho atual={atual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <Busca />
  </body>
</html>
