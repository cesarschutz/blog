---
/**
 * Layout de todas as páginas: head (SEO mínimo, fontes, tokens, anti-piscada), cabeçalho,
 * conteúdo e rodapé. Open Graph, JSON-LD e RSS entram na Fase 2.
 */
import { GRAO_CSS } from "../lib/livros-svg";
import "@fontsource-variable/besley/wght.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/jetbrains-mono/wght-italic.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "../styles/fontes.css";
import "../styles/base.css";
import "../styles/avisos.css";
import "../styles/desenho.css";
// Só as duas fontes do primeiro quadro são pré-carregadas (D5); itálico e código baixam quando usados.
// A da interface (IBM Plex Sans, D26) não: o CSS vem embutido no HTML, então ela é pedida logo, e a
// reserva ajustada (fontes.css) evita o deslocamento na troca.
import besley from "@fontsource-variable/besley/files/besley-latin-wght-normal.woff2?url";
import literata from "@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url";
import { claro, cssDosTokens, escuro } from "../styles/tokens";
import { url } from "../lib/url";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import Busca from "../components/Busca.astro";
import VoltarTopo from "../components/VoltarTopo.astro";
import { ESTATISTICAS, TEXTOS } from "../data/site";
import DefinicoesDesenho from "../components/DefinicoesDesenho.astro";
import Abertura from "../components/Abertura.astro";
// A troca de página por folhas (D51): embutida no <head>, antes da primeira pintura.
import trocaJs from "../scripts/troca.js?raw";

interface Props {
  /** Título da página, sem o nome do site. A home não passa título. */
  titulo?: string;
  descricao?: string;
  /** Item do menu que fica marcado como atual. */
  atual?: "artigos" | "categorias" | "series" | "tags";
  /** Open Graph: "article" nos posts. */
  tipo?: "website" | "article";
  /** Imagem de compartilhamento (caminho interno, 1200×630, D10); por padrão, a do blog. */
  imagem?: string;
  /** Texto alternativo da imagem de compartilhamento. */
  imagemAlt?: string;
  publicado?: Date;
  modificado?: Date;
  /** Dados estruturados (BlogPosting nos posts, WebSite na home). */
  jsonLd?: Record<string, unknown>;
  /** Fora dos buscadores e sem canonical (a 404, que responde em qualquer endereço). */
  semIndice?: boolean;
  /**
   * A abertura do site (D51, Abertura.astro), ao chegar de fora ou ao recarregar: a estante que se
   * monta na home (true) ou o caderno que pousa no cabeçalho nas outras páginas (o padrão).
   */
  abertura?: boolean;
  /** Como as folhas desta página chegam na troca (D51, troca.js): o intervalo entre elas ou "propria". */
  chegada?: { passo?: number; propria?: boolean };
  /** Artigo com sumário: a seção atual pode ocupar o lugar da marca no cabeçalho (C2, D49). */
  sumario?: boolean;
}

const NOME = "Cesar Schutz";
const {
  titulo,
  descricao = TEXTOS.descricao,
  atual,
  tipo = "website",
  imagem = "/og/default.png",
  imagemAlt = "Cesar Schutz, blog: a estante com os livros das categorias",
  publicado,
  modificado,
  jsonLd,
  semIndice = false,
  abertura = false,
  sumario = false,
  chegada,
} = Astro.props;
const tituloDaAba = titulo ? `${titulo} · ${NOME}` : `${NOME} · Arquitetura e engenharia de software`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(url(imagem), Astro.site).href;
// A pré-visualização não pode concorrer com o blog atual nos buscadores.
const preVisualizacao = process.env.PREVIEW === "true";
// Pré-carregar a página de um link do site quando o ponteiro para em cima dele (ou o dedo encosta), D52
// B14: regras de especulação do navegador (sem JavaScript; quem não conhece, ignora). Só o HTML, sem
// executar nada (prefetch, e não prerender: a página pré-renderizada rodaria os scripts antes da hora).
const preCarregar = {
  prefetch: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: ["/*.pdf", "/*.xml", "/*.png", "/*.svg", "/*.json", "/*.txt"] } },
          { not: { selector_matches: "[download], [target=_blank], [rel~=nofollow]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Antes da primeira pintura (D52, C01): o padrão é sempre claro e em cards, sem seguir o
      // sistema. A escolha do leitor (tema e/ou modo Lista/Cards) fica em localStorage com a data da
      // última troca ("cs-prefs-quando") e vale por 3 dias; passado isso, some e volta ao padrão. As
      // chaves antigas (tema para sempre em localStorage, som e frases, que saíram) também são limpas.
      // Voltando pelo histórico (bfcache), a página volta como estava: a escolha feita em outra página
      // depois dela é relida no pageshow (D54), e tema.ts e SeletorModo acompanham.
      document.documentElement.dataset.js = "";
      // Fora do macOS e do iOS, o atalho da busca é Ctrl+K (Cabecalho.astro).
      if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent)) document.documentElement.dataset.ctrlK = "";
      function aplicarPreferencias() {
        var raiz = document.documentElement;
        var TRES_DIAS = 3 * 24 * 60 * 60 * 1000;
        var quando = Number(localStorage.getItem("cs-prefs-quando"));
        var validas = quando > 0 && Date.now() - quando < TRES_DIAS;
        var tema = validas ? localStorage.getItem("cs-theme") : null;
        var modo = validas ? localStorage.getItem("cs-post-view") : null;
        if (!validas) {
          localStorage.removeItem("cs-theme");
          localStorage.removeItem("cs-post-view");
          localStorage.removeItem("cs-prefs-quando");
        }
        raiz.dataset.theme = tema === "dark" ? "dark" : "light";
        if (modo !== "list") raiz.dataset.postView = "cards";
        else delete raiz.dataset.postView;
      }
      try {
        aplicarPreferencias();
        localStorage.removeItem("cs-som");
        ["cs-frases", "cs-frase-ultima"].forEach(function (k) { localStorage.removeItem(k); });
        addEventListener("pageshow", function (e) {
          if (!e.persisted) return;
          try { aplicarPreferencias(); } catch (erro) {}
          dispatchEvent(new CustomEvent("preferencias:relidas"));
        });
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ modoDaAbertura: abertura ? "estante" : "caderno" }}>
      // A abertura do site (D51, Abertura.astro): ao chegar de fora (link de outro site, endereço
      // digitado, favorito) e ao recarregar; andando por dentro do site, vale a troca de página. Sem
      // movimento reduzido. Por segurança, ela sai sozinha em 7s se o script dela não chegar.
      try {
        var raizDaAbertura = document.documentElement;
        var navegacao = performance.getEntriesByType("navigation")[0];
        var tipoDaNavegacao = navegacao ? navegacao.type : "navigate";
        var deFora = !document.referrer || new URL(document.referrer).origin !== location.origin;
        if ((tipoDaNavegacao === "reload" || (tipoDaNavegacao === "navigate" && deFora)) && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          raizDaAbertura.dataset.abertura = modoDaAbertura;
          // A abertura cancela esta trava quando assume (Abertura.astro); ela só vale se o script não vier.
          window.csTravaDaAbertura = setTimeout(function () {
            delete raizDaAbertura.dataset.abertura;
            // Quem espera o fim da abertura (o desenho do destaque da home) fica sabendo (D54).
            dispatchEvent(new CustomEvent("cs:aberto"));
          }, 7000);
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Transição do livro (D29, D31): um livro da pilha do painel ou da grade de categorias e séries
      // voa até o livro aberto no topo da página dele. Só o livro que leva à página nova (ou que veio
      // da anterior) ganha o nome de transição (data-vt), para os outros não voarem junto; o livro
      // do topo já tem o nome no HTML. O link é o próprio elemento ou o <a> em volta dele. (O desenho
      // do artigo não voa mais da lista para o topo: ele se desenha quando a folha pousa, D51.)
      (function () {
        function livro(endereco) {
          var caminho = new URL(endereco).pathname;
          var livros = document.querySelectorAll("[data-vt]");
          for (var i = 0; i < livros.length; i++) {
            var link = livros[i].closest("a[href]");
            if (link && new URL(link.href).pathname === caminho) return livros[i];
          }
        }
        function nomear(endereco) {
          if (!endereco) return;
          var l = livro(endereco);
          if (l) l.style.viewTransitionName = l.dataset.vt;
        }
        addEventListener("pageswap", function (e) {
          if (e.viewTransition && e.activation && e.activation.entry) nomear(e.activation.entry.url);
        });
        addEventListener("pagereveal", function (e) {
          if (e.viewTransition && window.navigation && navigation.activation && navigation.activation.from) {
            nomear(navigation.activation.from.url);
          }
        });
      })();
    </script>
    <script is:inline set:html={trocaJs}></script>
    <script type="speculationrules" is:inline set:html={JSON.stringify(preCarregar)}></script>
    <link rel="expect" href="#fim-do-conteudo" blocking="render" />
    <style is:inline set:html={`${cssDosTokens()}:root{--grao:${GRAO_CSS}}`}></style>
    <title>{tituloDaAba}</title>
    <meta name="description" content={descricao} />
    {!semIndice && <link rel="canonical" href={canonico} />}
    {preVisualizacao ? <meta name="robots" content="noindex, nofollow" /> : semIndice && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={claro.paper} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={escuro.paper} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={NOME} href={url("/rss.xml")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <meta name="author" content={NOME} />
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={NOME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo ?? NOME} />
    <meta property="og:description" content={descricao} />
    {!semIndice && <meta property="og:url" content={canonico} />}
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagemAlt} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {modificado && <meta property="article:modified_time" content={modificado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preload" href={besley} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literata} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {
      ESTATISTICAS.goatcounter && (
        <script is:inline async data-goatcounter={`https://${ESTATISTICAS.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <DefinicoesDesenho />
    <Cabecalho atual={atual} sumario={sumario} />
    <main id="conteudo" data-chegada={chegada?.propria ? "propria" : undefined} data-chegada-passo={chegada?.passo}>
      <slot />
    </main>
    <!-- A abertura antes do marcador que libera a primeira pintura: em rede lenta, a página não
         aparece sem o papel por cima (D54). -->
    <Abertura modo={abertura ? "estante" : "caderno"} />
    <span id="fim-do-conteudo" hidden></span>
    <Rodape />
    <VoltarTopo />
    <Busca />
  </body>
</html>
