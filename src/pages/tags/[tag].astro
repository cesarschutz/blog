---
/**
 * Uma tag (/tags/<Nome>/, com o nome cru na URL, como no blog atual: D7), D33: o topo com a estante
 * de filtro (os livros por onde a tag passa, com o número de artigos dela em cada um) e as tags que
 * mais aparecem junto com ela; embaixo, os artigos no formato da home, com Lista / Cards
 * (ListaFiltrada). Na troca de página (D51, protótipo 05, "desfile direto"), as folhas chegam do fundo
 * com 60 ms entre elas, e não 85: a página de uma tag é a que tem mais cards.
 */
import Base from "../../layouts/Base.astro";
import { paginaDeColecao } from "../../lib/seo";
import ListaFiltrada from "../../components/ListaFiltrada.astro";
import { getTags, urlTag, type Grupo } from "../../lib/posts";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((grupo) => ({ params: { tag: grupo.nome }, props: { grupo } }));
}

interface Props {
  grupo: Grupo;
}

const { grupo } = Astro.props;
const n = grupo.posts.length;
const livros = new Set(grupo.posts.map((p) => p.livro)).size;
const descricao = `${n === 1 ? "1 artigo marcado" : `${n} artigos marcados`} com ${grupo.nome}, em ${livros} ${livros === 1 ? "livro" : "livros"}.`;
// As tags que mais aparecem nos mesmos artigos (até 6), para seguir por assunto.
const vizinhas = new Map<string, number>();
for (const p of grupo.posts) for (const t of p.tags) if (t !== grupo.nome) vizinhas.set(t, (vizinhas.get(t) ?? 0) + 1);
const junto = [...vizinhas]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "pt-BR"))
  .slice(0, 6)
  .map(([nome]) => nome);
---

<Base titulo={`#${grupo.nome}`} descricao={descricao} atual="tags" jsonLd={paginaDeColecao(`#${grupo.nome}`, descricao, Astro.url.pathname, Astro.site)} chegada={{ passo: 0.06 }}>
  <div class="wrap">
    <ListaFiltrada posts={grupo.posts} titulo={`#${grupo.nome}`} descricao={descricao} trilha={{ nome: "Tags", href: url("/tags/") }}>
      {
        junto.length > 0 && (
          <div class="linha-indice junto">
            <span class="rotulo-indice">Aparece junto com</span>
            <ul>
              {junto.map((t) => (
                <li>
                  <a class="pilula" href={urlTag(t)}>
                    #{t}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </ListaFiltrada>
  </div>
</Base>

<style>
  .junto .pilula {
    min-height: 30px;
    padding: 3px 11px;
    font-size: 13.5px;
  }
</style>
