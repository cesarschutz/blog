---
/**
 * Tags (/tags/, D39, D52; rodada 3, área 6: F11-2, F12-8, F13-3, F14-4, G16, G27, T13; rodada 4: P19-2,
 * P19-4, P16-7, A3).
 *
 * - No alto, a nuvem (NuvemTags: o nome de cada tag do tamanho da contagem, de A a Z) e, ao lado dela, o
 *   fichário do 19 em aço esmaltado com latão (Fichario.astro, src/scripts/fichario.ts): a 1000px ou mais,
 *   em pé à direita, com a mesma altura da nuvem; abaixo, embaixo dela, deitado. Puxar uma letra mostra só
 *   as fichas dela, que caem de cima; "Todas" puxa as gavetas em cascata e mostra todas.
 * - Embaixo, todas as tags como fichas (FichasTags), de A a Z, com a orelha da letra na primeira de cada
 *   uma; uma linha que não enche fica no meio (P16-7).
 * - A entrada: chegando pela cortina, as fichas acima da dobra vêm jogadas do alto à direita, tortas, e se
 *   arrumam na grade (A3, `data-jogadas`, troca.js); a nuvem e o fichário montam como as folhas, e depois
 *   as gavetas saem em cascata. As de baixo da dobra caem de cima quando entram na tela (P19-4,
 *   fichas-caem.ts); chegando de fora, todas as de cima caem quando a abertura termina.
 *
 * Para as linhas: `.nuvem-tags`, `.fichas-tags` e `.ficha-tag` são estáveis; cada ficha leva
 * `data-letra` (a inicial, sem acento) e `data-n` (a contagem). Sem JS, a página lista tudo, parada, e as
 * gavetas levam à primeira ficha de cada letra.
 */
import Base from "../../layouts/Base.astro";
import CabecalhoPagina from "../../components/CabecalhoPagina.astro";
import NuvemTags from "../../components/NuvemTags.astro";
import Fichario from "../../components/Fichario.astro";
import FichasTags from "../../components/FichasTags.astro";
import { getTags } from "../../lib/posts";

const tags = await getTags();
---

<Base titulo="Tags" descricao="Todas as tags do blog de Cesar Schutz, com o número de artigos de cada uma." atual="tags">
  <div class="wrap">
    <CabecalhoPagina titulo="Tags" descricao={`${tags.length} tags: a nuvem pelo uso, o fichário por letra.`} />
    <div class="topo-tags">
      <NuvemTags tags={tags} aoLado />
      <Fichario tags={tags.map((t) => ({ nome: t.nome, n: t.posts.length }))} />
    </div>
    <h2 class="sr">As fichas das tags, de A a Z</h2>
    <FichasTags tags={tags} jogadas />
  </div>
</Base>

<script>
  // Rodada 4 (P19-2): o fichário (as gavetas por letra) e as fichas que caem (fichas-caem.ts).
  import { fichario } from "../../scripts/fichario";
  import { fichasCaem } from "../../scripts/fichas-caem";

  const lista = document.querySelector<HTMLElement>("[data-fichas-caem]");
  const movel = document.querySelector<HTMLElement>("[data-fichario]");
  if (lista && movel) fichario(movel, lista);
  else if (lista) fichasCaem(lista);
</script>

<style>
  /*
   * A nuvem e o fichário (rodada 4, P19-2). A 1000px ou mais, a nuvem ocupa o que sobra e o fichário fica em
   * pé à direita, com a mesma altura: a linha estica os dois (a nuvem centra as palavras na altura; o
   * fichário reparte a sobra entre as gavetas). Abaixo, um embaixo do outro, com o fichário deitado.
   */
  .topo-tags {
    display: grid;
    gap: clamp(18px, 2.4vw, 26px);
    margin-bottom: clamp(24px, 3vw, 30px);
  }

  @media (min-width: 1000px) {
    .topo-tags {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: stretch;
    }
  }
</style>
