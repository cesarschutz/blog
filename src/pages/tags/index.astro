---
/** Nuvem de tags (/tags/): mais usadas primeiro, com a contagem. */
import Base from "../../layouts/Base.astro";
import CabecalhoPagina from "../../components/CabecalhoPagina.astro";
import { getTags, urlTag } from "../../lib/posts";

const tags = await getTags();
---

<Base titulo="Tags" descricao="Todas as tags do blog de Cesar Schutz, com o número de artigos de cada uma." atual="tags">
  <div class="wrap">
    <CabecalhoPagina titulo="Tags" descricao={`${tags.length} tags, das mais usadas às menos usadas.`} />
    <ul class="nuvem">
      {
        tags.map((t) => (
          <li>
            <a class="pilula" href={urlTag(t.nome)} data-busca-tag={t.nome}>
              #{t.nome} <small>{t.posts.length}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .nuvem {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
