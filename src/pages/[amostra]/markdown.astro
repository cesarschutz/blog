---
/**
 * Amostra dos recursos de Markdown (src/amostra/recursos.md) na grade do artigo: avisos, notas
 * laterais, código, tabela, fórmula, detalhes e imagem. Existe só no `npm run dev`
 * (/amostra/markdown/), como a /amostra/.
 */
import Base from "../../layouts/Base.astro";
import Sumario from "../../components/Sumario.astro";
import { Content, getHeadings } from "../../amostra/recursos.md";
import { url } from "../../lib/url";
import { secoesDoSumario } from "../../lib/posts";
import "../../styles/prosa.css";
import "../../styles/artigo.css";
import "../../styles/caneta.css";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { amostra: "amostra" } }] : [];
}

const secoes = secoesDoSumario(getHeadings());
---

<Base titulo="Amostra dos recursos de Markdown">
  <link slot="head" rel="stylesheet" href={url("/katex/katex.min.css")} />
  <article class="wrap" data-artigo>
    <h1 class="titulo">Amostra dos recursos de Markdown</h1>
    <div class="artigo-grade com-sumario">
      <Sumario secoes={secoes} variante="lateral" />
      <div class="folha artigo-folha">
        <div class="artigo-corpo">
          <div class="prose" data-corpo>
            <Sumario secoes={secoes} variante="recolhivel" />
            <Content />
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>

<script>
  import "../../scripts/artigo.ts";
  import { canetaNoLugar } from "../../scripts/caneta";

  canetaNoLugar();
</script>

<style>
  .titulo {
    margin: 36px 0 0;
    font-size: clamp(34px, 5vw, 52px);
  }
</style>
