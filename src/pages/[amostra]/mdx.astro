---
/**
 * Confere que os plugins do Markdown (avisos, notas laterais, código) valem no MDX (D21), na folha
 * do corpo do artigo (artigo.css). Só no `npm run dev` (/amostra/mdx/).
 */
import Base from "../../layouts/Base.astro";
import { Content } from "../../amostra/recursos.mdx";
import "../../styles/prosa.css";
import "../../styles/artigo.css";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { amostra: "amostra" } }] : [];
}
---

<Base titulo="Amostra em MDX">
  <div class="wrap">
    <div class="artigo-grade">
      <div class="folha artigo-folha">
        <div class="artigo-corpo">
          <div class="prose"><Content /></div>
        </div>
      </div>
    </div>
  </div>
</Base>
