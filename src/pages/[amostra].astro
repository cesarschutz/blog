---
/**
 * Página de conferência dos tokens, das fontes e dos avisos. Existe só no `npm run dev`
 * (/amostra/): no build, getStaticPaths não devolve nenhuma rota.
 */
import Base from "../layouts/Base.astro";
import Aviso from "../components/Aviso.astro";
import { claro, escuro, TOKENS } from "../styles/tokens";
import { CATEGORIAS } from "../data/taxonomia";
import { SERIES } from "../data/series";
import { url } from "../lib/url";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { amostra: "amostra" } }] : [];
}
---

<Base titulo="Amostra de tokens e fontes">
  <div class="wrap amostra">
    <h1>Amostra de tokens e fontes</h1>
    <p class="aviso-dev">Página só de desenvolvimento. Troque o tema no rodapé para conferir os dois.</p>

    <h2>Cores</h2>
    <ul class="cores">
      {
        TOKENS.map((t) => (
          <li>
            <span class="amostra-cor" style={`background:var(--${t})`} />
            <code>--{t}</code>
            <span class="valores">
              {claro[t]} · {escuro[t]}
            </span>
          </li>
        ))
      }
    </ul>

    <h2>Categorias e séries</h2>
    <ul class="tecidos">
      {
        CATEGORIAS.map((c) => (
          <li style={`background:${c.tecido};color:${c.texto}`}>
            <strong>{c.nome}</strong>
            <span>{c.tecido}</span>
          </li>
        ))
      }
      {
        SERIES.map((s) => (
          <li style={`background:${s.encadernacao};color:${s.letras};box-shadow:inset 0 6px 0 ${s.fita}`}>
            <strong>{s.nome}</strong>
            <span>fita {s.fita}</span>
          </li>
        ))
      }
    </ul>

    <h2>Tipografia</h2>
    <p class="titulos">
      <span style="font-weight:700">Besley 700</span>
      <span style="font-weight:800">Besley 800</span>
      <span style="font-weight:900">Besley 900</span>
    </p>
    <p class="interface">
      <span style="font-weight:400">IBM Plex Sans 400: menu, datas, tags</span>
      <span style="font-weight:500">500: categoria, botões</span>
      <span style="font-weight:600">600: números em destaque</span>
    </p>
    <div class="prose">
      <p>
        Texto corrido em Literata, 18,5px com entrelinha 1,72 e números em estilo antigo: em 2026 foram 26 artigos e
        119.739 palavras. Tem <em>itálico</em>, <strong>negrito</strong>, <a href={url("/sobre/")}>um link</a> e <code>código
        no meio do texto</code>. Atalho de busca: <kbd>⌘K</kbd>.
      </p>
      <pre><code>// JetBrains Mono, números alinhados
record Cobranca(String chave, long valorEmCentavos) {"{}"}</code></pre>
    </div>

    <h2>Avisos</h2>
    <div class="prose">
      <Aviso tipo="nota">Os exemplos usam PostgreSQL 17, mas a ideia vale para qualquer banco com restrição única.</Aviso>
      <Aviso tipo="dica">Gere a chave no cliente, uma vez por intenção de pagamento.</Aviso>
      <Aviso tipo="importante">A restrição única no banco é o que garante a unicidade.</Aviso>
      <Aviso tipo="atencao">Um lock na aplicação não resolve quando a API roda em mais de uma instância.</Aviso>
      <Aviso tipo="cuidado">Consultar antes de gravar abre uma janela para duas cobranças.</Aviso>
    </div>
  </div>
</Base>

<style>
  .amostra {
    padding-top: 40px;
  }

  h1 {
    margin: 0 0 6px;
    font-size: clamp(34px, 5vw, 52px);
  }

  .interface {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0 0 16px;
    font-family: var(--font-ui);
    font-size: 17px;
  }

  h2 {
    margin: 48px 0 16px;
    font-size: clamp(22px, 3vw, 28px);
  }

  .aviso-dev {
    margin: 0;
    color: var(--ink-2);
  }

  .cores {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cores li {
    display: grid;
    grid-template-columns: 44px 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
  }

  .amostra-cor {
    grid-row: span 2;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .cores code {
    font-size: 14px;
  }

  .valores {
    font-size: 13px;
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }

  .tecidos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tecidos li {
    display: grid;
    gap: 2px;
    min-width: 150px;
    padding: 16px 14px 12px;
    border-radius: 3px;
    font-size: 14px;
  }

  .tecidos strong {
    font-family: var(--font-titulo);
    font-size: 17px;
  }

  .titulos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0 0 16px;
    font-family: var(--font-titulo);
    font-size: 30px;
  }

  pre {
    padding: 14px 16px;
    overflow-x: auto;
    background: var(--well);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-size: 14px;
    line-height: 1.65;
    font-variant-numeric: lining-nums;
  }
</style>
