---
/**
 * Página de teste da figura em passos (D67), para o Cesar ver no celular: /animacoes-test-2/. As mesmas
 * 9 peças da /animacoes-test/ (que fica no ar como estava), refeitas no formato único, na mesma ordem,
 * com o que mudou em cada uma, as regras novas e o que a auditoria achou nas peças antigas. Fica fora da
 * busca, do sitemap e dos menus (noindex). Sai quando ele decidir.
 */
import Base from "../layouts/Base.astro";
import FiguraPassos from "../components/FiguraPassos.astro";
import { getResumos } from "../lib/posts";
import { url } from "../lib/url";
import { mdEmLinha } from "../lib/formato";
import "../styles/prosa.css";

const resumos = await getResumos();
const post = (slug: string) => {
  const r = resumos.find((x) => x.slug === slug);
  return { titulo: r?.titulo ?? slug, cor: r?.cor, endereco: url(`/posts/${slug}/`) };
};

interface Peca {
  titulo: string;
  slug: string;
  figura: string;
  era: string;
  ancora: string;
  passos: string[];
  legenda?: string;
  mudou: string;
}

const pecas: Peca[] = [
  {
    titulo: "O envelope do KMS",
    slug: "criptografia-em-repouso-e-em-transito",
    figura: "criptografia-em-repouso-e-em-transito/envelope-em-passos",
    era: "lousa de passos da opção 2 (marca-texto)",
    ancora: "marca-texto",
    passos: [
      "O banco cifra `Maria Souza` com a chave de dados e grava no disco.",
      "O KMS cifra a chave de dados com a chave mestra, que nunca sai dele.",
      "O banco guarda a chave cifrada no disco, junto dos dados.",
      "Para ler, o banco pede ao KMS para abrir a chave e decifra na memória.",
      "Depois, com a chave mestra desativada, o KMS recusa: dados e backups ficam ilegíveis.",
    ],
    legenda: "Cada cor é um ator: o KMS (azul), o banco (roxo) e o disco (âmbar); em vermelho, o que falha.",
    mudou:
      "a lousa abria no fim, com a falha por cima do fluxo (riscos e ✕). Virou um diagrama de sequência KMS, banco e disco, com uma linha de dados só, setas que seguem o texto (o pedido sai do banco e a chave mestra não sai do KMS) e a chave desativada numa linha nova embaixo, sem riscar nada.",
  },
  {
    titulo: "O TLS com require e com verify-full",
    slug: "criptografia-em-repouso-e-em-transito",
    figura: "criptografia-em-repouso-e-em-transito/tls-em-passos",
    era: "lousa de comparação da opção 2 (marca-texto)",
    ancora: "marca-texto",
    passos: [
      "Com `require`, o cliente aceita o certificado sem conferir quem está do outro lado.",
      "O intermediário repassa ao banco e lê tudo em claro, sem o cliente perceber.",
      "Com `verify-full`, o cliente confere a CA e o nome, e recusa o certificado.",
      "A conexão nem abre, e ninguém lê nada.",
    ],
    legenda: "Cada cor é um ator: o cliente (petróleo), o intermediário (âmbar) e o banco (roxo); vermelho é o que falha, e verde, o que dá certo.",
    mudou:
      "a parte igual nas duas linhas já vem desenhada, e os passos contam o `require` e depois o `verify-full`, um de cada vez. Saíram o ✓ que queria dizer \"aceitou, o ruim\", o ✕ verde e o intermediário que esmaecia.",
  },
  {
    titulo: "Os dois caminhos até o log",
    slug: "jackson-filtros-mascarando-cartao",
    figura: "jackson-filtros-mascarando-cartao/dois-caminhos-em-passos",
    era: "animação com play da opção 2 (marca-texto)",
    ancora: "marca-texto",
    passos: [
      "Com `log.info(\"{}\", pedido)`, o pedido vai direto ao log pelo `toString()`, sem filtro.",
      "No log, o número e o CVV chegam inteiros, e isso não pode.",
      "Com `logJson.toJson(pedido)`, o pedido passa antes pelo `MascaraCartaoFilter`.",
      "No log, chega o número mascarado, `550209******7890`, e nada do CVV.",
    ],
    legenda: "Em vermelho, o caminho que vaza o cartão; em verde, o que passa pelo filtro.",
    mudou:
      "sem o cartãozinho que andava e sumia, sem o CVV que caía e sem as linhas riscadas. Os dois caminhos ficam desenhados, com `toString()` escrito na seta vermelha, e as duas linhas do log, uma embaixo da outra, com ✕ e ✓.",
  },
  {
    titulo: "O filtro, uma propriedade por vez",
    slug: "jackson-filtros-mascarando-cartao",
    figura: "jackson-filtros-mascarando-cartao/filtro-em-passos",
    era: "lousa de passos da opção 3 (caderno e caneta)",
    ancora: "caderno",
    passos: [
      "`titular`: segue igual, e `\"titular\":\"Cesar\"` entra no JSON.",
      "`numero`: o filtro mascara, e `\"numero\":\"550209******7890\"` entra no JSON.",
      "`cvv`: o filtro omite, e nada é escrito no JSON.",
    ],
    legenda: "O cartão (azul) passa pelo filtro (verde); em verde, o que o filtro mudou.",
    mudou:
