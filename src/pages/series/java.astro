---
/**
 * Página da série "Atualizações do Java" (/series/java/, D32; /java/ redireciona para cá), portada do
 * blog atual (skill serie-java). Como as páginas de categoria (D31): o painel lateral à esquerda, com o livro da série fora da pilha, e o
 * livro aberto no topo, que chega da pilha ou da página de séries por transição de página.
 *
 * Rodada 4, H5 (S11, S12; docs/redesenho/rodada-4/direcao-papel.md): "Comece por aqui" é um bilhete de papel
 * colado na página (o `.papel-colado` com a fita no canto de cima à esquerda), girado −0,5°, com o fio de
 * 2px no laranja da série na borda de cima; o fundo tingido saiu. As edições são fichas de catálogo
 * (catalogo.css), com a mesma tira dos cards desses posts ("Coleção Java · ed. 7", "nº 025", de
 * src/lib/ficha.ts); a próxima LTS tem o fio da tira tracejado, no lugar do contorno tracejado da caixa.
 */
import Base from "../../layouts/Base.astro";
import { paginaDeColecao } from "../../lib/seo";
// Rodada 3, área 4: a fileira de cima, como na página do livro (no lugar do painel lateral); só com as séries (D62).
import FileiraTopo from "../../components/FileiraTopo.astro";
import TopoLivro from "../../components/TopoLivro.astro";
import { montarLivros } from "../../lib/estante";
import { GUIA_JAVA, JAVA_LTS, RELEASED_LTS } from "../../data/java";
import { serie } from "../../data/series";
import { getResumos } from "../../lib/posts";
import { url } from "../../lib/url";
import { chamadaDe } from "../../lib/ficha";
import "../../styles/catalogo.css";

const resumos = await getResumos();
const java = serie("java")!;
const versoes = await Promise.all(
  JAVA_LTS.map((lts) => ({ lts, post: resumos.find((r) => r.slug === `java-${lts.version}`) }))
    .filter((v) => v.post)
    .map(async (v) => ({ ...v, tira: await chamadaDe(v.post!) })),
);
const guia = resumos.find((r) => r.slug === GUIA_JAVA);
const proxima = JAVA_LTS.find((v) => v.upcoming);
// A fileira de cima e os vizinhos: só as séries, sem os livros da coleção (D62). Com uma série só, não há para
// onde trocar, e a fileira não aparece (ela teria só o lugar vazio desta).
const livros = (await montarLivros()).filter((l) => l.serie);
const i = livros.findIndex((l) => l.id === "serie-java");
const livro = livros[i];
const DESCRICAO =
  "Cada versão LTS do Java explicada: o que mudou desde a LTS anterior, em qual versão cada recurso chegou, com exemplos de código e fontes oficiais.";
---

<Base
  titulo="Atualizações do Java"
  descricao={DESCRICAO}
  atual="series"
  jsonLd={paginaDeColecao("Atualizações do Java", DESCRICAO, Astro.url.pathname, Astro.site)}
>
  <div class="wrap pagina-do-livro">
  {livros.length > 1 && <FileiraTopo livros={livros} atual={livro.id} />}
  <div class="java" style={`--cor:${java.destaque};--cor-texto:${java.destaqueTexto ?? java.destaque}`}>
    <TopoLivro
      livro={livro}
      anterior={livros[i - 1]}
      proximo={livros[i + 1]}
      descricao="Uma leitura por versão LTS: o que as versões intermediárias trouxeram desde a LTS anterior, em qual versão cada recurso chegou, com exemplos de código, diagramas e fontes oficiais."
      trilha={{ nome: "Séries", href: url("/series/") }}
    >
      <p class="numeros">
        <span><strong>{RELEASED_LTS.length}</strong> LTS lançadas</span>
        <span>mais recente: <strong>Java {RELEASED_LTS[0].version}</strong></span>
        {proxima && <span>próxima: <strong>Java {proxima.version}</strong>, prevista para {proxima.release}</span>}
      </p>
    </TopoLivro>

    {
      guia && (
        <a class="guia papel-colado" href={guia.url} data-unidade>
          <span class="fita-adesiva canto-esq" aria-hidden="true" />
          <span class="guia-rotulo">Comece por aqui</span>
          <span class="guia-titulo">{guia.titulo}</span>
          <span class="guia-texto">
            Como o ciclo de releases funciona, qual distribuição de JDK usar e como migrar com segurança: a base para ler
            as LTS.
          </span>
        </a>
      )
    }

    <ul class="versoes" aria-label="Versões LTS">
      {
        versoes.map(({ lts, post, tira }) => (
          <li>
            <a class:list={["versao", "folha", "ficha-catalogo", { proxima: lts.upcoming }]} href={post!.url}>
              <span class:list={["tira-catalogo", { tracejada: lts.upcoming }]} aria-hidden="true">
                <span>{tira.chamada}</span>
                <span>{tira.tombo}</span>
              </span>
              <span class="corpo-versao">
                <span class="topo-versao">
                  <span class="numero">{lts.version}</span>
                  <span class="selo">{lts.upcoming ? "Próxima LTS" : "LTS"}</span>
                </span>
                <span class="subtitulo">{post!.subtitulo}</span>
                <span class="rodape-versao">
                  <span>{lts.covers}</span>
                  <span>{lts.upcoming ? `previsto: ${lts.release}` : lts.release}</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  </div>
</Base>

<style>
  .pagina-do-livro {
    padding-top: 12px;
  }

  /* Texto pequeno no laranja da série usa a variante escura (D35); o grande fica na cor da capa. */
  .java {
    --destaque: color-mix(in oklab, var(--cor), #fff var(--branco-no-escuro));
    --destaque-texto: color-mix(in oklab, var(--cor-texto), #fff var(--branco-no-escuro));
  }

  .numeros {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 16px 0 0;
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .numeros strong {
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: lining-nums;
  }

  /*
   * "Comece por aqui" (rodada 4, S11): o bilhete colado na página, com o fio de 2px no laranja da série na
   * borda de cima, por baixo da fita, e um nada torto (−0,5°). No hover, endireita e o título fica azul.
   */
  .guia {
    display: grid;
    gap: 4px;
    width: fit-content;
    max-width: min(100%, 720px);
    margin-top: 36px;
    padding: 22px 26px 20px;
    color: var(--ink);
    text-decoration: none;
    rotate: -0.5deg;
    transition: rotate 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .guia::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--cor);
  }

  .guia :global(.fita-adesiva) {
    --fita-x: -14px;
    --fita-y: -8px;
  }

  @media (hover: hover) {
    .guia:hover {
      rotate: 0deg;
    }
  }

  .guia:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 4px;
  }

  .guia:hover .guia-titulo {
    color: var(--acento);
  }

  .guia-rotulo {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    color: var(--destaque-texto);
  }

  .guia-titulo {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 24px;
  }

  .guia-texto {
    color: var(--ink-2);
  }

  .versoes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 22px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  /* As edições (rodada 4, S12): fichas de catálogo, com a tira dos cards desses posts no alto. */
  .versao {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .corpo-versao {
    flex: 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding: 16px 18px 16px;
  }

  .versao:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-folha-alta);
  }

  .versao:hover .subtitulo {
    color: var(--acento);
  }

  @media (prefers-reduced-motion: reduce) {
    .versao:hover {
      transform: none;
    }

    .guia {
      transition: none;
    }
  }

  .topo-versao {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .numero {
    font-family: var(--font-titulo);
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
    color: var(--destaque);
    font-variant-numeric: lining-nums;
  }

  .selo {
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .subtitulo {
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.35;
  }

  .rodape-versao {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-2);
  }
</style>
