---
/**
 * Home (briefing §5.1): abertura com a estante, a gaveta do livro aberto e os artigos recentes (Lista /
 * Cards), na largura toda: o painel lateral da D28 saiu da home na D44 (continua na página de
 * categoria e na da série). O destaque (o post mais recente) é o primeiro deles (D52, C02): nos cards,
 * ocupa o lugar de dois; na lista e com uma coluna só, é o primeiro, maior (Cartao e ItemLista).
 * Paginada como no blog atual (D27), em /, /2/, /3/…: cada página tem 12 lugares na grade. Na primeira,
 * o destaque ocupa dois, e ela mostra 11 artigos (a grade fecha certinho com 1, 2, 3 ou 4 colunas); da
 * segunda em diante, 12 artigos, só a lista e a paginação. Nenhum post se repete nem fica de fora.
 * O nome do arquivo, `[...page]`, é o parâmetro de resto (a página 1 é a raiz).
 *
 * Rodada 4 (a versão final): o traço de caneta do 17 embaixo de "A coleção" e de "Artigos recentes" (P17-1,
 * só na primeira página), "Artigos recentes" numa etiqueta de papel colada com fita (P16-1) e a paginação
 * em papel, um por botão (P16-2, E6). A entrada do nome gigante é da Abertura (A1).
 *
 * D82 (04/10/2026, pedido do Cesar): saiu a linha entre o nome e os livros (a frase de apresentação, os números
 * Artigos, Livros e Tags com o odômetro e o último artigo), para os livros subirem e os artigos virem logo
 * depois; o nome ficou um pouco menor, com o "blog" carimbado sobre o Z (Marca.astro); e a coleção virou uma
 * estante de prateleiras, com os livros sempre de capa e grandes (ColecaoHome.astro).
 */
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import ColecaoHome from "../components/ColecaoHome.astro";
import Recentes from "../components/Recentes.astro";
import TracoTitulo from "../components/TracoTitulo.astro";
import { LIVRO_NA_LISTA } from "../lib/lista";
import Marca from "../components/Marca.astro";
import { TEXTOS } from "../data/site";
import { montarLivros } from "../lib/estante";
import { getResumos, type Resumo } from "../lib/posts";
import { url } from "../lib/url";

export const getStaticPaths = (async () => {
  // 12 lugares por página, como no blog atual (`SITE.pageSize`); na primeira, o destaque vale dois. Os
  // números ficam aqui dentro porque o Astro isola o getStaticPaths.
  const LUGARES = 12;
  const todos = await getResumos();
  const paginas = [todos.slice(0, LUGARES - 1)];
  for (let i = LUGARES - 1; i < todos.length; i += LUGARES) paginas.push(todos.slice(i, i + LUGARES));
  return paginas.map((posts, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { posts, atual: i + 1, ultima: paginas.length },
  }));
}) satisfies GetStaticPaths;

const { posts, atual, ultima } = Astro.props as { posts: Resumo[]; atual: number; ultima: number };
const endereco = (n: number) => url(n === 1 ? "/" : `/${n}/`);
const primeira = atual === 1;
const livros = primeira ? await montarLivros() : [];
const resumos = await getResumos();
// Como no blog atual: o total de artigos publicados abaixo do título da lista (D33).
const total = `${resumos.length} ${resumos.length === 1 ? "artigo publicado" : "artigos publicados"}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cesar Schutz",
  url: new URL(url("/"), Astro.site).href,
  description: TEXTOS.descricao,
  inLanguage: "pt-BR",
  author: { "@type": "Person", name: "Cesar Schutz", jobTitle: "Arquiteto de soluções" },
};
---

<Base
  titulo={primeira ? undefined : `Artigos — página ${atual}`}
  descricao={primeira ? undefined : `Artigos do blog de Cesar Schutz, do mais recente ao mais antigo: página ${atual} de ${ultima}.`}
  jsonLd={primeira ? jsonLd : undefined}
  abertura={primeira}
>
  {
    primeira && (
      <>
        {/* O nome gigante (com o caderno "cs" que abre, a assinatura e o "blog" carimbado) e a estante da coleção. */}
        <div class="wrap topo-grade">
          <h1 class="nome-gigante">
            <Marca variante="gigante" semLink />
          </h1>
          <section class="secao-colecao" aria-labelledby="colecao-titulo">
            <div class="topo-colecao">
              <h2 id="colecao-titulo" class="titulo-secao"><TracoTitulo texto="A coleção" /></h2>
            </div>
            <ColecaoHome livros={livros} />
          </section>
        </div>
      </>
    )
  }
  <div class="wrap artigos-home">
    <Recentes
      posts={posts}
      titulo={primeira ? "Artigos recentes" : `Artigos — página ${atual}`}
      subtitulo={total}
      nivel={primeira ? "h2" : "h1"}
      destaque={primeira}
      etiqueta
      tracoNoTitulo={primeira}
      livroAoLado={LIVRO_NA_LISTA}
      pagina={{
        atual,
        ultima,
        anterior: atual > 1 ? endereco(atual - 1) : undefined,
        proxima: atual < ultima ? endereco(atual + 1) : undefined,
      }}
    />
  </div>
</Base>

<script>
  // O desenho do destaque se desenha quando entra na tela, uma vez (D41; no primeiro card ou item, D52).
  import { desenharAoEntrar } from "../scripts/desenho-vivo";

  desenharAoEntrar();
</script>

<style>
  /* ---------- o topo ---------- */
  .topo-grade {
    padding-top: clamp(18px, 3vw, 40px);
  }

  /*
   * O nome na coluna: o tamanho sai da largura dela (o caderno, o nome e a folga). D82: um pouco menor que a
   * largura inteira (era 1/7,75 dela, até 196px), com o "blog" carimbado sobre o Z na sobra da direita.
   */
  .nome-gigante {
    margin: 0;
    font-size: min(calc(var(--util) / 8.9), 168px);
    line-height: 0.9;
  }

  /* No celular, o nome em duas linhas, com o caderno da altura delas. */
  @media (max-width: 700px) {
    .nome-gigante {
      font-size: calc(var(--util) / 5.6);
    }
  }

  /* ---------- a coleção ---------- */
  .secao-colecao {
    margin-top: clamp(26px, 3.4vw, 44px);
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  /* O traço de caneta embaixo do título (P17-1) desce 0,42em: a coleção começa depois dele, com um respiro
     para o primeiro abajur não encostar no traço. */
  .topo-colecao {
    margin-bottom: clamp(6px, 1.3vw, 18px);
  }

  .topo-colecao .titulo-secao {
    margin: 0;
  }

  /* Espaço entre a coleção e os artigos. */
  .artigos-home {
    padding-top: clamp(28px, 4vw, 52px);
  }
</style>
