---
/**
 * Home (briefing §5.1): abertura com a estante, a gaveta do livro aberto, o destaque (post mais
 * recente, que não se repete na lista) e os artigos recentes (Lista / Cards), na largura toda: o
 * painel lateral da D28 saiu da home na D44 (continua na página de categoria e na da série).
 * O nome do arquivo, `[...page]`, é exigência do paginate do Astro.
 * Paginada como no blog atual (D27): 12 artigos por página em /, /2/, /3/…; da página 2 em diante,
 * só a lista e a paginação.
 */
import type { GetStaticPaths, Page } from "astro";
import Base from "../layouts/Base.astro";
import Estante from "../components/Estante.astro";
import Gaveta from "../components/Gaveta.astro";
import Destaque from "../components/Destaque.astro";
import Recentes from "../components/Recentes.astro";
import Marca from "../components/Marca.astro";
import { TEXTOS } from "../data/site";
import { montarLivros } from "../lib/estante";
import { getResumos, type Resumo } from "../lib/posts";
import { url } from "../lib/url";

export const getStaticPaths = (async ({ paginate }) => {
  // O destaque (o mais recente) fica fora da lista, em todas as páginas. 12 por página, como no blog
  // atual (`SITE.pageSize`). O número fica aqui dentro porque o Astro isola o getStaticPaths.
  const [, ...demais] = await getResumos();
  return paginate(demais, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Resumo> };
const primeira = page.currentPage === 1;
const livros = primeira ? await montarLivros() : [];
const resumos = await getResumos();
const [destaque] = resumos;
// Como no blog atual: o total de artigos publicados abaixo do título da lista (D33).
const total = `${resumos.length} ${resumos.length === 1 ? "artigo publicado" : "artigos publicados"}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cesar Schutz",
  url: new URL(url("/"), Astro.site).href,
  description: TEXTOS.descricao,
  inLanguage: "pt-BR",
  author: { "@type": "Person", name: "Cesar Schutz", jobTitle: "Arquiteto de soluções" },
};
---

<Base
  titulo={primeira ? undefined : `Artigos — página ${page.currentPage}`}
  descricao={primeira ? undefined : `Artigos do blog de Cesar Schutz, do mais recente ao mais antigo: página ${page.currentPage} de ${page.lastPage}.`}
  jsonLd={primeira ? jsonLd : undefined}
>
  {
    primeira && (
      <>
        {/*
          A abertura (D33) é uma folha: a identidade (a marca grande e a apresentação do blog atual) e a
          estante; a gaveta do livro aberto abre dentro da folha (D26). O post-it das frases saiu (D39).
        */}
        <div class="wrap topo-home">
          <div class="folha folha-abertura">
            <div class="abertura">
              <div class="identidade">
                <h1 class="marca-abertura">
                  <Marca variante="grande" semLink />
                </h1>
                <p class="frase">{TEXTOS.apresentacao}</p>
              </div>
              <div class="cena">
                <Estante livros={livros} />
              </div>
            </div>
            <Gaveta livros={livros} />
          </div>
        </div>
        {destaque && <Destaque post={destaque} />}
      </>
    )
  }
  <div class="wrap artigos-home">
    <Recentes
      posts={page.data}
      titulo={primeira ? "Artigos recentes" : `Artigos — página ${page.currentPage}`}
      subtitulo={total}
      nivel={primeira ? "h2" : "h1"}
      pagina={{ atual: page.currentPage, ultima: page.lastPage, anterior: page.url.prev, proxima: page.url.next }}
    />
  </div>
</Base>

<style>
  .topo-home {
    padding-top: 26px;
  }

  /* Espaço entre o destaque (ou o cabeçalho) e os artigos. */
  .artigos-home {
    padding-top: 56px;
  }

  .folha-abertura {
    padding: 34px 44px 30px;
  }

  /*
   * Computador: a identidade à esquerda e a cena à direita, no centro da altura uma da outra.
   * Tablet (até 1359px): a cena desce para baixo da identidade, no centro.
   */
  .abertura {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px 52px;
    align-items: center;
  }

  /* A marca ocupa a largura da coluna (a identidade é um contêiner), até 52px. */
  .identidade {
    container-type: inline-size;
    min-width: 0;
  }

  .marca-abertura {
    margin: 0;
    font-size: clamp(28px, calc(100cqi / 9.9), 52px);
    line-height: 1;
  }

  .marca-abertura :global(.marca) {
    font-size: inherit;
  }

  .frase {
    max-width: 40ch;
    margin: 20px 0 0;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
  }

  /* A cena: a estante, sem encolher além da largura da folha. */
  .cena {
    max-width: 100%;
    min-width: 0;
  }

  @media (max-width: 1359px) {
    .abertura {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .frase {
      max-width: 60ch;
    }

    .cena {
      justify-self: center;
    }
  }

  @media (max-width: 860px) {
    .topo-home {
      padding-top: 20px;
    }

    .folha-abertura {
      padding: 26px 22px 20px;
    }
  }

  @media (max-width: 640px) {
    .abertura {
      gap: 22px;
    }

    /*
     * Abertura mais curta no celular (D38): a marca grande sai da tela (ela já está no cabeçalho) e
     * continua como o h1 da página para quem usa leitor de tela.
     */
    .marca-abertura {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .frase {
      margin-top: 0;
    }
  }
</style>
