---
/** Página não encontrada. O GitHub Pages serve este 404.html sozinho. */
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---

<Base titulo="Página não encontrada" descricao="Esta página não existe ou mudou de endereço." semIndice>
  <div class="wrap nao-encontrada">
    <div class="folha caixa">
      <p class="codigo">Erro 404</p>
      <h1>Página não encontrada</h1>
      <p>O endereço pode ter mudado ou nunca ter existido. Tente a busca, a lista de artigos ou a página inicial.</p>
      <p class="caminhos">
        <a href={url("/archive/")}>Todos os artigos</a>
        <a href={url("/")}>Página inicial</a>
        <button type="button" class="pilula" data-busca-abrir>Buscar</button>
      </p>
    </div>
  </div>
</Base>

<style>
  .nao-encontrada {
    max-width: calc(var(--coluna) + 96px + 2 * var(--pad));
    padding-top: 56px;
  }

  .caixa {
    padding: 36px 48px 40px;
  }

  .codigo {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }

  h1 {
    margin: 8px 0 12px;
    font-size: clamp(34px, 5vw, 52px);
  }

  .caminhos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin: 24px 0 0;
    font-family: var(--font-ui);
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .caixa {
      padding: 24px 22px 28px;
    }
  }
</style>
