---
/**
 * Índice das categorias (/categories/, D31): os livros da coleção lado a lado, grandes, abertos em
 * três quartos, na ordem dos volumes. Cada um leva à página do livro, com a transição do livro.
 *
 * A chegada (D51, protótipo 04, "desfile e pilha"): vindo de outra página (troca.js) ou depois do
 * caderno da abertura, os livros chegam como os cartões do A2, um depois do outro, do fundo, e pousam um
 * em cima do outro numa pilha; a ficha ao lado diz o volume e o nome do que está pousando. Com a pilha
 * pronta, cada um vai para o seu lugar na grade (sai primeiro o de cima). Voltando pelo histórico, a
 * grade chega pela troca de página comum.
 */
import Base from "../../layouts/Base.astro";
import CabecalhoPagina from "../../components/CabecalhoPagina.astro";
import GradeLivros from "../../components/GradeLivros.astro";
import { montarLivros } from "../../lib/estante";

const livros = (await montarLivros()).filter((l) => !l.serie);
---

<Base titulo="Livros" descricao="Os livros do blog de Cesar Schutz: cada assunto é um livro da coleção." atual="categorias" chegada={{ propria: true }}>
  <div class="wrap">
    <CabecalhoPagina titulo="Livros" descricao="Cada assunto é um livro da coleção. Abra um para ver os artigos dele; as séries ficam em Séries." />
    <GradeLivros livros={livros} />
  </div>
</Base>

<script>
  import { carregarGsap, movimentoReduzido } from "../../scripts/gsap";

  type Unidade = { el: HTMLElement; texto: boolean };
  type Troca = { unidades: () => Unidade[]; chegar: (novas: Unidade[], opcoes?: { t0?: number }) => number };
  type Chegada = { novas: Unidade[]; inicio: number; t0?: number; comecou?: boolean; revelada?: boolean };
  const janela = window as unknown as { csTroca?: Troca; csChegada?: Chegada | null };

  async function desfilar(novas: Unidade[], t0: number, curto = false) {
    const gsap = await carregarGsap();
    const troca = janela.csTroca;
    const cartoes = novas.filter((u) => u.el.matches(".cartao-livro")).map((u) => u.el);
    const outras = novas.filter((u) => !u.el.matches(".cartao-livro"));
    // Rodada 3 (revisão final, correção comum 4): só os cartões à vista vão para a pilha. Os que estão abaixo
    // da dobra não entram na fila: esperam a rolagem e aparecem como as outras listas (data-revelar,
    // revelar.ts, T13). Antes, todos iam para a pilha, e a montagem só assentava entre 3,5 e 4s.
    const dobra = innerHeight - 40;
    const abaixo: HTMLElement[] = [];
    for (const c of document.querySelectorAll<HTMLElement>("[data-grade-livros] .cartao-livro")) {
      if (cartoes.includes(c)) continue;
      if (c.getBoundingClientRect().top >= dobra) abaixo.push(c);
      else cartoes.push(c);
    }
    if (abaixo.length) {
      abaixo.forEach((c) => {
        c.style.opacity = "";
        c.setAttribute("data-revelar", "");
      });
      dispatchEvent(new CustomEvent("cs:revelar"));
    }
    outras.forEach((u) => (u.el.style.opacity = ""));
    troca?.chegar(outras, { t0 });
    const livros = cartoes.map((c) => ({ volume: c.querySelector(".volume")?.textContent ?? "", nome: c.querySelector(".nome")?.textContent ?? "" }));

    const W = innerWidth, H = innerHeight, cel = W <= 640, P = 1400;
    const S = { x: cel ? W / 2 : W * 0.6, y: H * (cel ? 0.56 : 0.54) };
    const alvo = cartoes.map((c) => {
      const r = c.getBoundingClientRect();
      return { dx: S.x - (r.left + r.width / 2), dy: S.y - (r.top + r.height / 2) };
    });
    cartoes.forEach((c, i) => {
      c.style.opacity = "";
      gsap.set(c, { position: "relative", zIndex: 10 + i, transformPerspective: P, transformOrigin: "50% 50%", opacity: 0, transition: "none" });
    });

    // A ficha ao lado do desfile, como a do A2.
    const ficha = document.createElement("div");
    ficha.className = "ficha-desfile";
    ficha.setAttribute("aria-hidden", "true");
    ficha.innerHTML = `<span class="vol"></span><span class="mascara"><b></b></span>`;
    document.body.append(ficha);
    const vol = ficha.querySelector<HTMLElement>(".vol")!, nome = ficha.querySelector<HTMLElement>("b")!;
    const rnd = gsap.utils.random;
    // Rodada 4 (A3): o desfile do blog de hoje (o 11), com os tempos dele: cada cartão voa 0,75s, um a cada
    // 0,13s (0,12s no celular), e o nome dele aparece grande à esquerda quando ele está chegando à pilha; com
    // a pilha pronta, cada um vai ao lugar em 0,7s, 60ms entre eles, saindo primeiro o de cima. Sob a
    // cortina, ele começa aos 0,42s (troca.js): com os quatro cartões à vista (1440), assenta por volta de
    // 2,7s; com oito, por volta de 3,4s (até 3,5s do clique). Os cartões abaixo da dobra não entram na pilha:
    // aparecem ao rolar. Depois do caderno da abertura, mais curto: a pessoa já esperou por ele.
    const n = cartoes.length, um = Math.max(1, n - 1);
    const passo = curto ? Math.min(0.08, 0.5 / um) : Math.min(cel ? 0.12 : 0.13, 0.95 / um), dur = curto ? 0.6 : 0.75, z = cel ? -900 : -1600, k = P / (P - z);
    const distribui = curto ? 0.6 : 0.7, passoDistribui = curto ? Math.min(0.05, 0.3 / um) : Math.min(0.06, 0.42 / um);
    const tl = gsap.timeline({
      onComplete: () => {
        ficha.remove();
        gsap.set(cartoes, { clearProps: "transform,opacity,zIndex,position,transition,transformPerspective,transformOrigin" });
      },
    });
    gsap.set(ficha, { opacity: 0 });
    tl.to(ficha, { opacity: 1, duration: 0.3 }, t0 + 0.1);
    cartoes.forEach((c, i) => {
      const t = t0 + 0.1 + i * passo, a = alvo[i];
      tl.fromTo(
        c,
        cel
          ? { x: a.dx, y: a.dy - (H * 0.45) / k, z, rotationX: 22, rotationY: 0, rotationZ: rnd(-8, 8), scale: 0.86 }
          : { x: a.dx + (W * 0.3) / k, y: a.dy - (H * 0.5) / k, z, rotationX: 16, rotationY: -30, rotationZ: rnd(-10, 10), scale: 0.86 },
        { x: a.dx, y: a.dy, z: 0, rotationX: 0, rotationY: 0, rotationZ: rnd(-7, 7), scale: 0.86, duration: dur, ease: "power3.out" },
        t,
      )
        // Opaco logo, ainda longe e pequeno: na pilha, nenhum cartão fica translúcido sobre os outros.
        .to(c, { opacity: 1, duration: 0.12, ease: "power1.out" }, t)
        .call(() => {
          vol.textContent = livros[i].volume;
          nome.textContent = livros[i].nome;
          gsap.fromTo(nome, { yPercent: 70, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.24, ease: "power2.out", overwrite: true });
        }, undefined, t + 0.3);
    });
    // Saindo no meio do desfile, ele termina antes (troca.js, cs:congelar, D54). Os cartões vão ao lugar sem a
    // transição do CSS, que o fim do desfile devolve: senão, voltando pelo bfcache, um deles ainda deslizava.
    addEventListener(
      "cs:congelar",
      () => {
        if (tl.progress() === 1) return;
        tl.progress(1);
        cartoes.forEach((c) => (c.style.transition = "none"));
        void document.body.offsetHeight;
        cartoes.forEach((c) => c.style.removeProperty("transition"));
      },
      { once: true },
    );
    // Da pilha para a grade: sai primeiro o de cima (o último volume); cada um sobe um pouco no caminho.
    const tDist = t0 + 0.1 + (n - 1) * passo + dur + 0.1;
    tl.to(ficha, { opacity: 0, duration: 0.25 }, tDist - 0.1);
    [...cartoes].reverse().forEach((c, j) => {
      tl.to(c, { x: 0, y: 0, rotationZ: 0, scale: 1, duration: distribui, ease: "power3.inOut" }, tDist + j * passoDistribui)
        .to(c, { z: 70, duration: distribui / 2, ease: "power2.out", yoyo: true, repeat: 1 }, tDist + j * passoDistribui);
    });
  }

  if (!movimentoReduzido.matches) {
    // Vindo de outra página: a troca (troca.js) deixou as folhas escondidas esperando por esta chegada.
    const chegada = janela.csChegada;
    if (chegada) {
      // O desfile começa quando as folhas da página anterior já caíram (troca.js, D52 A02) e o GSAP chegou.
      // Com a rede lenta, se o GSAP demorar, a troca mostra as folhas paradas (D52 B14) e o desfile não vem.
      void carregarGsap().then(() => {
        if (chegada.revelada) return;
        chegada.comecou = true;
        janela.csChegada = null;
        void desfilar(chegada.novas, Math.max(0, (chegada.t0 ?? 0.2) - (performance.now() - chegada.inicio) / 1000));
      }, () => {});
    }
    // Entrando direto: o caderno da abertura avisa quando o papel começa a sair.
    addEventListener("cs:abertura-chega", () => janela.csTroca && void desfilar(janela.csTroca.unidades(), 0, true), { once: true });
  }
</script>

<style is:global>
  /* A ficha do desfile (D51): o volume e o nome do livro que está pousando na pilha. */
  .ficha-desfile {
    position: fixed;
    left: clamp(20px, 5vw, 72px);
    top: 46%;
    translate: 0 -50%;
    z-index: 5;
    width: min(30vw, 380px);
    display: grid;
    gap: 10px;
    pointer-events: none;
  }

  .ficha-desfile .vol {
    font: 700 12px/1 var(--font-livro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .ficha-desfile .mascara {
    overflow: clip;
    height: 2.3em;
    display: flex;
    align-items: flex-end;
    font: 700 clamp(26px, 3.2vw, 42px)/1.08 var(--font-titulo);
    color: var(--ink);
  }

  .ficha-desfile b {
    display: block;
    padding-bottom: 0.12em;
    text-wrap: balance;
  }

  /* No celular, a ficha fica embaixo (em cima, ela cobria o título da página), acima do ícone do computador. */
  @media (max-width: 640px) {
    .ficha-desfile {
      top: auto;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 78px);
      translate: none;
      left: 18px;
      right: 18px;
      width: auto;
    }

    .ficha-desfile .mascara {
      font-size: 24px;
    }
  }
</style>
