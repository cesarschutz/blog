---
/** Todos os artigos (/archive/), agrupados por ano. Os ids #y2026 vêm do blog atual. */
import Base from "../layouts/Base.astro";
import CabecalhoPagina from "../components/CabecalhoPagina.astro";
import ItemLista from "../components/ItemLista.astro";
import { getResumos } from "../lib/posts";

const resumos = await getResumos();
const anos = [...new Set(resumos.map((r) => r.publicado.getUTCFullYear()))];
---

<Base titulo="Todos os artigos" descricao="Todos os artigos do blog de Cesar Schutz, do mais recente ao mais antigo." atual="artigos">
  <div class="wrap">
    <CabecalhoPagina titulo="Todos os artigos" descricao={`${resumos.length} artigos, do mais recente ao mais antigo.`} />
    {
      anos.map((ano) => (
        <section aria-labelledby={`y${ano}`}>
          <h2 id={`y${ano}`} class="ano">{ano}</h2>
          <ol class="lista-artigos folha">
            {resumos
              .filter((r) => r.publicado.getUTCFullYear() === ano)
              .map((r) => (
                <ItemLista post={r} compacto />
              ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .ano {
    margin: 36px 0 14px;
    font-size: clamp(24px, 2.6vw, 28px);
    font-variant-numeric: lining-nums;
  }

  section:first-of-type .ano {
    margin-top: 8px;
  }
</style>
