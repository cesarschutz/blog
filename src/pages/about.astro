---
/**
 * /about/ → /sobre/ (D7). Não é um redirecionamento da configuração porque precisa levar a âncora
 * antiga: o "Saiba mais" dos posts do blog atual aponta para /about/#site.
 */
import { url } from "../lib/url";

const destino = url("/sobre/");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Redirecionando para a página Sobre</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destino, Astro.site)} />
    <script is:inline define:vars={{ destino }}>
      var ancora = location.hash === "#site" ? "#como-os-artigos-sao-produzidos" : location.hash;
      location.replace(destino + ancora);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destino}`} />
  </head>
  <body>
    <p><a href={destino}>Ir para a página Sobre</a></p>
  </body>
</html>
